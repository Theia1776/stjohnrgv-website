# Response headers, applied by Cloudflare Pages.
#
# The site was serving only X-Content-Type-Options and Referrer-Policy.
# These are the rest of the ordinary set for a site that has a sign-in
# form, an admin area and a session cookie.
#
# Syntax note: this is Cloudflare's own format, not nginx. A rule is a
# path pattern on its own line, then its headers indented beneath. No
# semicolons between rules.

/*
  # Tell browsers to refuse plain HTTP for a year. Cloudflare already
  # redirects, but a redirect still sends the first request in the
  # clear, where a session cookie can be read off a cafe network.
  # No `preload` — that is a one-way door and belongs to a deliberate
  # decision, not a config file.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # The parish's pages are nobody's iframe. Stops a lookalike site
  # framing the real sign-in form and reading what is typed into it.
  X-Frame-Options: DENY

  # Browser features this site never uses. Asked for by name so a
  # script that tries anyway is refused by the browser rather than
  # trusted.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

  # Already set, kept here so the whole set reads in one place.
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

  # Content-Security-Policy is deliberately NOT set here yet. Getting
  # it wrong silently breaks a page rather than warning about it, and
  # this site loads Google Fonts, uses inline <script> blocks that
  # Astro emits, and talks to Supabase. A real policy needs those
  # enumerated and then tested page by page with the browser console
  # open. Worth doing; not worth guessing at.

# The API answers with JSON and should never be treated as a document
# or cached by anything in between.
/api/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Hashed filenames, so these can be held for a year. Astro writes a new
# name whenever the contents change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
