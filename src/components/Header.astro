---
/**
 * The menu.
 *
 * Two of these open. Not for tidiness — the site had fifteen real
 * pages and the menu showed eight, so the Library, the catechumen
 * guide, the history, both saints' lives and the gluten-free section
 * could not be reached from the top of any page. A flat row cannot
 * hold them, and a label like "Learn More / Library" promises two
 * places and goes to one.
 *
 * `children` makes a link a menu; its own href is the first item in
 * it, so the parent is still somewhere you can go.
 */
const navLinks = [
  {
    href: "/calendar/",
    label: "Calendar",
    // These jump to parts of the one calendar page rather than to
    // separate pages — the whole day is on that page on purpose, and
    // splitting it would be a step backwards. The page scrolls to
    // them itself once the day has loaded, because the browser looks
    // for the anchor long before the data arrives.
    children: [
      { href: "/calendar/", label: "Today" },
      { href: "/calendar/#fast-banner", label: "Fasting Today" },
      { href: "/calendar/#saint-diptych", label: "Saint of the Day" },
      { href: "/learn/saints/", label: "All Saints" },
      { href: "/calendar/#cal-commemorations", label: "Commemorations" },
      { href: "/calendar/#cal-readings", label: "Scripture Readings" },
      { href: "/calendar/#cal-troparia", label: "Troparia & Kontakia" },
    ],
  },
  {
    href: "/learn/",
    label: "Learn More",
    children: [
      { href: "/learn/", label: "Learn More" },
      { href: "/learn/library/", label: "The Library" },
      { href: "/newsletter/", label: "Parish Newsletter" },
      { href: "/learn/catechumen/", label: "For Catechumens" },
      { href: "/learn/orthodox-history/", label: "Orthodox History" },
      { href: "/learn/st-john-of-kronstadt/", label: "St. John of Kronstadt" },
      { href: "/learn/st-john-chrysostom/", label: "St. John Chrysostom" },
    ],
  },
  {
    href: "/table/",
    label: "Fasting",
    children: [
      { href: "/table/", label: "An Orthodox Table" },
      { href: "/table/keeping-the-fast/", label: "Keeping the Fast" },
      { href: "/table/eating-for-the-fast/", label: "Eating for the Fast" },
      { href: "/table/fasting/", label: "Fasting Recipes" },
      { href: "/table/everyday/", label: "Everyday Recipes" },
      { href: "/table/gluten-free/", label: "Gluten-Free" },
      { href: "/table/share/", label: "Share a Recipe" },
    ],
  },
  { href: "/donate/", label: "Tithe / Donate" },
  { href: "/visit/", label: "Visit" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;

/** True when this nav link should be marked as the current page. */
function isActive(hrefWithHash: string): boolean {
  // Strip the fragment first: /calendar/#cal-readings is the calendar
  // page, and without this every item in its menu would read as the
  // page you are on.
  const href = hrefWithHash.split("#")[0];
  // Exact match first; otherwise treat the link as a section root and
  // mark active when the current path starts with it (e.g. /about/foo).
  if (currentPath === href) return true;
  if (href === "/") return false;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-1 z-40 border-b border-border-soft bg-cream-card shadow-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
    <a
      href="/"
      class="flex items-center gap-3 text-text-primary no-underline hover:text-brand-blue-dark transition-colors"
    >
      <span aria-hidden="true" class="text-2xl text-sacred-gold"><svg class="orth-cross" viewBox="0 0 20 32" fill="currentColor" aria-hidden="true"><rect x="8" y="0" width="4" height="32"/><rect x="5" y="4" width="10" height="3"/><rect x="1" y="10" width="18" height="3"/><polygon points="4,20 16,24 16,27 4,23"/></svg></span>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base md:text-lg">St. John of Kronstadt</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Orthodox Mission · RGV</span>
      </span>
    </a>

    <div class="flex items-center gap-3">
      <nav class="hidden lg:flex items-center gap-5 text-sm" aria-label="Primary">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          if (link.children) {
            // A menu is open when the page you are on is inside it, so
            // the top row still shows where you are.
            const inside = link.children.some((c) => isActive(c.href));
            return (
              <div class="nav-menu relative">
                <button
                  type="button"
                  class:list={[
                    "nav-menu-trigger flex items-center gap-1 py-1 border-b-2 whitespace-nowrap transition-colors",
                    inside
                      ? "text-text-primary border-liturgical-current"
                      : "text-text-primary/80 border-transparent hover:text-brand-blue-dark",
                  ]}
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {link.label}
                  <span aria-hidden="true" class="text-[0.6rem] leading-none">&#9660;</span>
                </button>
                <div
                  class="nav-menu-panel absolute left-0 top-full z-50 mt-1 hidden min-w-[14rem] border border-border-soft bg-cream-card py-1 shadow-lg"
                  role="menu"
                >
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      role="menuitem"
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class:list={[
                        "block px-4 py-2 text-sm no-underline hover:bg-brand-blue-pale",
                        isActive(child.href) ? "text-brand-blue-dark font-semibold" : "text-text-primary",
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "no-underline transition-colors py-1 border-b-2 whitespace-nowrap",
                active
                  ? "text-text-primary border-liturgical-current"
                  : "text-text-primary/80 border-transparent hover:text-brand-blue-dark",
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- ADA / accessibility: larger text and read-aloud, in one place so
           the people who need them can find them. Plain text after Contact. -->
      <div class="relative print:hidden lg:ml-2">
        <a
          id="a11y-trigger"
          href="#a11y-panel"
          role="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="a11y-panel"
          aria-label="Accessibility options: larger text, read aloud, language, light or dark"
          title="Accessibility options"
          class="block text-sm no-underline transition-colors py-1 border-b-2 whitespace-nowrap text-text-primary/80 border-transparent hover:text-brand-blue-dark"
        >ADA</a>
        <div
          id="a11y-panel"
          role="dialog"
          aria-label="Accessibility options"
          class="hidden absolute right-0 top-full z-50 mt-1 w-[22rem] max-w-[92vw] space-y-4 border border-border-soft bg-cream-card p-4 text-sm shadow-md"
        >
          <div>
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Text size</p>
            <div class="grid grid-cols-3 gap-2" role="group" aria-label="Text size">
              <button type="button" data-size="normal" aria-pressed="true" class="a11y-size min-w-0 break-words border border-border-soft px-1 py-2 text-sm text-text-primary hover:bg-brand-blue-pale">Normal</button>
              <button type="button" data-size="large" aria-pressed="false" class="a11y-size min-w-0 break-words border border-border-soft px-1 py-2 text-base text-text-primary hover:bg-brand-blue-pale">Larger</button>
              <button type="button" data-size="xlarge" aria-pressed="false" class="a11y-size min-w-0 break-words border border-border-soft px-1 py-2 text-lg text-text-primary hover:bg-brand-blue-pale">Largest</button>
            </div>
          </div>
          <div id="a11y-listen-box">
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Read aloud</p>
            <div class="flex gap-2">
              <button type="button" id="a11y-listen" class="btn btn-primary flex-1 text-sm">Read this page</button>
              <button type="button" id="a11y-stop" class="btn btn-secondary w-full text-sm">Stop</button>
            </div>
            <p id="a11y-note" role="status" class="mt-2 text-xs text-text-secondary"></p>
          </div>
          <div>
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Language</p>
            <div class="grid grid-cols-3 gap-2" role="group" aria-label="Language">
              <button data-lang="en" type="button" class="lang-option min-w-0 break-words border border-border-soft px-1 py-2 text-sm text-text-primary hover:bg-brand-blue-pale">English</button>
              <button data-lang="es" type="button" class="lang-option min-w-0 break-words border border-border-soft px-1 py-2 text-sm text-text-primary hover:bg-brand-blue-pale">Español</button>
              <button data-lang="ru" type="button" class="lang-option min-w-0 break-words border border-border-soft px-1 py-2 text-sm text-text-primary hover:bg-brand-blue-pale">Русский</button>
            </div>
          </div>
          <div>
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Light or dark</p>
            <button
              type="button"
              id="theme-toggle"
              class="flex w-full items-center justify-center gap-2 border border-border-soft px-2 py-2 text-text-primary hover:bg-brand-blue-pale"
            >
              <span id="theme-icon" aria-hidden="true">🌙</span>
              <span id="theme-label">Switch to dark mode</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Auth nav lives furthest right by design — rendered client-side
           by the script below once /api/auth/me resolves. -->
      <div id="auth-nav" class="hidden md:flex items-center text-sm"></div>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden flex items-center justify-center rounded-sm border border-border-soft px-3 py-2 text-text-primary hover:bg-brand-blue-pale"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>


    </div>
  </div>

  <!-- The header is sticky, so an open menu taller than the phone ran
       off the bottom of the screen with no way to reach Sign In or
       Parish Admin. It scrolls on its own instead; the script below
       caps its height at whatever room is left under the header. -->
  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain border-t border-border-soft bg-cream-bg lg:hidden" aria-label="Mobile">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-4">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        // No hover on a phone, and a tap that only opens a submenu is
        // a tap that feels broken. The children are simply listed,
        // indented, under their heading.
        if (link.children) {
          return (
            <div class="border-b border-border-soft py-2">
              <p class="py-1 font-display text-xs uppercase tracking-widest text-text-secondary">
                {link.label}
              </p>
              {link.children.map((child) => (
                <a
                  href={child.href}
                  aria-current={isActive(child.href) ? "page" : undefined}
                  class:list={[
                    "block py-2 pl-3 no-underline transition-colors",
                    isActive(child.href)
                      ? "border-l-2 border-l-liturgical-current text-text-primary"
                      : "text-text-primary hover:text-brand-blue-dark",
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          );
        }
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "border-b border-border-soft py-3 no-underline transition-colors",
              active
                ? "text-text-primary border-l-2 border-l-liturgical-current pl-3"
                : "text-text-primary hover:text-brand-blue-dark",
            ]}
          >
            {link.label}
          </a>
        );
      })}
      <div id="mobile-auth-nav" class="mt-3"></div>

      <!-- Language switcher (mobile). Same data-lang values as the
           desktop dropdown so the JS treats them uniformly. -->
      <div class="mt-4 flex items-center gap-2 border-t border-border-soft pt-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-text-secondary">Language:</span>
        <button data-lang="en" type="button" class="lang-option px-3 py-1 text-xs font-display uppercase tracking-widest border border-border-soft rounded text-text-primary hover:bg-brand-blue-pale">EN</button>
        <button data-lang="ru" type="button" class="lang-option px-3 py-1 text-xs font-display uppercase tracking-widest border border-border-soft rounded text-text-primary hover:bg-brand-blue-pale">RU</button>
        <button data-lang="es" type="button" class="lang-option px-3 py-1 text-xs font-display uppercase tracking-widest border border-border-soft rounded text-text-primary hover:bg-brand-blue-pale">ES</button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    if (open && menu) {
      menu.style.maxHeight = `calc(100dvh - ${Math.ceil(menu.getBoundingClientRect().top)}px)`;
    }
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  // ===== Language switcher =====
  // ES / RU send the visitor through Google's translate proxy at
  // <site-with-dashes>.translate.goog with _x_tr_tl=<lang>. Once
  // there, every internal link stays inside the proxy until the user
  // picks EN again. EN strips the _x_tr_* params and bounces back to
  // the canonical host.
  const TRANSLATE_PROXY_HOST = "stjohnrgv-org.translate.goog";
  const ORIGINAL_HOST = "stjohnrgv.org";
  const LANG_LABEL = { en: "English", es: "Español", ru: "Русский" };

  function detectActiveLang() {
    if (window.location.hostname.endsWith(".translate.goog")) {
      const tl = new URLSearchParams(window.location.search).get("_x_tr_tl");
      if (tl === "es" || tl === "ru") return tl;
    }
    return "en";
  }

  function stripTranslateParams(search) {
    if (!search) return "";
    const params = new URLSearchParams(search);
    Array.from(params.keys()).forEach((k) => {
      if (k.startsWith("_x_tr_")) params.delete(k);
    });
    const out = params.toString();
    return out ? "?" + out : "";
  }

  // Remember the visitor's choice. The translated site lives on a
  // different address, so English is passed back as _site_lang=en and
  // saved here when the canonical site loads.
  const LANG_KEY = "site-lang";
  function savedLang() {
    try { return localStorage.getItem(LANG_KEY); } catch (e) { return null; }
  }
  function saveLang(l) {
    try { localStorage.setItem(LANG_KEY, l); } catch (e) {}
  }
  (function applySavedLanguage() {
    if (window.location.hostname !== ORIGINAL_HOST) return;
    const params = new URLSearchParams(window.location.search);
    if (params.get("_site_lang")) {
      saveLang("en");
      params.delete("_site_lang");
      const rest = params.toString();
      history.replaceState(null, "", window.location.pathname + (rest ? "?" + rest : "") + window.location.hash);
      return;
    }
    const s = savedLang();
    if (s === "es" || s === "ru") {
      const cleaned = stripTranslateParams(window.location.search);
      const sep = cleaned ? cleaned + "&" : "?";
      window.location.replace(
        "https://" + TRANSLATE_PROXY_HOST + window.location.pathname + sep
        + "_x_tr_sl=en&_x_tr_tl=" + s + "&_x_tr_hl=en" + window.location.hash
      );
    }
  })();

  function switchLanguage(target) {
    const path = window.location.pathname;
    const cleaned = stripTranslateParams(window.location.search);
    const hash = window.location.hash;
    if (target === "en") {
      saveLang("en");
      const sep0 = cleaned ? cleaned + "&" : "?";
      window.location.href = "https://" + ORIGINAL_HOST + path + sep0 + "_site_lang=en" + hash;
      return;
    }
    saveLang(target);
    const sep = cleaned ? cleaned + "&" : "?";
    window.location.href =
      "https://" + TRANSLATE_PROXY_HOST + path + sep
      + "_x_tr_sl=en&_x_tr_tl=" + target + "&_x_tr_hl=en" + hash;
  }

  function initLanguageSwitcher() {
    const active = detectActiveLang();

    const currentLabel = document.getElementById("lang-current-label");
    if (currentLabel) currentLabel.textContent = LANG_LABEL[active];

    document.querySelectorAll(".lang-option").forEach((el) => {
      const btn = el;
      const lang = btn.dataset.lang;
      if (lang === active) {
        btn.setAttribute("aria-current", "true");
        btn.classList.add("bg-brand-blue-pale", "font-semibold");
      }
      btn.addEventListener("click", () => {
        if (lang && lang !== active) switchLanguage(lang);
      });
    });

    const trigger = document.getElementById("lang-trigger");
    const panel = document.getElementById("lang-panel");
    if (!trigger || !panel) return;

    const close = () => {
      panel.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      panel.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) close(); else open();
    });
    document.addEventListener("click", (e) => {
      if (!panel.contains(e.target) && e.target !== trigger) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  initLanguageSwitcher();

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function attachSignOutHandlers() {
    const buttons = [
      document.getElementById("sign-out-button"),
      document.getElementById("mobile-sign-out-button"),
    ].filter(Boolean);

    buttons.forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          await fetch("/api/auth/logout", {
            method: "POST",
            credentials: "same-origin",
            cache: "no-store",
          });
        } finally {
          window.location.assign("/");
        }
      });
    });
  }

  function attachUserMenuToggle() {
    const trigger = document.getElementById("user-menu-trigger");
    const panel = document.getElementById("user-menu-panel");
    if (!trigger || !panel) return;

    const close = () => {
      panel.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      panel.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) close(); else open();
    });

    // Click outside the panel closes it.
    document.addEventListener("click", (e) => {
      if (!panel.contains(e.target) && e.target !== trigger) close();
    });

    // ESC closes it. Pressing Tab past the last menu item also closes
    // (browser default, no extra wiring needed since we don't trap focus).
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  async function showBoardBadge() {
    try {
      const res = await fetch("/api/board/counts", { credentials: "same-origin", cache: "no-store" });
      if (!res.ok) return;
      const c = await res.json();
      const n = (c.messages || 0) + (c.mentions || 0);
      if (n < 1) return;
      const badge = (extra) =>
        `<span class="board-badge ml-1 inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-liturgical-red px-1 text-[0.7rem] font-semibold text-white ${extra || ""}" title="${n} new on the parish board">${n}</span>`;
      const trigger = document.querySelector("#user-menu-trigger > span");
      if (trigger) trigger.insertAdjacentHTML("afterend", badge());
      document.querySelectorAll('#user-menu-panel a[href="/board/"]').forEach((a) => a.insertAdjacentHTML("beforeend", badge()));
      document.querySelectorAll('#mobile-auth-nav a[href="/board/"]').forEach((a) => a.insertAdjacentHTML("beforeend", badge()));
    } catch (_e) {
      // No number is better than a broken menu.
    }
  }

  async function updateAuthNav() {
    const authNav = document.getElementById("auth-nav");
    const mobileAuthNav = document.getElementById("mobile-auth-nav");

    if (!authNav || !mobileAuthNav) return;

    try {
      const response = await fetch("/api/auth/me", {
        credentials: "same-origin",
        cache: "no-store",
      });
      const data = await response.json();

      if (response.ok && data.loggedIn) {
        const name = escapeHtml(data.name || "Member");
        const isAdmin = data.role === "admin";

        // The parish board is announced with the December newsletter on
        // 29 Nov 2026. Until then only admins see the link; after it,
        // everyone does, without anything needing to be redeployed.
        // Checked here at page load, so it turns itself on.
        const boardOpen = Date.now() >= Date.parse("2026-11-29T06:00:00Z");
        const boardItem = (boardOpen || isAdmin)
          ? `<a href="/board/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">Parish Board</a>`
          : "";
        const boardMobile = (boardOpen || isAdmin)
          ? `<a href="/board/" class="btn btn-secondary w-full mb-2">Parish Board</a>`
          : "";
        const adminDesktopItem = isAdmin
          ? `<div class="my-1 border-t border-border-soft"></div>
             <a href="/admin/" role="menuitem" class="block px-4 py-2 text-sm text-brand-tan-dark no-underline hover:bg-brand-blue-pale">Parish Admin</a>`
          : "";
        const adminMobile = isAdmin
          ? `<a href="/admin/" class="btn btn-secondary w-full mb-2">Parish Admin</a>`
          : "";

        // Desktop: name → click → dropdown panel with Account / Admin / Sign Out.
        authNav.innerHTML = `
          <div class="relative">
            <button
              id="user-menu-trigger"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="user-menu-panel"
              class="flex items-center gap-1 rounded border border-brand-blue-dark px-2.5 py-1 font-display text-sm text-brand-blue-dark hover:bg-brand-blue-pale transition-colors"
            >
              <span>${name}</span>
              <span aria-hidden="true" class="text-xs">▾</span>
            </button>
            <div
              id="user-menu-panel"
              role="menu"
              aria-labelledby="user-menu-trigger"
              class="hidden absolute right-0 top-full mt-2 min-w-44 border border-border-soft bg-cream-card shadow-md py-1 z-50"
            >
              <a href="/account/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">My Account</a>
              <a href="/account/#section-learning" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">My Learning</a>
              <a href="/learn/library/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">Parish Library</a>
              <a href="/table/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">An Orthodox Table</a>
              ${boardItem}
              <a href="/directory/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">Directory</a>
              <a href="/coffee-hour/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">Coffee Hour</a>
              <a href="/prayers/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">Prayer Requests</a>
              ${adminDesktopItem}
              <button
                id="sign-out-button"
                type="button"
                role="menuitem"
                class="block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-brand-blue-pale"
              >Sign Out</button>
            </div>
          </div>
        `;

        // Mobile: keep options as inline buttons/links, no dropdown.
        mobileAuthNav.innerHTML = `
          <a href="/account/" class="btn btn-secondary w-full mb-2">My Account</a>
          <a href="/account/#section-learning" class="btn btn-secondary w-full mb-2">My Learning</a>
          <a href="/learn/library/" class="btn btn-secondary w-full mb-2">Parish Library</a>
          <a href="/table/" class="btn btn-secondary w-full mb-2">An Orthodox Table</a>
          ${boardMobile}
          <a href="/directory/" class="btn btn-secondary w-full mb-2">Directory</a>
          <a href="/coffee-hour/" class="btn btn-secondary w-full mb-2">Coffee Hour</a>
          <a href="/prayers/" class="btn btn-secondary w-full mb-2">Prayer Requests</a>
          ${adminMobile}
          <button id="mobile-sign-out-button" type="button" class="btn btn-primary w-full">
            Sign Out
          </button>
        `;

        // A small number on the menu when something is waiting on the board
        // (new messages and mentions). There's no email, so this is how
        // someone finds out without opening the board.
        showBoardBadge();
        attachSignOutHandlers();
        attachUserMenuToggle();
        return;
      }
    } catch (error) {
      // Gracefully fall through to show sign-in when unauthenticated or on error.
    }

    authNav.innerHTML = `
      <a href="/login/" class="font-display text-sm text-brand-blue-dark hover:text-brand-blue px-2 py-1">Sign In</a>
    `;
    mobileAuthNav.innerHTML = `
      <a href="/login/" class="btn btn-secondary w-full">Sign In</a>
    `;
  }

  updateAuthNav();
</script>

<script is:inline>
  // Dark-mode toggle. Initial state is set by the bootstrap script in
  // Layout.astro <head>; this just flips the attribute on click and
  // persists the user's choice. Icon swaps moon ↔ sun.
  (function () {
    const btn = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    if (!btn || !icon) return;

    const label = document.getElementById('theme-label');
    function updateIcon() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      icon.textContent = isDark ? '☀️' : '🌙';
      if (label) label.textContent = isDark ? 'Switch to light mode' : 'Switch to dark mode';
    }

    updateIcon();

    btn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      }
      updateIcon();
    });
  })();

  // ---- Primary nav menus ----
  // Click to open, hover to open, Escape and an outside click to
  // close. Hover alone is not enough: it does nothing on a touch
  // screen and nothing for a keyboard, and the parent link is still
  // reachable as the first item inside.
  (() => {
    const menus = Array.from(document.querySelectorAll(".nav-menu"));
    if (!menus.length) return;

    function setOpen(menu, open) {
      const trigger = menu.querySelector(".nav-menu-trigger");
      const panel = menu.querySelector(".nav-menu-panel");
      if (!trigger || !panel) return;
      panel.classList.toggle("hidden", !open);
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
    }
    const closeAll = (except) => {
      for (const m of menus) if (m !== except) setOpen(m, false);
    };

    for (const menu of menus) {
      const trigger = menu.querySelector(".nav-menu-trigger");
      trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = trigger.getAttribute("aria-expanded") === "true";
        closeAll(menu);
        setOpen(menu, !open);
      });
      // Tabbing out of the last item closes it behind you.
      menu.addEventListener("focusout", (e) => {
        if (!menu.contains(e.relatedTarget)) setOpen(menu, false);
      });
    }

    document.addEventListener("click", () => closeAll(null));
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = menus.find((m) => m.querySelector(".nav-menu-trigger")?.getAttribute("aria-expanded") === "true");
      if (!open) return;
      setOpen(open, false);
      open.querySelector(".nav-menu-trigger")?.focus();
    });
  })();
</script>

<script is:inline>
  // ADA panel: text size (saved, applied on every page before it paints,
  // see Layout.astro) and read-aloud using the voice built into the
  // visitor's own browser, so it costs nothing.
  (function () {
    const trigger = document.getElementById('a11y-trigger');
    const panel = document.getElementById('a11y-panel');
    if (!trigger || !panel) return;

    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    trigger.addEventListener('click', (e) => {
      e.preventDefault();e.stopPropagation();
      setOpen(panel.classList.contains('hidden'));
    });
    panel.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
        setOpen(false);
        trigger.focus();
      }
    });

    // ---- text size ----
    const html = document.documentElement;
    const sizeButtons = Array.from(panel.querySelectorAll('.a11y-size'));
    function currentSize() {
      return html.classList.contains('text-xlarge') ? 'xlarge' : html.classList.contains('text-large') ? 'large' : 'normal';
    }
    function showSize() {
      const now = currentSize();
      sizeButtons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.size === now ? 'true' : 'false'));
      sizeButtons.forEach((b) => b.classList.toggle('bg-brand-blue-pale', b.dataset.size === now));
    }
    sizeButtons.forEach((b) =>
      b.addEventListener('click', () => {
        const size = b.dataset.size;
        html.classList.toggle('text-large', size === 'large');
        html.classList.toggle('text-xlarge', size === 'xlarge');
        try { localStorage.setItem('site-text-size', size); } catch (e) {}
        showSize();
      }),
    );
    showSize();

    // ---- read aloud ----
    const listenBox = document.getElementById('a11y-listen-box');
    const listenBtn = document.getElementById('a11y-listen');
    const stopBtn = document.getElementById('a11y-stop');
    const note = document.getElementById('a11y-note');
    const synth = window.speechSynthesis;
    if (!synth || typeof SpeechSynthesisUtterance === 'undefined') {
      if (listenBox) listenBox.innerHTML = '<p class="text-xs text-text-secondary">This browser can not read pages aloud. On an iPhone, swipe down with two fingers to hear the page. In Microsoft Edge, press Ctrl+Shift+U.</p>';
      return;
    }

    function pageText() {
      const main = document.querySelector('main');
      return main ? main.innerText.replace(/\s+/g, ' ').trim() : '';
    }
    // Long utterances get cut off by some browsers, so read in short pieces.
    function pieces(text) {
      const sentences = text.match(/[^.!?]+[.!?]*\s*/g) || [text];
      const out = [];
      let cur = '';
      for (const sentence of sentences) {
        if ((cur + sentence).length > 220 && cur) { out.push(cur); cur = ''; }
        cur += sentence;
      }
      if (cur) out.push(cur);
      return out;
    }
    function stop() {
      synth.cancel();
      if (note) note.textContent = '';
    }
    listenBtn.addEventListener('click', () => {
      stop();
      const text = pageText();
      if (!text) { note.textContent = 'There is nothing on this page to read yet.'; return; }
      const parts = pieces(text);
      parts.forEach((part, i) => {
        const u = new SpeechSynthesisUtterance(part);
        u.lang = html.lang || 'en-US';
        u.rate = 0.92;
        if (i === parts.length - 1) u.onend = () => { note.textContent = ''; };
        synth.speak(u);
      });
      note.textContent = 'Reading this page. Press Stop to end.';
    });
    stopBtn.addEventListener('click', stop);
    window.addEventListener('pagehide', () => synth.cancel());
  })();
</script>

<script is:inline>
  // Close a menu when the mouse moves off it. Touch and keyboard are
  // untouched: this only reacts to a real mouse pointer leaving.
  (function () {
    const timers = new WeakMap();
    function holder(el) {
      return el.closest('.nav-menu') ||
        (el.closest('#auth-nav') && el.closest('#auth-nav .relative')) ||
        (el.closest('#a11y-trigger, #a11y-panel') && document.getElementById('a11y-trigger').parentElement);
    }
    function closeIn(box) {
      box.querySelectorAll('[aria-expanded="true"]').forEach((t) => {
        const id = t.getAttribute('aria-controls');
        const panel = (id && document.getElementById(id)) || box.querySelector('.nav-menu-panel');
        if (!panel) return;
        panel.classList.add('hidden');
        t.setAttribute('aria-expanded', 'false');
      });
    }
    document.addEventListener('pointerout', (e) => {
      if (e.pointerType !== 'mouse') return;
      const box = holder(e.target);
      if (!box) return;
      if (e.relatedTarget && box.contains(e.relatedTarget)) return;
      clearTimeout(timers.get(box));
      timers.set(box, setTimeout(() => closeIn(box), 300));
    });
    document.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse') return;
      const box = holder(e.target);
      if (box) clearTimeout(timers.get(box));
    });
  })();
</script>
