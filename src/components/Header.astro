---
const navLinks = [
  { href: "/about/", label: "About" },
  { href: "/schedule/", label: "Schedule" },
  { href: "/learn/", label: "Learn" },
  { href: "/calendar/", label: "Calendar" },
  { href: "/communion/", label: "Communion" },
  { href: "/donate/", label: "Donate" },
  { href: "/contact/", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-gold/20 bg-parchment/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
    <a href="/" class="flex items-center gap-3 text-ink hover:text-burgundy transition-colors">
      <span aria-hidden="true" class="text-2xl text-gold">☩</span>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base md:text-lg">St. John of Kronstadt</span>
        <span class="text-xs uppercase tracking-widest text-gold-dim">Orthodox Mission · RGV</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-ink/80 hover:text-burgundy transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/schedule/"
        class="rounded-sm border border-gold bg-burgundy px-4 py-2 text-parchment hover:bg-ink transition-colors"
      >
        Plan Your Visit
      </a>
    </nav>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="md:hidden flex items-center justify-center rounded-sm border border-gold/40 px-3 py-2 text-ink hover:bg-gold/10"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-gold/20 bg-parchment md:hidden" aria-label="Mobile">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="border-b border-gold/10 py-3 text-ink hover:text-burgundy transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/schedule/"
        class="mt-3 rounded-sm border border-gold bg-burgundy px-4 py-3 text-center text-parchment hover:bg-ink transition-colors"
      >
        Plan Your Visit
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
