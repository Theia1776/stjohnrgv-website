---
const navLinks = [
  { href: "/about/", label: "About" },
  { href: "/calendar/", label: "Calendar" },
  { href: "/learn/saints/", label: "Saints" },
  { href: "/learn/library/", label: "Library" },
  { href: "/donate/", label: "Tithe / Donate" },
  { href: "/contact/", label: "Contact" },
  { href: "/learn/", label: "Learn" },
];

const currentPath = Astro.url.pathname;

/** True when this nav link should be marked as the current page. */
function isActive(href: string): boolean {
  // Exact match first; otherwise treat the link as a section root and
  // mark active when the current path starts with it (e.g. /about/foo).
  if (currentPath === href) return true;
  if (href === "/") return false;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-1 z-40 border-b border-border-soft bg-cream-card shadow-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
    <a
      href="/"
      class="flex items-center gap-3 text-text-primary no-underline hover:text-brand-blue-dark transition-colors"
    >
      <span aria-hidden="true" class="text-2xl text-sacred-gold">☩</span>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base md:text-lg">St. John of Kronstadt</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Orthodox Mission · RGV</span>
      </span>
    </a>

    <div class="flex items-center gap-3">
      <nav class="hidden md:flex items-center gap-6 text-sm" aria-label="Primary">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "no-underline transition-colors py-1 border-b-2 whitespace-nowrap",
                active
                  ? "text-text-primary border-liturgical-current"
                  : "text-text-primary/80 border-transparent hover:text-brand-blue-dark",
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Language switcher (desktop). Click EN/ES/RU; ES and RU send
           the visitor through Google's translate proxy
           (stjohnrgv-org.translate.goog). Google maintains the
           translated session on subsequent navigations until the user
           switches back. -->
      <div class="hidden md:block relative">
        <button
          id="lang-trigger"
          type="button"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="lang-panel"
          aria-label="Select language"
          class="flex items-center gap-1 px-2 py-1 text-xs font-display uppercase tracking-widest text-text-primary/80 hover:text-brand-blue-dark rounded transition-colors"
        >
          <span id="lang-current-label">EN</span>
          <span aria-hidden="true" class="text-[0.6rem]">▾</span>
        </button>
        <div
          id="lang-panel"
          role="menu"
          aria-labelledby="lang-trigger"
          class="hidden absolute right-0 top-full mt-2 min-w-36 border border-border-soft bg-cream-card shadow-md py-1 z-50"
        >
          <button data-lang="en" type="button" role="menuitem" class="lang-option block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-brand-blue-pale">English</button>
          <button data-lang="es" type="button" role="menuitem" class="lang-option block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-brand-blue-pale">Español</button>
          <button data-lang="ru" type="button" role="menuitem" class="lang-option block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-brand-blue-pale">Русский</button>
        </div>
      </div>

      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
        class="text-xl px-2 py-1 rounded hover:bg-brand-blue/20 transition-colors"
      >
        <span id="theme-icon">🌙</span>
      </button>

      <!-- Auth nav lives furthest right by design — rendered client-side
           by the script below once /api/auth/me resolves. -->
      <div id="auth-nav" class="hidden md:flex items-center text-sm"></div>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden flex items-center justify-center rounded-sm border border-border-soft px-3 py-2 text-text-primary hover:bg-brand-blue-pale"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-border-soft bg-cream-bg md:hidden" aria-label="Mobile">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-4">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "border-b border-border-soft py-3 no-underline transition-colors",
              active
                ? "text-text-primary border-l-2 border-l-liturgical-current pl-3"
                : "text-text-primary hover:text-brand-blue-dark",
            ]}
          >
            {link.label}
          </a>
        );
      })}
      <div id="mobile-auth-nav" class="mt-3"></div>

      <!-- Language switcher (mobile). Same data-lang values as the
           desktop dropdown so the JS treats them uniformly. -->
      <div class="mt-4 flex items-center gap-2 border-t border-border-soft pt-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-text-secondary">Language:</span>
        <button data-lang="en" type="button" class="lang-option px-3 py-1 text-xs font-display uppercase tracking-widest border border-border-soft rounded text-text-primary hover:bg-brand-blue-pale">EN</button>
        <button data-lang="es" type="button" class="lang-option px-3 py-1 text-xs font-display uppercase tracking-widest border border-border-soft rounded text-text-primary hover:bg-brand-blue-pale">ES</button>
        <button data-lang="ru" type="button" class="lang-option px-3 py-1 text-xs font-display uppercase tracking-widest border border-border-soft rounded text-text-primary hover:bg-brand-blue-pale">RU</button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  // ===== Language switcher =====
  // ES / RU send the visitor through Google's translate proxy at
  // <site-with-dashes>.translate.goog with _x_tr_tl=<lang>. Once
  // there, every internal link stays inside the proxy until the user
  // picks EN again. EN strips the _x_tr_* params and bounces back to
  // the canonical host.
  const TRANSLATE_PROXY_HOST = "stjohnrgv-org.translate.goog";
  const ORIGINAL_HOST = "stjohnrgv.org";
  const LANG_LABEL = { en: "EN", es: "ES", ru: "RU" };

  function detectActiveLang() {
    if (window.location.hostname.endsWith(".translate.goog")) {
      const tl = new URLSearchParams(window.location.search).get("_x_tr_tl");
      if (tl === "es" || tl === "ru") return tl;
    }
    return "en";
  }

  function stripTranslateParams(search) {
    if (!search) return "";
    const params = new URLSearchParams(search);
    Array.from(params.keys()).forEach((k) => {
      if (k.startsWith("_x_tr_")) params.delete(k);
    });
    const out = params.toString();
    return out ? "?" + out : "";
  }

  function switchLanguage(target) {
    const path = window.location.pathname;
    const cleaned = stripTranslateParams(window.location.search);
    const hash = window.location.hash;
    if (target === "en") {
      window.location.href = "https://" + ORIGINAL_HOST + path + cleaned + hash;
      return;
    }
    const sep = cleaned ? cleaned + "&" : "?";
    window.location.href =
      "https://" + TRANSLATE_PROXY_HOST + path + sep
      + "_x_tr_sl=en&_x_tr_tl=" + target + "&_x_tr_hl=en" + hash;
  }

  function initLanguageSwitcher() {
    const active = detectActiveLang();

    const currentLabel = document.getElementById("lang-current-label");
    if (currentLabel) currentLabel.textContent = LANG_LABEL[active];

    document.querySelectorAll(".lang-option").forEach((el) => {
      const btn = el;
      const lang = btn.dataset.lang;
      if (lang === active) {
        btn.setAttribute("aria-current", "true");
        btn.classList.add("bg-brand-blue-pale", "font-semibold");
      }
      btn.addEventListener("click", () => {
        if (lang && lang !== active) switchLanguage(lang);
      });
    });

    const trigger = document.getElementById("lang-trigger");
    const panel = document.getElementById("lang-panel");
    if (!trigger || !panel) return;

    const close = () => {
      panel.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      panel.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) close(); else open();
    });
    document.addEventListener("click", (e) => {
      if (!panel.contains(e.target) && e.target !== trigger) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  initLanguageSwitcher();

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function attachSignOutHandlers() {
    const buttons = [
      document.getElementById("sign-out-button"),
      document.getElementById("mobile-sign-out-button"),
    ].filter(Boolean);

    buttons.forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          await fetch("/api/auth/logout", {
            method: "POST",
            credentials: "same-origin",
            cache: "no-store",
          });
        } finally {
          window.location.assign("/");
        }
      });
    });
  }

  function attachUserMenuToggle() {
    const trigger = document.getElementById("user-menu-trigger");
    const panel = document.getElementById("user-menu-panel");
    if (!trigger || !panel) return;

    const close = () => {
      panel.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      panel.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) close(); else open();
    });

    // Click outside the panel closes it.
    document.addEventListener("click", (e) => {
      if (!panel.contains(e.target) && e.target !== trigger) close();
    });

    // ESC closes it. Pressing Tab past the last menu item also closes
    // (browser default, no extra wiring needed since we don't trap focus).
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  async function updateAuthNav() {
    const authNav = document.getElementById("auth-nav");
    const mobileAuthNav = document.getElementById("mobile-auth-nav");

    if (!authNav || !mobileAuthNav) return;

    try {
      const response = await fetch("/api/auth/me", {
        credentials: "same-origin",
        cache: "no-store",
      });
      const data = await response.json();

      if (response.ok && data.loggedIn) {
        const name = escapeHtml(data.name || "Member");
        const isAdmin = data.role === "admin";
        const adminDesktopItem = isAdmin
          ? `<div class="my-1 border-t border-border-soft"></div>
             <div class="px-4 pt-2 pb-1 text-xs font-semibold uppercase tracking-widest text-text-secondary">Admin</div>
             <a href="/admin/contacts/" role="menuitem" class="block px-4 py-2 text-sm text-brand-tan-dark no-underline hover:bg-brand-blue-pale">Contacts &amp; Approvals</a>
             <a href="/admin/library/" role="menuitem" class="block px-4 py-2 text-sm text-brand-tan-dark no-underline hover:bg-brand-blue-pale">Library</a>
             <a href="/admin/saints/" role="menuitem" class="block px-4 py-2 text-sm text-brand-tan-dark no-underline hover:bg-brand-blue-pale">Saints</a>`
          : "";
        const adminMobile = isAdmin
          ? `<div class="mt-3 mb-1 text-xs font-semibold uppercase tracking-widest text-text-secondary">Admin</div>
             <a href="/admin/contacts/" class="btn btn-secondary w-full mb-2">Contacts &amp; Approvals</a>
             <a href="/admin/library/" class="btn btn-secondary w-full mb-2">Library</a>
             <a href="/admin/saints/" class="btn btn-secondary w-full mb-2">Saints</a>`
          : "";

        // Desktop: name → click → dropdown panel with Account / Admin / Sign Out.
        authNav.innerHTML = `
          <div class="relative">
            <button
              id="user-menu-trigger"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="user-menu-panel"
              class="flex items-center gap-1 font-display text-sm text-brand-blue-dark hover:text-brand-blue px-2 py-1 rounded transition-colors"
            >
              <span>${name}</span>
              <span aria-hidden="true" class="text-xs">▾</span>
            </button>
            <div
              id="user-menu-panel"
              role="menu"
              aria-labelledby="user-menu-trigger"
              class="hidden absolute right-0 top-full mt-2 min-w-44 border border-border-soft bg-cream-card shadow-md py-1 z-50"
            >
              <a href="/account/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">My Account</a>
              <a href="/directory/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">Directory</a>
              <a href="/coffee-hour/" role="menuitem" class="block px-4 py-2 text-sm text-text-primary no-underline hover:bg-brand-blue-pale">Coffee Hour</a>
              ${adminDesktopItem}
              <button
                id="sign-out-button"
                type="button"
                role="menuitem"
                class="block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-brand-blue-pale"
              >Sign Out</button>
            </div>
          </div>
        `;

        // Mobile: keep options as inline buttons/links, no dropdown.
        mobileAuthNav.innerHTML = `
          <a href="/account/" class="btn btn-secondary w-full mb-2">My Account</a>
          <a href="/directory/" class="btn btn-secondary w-full mb-2">Directory</a>
          <a href="/coffee-hour/" class="btn btn-secondary w-full mb-2">Coffee Hour</a>
          ${adminMobile}
          <button id="mobile-sign-out-button" type="button" class="btn btn-primary w-full">
            Sign Out
          </button>
        `;
        attachSignOutHandlers();
        attachUserMenuToggle();
        return;
      }
    } catch (error) {
      // Gracefully fall through to show sign-in when unauthenticated or on error.
    }

    authNav.innerHTML = `
      <a href="/login/" class="font-display text-sm text-brand-blue-dark hover:text-brand-blue px-2 py-1">Sign In</a>
    `;
    mobileAuthNav.innerHTML = `
      <a href="/login/" class="btn btn-secondary w-full">Sign In</a>
    `;
  }

  updateAuthNav();
</script>

<script is:inline>
  // Dark-mode toggle. Initial state is set by the bootstrap script in
  // Layout.astro <head>; this just flips the attribute on click and
  // persists the user's choice. Icon swaps moon ↔ sun.
  (function () {
    const btn = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    if (!btn || !icon) return;

    function updateIcon() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      icon.textContent = isDark ? '☀️' : '🌙';
    }

    updateIcon();

    btn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      }
      updateIcon();
    });
  })();
</script>
