---
// One book of An Orthodox Table. Both /table/fasting/ and
// /table/everyday/ render this with a different `book`, so the two
// shelves can't drift apart in look or behaviour.
//
// Recipes load at runtime from /api/recipes, so a newly posted one
// appears without a rebuild — the same table-driven pattern as the
// library and the lessons.
interface Props {
  book: "fasting" | "everyday";
  heading: string;
  blurb: string;
}
const { book, heading, blurb } = Astro.props;
const fasting = book === "fasting";
---

<main class="mx-auto max-w-5xl px-4 py-12 md:px-6">
  <p class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
    <a href="/table/" class="text-brand-tan-dark no-underline hover:underline">← An Orthodox Table</a>
  </p>
  <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">{heading}</h1>
  <div class="mt-5 h-px w-24 bg-liturgical-current"></div>
  <p class="mt-5 max-w-2xl text-text-primary/85 leading-relaxed">{blurb}</p>

  <!-- Searching and filtering happen here in the browser: a parish
       collection is small enough that every recipe is already loaded,
       and a dish you half-remember is found by typing, not by paging. -->
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <label for="recipe-search" class="sr-only">Search these recipes</label>
    <input
      id="recipe-search"
      type="search"
      placeholder="Search by name or ingredient…"
      class="min-w-0 flex-1 border border-border-soft bg-cream-card px-3 py-2 text-sm focus:outline-none focus:ring-2"
    />
    <label for="recipe-category" class="sr-only">Filter by kind of dish</label>
    <select
      id="recipe-category"
      class="border border-border-soft bg-cream-card px-3 py-2 text-sm focus:outline-none focus:ring-2"
    >
      <option value="">All kinds</option>
    </select>
    <span id="recipe-count" class="text-sm text-text-secondary" role="status"></span>
  </div>

  <p id="recipe-loading" class="mt-8 text-sm italic text-text-secondary">Loading recipes…</p>
  <p id="recipe-error" hidden role="alert" class="mt-8 text-sm text-liturgical-red"></p>
  <p id="recipe-empty" hidden class="mt-8 text-sm italic text-text-secondary">
    Nothing here yet. If you have one to share,
    <a href="/table/share/" class="text-brand-blue-dark">send it in</a>.
  </p>

  <div id="recipe-list" class="mt-8 space-y-10" data-fasting={String(fasting)}></div>

  <p class="mt-12 border-t border-border-soft pt-6 text-sm text-text-secondary">
    Have one to add? <a href="/table/share/" class="font-semibold text-brand-blue-dark">Share a recipe →</a>
  </p>
</main>

<script>
  import { RECIPE_CATEGORIES, categoryOf, groupOf } from "../lib/recipe-categories";

  type Recipe = {
    slug: string;
    title: string;
    category: string | null;
    hands_on: string | null;
    total_time: string | null;
    serves: string | null;
    intro: string | null;
    ingredients: string[];
    submitted_by_name: string | null;
  };

  let recipes: Recipe[] = [];

  const listEl = document.getElementById("recipe-list") as HTMLDivElement;
  const categoryEl = document.getElementById("recipe-category") as HTMLSelectElement;
  const loadingEl = document.getElementById("recipe-loading") as HTMLParagraphElement;
  const errorEl = document.getElementById("recipe-error") as HTMLParagraphElement;
  const emptyEl = document.getElementById("recipe-empty") as HTMLParagraphElement;
  const countEl = document.getElementById("recipe-count") as HTMLSpanElement;
  const searchEl = document.getElementById("recipe-search") as HTMLInputElement;

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  /** Accents folded and punctuation dropped, as elsewhere on the site. */
  function normalise(value: unknown): string {
    return String(value ?? "")
      .normalize("NFKD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function card(r: Recipe): string {
    // The times a cook actually wants before opening anything.
    const meta = [r.total_time ? `${r.total_time}` : "", r.serves ? `Serves ${r.serves}` : ""]
      .filter(Boolean)
      .join(" · ");
    return `<li class="border border-border-soft bg-cream-card p-5 shadow-sm">
      ${r.category ? `<p class="mb-1 text-[0.65rem] uppercase tracking-widest text-brand-tan-dark">${escapeHtml(categoryOf(r.category))}</p>` : ""}
      <h3 class="font-display text-xl">
        <a href="/table/recipe/?slug=${encodeURIComponent(r.slug)}"
           class="text-brand-blue-dark no-underline hover:underline">${escapeHtml(r.title)}</a>
      </h3>
      ${meta ? `<p class="mt-1 text-xs uppercase tracking-widest text-text-secondary">${escapeHtml(meta)}</p>` : ""}
      ${r.intro ? `<p class="mt-2 text-sm text-text-primary/85">${escapeHtml(r.intro.slice(0, 160))}${r.intro.length > 160 ? "…" : ""}</p>` : ""}
      ${r.submitted_by_name ? `<p class="mt-3 text-xs italic text-text-secondary">from ${escapeHtml(r.submitted_by_name)}</p>` : ""}
    </li>`;
  }

  function render() {
    const terms = normalise(searchEl.value).split(/\s+/).filter(Boolean);
    // Ingredients are searched too, because the question is usually
    // "what can I do with these lentils", not "what was it called".
    const wanted = categoryEl.value;
    const inCategory = wanted ? recipes.filter((r) => r.category === wanted) : recipes;
    const shown = terms.length
      ? inCategory.filter((r) => {
          const hay = normalise([r.title, r.intro, (r.ingredients ?? []).join(" ")].join(" "));
          return terms.every((t) => hay.includes(t));
        })
      : inCategory;

    // Grouped under headings, in the order the groups are defined, with
    // anything unfiled last. A flat grid of eighty recipes is a wall;
    // the groups are how a cook narrows it without typing.
    const order = [...RECIPE_CATEGORIES.map((g) => g.group), ""];
    const byGroup = new Map<string, Recipe[]>();
    for (const r of shown) {
      const key = groupOf(r.category);
      if (!byGroup.has(key)) byGroup.set(key, []);
      byGroup.get(key)!.push(r);
    }

    listEl.innerHTML = order
      .filter((g) => byGroup.has(g))
      .map((g) => {
        const rows = byGroup.get(g)!;
        const label = g || "Not yet filed";
        return `<section>
          <h2 class="font-display text-xs uppercase tracking-widest text-text-secondary">${escapeHtml(label)}</h2>
          <div class="mt-1 h-px w-12 bg-liturgical-current"></div>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">${rows.map(card).join("")}</ul>
        </section>`;
      })
      .join("");

    countEl.textContent = shown.length
      ? `${shown.length} ${shown.length === 1 ? "recipe" : "recipes"}`
      : "";
    emptyEl.hidden = shown.length > 0 || recipes.length === 0;
    if (recipes.length > 0 && shown.length === 0) {
      emptyEl.hidden = false;
      emptyEl.textContent = `Nothing matches "${searchEl.value.trim()}".`;
    }
  }

  searchEl.addEventListener("input", render);
  categoryEl.addEventListener("change", render);

  /**
   * Only the categories this book actually has. Offering "Lamb" in the
   * fasting book, or any empty shelf, invites a filter that returns
   * nothing and looks broken.
   */
  function fillCategoryFilter() {
    const present = new Set(recipes.map((r) => r.category).filter(Boolean) as string[]);
    for (const group of RECIPE_CATEGORIES) {
      const values = group.categories
        .map((c) => `${group.group} — ${c}`)
        .filter((v) => present.has(v));
      if (values.length === 0) continue;
      const optgroup = document.createElement("optgroup");
      optgroup.label = group.group;
      for (const value of values) {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = categoryOf(value);
        optgroup.appendChild(option);
      }
      categoryEl.appendChild(optgroup);
    }
    categoryEl.hidden = categoryEl.options.length <= 1;
  }

  (async () => {
    try {
      const res = await fetch(`/api/recipes?fasting=${listEl.dataset.fasting === "true" ? "true" : "false"}`, {
        credentials: "same-origin",
      });
      loadingEl.hidden = true;
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        errorEl.textContent = `Could not load the recipes: ${body.error ?? res.status}`;
        errorEl.hidden = false;
        return;
      }
      const data = await res.json();
      recipes = (data.recipes ?? []) as Recipe[];
      if (recipes.length === 0) {
        emptyEl.hidden = false;
        return;
      }
      fillCategoryFilter();
      render();
    } catch (err) {
      loadingEl.hidden = true;
      errorEl.textContent = `Could not load the recipes: ${err instanceof Error ? err.message : String(err)}`;
      errorEl.hidden = false;
    }
  })();
</script>
