---
/**
 * Saint of the Day diptych — self-contained interactive component.
 *
 * Closed state: tall burgundy book cover with a gold three-bar
 * Orthodox cross, "SAINT OF THE DAY" lettering, and a bouncing gold
 * latch on the right edge. Click anywhere on the cover to open.
 *
 * Open state: two cream panels side-by-side connected by a gold
 * hinge. Left panel shows the saint's icon (if iconSlug is set) or a
 * fallback gold cross + "ICON PENDING" label. Right panel shows
 * eyebrow, saint name, feast date, gold rule, optional life preview
 * (first two sentences, italic Crimson Pro), and an "All Saints →"
 * link. A small "✕ close" returns to the closed state.
 *
 * Logic mirrors the previous Saint of the Day card:
 *   - julian = today − 13 days
 *   - find first saint whose feasts[] contains "Month Day"
 *   - hide the entire component if no match
 *   - skip the bio if life starts with the "Little is known…" stub
 */

// The saints themselves are no longer inlined here — the client
// fetches /saints-data.json once and shares it with anything else on
// the page that wants it. Only the icon map below is still printed,
// being a few kilobytes of build-time asset URLs nothing else has.

// Build a slug → URL map at build time. import.meta.glob with eager:true
// resolves to the same processed asset URLs Astro's <Image> component
// uses, so the client gets a hashed /_astro/<slug>.<hash>.<ext> path
// it can drop into a plain <img src=…> at runtime. Files live in
// src/assets/images/<iconSlug>.<jpg|png|webp>; if a saint's iconSlug
// matches a filename here, the icon panel renders the image; otherwise
// it falls back to the gold-cross "ICON PENDING" placeholder.
const iconModules = import.meta.glob<{ default: { src: string } }>(
  "../assets/images/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const saintIconUrls: Record<string, string> = {};
for (const [path, mod] of Object.entries(iconModules)) {
  const filename = path.split("/").pop() ?? "";
  const slug = filename.replace(/\.[^.]+$/, "");
  saintIconUrls[slug] = mod.default.src;
}

// Escape `<` so a filename containing "</script>" cannot break out of
// the JSON tag.
const saintIconUrlsJson = JSON.stringify(saintIconUrls).replace(/</g, "\\u003c");
---

<div
  id="saint-diptych"
  data-state="closed"
  hidden
  class="diptych-host mx-auto"
>
  <!-- ============== CLOSED STATE: BOOK COVER ============== -->
  <button
    type="button"
    data-action="open"
    aria-label="Open Saint of the Day"
    class="diptych-closed group relative mx-auto block h-96 w-72 overflow-hidden focus:outline-none"
    style="background-color: #6B1F1F;"
  >
    <!-- Spine shadow on left edge -->
    <span
      aria-hidden="true"
      class="absolute inset-y-0 left-0 w-12"
      style="background: linear-gradient(to right, #3A0F0F, transparent);"
    ></span>

    <!-- Double inset gold border -->
    <span aria-hidden="true" class="pointer-events-none absolute inset-3 border border-sacred-gold/80"></span>
    <span aria-hidden="true" class="pointer-events-none absolute inset-5 border border-sacred-gold/80"></span>

    <!-- Cross + label, vertically centered with breathing room -->
    <span class="relative flex h-full w-full flex-col items-center justify-center px-6">
      <svg
        viewBox="0 0 100 200"
        class="h-32 w-auto text-sacred-gold"
        fill="none"
        stroke="currentColor"
        stroke-width="6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="50" y1="20" x2="50" y2="185" />
        <line x1="38" y1="42" x2="62" y2="42" />
        <line x1="25" y1="80" x2="75" y2="80" />
        <line x1="30" y1="135" x2="70" y2="150" />
      </svg>
      <span class="mt-12 font-display text-xs uppercase tracking-[0.3em] text-sacred-gold">
        Saint of the Day
      </span>
    </span>

    <!-- Bouncing gold latch on right edge — horizontal bar reading
         as a book clasp rather than a vertical nub. -->
    <span aria-hidden="true" class="diptych-latch absolute right-0 top-1/2 h-3 w-8 bg-sacred-gold"></span>
  </button>

  <!-- ============== OPEN STATE: DIPTYCH ============== -->
  <div class="diptych-open relative mx-auto w-full max-w-3xl">
    <div
      class="grid grid-cols-1 overflow-hidden border-2 border-sacred-gold shadow-lg md:grid-cols-[1fr_8px_1fr]"
      style="background-color: #FAF7F0;"
    >

      <!-- LEFT PANEL: icon area with gold frame -->
      <div class="relative flex items-center justify-center p-4">
        <div class="relative flex h-64 w-full max-w-[16rem] items-center justify-center border-2 border-sacred-gold p-3 md:h-full md:max-w-none">
          <div data-icon-area class="flex h-full w-full items-center justify-center"></div>
        </div>
      </div>

      <!-- HINGE — visible on md+ only -->
      <div class="hidden bg-sacred-gold md:block" aria-hidden="true"></div>

      <!-- RIGHT PANEL: text content -->
      <div class="relative flex flex-col p-6 md:p-8">
        <!-- Corner flourishes -->
        <span aria-hidden="true" class="absolute top-3 left-3 h-3 w-3 border-l border-t border-sacred-gold"></span>
        <span aria-hidden="true" class="absolute top-3 right-3 h-3 w-3 border-r border-t border-sacred-gold"></span>
        <span aria-hidden="true" class="absolute bottom-3 left-3 h-3 w-3 border-l border-b border-sacred-gold"></span>
        <span aria-hidden="true" class="absolute bottom-3 right-3 h-3 w-3 border-r border-b border-sacred-gold"></span>

        <p class="font-display text-xs uppercase tracking-widest text-sacred-gold">Saint of the Day</p>
        <h3 data-saint-name class="mt-2 font-display text-xl text-text-primary md:text-2xl"></h3>
        <p data-saint-feast class="mt-1 text-sm text-sacred-gold"></p>
        <hr class="mt-4 h-px w-12 border-0 bg-sacred-gold" />
        <p
          data-saint-bio
          hidden
          class="mt-4 italic leading-relaxed text-text-primary/85"
        ></p>
        <div class="mt-auto flex items-center justify-between gap-4 pt-4">
          <a
            href="/learn/saints/"
            class="font-display text-sm text-brand-blue-dark no-underline hover:underline"
          >All Saints &rarr;</a>
          <button
            type="button"
            data-action="close"
            aria-label="Close Saint of the Day"
            class="font-display text-xs uppercase tracking-widest text-text-secondary hover:text-text-primary"
          >&times; close</button>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- iconSlug → URL map for the diptych client script -->
<script type="application/json" id="diptych-icon-urls" is:inline set:html={saintIconUrlsJson}></script>

<script is:inline>
(function () {
  /**
   * One fetch of /saints-data.json for the whole page, memoised on
   * window so this component and the calendar's modal share it rather
   * than each pulling 2,389 saints down separately. Whichever asks
   * first creates the promise; the other awaits the same one.
   */
  function loadSaints() {
    if (!window.__saintsData) {
      window.__saintsData = fetch('/saints-data.json')
        .then((r) => (r.ok ? r.json() : []))
        .catch(() => []);
    }
    return window.__saintsData;
  }

  /**
   * Old Style -> the day it falls on. The catalogue stores Julian
   * dates; this parish keeps the old calendar, so the civil date is
   * thirteen days later. Mirrors src/lib/julian.ts — change both.
   * Movable feasts have no number and pass through untouched.
   */
  const NS_MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  function newStyleLabel(feast) {
    const m = /^([A-Za-z]+)\s+(\d{1,2})$/.exec(String(feast ?? '').trim());
    if (!m) return String(feast ?? '').trim();
    const mi = NS_MONTHS.findIndex((n) => n.toLowerCase() === m[1].toLowerCase());
    const d = Number(m[2]);
    if (mi === -1 || d < 1 || d > 31) return String(feast).trim();
    const dt = new Date(Date.UTC(2024, mi, d));
    if (dt.getUTCMonth() !== mi) return String(feast).trim();
    dt.setUTCDate(dt.getUTCDate() + 13);
    return NS_MONTHS[dt.getUTCMonth()] + ' ' + dt.getUTCDate();
  }
  function bothStyles(feast) {
    const ns = newStyleLabel(feast);
    const t = String(feast ?? '').trim();
    return ns === t ? t : t + ' / ' + ns;
  }
  function newStyleList(feasts, sep) {
    return Array.isArray(feasts) ? feasts.map(bothStyles).join(sep || ' · ') : '';
  }

  async function initDiptych() {
    const iconUrlsEl = document.getElementById('diptych-icon-urls');
    const host = document.getElementById('saint-diptych');
    if (!host) return;

    const saints = await loadSaints();
    if (!saints.length) return;
    const ICON_URLS = iconUrlsEl ? JSON.parse(iconUrlsEl.textContent) : {};
    const MONTHS = [
      'January','February','March','April','May','June',
      'July','August','September','October','November','December',
    ];

    function feastKeyForGregorian(gregorian) {
      // Liturgical (Julian) date = Gregorian − 13 days for the
      // 1900–2099 window.
      const julian = new Date(gregorian.getTime() - 13 * 24 * 60 * 60 * 1000);
      return MONTHS[julian.getMonth()] + ' ' + julian.getDate();
    }

    function renderFallbackIcon() {
      return (
        '<div class="flex h-full w-full flex-col items-center justify-center text-center">' +
          '<svg viewBox="0 0 100 200" class="h-3/4 max-h-44 w-auto text-sacred-gold" ' +
            'fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" aria-hidden="true">' +
            '<line x1="50" y1="20" x2="50" y2="185" />' +
            '<line x1="38" y1="42" x2="62" y2="42" />' +
            '<line x1="25" y1="80" x2="75" y2="80" />' +
            '<line x1="30" y1="135" x2="70" y2="150" />' +
          '</svg>' +
          '<p class="mt-3 font-display text-[10px] uppercase tracking-widest text-text-secondary">Icon Pending</p>' +
        '</div>'
      );
    }

    function loadForDate(gregorian) {
      const feastKey = feastKeyForGregorian(gregorian);

      const saint = saints.find(
        (s) => Array.isArray(s.feasts) && s.feasts.includes(feastKey),
      );

      // No match — hide the diptych entirely. Re-collapse to closed
      // state so the next match doesn't open mid-flip.
      if (!saint) {
        host.dataset.state = 'closed';
        host.hidden = true;
        return;
      }

      // Right-panel text fields
      host.querySelector('[data-saint-name]').textContent = saint.name || '';
      host.querySelector('[data-saint-feast]').textContent = 'Commemorated on ' + bothStyles(feastKey);

      // Bio: skip the stub placeholder used for entries we haven't
      // written yet.
      const bioEl = host.querySelector('[data-saint-bio]');
      const isStub =
        typeof saint.life === 'string' &&
        saint.life.startsWith('Little is known about this saint beyond their commemoration');
      if (saint.life && !isStub) {
        const sentences = saint.life.match(/[^.!?]+[.!?]+/g) || [];
        const preview = sentences.slice(0, 2).join(' ').trim();
        if (preview) {
          bioEl.textContent = preview;
          bioEl.hidden = false;
        } else {
          bioEl.textContent = '';
          bioEl.hidden = true;
        }
      } else {
        bioEl.textContent = '';
        bioEl.hidden = true;
      }

      // Left-panel icon: if the saint's iconSlug matches a file in
      // src/assets/images/ (mapped to its processed URL at build time),
      // render the image; otherwise fall through to the gold-cross
      // "ICON PENDING" placeholder.
      const iconArea = host.querySelector('[data-icon-area]');
      const iconUrl = saint.iconSlug ? ICON_URLS[saint.iconSlug] : null;
      if (iconUrl) {
        const safeAlt = (saint.name || '')
          .replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        iconArea.innerHTML =
          '<img src="' + iconUrl + '" alt="Icon of ' + safeAlt + '" class="h-full w-full object-contain" />';
      } else {
        iconArea.innerHTML = renderFallbackIcon();
      }

      host.hidden = false;
    }

    // Initial render — today's date.
    loadForDate(new Date());

    // The calendar page dispatches `calendar-date-change` whenever the
    // user navigates Prev/Next/Today. We re-run the match against the
    // event's date so the diptych stays in sync with what's below.
    window.addEventListener('calendar-date-change', (e) => {
      const detail = e && e.detail ? e.detail : null;
      const date = detail && detail.date instanceof Date ? detail.date : new Date();
      loadForDate(date);
    });

    // Open / close. Single delegated listener catches the closed-cover
    // button (data-action="open") and the close button in the right
    // panel (data-action="close").
    host.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-action]');
      if (!trigger) return;
      const action = trigger.dataset.action;
      if (action === 'open') {
        host.dataset.state = 'open';
      } else if (action === 'close') {
        host.dataset.state = 'closed';
      }
    });

    // Esc closes when open.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && host.dataset.state === 'open') {
        host.dataset.state = 'closed';
      }
    });
  }

  // Run once the document is parsed, not at this point in it.
  //
  // This script used to sit directly beneath its own data block, so the
  // data was always there by the time it ran. Now that it can read a
  // block the *page* printed, it can no longer assume that: on
  // /calendar/ the shared block comes several hundred lines lower, so
  // the lookup found nothing, the function returned early, and the
  // Saint of the Day silently never appeared. Waiting for
  // DOMContentLoaded makes the order stop mattering either way.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiptych);
  } else {
    initDiptych();
  }
})();
</script>

<style>
  /* State swap: closed/open hide each other */
  #saint-diptych[data-state="closed"] .diptych-open { display: none; }
  #saint-diptych[data-state="open"]   .diptych-closed { display: none; }

  /* Latch bounce. Combine vertical centering with horizontal nudge
     directly in the keyframe transform so it overrides Tailwind
     utility classes cleanly. */
  @keyframes diptych-latch-bounce {
    0%, 100% { transform: translate(0,   -50%); }
    50%      { transform: translate(6px, -50%); }
  }
  .diptych-latch {
    animation: diptych-latch-bounce 1.8s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .diptych-latch { animation: none; transform: translateY(-50%); }
  }
</style>
