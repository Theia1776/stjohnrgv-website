---
const year = new Date().getFullYear();

// Single grouped link grid — every page on the site lives in exactly one
// of these columns, sorted by why a visitor would click it. Keeps the
// "split by relevance" feel of the old Visit/Learn/Support row while
// also covering the routes that used to be in the separate Site Map +
// Site Information rows.
const footerColumns = [
  {
    heading: "Visit",
    links: [
      { href: "/about/#schedule", label: "Service Schedule" },
      { href: "/calendar/", label: "Calendar" },
      { href: "/contact/", label: "Contact" },
    ],
  },
  {
    heading: "Learn",
    links: [
      { href: "/about/", label: "About the Mission" },
      { href: "/learn/", label: "What is Orthodoxy?" },
      { href: "/learn/library/", label: "Parish Library" },
      { href: "/about/#communion", label: "Canonical Standing" },
    ],
  },
  {
    heading: "Support",
    links: [
      { href: "/donate/", label: "Tithe / Donate" },
      { href: "/contact/", label: "Prayer Requests" },
    ],
  },
  {
    heading: "Account",
    links: [
      { href: "/account/", label: "My Account" },
      { href: "/login/", label: "Sign In" },
    ],
  },
  {
    heading: "Site Information",
    links: [
      { href: "/iconography/", label: "Iconography" },
      { href: "/colophon/", label: "Colophon" },
      { href: "/privacy/", label: "Privacy" },
    ],
  },
];
---

<footer class="mt-16 border-t-2 border-liturgical-current bg-cream-card text-text-primary">
  <div class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <!-- Identity row — parish name, mission tagline, address, phone.
         Sits above the link grid so the grid gets full width and
         doesn't have to share a column with the address block. -->
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-3xl text-sacred-gold">☩</span>
        <span class="font-display text-lg leading-tight">St. John of Kronstadt</span>
      </div>
      <p class="text-sm text-text-secondary">A True Orthodox mission serving the Rio Grande Valley.</p>
      <address class="not-italic text-sm leading-relaxed text-text-primary sm:ml-auto sm:text-right">
        39737 Palm Drive, Bayview, TX 78566 · <a href="tel:+19564490225">(956) 449-0225</a>
      </address>
    </div>

    <!-- Single grouped link grid — relevance-sorted columns. -->
    <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 md:grid-cols-5">
      {footerColumns.map((col) => (
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-brand-tan-dark">{col.heading}</h3>
          <ul class="mt-3 space-y-2 text-sm">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-text-secondary no-underline hover:text-brand-blue-dark hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Legal / credits row -->
    <div class="mt-10 grid gap-3 border-t border-border-soft pt-6 text-center text-xs text-text-secondary md:grid-cols-3 md:items-center md:gap-4">
      <p class="md:text-left">© {year} St. John of Kronstadt Orthodox Mission. All rights reserved.</p>
      <div class="md:text-center">
        <p>
          Site by <a
            href="https://www.linkedin.com/in/goodnertheia/"
            target="_blank"
            rel="noopener noreferrer"
          >Philothei “Theia” Goodner</a>
        </p>
        <p class="mt-1">
          <a
            href="https://www.sociallyawkward.me"
            target="_blank"
            rel="noopener noreferrer"
          >Socially Awkward Media</a>
        </p>
      </div>
      <p class="font-display tracking-wider text-brand-tan-dark md:text-right">Anchored in Ancient Faith</p>
    </div>
  </div>
</footer>
