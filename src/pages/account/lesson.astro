---
import Layout from "../../layouts/Layout.astro";

// Reader for a single catechism lesson, opened from the My Learning
// section of /account/. Takes the lesson's slug from a `?slug=` query
// param and populates the header + PDF viewer at runtime, so every
// lesson in catechism_lessons works without a per-slug rebuild.
// Members only: /api/catechism/lessons returns 401 to logged-out
// visitors and this page bounces them to /login. The PDF arrives as a
// 60-second signed URL from /api/catechism/pdf.
//
// The viewer itself (scroll / book modes, pager, PDF.js wiring) is the
// same one used by the parish library reader at
// src/pages/learn/library/reader.astro.
---

<Layout
  title="Lesson | My Learning"
  description="Read a catechism lesson posted to your parish account."
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <!-- Reader-only theming. The site has light/dark mode but the reader
       always uses a dark frame so the white PDF pages pop. The toolbar
       and breadcrumb stay in the site's regular theme above. -->
  <style is:global>
    .pdf-stage { background: #1d1f23; }
    .pdf-page-canvas {
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
      display: block;
      margin: 0 auto;
    }
  </style>

  <!-- ============== HEADER + TOOLBAR ============== -->
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-6xl px-4 pt-10 pb-6 md:px-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">
        <a href="/account/" class="text-brand-tan-dark no-underline hover:underline">
          ← My Learning
        </a>
      </p>
      <h1 id="book-title" class="mt-2 font-display text-2xl text-text-primary md:text-3xl">Loading…</h1>
      <p id="book-author" class="mt-2 text-sm italic text-text-secondary"></p>
      <p id="lesson-note" class="mt-3 max-w-2xl text-sm text-text-primary/85"></p>
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-4 md:px-6">
      <div
        class="flex flex-wrap items-center gap-3 border border-border-soft bg-cream-card p-3 shadow-sm md:gap-4 md:p-4"
        role="toolbar"
        aria-label="Reader controls"
      >
        <!-- Mode toggle -->
        <div role="group" aria-label="View mode" class="flex">
          <button
            id="mode-scroll"
            type="button"
            aria-pressed="true"
            class="border border-brand-blue-dark bg-brand-blue-dark px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-cream-card"
          >
            Scroll
          </button>
          <button
            id="mode-book"
            type="button"
            aria-pressed="false"
            class="border border-brand-blue-dark border-l-0 bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark"
          >
            Book
          </button>
          <!-- The pages are drawn onto a canvas, so the browser's own
               Ctrl+F finds nothing in them. This view is the text
               itself: selectable, quotable, and searchable. -->
          <button
            id="mode-text"
            type="button"
            aria-pressed="false"
            hidden
            class="border border-brand-blue-dark border-l-0 bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark"
          >
            Text
          </button>
        </div>

        <!-- Pager -->
        <div id="pager" class="ml-auto flex items-center gap-2">
          <button
            id="pager-prev"
            type="button"
            class="border border-border-soft bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-text-primary disabled:cursor-not-allowed disabled:opacity-40"
          >
            ← Prev
          </button>
          <span
            id="pager-status"
            class="font-display text-xs uppercase tracking-widest text-text-secondary"
            aria-live="polite"
          >
            Loading…
          </span>
          <button
            id="pager-next"
            type="button"
            class="border border-border-soft bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-text-primary disabled:cursor-not-allowed disabled:opacity-40"
          >
            Next →
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== READER STAGE ============== -->
  <section class="pdf-stage">
    <div
      id="pdf-viewer"
      class="mx-auto min-h-[60vh] max-w-6xl px-4 py-8 md:px-6 md:py-12"
    >
      <p id="pdf-loading" class="text-center font-display text-sm uppercase tracking-widest text-cream-card/70">
        Loading text…
      </p>
      <p
        id="pdf-error"
        hidden
        role="alert"
        class="mx-auto max-w-md border border-liturgical-red bg-cream-card p-4 text-center text-sm text-liturgical-red"
      ></p>
    </div>

    <!-- ============== TEXT VIEW ============== -->
    <div id="text-view" hidden class="mx-auto max-w-3xl px-4 py-8 md:px-6 md:py-12">
      <!-- The find bar stays put while the text scrolls, so a long
           lesson doesn't mean scrolling back up to search again. -->
      <div class="sticky top-0 z-10 -mx-4 mb-6 border-b border-border-soft bg-cream-card px-4 py-3 md:-mx-6 md:px-6">
        <div class="flex flex-wrap items-center gap-2">
          <label for="text-find" class="sr-only">Find in this lesson</label>
          <input
            id="text-find"
            type="search"
            placeholder="Find in this lesson"
            class="min-w-0 flex-1 border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
          />
          <button type="button" id="find-prev" class="btn btn-secondary text-sm">Previous</button>
          <button type="button" id="find-next" class="btn btn-secondary text-sm">Next</button>
          <span id="find-count" class="text-sm text-text-secondary" role="status"></span>
        </div>
      </div>
      <div id="text-body" class="whitespace-pre-wrap text-base leading-relaxed text-text-primary"></div>
    </div>
  </section>

  <!-- PDF.js — pinned to 3.11.174 -->
  <script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
  ></script>

  <script>
    // PDF.js attaches itself as window.pdfjsLib. Declare a typed shim so
    // TypeScript stops complaining; the actual API surface is documented
    // at https://mozilla.github.io/pdf.js/api/.
    interface PDFViewport { width: number; height: number; }
    interface PDFPage {
      getViewport(opts: { scale: number }): PDFViewport;
      render(opts: { canvasContext: CanvasRenderingContext2D; viewport: PDFViewport }): { promise: Promise<void> };
    }
    interface PDFDocument {
      numPages: number;
      getPage(n: number): Promise<PDFPage>;
    }
    interface PDFJSLib {
      GlobalWorkerOptions: { workerSrc: string };
      getDocument(opts: { url: string } | string): { promise: Promise<PDFDocument> };
    }
    const pdfjsLib = (window as unknown as { pdfjsLib: PDFJSLib }).pdfjsLib;

    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

    type Lesson = {
      slug: string;
      title: string;
      teacher: string | null;
      series: string | null;
      lesson_date: string | null;
      description: string | null;
      pdf_storage_key: string;
      published: boolean;
    };

    const viewer = document.getElementById("pdf-viewer") as HTMLDivElement;
    const loadingEl = document.getElementById("pdf-loading") as HTMLParagraphElement;
    const errorEl = document.getElementById("pdf-error") as HTMLParagraphElement;
    const titleEl = document.getElementById("book-title") as HTMLHeadingElement;
    const authorEl = document.getElementById("book-author") as HTMLParagraphElement;
    const noteEl = document.getElementById("lesson-note") as HTMLParagraphElement;
    const modeScrollBtn = document.getElementById("mode-scroll") as HTMLButtonElement;
    const modeTextBtn = document.getElementById("mode-text") as HTMLButtonElement | null;
    const modeBookBtn = document.getElementById("mode-book") as HTMLButtonElement;
    const prevBtn = document.getElementById("pager-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("pager-next") as HTMLButtonElement;
    const statusEl = document.getElementById("pager-status") as HTMLSpanElement;

    type Mode = "scroll" | "book" | "text";
    let mode: Mode = "scroll";
    let pdf: PDFDocument | null = null;
    let currentPage = 1;
    // Cache rendered scroll-mode canvases so toggling modes doesn't
    // re-render every page.
    const scrollCanvases = new Map<number, HTMLCanvasElement>();

    function showError(msg: string) {
      loadingEl.hidden = true;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }

    function setStatus() {
      if (!pdf) {
        statusEl.textContent = "Loading…";
        return;
      }
      if (mode === "scroll") {
        statusEl.textContent = `Page ${currentPage} of ${pdf.numPages}`;
      } else {
        const left = currentPage;
        const right = Math.min(currentPage + 1, pdf.numPages);
        statusEl.textContent =
          left === right
            ? `Page ${left} of ${pdf.numPages}`
            : `Pages ${left}-${right} of ${pdf.numPages}`;
      }
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled =
        mode === "scroll"
          ? currentPage >= pdf.numPages
          : currentPage + 1 > pdf.numPages;
    }

    async function renderToCanvas(pageNum: number, targetWidth: number): Promise<HTMLCanvasElement> {
      const page = await pdf!.getPage(pageNum);
      const baseViewport = page.getViewport({ scale: 1 });
      const scale = targetWidth / baseViewport.width;
      const viewport = page.getViewport({ scale });

      const canvas = document.createElement("canvas");
      canvas.className = "pdf-page-canvas";
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.maxWidth = "100%";
      canvas.style.height = "auto";
      canvas.dataset.pageNum = String(pageNum);

      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("Canvas 2D context unavailable.");
      await page.render({ canvasContext: ctx, viewport }).promise;
      return canvas;
    }

    function clearViewer() {
      viewer.querySelectorAll(".pdf-stack, .pdf-spread").forEach((n) => n.remove());
    }

    async function renderScroll() {
      clearViewer();
      const stack = document.createElement("div");
      stack.className = "pdf-stack space-y-6";
      viewer.appendChild(stack);

      const targetWidth = Math.min(viewer.clientWidth - 32, 900);

      for (let i = 1; i <= pdf!.numPages; i++) {
        let canvas = scrollCanvases.get(i);
        if (!canvas) {
          canvas = await renderToCanvas(i, targetWidth);
          scrollCanvases.set(i, canvas);
        }
        canvas.id = `pdf-page-${i}`;
        stack.appendChild(canvas);
      }

      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && e.intersectionRatio > 0.5) {
              const n = Number((e.target as HTMLElement).dataset.pageNum);
              if (n) {
                currentPage = n;
                setStatus();
              }
            }
          }
        },
        { threshold: [0.5] },
      );
      stack.querySelectorAll<HTMLCanvasElement>(".pdf-page-canvas").forEach((c) => obs.observe(c));
    }

    async function renderSpread() {
      clearViewer();
      const spread = document.createElement("div");
      spread.className =
        "pdf-spread relative grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6";
      viewer.appendChild(spread);

      const halfWidth = Math.min((viewer.clientWidth - 64) / 2, 700);

      const left = await renderToCanvas(currentPage, halfWidth);
      spread.appendChild(left);

      if (currentPage + 1 <= pdf!.numPages) {
        const right = await renderToCanvas(currentPage + 1, halfWidth);
        spread.appendChild(right);
      }

      const overlay = document.createElement("div");
      overlay.className = "pointer-events-none absolute inset-0 grid grid-cols-2";
      const leftHalf = document.createElement("div");
      leftHalf.className = "pointer-events-auto cursor-w-resize";
      leftHalf.title = "Previous spread";
      leftHalf.addEventListener("click", () => goPrev());
      const rightHalf = document.createElement("div");
      rightHalf.className = "pointer-events-auto cursor-e-resize";
      rightHalf.title = "Next spread";
      rightHalf.addEventListener("click", () => goNext());
      overlay.appendChild(leftHalf);
      overlay.appendChild(rightHalf);
      spread.appendChild(overlay);
    }

    async function render() {
      if (!pdf) return;
      if (mode === "scroll") await renderScroll();
      else await renderSpread();
      setStatus();
    }

    function goPrev() {
      if (!pdf) return;
      if (mode === "scroll") {
        currentPage = Math.max(1, currentPage - 1);
        document.getElementById(`pdf-page-${currentPage}`)?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
        setStatus();
      } else {
        currentPage = Math.max(1, currentPage - 2);
        render();
      }
    }

    function goNext() {
      if (!pdf) return;
      if (mode === "scroll") {
        currentPage = Math.min(pdf.numPages, currentPage + 1);
        document.getElementById(`pdf-page-${currentPage}`)?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
        setStatus();
      } else {
        if (currentPage + 2 <= pdf.numPages) currentPage += 2;
        render();
      }
    }
    prevBtn.addEventListener("click", goPrev);
    nextBtn.addEventListener("click", goNext);

    /** One button lit, the rest not. Three modes now, so this is a loop. */
    function paintModeButtons() {
      const buttons: [HTMLButtonElement | null, Mode][] = [
        [modeScrollBtn, "scroll"],
        [modeBookBtn, "book"],
        [modeTextBtn, "text"],
      ];
      for (const [btn, which] of buttons) {
        if (!btn) continue;
        const on = mode === which;
        btn.setAttribute("aria-pressed", String(on));
        btn.classList.toggle("bg-brand-blue-dark", on);
        btn.classList.toggle("text-cream-card", on);
        btn.classList.toggle("bg-cream-card", !on);
        btn.classList.toggle("text-brand-blue-dark", !on);
      }
    }

    function setMode(next: Mode) {
      if (mode === next) return;
      mode = next;
      paintModeButtons();

      const reading = mode === "text";
      const viewerEl = document.getElementById("pdf-viewer");
      const textEl = document.getElementById("text-view");
      const pagerEl = document.getElementById("pager");
      if (viewerEl) viewerEl.hidden = reading;
      if (textEl) textEl.hidden = !reading;
      // The pager turns pages, and the text view has none to turn.
      if (pagerEl) pagerEl.hidden = reading;

      if (reading) {
        document.getElementById("text-find")?.focus();
        return;
      }
      if (mode === "book" && currentPage % 2 === 0) currentPage -= 1;
      render();
    }
    modeScrollBtn.addEventListener("click", () => setMode("scroll"));
    modeBookBtn.addEventListener("click", () => setMode("book"));
    modeTextBtn?.addEventListener("click", () => setMode("text"));

    document.addEventListener("keydown", (e) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      if (e.key === "ArrowLeft") goPrev();
      else if (e.key === "ArrowRight") goNext();
    });

    // Lesson dates are plain YYYY-MM-DD strings; splitting them avoids
    // the day-shift the Date constructor causes in US time zones.
    function formatDate(value: string | null): string {
      if (!value) return "";
      const [y, m, d] = value.split("-").map(Number);
      if (!y || !m || !d) return value;
      const months = ["January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"];
      return `${months[m - 1]} ${d}, ${y}`;
    }

    // ============================================================
    // BOOTSTRAP — read slug from URL, fetch lesson metadata,
    // populate header, fetch signed PDF URL, render
    // ============================================================
    (async () => {
      const params = new URLSearchParams(window.location.search);
      const slug = (params.get("slug") || "").trim();
      if (!slug) {
        titleEl.textContent = "No lesson selected";
        showError("This reader needs a ?slug= parameter. Pick a lesson from My Learning.");
        return;
      }

      try {
        // Look up the lesson in the member's list. At parish scale the
        // list is small enough that one fetch is cheaper than a
        // dedicated per-slug endpoint.
        const listRes = await fetch("/api/catechism/lessons", {
          credentials: "same-origin",
          cache: "no-store",
        });
        if (listRes.status === 401) {
          location.assign(`/login/?next=${encodeURIComponent(location.pathname + location.search)}`);
          return;
        }
        if (!listRes.ok) {
          showError(`Could not load your lessons (${listRes.status}).`);
          return;
        }
        const { lessons } = (await listRes.json()) as { lessons: Lesson[] };
        const lesson = (lessons ?? []).find((l) => l.slug === slug);
        if (!lesson) {
          titleEl.textContent = "Lesson not found";
          showError(`No lesson with slug "${slug}".`);
          return;
        }

        document.title = `${lesson.title} | My Learning`;
        titleEl.textContent = lesson.title;
        // Byline gathers whatever the admin supplied: series, teacher, date.
        authorEl.textContent = [lesson.series, lesson.teacher, formatDate(lesson.lesson_date)]
          .filter(Boolean)
          .join(" · ");
        noteEl.textContent = lesson.description ?? "";

        // Before the PDF, and never waited on: the text is the part that
        // can be searched and quoted, and it shouldn't be lost because
        // the PDF is slow, missing, or broken.
        void loadLessonText(slug);

        const pdfRes = await fetch(`/api/catechism/pdf?key=${encodeURIComponent(lesson.pdf_storage_key)}`, {
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        if (pdfRes.status === 401) {
          location.assign(`/login/?next=${encodeURIComponent(location.pathname + location.search)}`);
          return;
        }
        if (!pdfRes.ok) {
          const json = await pdfRes.json().catch(() => ({}));
          showError(json.error || `Could not load lesson (${pdfRes.status}).`);
          return;
        }
        const { url } = (await pdfRes.json()) as { url: string };
        pdf = await pdfjsLib.getDocument({ url }).promise;
        loadingEl.hidden = true;
        await render();
      } catch (e) {
        showError(`Could not load lesson: ${(e as Error).message || e}`);
      }
    })();
  
    // ============== THE TEXT OF THE LESSON ==============
    // Pulled out of the PDF when the lesson was uploaded and stored on
    // its row (migration 017). Fetched quietly alongside the pages: if
    // there is none — a scan, or a lesson uploaded before this existed —
    // the Text button simply never appears.

    let lessonText = "";

    function escapeForHtml(value: string): string {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    /**
     * The text as readable HTML: page markers become visible dividers,
     * so a passage can be cited to the page it is printed on rather
     * than guessed at.
     */
    function textToHtml(text: string, highlight: string): string {
      const escaped = escapeForHtml(text);
      // Markers survive escaping untouched (U+241E is not & < or >).
      let html = escaped.replace(
        // ␞printedLabel|pdfPage␞, written between pages by extraction,
        // with the newline that follows it.
        /␞([^␞|]*)\|?([^␞]*)␞\n?/g,
        (_m: string, label: string) =>
          `<span class="mt-6 mb-2 block border-t border-border-soft pt-2 font-display text-xs uppercase tracking-widest text-text-secondary">Page ${label || "—"}</span>`,
      );

      if (highlight) {
        // Matching allows for what extraction does to words: a line
        // break can leave "near- ness", kerning can leave "near ness".
        const loose = highlight
          .trim()
          .split(/\s+/)
          .map((word) =>
            word
              .replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
              .split("")
              // Between any two letters: a hyphen from a line break, a
              // stray space from kerning, or a soft hyphen.
              .join("[-\\s­]*"),
          )
          .join("\\s+");
        try {
          html = html.replace(
            new RegExp(`(${loose})`, "gi"),
            '<mark class="find-hit bg-sacred-gold/40">$1</mark>',
          );
        } catch {
          // An unusable pattern just means no highlighting.
        }
      }
      return html;
    }

    function renderText(highlight = "") {
      const body = document.getElementById("text-body");
      if (!body) return;
      body.innerHTML = textToHtml(lessonText, highlight);
    }

    let hits: HTMLElement[] = [];
    let hitIndex = -1;

    function showHit(index: number) {
      if (hits.length === 0) return;
      hitIndex = (index + hits.length) % hits.length;
      hits.forEach((el, i) => {
        el.classList.toggle("bg-sacred-gold", i === hitIndex);
        el.classList.toggle("bg-sacred-gold/40", i !== hitIndex);
      });
      hits[hitIndex].scrollIntoView({ block: "center" });
      const count = document.getElementById("find-count");
      if (count) count.textContent = `${hitIndex + 1} of ${hits.length}`;
    }

    function runFind(query: string) {
      const count = document.getElementById("find-count");
      renderText(query);
      hits = Array.from(document.querySelectorAll<HTMLElement>(".find-hit"));
      hitIndex = -1;
      if (!query) {
        if (count) count.textContent = "";
        return;
      }
      if (hits.length === 0) {
        if (count) count.textContent = "Not found";
        return;
      }
      showHit(0);
    }

    const findInput = document.getElementById("text-find") as HTMLInputElement | null;
    let findTimer: number | undefined;
    findInput?.addEventListener("input", () => {
      window.clearTimeout(findTimer);
      findTimer = window.setTimeout(() => runFind(findInput.value.trim()), 200);
    });
    findInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        if (hits.length > 0) showHit(hitIndex + (event.shiftKey ? -1 : 1));
        else runFind(findInput.value.trim());
      } else if (event.key === "Escape") {
        findInput.value = "";
        runFind("");
      }
    });
    document.getElementById("find-next")?.addEventListener("click", () => showHit(hitIndex + 1));
    document.getElementById("find-prev")?.addEventListener("click", () => showHit(hitIndex - 1));

    // Ctrl+F would search the canvas pages, where there is nothing to
    // find. Send it to the text instead, when there is text.
    document.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "f" && lessonText) {
        event.preventDefault();
        if (mode !== "text") setMode("text");
        findInput?.focus();
        findInput?.select();
      }
    });

    async function loadLessonText(slug: string) {
      try {
        const res = await fetch(`/api/catechism/text?slug=${encodeURIComponent(slug)}`, {
          credentials: "same-origin",
          cache: "no-store",
        });
        if (!res.ok) return; // 409 = a scan, or not read yet. No button.
        const data = await res.json();
        lessonText = String(data.text ?? "");
        if (!lessonText) return;
        renderText();
        if (modeTextBtn) modeTextBtn.hidden = false;
      } catch {
        // No text view; the pages still work.
      }
    }
</script>
</Layout>
