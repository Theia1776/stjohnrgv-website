---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="What is Orthodox Christianity? | St. John of Kronstadt Orthodox Mission"
  description="Discover Orthodox Christianity — the ancient faith of the Apostles and Church Fathers. Learn what makes Orthodoxy unique, what to expect at a service, and how to begin your journey."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">For Inquirers &amp; Seekers</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">What is Orthodox Christianity?</h1>
    <p class="mt-6 text-lg text-text-primary/80">
      A welcoming introduction to the Orthodox faith, the Divine Liturgy, the Julian Calendar,
      and the path of catechumens — coming soon.
    </p>
    <p class="mt-4 text-text-primary/75">
      If you are exploring Orthodoxy and would like to speak with someone,
      <a href="/contact/">reach out to Fr. Antonios</a>.
      All seekers are welcome to attend services without prior introduction.
    </p>

    <!-- Sub-pages under /learn/ -->
    <h2 class="mt-12 font-display text-xl text-text-primary md:text-2xl">Available now</h2>
    <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
    <ul class="mt-6 space-y-3 text-text-primary/85">
      <li>
        <a href="/learn/saints/" class="font-display">Saints &rarr;</a>
        <span class="block text-sm text-text-secondary">A growing, searchable encyclopedia of the saints commemorated in our parish.</span>
      </li>
      <li>
        <a href="/learn/st-john-of-kronstadt/" class="font-display">St. John of Kronstadt &rarr;</a>
        <span class="block text-sm text-text-secondary">The life of our patron saint.</span>
      </li>
      <li>
        <a href="/learn/st-john-chrysostom/" class="font-display">St. John Chrysostom &rarr;</a>
        <span class="block text-sm text-text-secondary">The life of the Golden-Tongued Hierarch, whose Divine Liturgy we celebrate each Lord's Day.</span>
      </li>
    </ul>
  </section>
</Layout>
