---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="What is Orthodox Christianity? | St. John of Kronstadt Orthodox Mission"
  description="Discover Orthodox Christianity — the ancient faith of the Apostles and Church Fathers. Learn what makes Orthodoxy unique, what to expect at a service, and how to begin your journey."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs uppercase tracking-widest text-brand-tan-dark">For Inquirers &amp; Seekers</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">What is Orthodox Christianity?</h1>
    <p class="mt-6 text-lg text-text-primary/80">
      A welcoming introduction to the Orthodox faith, the Divine Liturgy, the Julian Calendar,
      and the path of catechumens — coming soon.
    </p>
    <p class="mt-4 text-text-primary/75">
      If you are exploring Orthodoxy and would like to speak with someone,
      <a href="/contact/">reach out to Fr. Antonios</a>.
      All seekers are welcome to attend services without prior introduction.
    </p>
  </section>
</Layout>
