---
import Layout from "../../layouts/Layout.astro";
import "../../styles/board.css";
---

<Layout title="Parish Board" description="A conversation on the parish board.">
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 id="thread-title" class="text-3xl font-bold mb-1">Loading…</h1>

    <div class="bb-crumb">
      <a href="/board/">Parish Board</a>
      <span id="crumb-tail"></span>
    </div>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>

    <div
      id="error-banner"
      class="hidden border border-liturgical-red bg-cream-card p-4 mb-6 text-sm"
      role="alert"
    >
    </div>

    <div id="content" class="hidden">
      <div class="bb-bar">
        <span>
          <button id="reply-top" type="button" class="bb-btn bb-btn-strong">Post Reply</button>
          <a id="back-link" href="/board/" class="bb-btn">Back to forum</a>
        </span>
        <span id="thread-meta" class="text-xs text-text-secondary"></span>
      </div>

      <table class="bb-table">
        <thead>
          <tr>
            <th class="bb-author">Author</th>
            <th>Message</th>
          </tr>
        </thead>
        <tbody id="posts"></tbody>
      </table>

      <p id="locked-note" class="hidden mt-4 border border-border-soft bg-cream-card p-3 text-sm text-text-secondary">
        This topic is closed. No new replies can be posted.
      </p>

      <form id="reply-form" class="hidden mt-4 border border-border-soft bg-cream-card p-4 space-y-3">
        <label class="block">
          <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
            Post a reply
          </span>
          <textarea
            id="reply-body"
            rows="7"
            maxlength="10000"
            required
            spellcheck="true"
            autocapitalize="sentences"
            class="block w-full border border-border-soft bg-cream-bg px-3 py-2"
          ></textarea>
        </label>
        <div class="flex items-center gap-2">
          <button id="reply-submit" type="submit" class="bb-btn bb-btn-strong">Submit</button>
          <span id="reply-status" class="text-sm text-text-secondary" role="status"></span>
        </div>
      </form>

      <div class="bb-bar">
        <a id="back-link-2" href="/board/" class="bb-btn">Back to forum</a>
        <button id="tool-delete" type="button" class="bb-btn bb-btn-danger hidden">
          Delete this topic
        </button>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { confirmAction } from "../../lib/confirm";
  import {
    escapeHtml,
    renderBody,
    quoteOf,
    when,
    exactly,
    errorDetail,
    boardFetch,
  } from "../../lib/board-ui";

  type Reaction = { emoji: string; count: number; mine: boolean };
  type Panel = {
    name: string;
    rank: string;
    joined: string;
    posts: number;
    avatarUrl: string | null;
  };
  type Post = {
    id: string;
    author: string;
    panel: Panel;
    body: string;
    createdAt: string;
    editedAt: string | null;
    mine: boolean;
    reactions: Reaction[];
  };

  /** Must match REACTIONS in functions/api/board/react.ts. */
  const PALETTE = ["🙏", "☦️", "❤️", "👍", "😂", "🕯️"];

  const threadId = new URLSearchParams(window.location.search).get("id") ?? "";
  const here = `/board/thread/?id=${encodeURIComponent(threadId)}`;

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;
  const banner = document.getElementById("error-banner") as HTMLElement;
  const titleEl = document.getElementById("thread-title") as HTMLElement;
  const metaEl = document.getElementById("thread-meta") as HTMLElement;
  const crumbTail = document.getElementById("crumb-tail") as HTMLElement;
  const postsEl = document.getElementById("posts") as HTMLElement;
  const replyForm = document.getElementById("reply-form") as HTMLFormElement;
  const replyBody = document.getElementById("reply-body") as HTMLTextAreaElement;
  const replyStatus = document.getElementById("reply-status") as HTMLElement;
  const lockedNote = document.getElementById("locked-note") as HTMLElement;
  const deleteButton = document.getElementById("tool-delete") as HTMLButtonElement;

  let isAdmin = false;
  let canReply = false;

  function showError(message: string) {
    banner.textContent = message;
    banner.classList.remove("hidden");
    loading.classList.add("hidden");
  }

  /** "Joined: 14 Oct 2026 · Posts: 9" down the left of a post. */
  function authorCell(panel: Panel): string {
    const joined = panel.joined
      ? new Date(panel.joined).toLocaleDateString("en-US", {
          day: "numeric",
          month: "short",
          year: "numeric",
        })
      : "";
    return `
      <td class="bb-author">
        ${panel.avatarUrl ? `<img class="bb-avatar" src="${escapeHtml(panel.avatarUrl)}" alt="" />` : ""}
        <span class="bb-author-name">${escapeHtml(panel.name)}</span>
        ${panel.rank ? `<span class="bb-author-rank">${escapeHtml(panel.rank)}</span>` : ""}
        <span class="bb-author-meta">
          ${joined ? `Joined: ${escapeHtml(joined)}<br />` : ""}
          Posts: ${panel.posts}
        </span>
      </td>`;
  }

  function reactionStrip(post: Post): string {
    const given = post.reactions
      .map(
        (r) =>
          `<button type="button" class="bb-react ${r.mine ? "bb-react-on" : ""}" data-emoji="${escapeHtml(r.emoji)}"
                   title="${r.mine ? "You reacted. Click to take it back." : "Add yours"}">
             <span>${escapeHtml(r.emoji)}</span><span class="bb-react-count">${r.count}</span>
           </button>`,
      )
      .join("");

    // The palette only shows what hasn't been given yet, so the row
    // doesn't turn into twelve buttons on a post nobody answered.
    const taken = new Set(post.reactions.map((r) => r.emoji));
    const rest = PALETTE.filter((e) => !taken.has(e));
    const adder = canReply
      ? `<span class="bb-react-add">
           <button type="button" class="bb-react react-open" title="React to this post">＋</button>
           <span class="react-tray hidden">
             ${rest.map((e) => `<button type="button" class="bb-react" data-emoji="${escapeHtml(e)}">${escapeHtml(e)}</button>`).join("")}
           </span>
         </span>`
      : "";

    return `<span class="bb-reacts">${given}${adder}</span>`;
  }

  function renderPosts(posts: Post[], previouslyReadAt: string | null) {
    const seen = previouslyReadAt ? new Date(previouslyReadAt).getTime() : null;
    let dividerDrawn = false;

    postsEl.innerHTML = posts
      .map((p, index) => {
        const isNew = seen !== null && new Date(p.createdAt).getTime() > seen;
        let divider = "";
        if (isNew && !dividerDrawn && index > 0) {
          dividerDrawn = true;
          divider = `<tr class="bb-newline"><td colspan="2">New since you last looked</td></tr>`;
        }

        const canEdit = p.mine || isAdmin;
        // The opening post can be edited but not deleted on its own —
        // the whole topic hangs off it.
        const canDelete = canEdit && index > 0;

        const buttons = [
          canReply ? '<button type="button" class="bb-btn post-quote">Quote</button>' : "",
          canEdit ? '<button type="button" class="bb-btn post-edit">Edit</button>' : "",
          canDelete ? '<button type="button" class="bb-btn bb-btn-danger post-delete">Delete</button>' : "",
        ]
          .filter(Boolean)
          .join(" ");

        return `
          ${divider}
          <tr class="bb-post-row" data-id="${escapeHtml(p.id)}" id="p${escapeHtml(p.id)}">
            ${authorCell(p.panel)}
            <td>
              <div class="bb-posted">
                <span title="${escapeHtml(exactly(p.createdAt))}">
                  Posted: ${escapeHtml(exactly(p.createdAt) || when(p.createdAt))}
                  ${p.editedAt ? `<em title="${escapeHtml(exactly(p.editedAt))}">&middot; edited</em>` : ""}
                </span>
                <span>${buttons}</span>
              </div>
              <div class="bb-body post-body">${renderBody(p.body)}</div>
              <div class="bb-foot">
                ${reactionStrip(p)}
                <a href="#top" class="bb-react-add">Back to top</a>
              </div>
            </td>
          </tr>`;
      })
      .join("");
  }

  async function load() {
    if (!threadId) {
      showError("No topic in that link. Go back to the board and pick one.");
      return;
    }

    const res = await boardFetch(`/api/board/thread?id=${encodeURIComponent(threadId)}`, {}, here);
    if (!res) return;

    if (res.status === 403) {
      showError(
        (await errorDetail(res)) ||
          "The parish board opens up when Father receives you as a catechumen.",
      );
      return;
    }
    if (res.status === 404) {
      showError("That topic isn't on the board any more.");
      return;
    }
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't load this topic (${res.status}).`);
      return;
    }

    const data = await res.json();
    const thread = data.thread;
    const posts: Post[] = data.posts ?? [];
    isAdmin = !!data.viewer?.isAdmin;
    canReply = !thread.locked || isAdmin;

    titleEl.textContent = thread.title;
    document.title = `${thread.title} | St. John of Kronstadt Orthodox Mission`;

    const backHref = thread.category
      ? `/board/category/?c=${encodeURIComponent(thread.category.slug)}`
      : "/board/";
    (document.getElementById("back-link") as HTMLAnchorElement).href = backHref;
    (document.getElementById("back-link-2") as HTMLAnchorElement).href = backHref;

    crumbTail.innerHTML = thread.category
      ? ` &rsaquo; <a href="${backHref}">${escapeHtml(thread.category.name)}</a> &rsaquo; ${escapeHtml(thread.title)}`
      : ` &rsaquo; ${escapeHtml(thread.title)}`;

    metaEl.innerHTML =
      `${thread.replyCount} ${thread.replyCount === 1 ? "reply" : "replies"} &middot; ` +
      `${thread.viewCount} ${thread.viewCount === 1 ? "view" : "views"}` +
      (thread.locked ? " &middot; closed" : "");

    renderPosts(posts, data.previouslyReadAt);

    lockedNote.classList.toggle("hidden", !thread.locked);
    replyForm.classList.toggle("hidden", !canReply);
    (document.getElementById("reply-top") as HTMLButtonElement).classList.toggle("hidden", !canReply);
    deleteButton.classList.toggle("hidden", !data.canDelete);

    postsEl.onclick = async (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest("button");
      if (!button) return;
      const row = button.closest("tr") as HTMLElement | null;
      const id = row?.dataset.id;
      if (!id || !row) return;
      const post = posts.find((p) => p.id === id);
      if (!post) return;

      // --- react ---
      if (button.classList.contains("react-open")) {
        button.parentElement?.querySelector(".react-tray")?.classList.toggle("hidden");
        return;
      }
      if (button.classList.contains("bb-react") && button.dataset.emoji) {
        const res = await boardFetch(
          "/api/board/react",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ post: id, emoji: button.dataset.emoji }),
          },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't react (${res.status}).`);
          return;
        }
        await load();
        return;
      }

      // --- quote ---
      if (button.classList.contains("post-quote")) {
        replyForm.classList.remove("hidden");
        const existing = replyBody.value ? replyBody.value.replace(/\n*$/, "\n\n") : "";
        replyBody.value = existing + quoteOf(post.panel.name, post.body);
        replyBody.focus();
        replyBody.setSelectionRange(replyBody.value.length, replyBody.value.length);
        replyForm.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      // --- edit, in place ---
      if (button.classList.contains("post-edit")) {
        const bodyEl = row.querySelector(".post-body") as HTMLElement;
        bodyEl.innerHTML = `
          <textarea rows="8" maxlength="10000" spellcheck="true" autocapitalize="sentences"
                    class="block w-full border border-border-soft bg-cream-bg px-3 py-2">${escapeHtml(post.body)}</textarea>
          <span class="mt-2 inline-flex gap-2">
            <button type="button" class="bb-btn bb-btn-strong edit-save">Save</button>
            <button type="button" class="bb-btn edit-cancel">Cancel</button>
          </span>`;
        const textarea = bodyEl.querySelector("textarea") as HTMLTextAreaElement;
        textarea.focus();

        (bodyEl.querySelector(".edit-save") as HTMLElement).onclick = async () => {
          const text = textarea.value.trim();
          if (!text) return;
          const res = await boardFetch(
            "/api/board/post",
            {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id, body: text }),
            },
            here,
          );
          if (!res) return;
          if (!res.ok) {
            showError((await errorDetail(res)) || `Couldn't save that (${res.status}).`);
            return;
          }
          await load();
        };
        (bodyEl.querySelector(".edit-cancel") as HTMLElement).onclick = () => load();
        return;
      }

      // --- delete ---
      if (button.classList.contains("post-delete")) {
        const goAhead = await confirmAction({
          message: "Delete this post? It won't come back.",
          confirmLabel: "Delete it",
          cancelLabel: "Keep it",
          danger: true,
        });
        if (!goAhead) return;

        const res = await boardFetch(
          `/api/board/post?id=${encodeURIComponent(id)}`,
          { method: "DELETE" },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
          return;
        }
        await load();
      }
    };

    deleteButton.onclick = async () => {
      const goAhead = await confirmAction({
        message: `Delete "${thread.title}" and every post in it? That can't be undone.`,
        confirmLabel: "Delete the topic",
        cancelLabel: "Keep it",
        danger: true,
      });
      if (!goAhead) return;

      const res = await boardFetch(
        `/api/board/thread?id=${encodeURIComponent(threadId)}`,
        { method: "DELETE" },
        here,
      );
      if (!res) return;
      if (!res.ok) {
        showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
        return;
      }
      window.location.assign(backHref);
    };

    loading.classList.add("hidden");
    banner.classList.add("hidden");
    content.classList.remove("hidden");
  }

  (document.getElementById("reply-top") as HTMLButtonElement).addEventListener("click", () => {
    replyForm.classList.remove("hidden");
    replyBody.focus();
    replyForm.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  replyForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = document.getElementById("reply-submit") as HTMLButtonElement;
    const text = replyBody.value.trim();
    if (!text) {
      replyStatus.textContent = "Nothing to post yet.";
      return;
    }

    submit.disabled = true;
    replyStatus.textContent = "Posting…";

    const res = await boardFetch(
      "/api/board/thread",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: threadId, body: text }),
      },
      here,
    );
    submit.disabled = false;
    if (!res) return;

    if (!res.ok) {
      replyStatus.textContent = (await errorDetail(res)) || `Couldn't post that (${res.status}).`;
      return;
    }

    replyBody.value = "";
    replyStatus.textContent = "";
    await load();
    postsEl.lastElementChild?.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  load();
</script>
