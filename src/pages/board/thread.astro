---
import Layout from "../../layouts/Layout.astro";
import "../../styles/board.css";
---

<Layout title="Parish Board" description="A conversation on the parish board.">
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 id="thread-title" class="text-3xl font-bold mb-1">Loading…</h1>

    <div class="bb-crumb">
      <a href="/board/">Parish Board</a>
      <span id="crumb-tail"></span>
    </div>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>

    <div
      id="error-banner"
      class="hidden border border-liturgical-red bg-cream-card p-4 mb-6 text-sm"
      role="alert"
    >
    </div>

    <div id="content" class="hidden">
      <div class="bb-bar">
        <span>
          <button id="reply-top" type="button" class="bb-btn bb-btn-strong">Post Reply</button>
          <a id="back-link" href="/board/" class="bb-btn">Back to forum</a>
          <a id="jump-new" href="#first-new" class="bb-btn hidden">Go to first new post</a>
          <button id="tool-title" type="button" class="bb-btn hidden">Edit title</button>
        </span>
        <span id="thread-meta" class="text-xs text-text-secondary"></span>
      </div>

      <div id="mod-note" class="hidden bb-notice" role="status"></div>
      <div id="flash" class="hidden bb-notice" role="status"></div>
      <div id="poll" class="hidden bb-notice"></div>

      <table class="bb-table">
        <thead>
          <tr>
            <th class="bb-author">Author</th>
            <th>Message</th>
          </tr>
        </thead>
        <tbody id="posts"></tbody>
      </table>

      <p id="locked-note" class="hidden mt-4 border border-border-soft bg-cream-card p-3 text-sm text-text-secondary">
        This topic is closed. No new replies can be posted.
      </p>

      <form id="reply-form" class="hidden mt-4 border border-border-soft bg-cream-card p-4 space-y-3">
        <label class="block">
          <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
            Post a reply
          </span>
          <textarea
            id="reply-body"
            rows="7"
            maxlength="10000"
            required
            spellcheck="true"
            autocapitalize="sentences"
            class="block w-full border border-border-soft bg-cream-bg px-3 py-2"
          ></textarea>
        </label>
        <div id="reply-smilies"></div>
        <div id="reply-photos"></div>
        <p class="text-xs text-text-secondary">
          If you have a signature, it goes under your post by itself.
          <a href="/board/#signature" class="underline">Set or change it</a>
        </p>
        <div class="flex items-center gap-2">
          <button id="reply-submit" type="submit" class="bb-btn bb-btn-strong">Submit</button>
          <span id="reply-status" class="text-sm text-text-secondary" role="status"></span>
        </div>
      </form>

<dialog id="title-dialog" class="bb-help-dialog" aria-labelledby="title-dialog-h">
        <form id="title-form" method="dialog">
          <h2 id="title-dialog-h">Edit the title</h2>
          <input id="title-input" type="text" maxlength="160" required spellcheck="true" autocapitalize="sentences" class="bb-suspend-select" />
          <div class="bb-help-actions">
            <button type="submit" class="bb-btn bb-btn-strong">Save</button>
            <button type="button" class="bb-btn title-close">Cancel</button>
            <span id="title-status" class="text-sm" role="status"></span>
          </div>
        </form>
      </dialog>

      <dialog id="report-dialog" class="bb-help-dialog" aria-labelledby="report-title">
        <form id="report-form" method="dialog">
          <h2 id="report-title">Report this post?</h2>
          <label class="block">
            <span class="bb-help-label">Reason</span>
            <textarea id="report-reason" rows="4" maxlength="500" spellcheck="true" autocapitalize="sentences"></textarea>
          </label>
          <div class="bb-help-actions">
            <button type="submit" class="bb-btn bb-btn-strong">Report</button>
            <button type="button" class="bb-btn report-close">Cancel</button>
            <span id="report-status" class="text-sm" role="status"></span>
          </div>
        </form>
      </dialog>

      <dialog id="history-dialog" class="bb-help-dialog" aria-labelledby="history-title">
        <h2 id="history-title">Earlier versions</h2>
        <div id="history-body" class="text-sm"></div>
        <div class="bb-help-actions">
          <button type="button" class="bb-btn history-close">Close</button>
        </div>
      </dialog>

      <dialog id="suspend-dialog" class="bb-help-dialog" aria-labelledby="suspend-title">
        <form id="suspend-form" method="dialog">
          <h2 id="suspend-title">Suspend</h2>
          <p class="bb-help-lead">
            They can still read the board, but can't post, reply, react, send messages or add photos. Their
            existing posts stay. It ends by itself when the time is up.
          </p>
          <label class="block">
            <span class="bb-help-label">How long</span>
            <select id="suspend-days" class="bb-suspend-select">
              <option value="1">One day</option>
              <option value="7" selected>One week</option>
              <option value="30">One month</option>
              <option value="0">Until a moderator lifts it</option>
            </select>
          </label>
          <label class="block mt-3">
            <span class="bb-help-label">Reason (they'll see this)</span>
            <input id="suspend-reason" type="text" maxlength="300" class="bb-suspend-select" />
          </label>
          <div class="bb-help-actions">
            <button type="submit" class="bb-btn bb-btn-strong">Suspend</button>
            <button type="button" class="bb-btn suspend-close">Cancel</button>
            <span id="suspend-status" class="text-sm" role="status"></span>
          </div>
        </form>
      </dialog>

      <dialog id="help-dialog" class="bb-help-dialog" aria-labelledby="help-title">
        <div id="help-ask">
          <form id="help-form" method="dialog">
            <h2 id="help-title">Message the moderators</h2>
            <p class="bb-help-lead">
              This goes to the moderators and admins as a private message about this topic. Any one of
              them can answer you, and you'll see the answer in your Messages. Nothing changes on the
              topic until one of them acts.
            </p>
            <label class="block">
              <span class="bb-help-label">What's going on? (optional)</span>
              <textarea
                id="help-reason"
                rows="5"
                maxlength="1000"
                spellcheck="true"
                autocapitalize="sentences"
                placeholder="For example: I'd like this closed, or someone said something unkind."
              ></textarea>
            </label>
            <div class="bb-help-actions">
              <button id="help-send" type="submit" class="bb-btn bb-btn-strong">Send to the moderators</button>
              <button type="button" class="bb-btn help-close">Cancel</button>
              <span id="help-status" class="text-sm" role="status"></span>
            </div>
          </form>
        </div>
        <div id="help-done" class="hidden">
          <h2>Sent</h2>
          <p class="bb-help-lead">
            Your message is with the moderators and admins now. When one of them answers, it will be in
            your Messages.
          </p>
          <div class="bb-help-actions">
            <a href="/board/messages/" class="bb-btn bb-btn-strong">Open my Messages</a>
            <button type="button" class="bb-btn help-close">Close</button>
          </div>
        </div>
      </dialog>

      <div class="bb-bar">
        <a id="back-link-2" href="/board/" class="bb-btn">Back to forum</a>
        <button id="tool-delete" type="button" class="bb-btn bb-btn-danger hidden">
          Delete this topic
        </button>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { confirmAction } from "../../lib/confirm";
  import {
    escapeHtml,
    renderBody,
    renderSignature,
    quoteOf,
    when,
    exactly,
    errorDetail,
    boardFetch,
    attachSmilies,
    attachFormatBar,
    videoEmbeds,
    setMentionNames,
  } from "../../lib/board-ui";
  import { attachPhotoPicker } from "../../lib/board-photo-picker";

  type Reaction = { emoji: string; count: number; mine: boolean };
  type Panel = {
    name: string;
    rank: string;
    joined: string;
    posts: number;
    avatarUrl: string | null;
  };
  type Post = {
    id: string;
    author: string;
    panel: Panel;
    body: string;
    signature: string;
    photos: Array<{ id: string; width: number; height: number; thumb: string; full: string }>;
    createdAt: string;
    editedAt: string | null;
    mine: boolean;
    hidden?: boolean;
    authorId?: string | null;
    profileId?: string | null;
    canSuspend?: boolean;
    suspended?: boolean;
    reactions: Reaction[];
  };

  /** Must match REACTIONS in functions/api/board/react.ts. */
  const PALETTE = ["🙏", "☦️", "❤️", "👍", "😂", "🕯️", "😢"];

  const threadId = new URLSearchParams(window.location.search).get("id") ?? "";
  const here = `/board/thread/?id=${encodeURIComponent(threadId)}`;

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;
  const banner = document.getElementById("error-banner") as HTMLElement;
  const titleEl = document.getElementById("thread-title") as HTMLElement;
  const metaEl = document.getElementById("thread-meta") as HTMLElement;
  const crumbTail = document.getElementById("crumb-tail") as HTMLElement;
  const postsEl = document.getElementById("posts") as HTMLElement;
  const replyForm = document.getElementById("reply-form") as HTMLFormElement;
  const replyBody = document.getElementById("reply-body") as HTMLTextAreaElement;
  const replyStatus = document.getElementById("reply-status") as HTMLElement;
  const lockedNote = document.getElementById("locked-note") as HTMLElement;
  const deleteButton = document.getElementById("tool-delete") as HTMLButtonElement;
  const titleButton = document.getElementById("tool-title") as HTMLButtonElement;
  const titleDialog = document.getElementById("title-dialog") as HTMLDialogElement;
  const titleInput = document.getElementById("title-input") as HTMLInputElement;

  let isAdmin = false;
  let canReply = false;
  let helpState = { canAsk: false, waiting: false };
  let isMod = false;
  let jumpedToPost = false;
  let reportTarget = "";
  let pollData: {
    id: string; multiple: boolean; question?: string | null; closed: boolean; voters: number; mine: string[];
    options: Array<{ id: string; label: string; votes: number; voters?: string[] }>;
    showVoters?: boolean;
  } | null = null;
  let pollChanging = false;
  let suspendTarget: { id: string; name: string } | null = null;

  const suspendDialog = document.getElementById("suspend-dialog") as HTMLDialogElement;
  const suspendTitle = document.getElementById("suspend-title") as HTMLElement;
  const suspendStatus = document.getElementById("suspend-status") as HTMLElement;

  const helpDialog = document.getElementById("help-dialog") as HTMLDialogElement;
  const helpForm = document.getElementById("help-form") as HTMLFormElement;
  const helpAsk = document.getElementById("help-ask") as HTMLElement;
  const helpDone = document.getElementById("help-done") as HTMLElement;
  const helpReason = document.getElementById("help-reason") as HTMLTextAreaElement;
  const helpSend = document.getElementById("help-send") as HTMLButtonElement;
  const helpStatus = document.getElementById("help-status") as HTMLElement;
  const modNote = document.getElementById("mod-note") as HTMLElement;

  async function patchThreadFlags(updates: Record<string, unknown>) {
    const res = await boardFetch(
      "/api/board/thread",
      {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: threadId, ...updates }),
      },
      here,
    );
    if (!res) return false;
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't do that (${res.status}).`);
      return false;
    }
    return true;
  }

  modNote.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest("button");
    if (!button) return;
    if (button.classList.contains("note-close")) {
      const goAhead = await confirmAction({
        message: "Close this topic? People can still read it, but no new replies can be posted.",
        confirmLabel: "Close the topic",
        cancelLabel: "Not yet",
      });
      if (goAhead && (await patchThreadFlags({ locked: true }))) await load();
    }
    if (button.classList.contains("note-dismiss")) {
      if (await patchThreadFlags({ dismissRequest: true })) await load();
    }
  });

  function showError(message: string) {
    banner.textContent = message;
    banner.classList.remove("hidden");
    loading.classList.add("hidden");
  }

  /** "Joined: 14 Oct 2026 · Posts: 9" down the left of a post. */
  function authorCell(panel: Panel, authorId: string | null, profileId: string | null, suspended = false): string {
    const joined = panel.joined
      ? new Date(panel.joined).toLocaleDateString("en-US", {
          day: "numeric",
          month: "short",
          year: "numeric",
        })
      : "";
    return `
      <td class="bb-author">
        ${panel.avatarUrl ? `<img class="bb-avatar" src="${escapeHtml(panel.avatarUrl)}" alt="" />` : ""}
        <span class="bb-author-name">${profileId ? `<a href="/board/profile/?id=${encodeURIComponent(profileId)}" class="underline">${escapeHtml(panel.name)}</a>` : escapeHtml(panel.name)}</span>
        ${authorId ? `<a class="bb-author-msg" href="/board/messages/?to=${encodeURIComponent(authorId)}" title="Send ${escapeHtml(panel.name)} a private message">Message</a>` : ""}
        ${panel.rank ? `<span class="bb-author-rank">${escapeHtml(panel.rank)}</span>` : ""}
        ${suspended ? '<span class="bb-flag" title="Suspended from posting">Suspended</span>' : ""}
        <span class="bb-author-meta">
          ${joined ? `Joined: ${escapeHtml(joined)}<br />` : ""}
          Posts: ${panel.posts}
        </span>
      </td>`;
  }

  /** The pictures on a post. Click one to see it large. */
  function photosHtml(post: Post, canEdit: boolean): string {
    if (!post.photos?.length) return "";
    return (
      `<div class="bb-photos">` +
      post.photos
        .map(
          (ph) => `
          <span class="bb-photo-wrap">
            <a class="bb-photo" href="${escapeHtml(ph.full)}" target="_blank" rel="noopener"
               data-full="${escapeHtml(ph.full)}">
              <img src="${escapeHtml(ph.thumb)}" width="${ph.width}" height="${ph.height}"
                   loading="lazy" alt="Photo posted by ${escapeHtml(post.panel.name)}" />
            </a>
            ${
              canEdit
                ? `<button type="button" class="bb-btn bb-btn-danger photo-remove" data-photo-id="${escapeHtml(ph.id)}">Remove photo</button>`
                : ""
            }
          </span>`,
        )
        .join("") +
      `</div>`
    );
  }

  function reactionStrip(post: Post): string {
    const given = post.reactions
      .map(
        (r) =>
          `<button type="button" class="bb-react ${r.mine ? "bb-react-on" : ""}" data-emoji="${escapeHtml(r.emoji)}"
                   title="${r.mine ? "You reacted. Click to take it back." : "Add yours"}">
             <span>${escapeHtml(r.emoji)}</span><span class="bb-react-count">${r.count}</span>
           </button>`,
      )
      .join("");

    // The palette only shows what hasn't been given yet, so the row
    // doesn't turn into twelve buttons on a post nobody answered.
    const taken = new Set(post.reactions.map((r) => r.emoji));
    const rest = PALETTE.filter((e) => !taken.has(e));
    const adder = canReply
      ? `<span class="bb-react-add">
           <button type="button" class="bb-react react-open" title="React to this post">＋</button>
           <span class="react-tray hidden">
             ${rest.map((e) => `<button type="button" class="bb-react" data-emoji="${escapeHtml(e)}">${escapeHtml(e)}</button>`).join("")}
           </span>
         </span>`
      : "";

    return `<span class="bb-reacts">${given}${adder}</span>`;
  }

  function renderPoll(question: string) {
    const box = document.getElementById("poll") as HTMLElement;
    if (!pollData) {
      box.classList.add("hidden");
      return;
    }
    const p = pollData;
    const voted = p.mine.length > 0;
    let html = `<strong>${p.showVoters ? "RSVP" : "Poll"}: ${escapeHtml(p.question || question)}</strong>`;
    if (!p.closed && (!voted || pollChanging)) {
      html += `<form id="poll-form" class="mt-2 space-y-1">` +
        p.options
          .map(
            (o) => `<label class="flex items-center gap-2"><input type="${p.multiple ? "checkbox" : "radio"}" name="choice" value="${escapeHtml(o.id)}" ${p.mine.includes(o.id) ? "checked" : ""} class="h-4 w-4" /> ${escapeHtml(o.label)}</label>`,
          )
          .join("") +
        `<div class="mt-2"><button type="submit" class="bb-btn bb-btn-strong">Vote</button> <span id="poll-status" class="text-sm" role="status"></span></div></form>` +
        (p.multiple ? `<p class="text-xs text-text-secondary mt-1">You can choose more than one.</p>` : "");
    } else {
      const top = Math.max(1, ...p.options.map((o) => o.votes));
      html += `<div class="mt-2 space-y-2">` +
        p.options
          .map((o) => {
            const pct = p.voters ? Math.round((o.votes / p.voters) * 100) : 0;
            return `<div><div class="flex justify-between text-sm"><span>${escapeHtml(o.label)}${p.mine.includes(o.id) ? " ✓" : ""}</span><span>${o.votes} (${pct}%)</span></div><div class="bb-poll-bar"><i style="width:${Math.round((o.votes / top) * 100)}%"></i></div>${p.showVoters && o.voters?.length ? `<div class="text-xs text-text-secondary mt-0.5">${o.voters.map((n) => escapeHtml(n)).join(", ")}</div>` : ""}</div>`;
          })
          .join("") +
        `</div><p class="text-xs text-text-secondary mt-2">${p.voters} ${p.voters === 1 ? "person" : "people"} voted${p.closed ? " · This poll is closed." : ""}</p>`;
      if (!p.closed) html += `<button type="button" id="poll-change" class="bb-btn mt-2">Change my vote</button>`;
    }
    box.innerHTML = html;
    box.classList.remove("hidden");
  }

  function renderPosts(posts: Post[], previouslyReadAt: string | null) {
    const seen = previouslyReadAt ? new Date(previouslyReadAt).getTime() : null;
    let dividerDrawn = false;

    postsEl.innerHTML = posts
      .map((p, index) => {
        const isNew = seen !== null && new Date(p.createdAt).getTime() > seen;
        let divider = "";
        if (isNew && !dividerDrawn && index > 0) {
          dividerDrawn = true;
          divider = `<tr class="bb-newline" id="first-new"><td colspan="2">New since you last looked</td></tr>`;
        }

        const canEdit = p.mine || isAdmin || isMod;
        // The opening post can be edited but not deleted on its own —
        // the whole topic hangs off it.
        const canDelete = canEdit && index > 0;
        // A reported post is held back from everyone but the moderators.
        const underReview = !!p.hidden && !isMod;

        const asking = index === 0 && helpState.canAsk;
        const buttons = [
          asking
            ? '<button type="button" class="bb-btn post-help" title="Ask the moderators for help with this topic">Help</button>'
            : "",
          index === 0 && helpState.waiting
            ? '<span class="bb-flag" title="A moderator will look at it">Help requested</span>'
            : "",
          p.hidden && isMod ? '<button type="button" class="bb-btn bb-btn-strong post-restore" title="Put this post back on the board">Restore this post</button>' : "",
          canReply && !underReview ? '<button type="button" class="bb-btn post-quote">Quote</button>' : "",
          p.canSuspend
            ? p.suspended
              ? '<button type="button" class="bb-btn bb-btn-strong post-unsuspend" title="Let this member post again">Lift suspension</button>'
              : '<button type="button" class="bb-btn post-suspend" title="Stop this member posting for a while">Suspend</button>'
            : "",
          canEdit && !underReview ? '<button type="button" class="bb-btn post-edit">Edit</button>' : "",
          canDelete ? '<button type="button" class="bb-btn bb-btn-danger post-delete">Delete</button>' : "",
          !underReview ? '<button type="button" class="bb-btn post-share" title="Copy a link to this post, to send to someone on the board">Share</button>' : "",
          // On every post, own included: a small red hand in the corner.
          !underReview ? '<button type="button" class="bb-btn bb-report-icon post-report" title="Report this post" aria-label="Report this post"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="9" width="12" height="11" rx="4"/><rect x="6" y="3" width="2.6" height="9" rx="1.3"/><rect x="9.6" y="1.5" width="2.6" height="10" rx="1.3"/><rect x="13.2" y="2.5" width="2.6" height="9.5" rx="1.3"/><rect x="16.6" y="5" width="2.4" height="8" rx="1.2"/><path d="M6 13 L2.5 10.5 a1.4 1.4 0 0 0 -2 2 L5 18z"/></svg></button>' : "",
        ]
          .filter(Boolean)
          .join(" ");

        return `
          ${divider}
          <tr class="bb-post-row" data-id="${escapeHtml(p.id)}" id="p${escapeHtml(p.id)}">
            ${authorCell(p.panel, p.authorId ?? null, p.profileId ?? null, !!p.suspended)}
            <td>
              <div class="bb-posted">
                <span title="${escapeHtml(exactly(p.createdAt))}">
                  Posted: ${escapeHtml(exactly(p.createdAt) || when(p.createdAt))}
                  ${p.editedAt ? (isMod ? `<button type="button" class="post-history underline" title="See what it said before">&middot; edited</button>` : `<em title="${escapeHtml(exactly(p.editedAt))}">&middot; edited</em>`) : ""}
                </span>
                <span>${buttons}</span>
              </div>
              ${
                underReview
                  ? `<div class="bb-notice">This post is hidden while the moderators look at a report. It comes back if they find nothing wrong.</div>`
                  : `${p.hidden ? '<div class="bb-notice">Reported. Hidden from everyone but moderators until it is restored.</div>' : ""}
              <div class="bb-body post-body">${renderBody(p.body)}</div>
              ${videoEmbeds(p.body)}
              ${photosHtml(p, canEdit)}
              ${p.signature ? `<div class="bb-signature">${renderSignature(p.signature)}</div>` : ""}`
              }
              <div class="bb-foot">
                ${reactionStrip(p)}
                <a href="#top" class="bb-react-add">Back to top</a>
              </div>
            </td>
          </tr>`;
      })
      .join("");
  }

  async function load() {
    if (!threadId) {
      showError("No topic in that link. Go back to the board and pick one.");
      return;
    }

    const res = await boardFetch(`/api/board/thread?id=${encodeURIComponent(threadId)}`, {}, here);
    if (!res) return;

    if (res.status === 403) {
      showError(
        (await errorDetail(res)) ||
          "The parish board opens up when Father receives you as a catechumen.",
      );
      return;
    }
    if (res.status === 404) {
      showError("That topic isn't on the board any more.");
      return;
    }
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't load this topic (${res.status}).`);
      return;
    }

    const data = await res.json();
    const thread = data.thread;
    const posts: Post[] = data.posts ?? [];
    // Moderators and admins: edit and remove anyone's posts, reply to a closed topic.
    isAdmin = !!data.viewer?.isModerator;
    canReply = !thread.locked || isAdmin;

    titleEl.textContent = thread.title;
    document.title = `${thread.title} | St. John of Kronstadt Orthodox Mission`;

    const backHref = thread.category
      ? `/board/category/?c=${encodeURIComponent(thread.category.slug)}`
      : "/board/";
    (document.getElementById("back-link") as HTMLAnchorElement).href = backHref;
    (document.getElementById("back-link-2") as HTMLAnchorElement).href = backHref;

    crumbTail.innerHTML = thread.category
      ? ` &rsaquo; <a href="${backHref}">${escapeHtml(thread.category.name)}</a> &rsaquo; ${escapeHtml(thread.title)}`
      : ` &rsaquo; ${escapeHtml(thread.title)}`;

    metaEl.innerHTML =
      `${thread.replyCount} ${thread.replyCount === 1 ? "reply" : "replies"} &middot; ` +
      `${thread.viewCount} ${thread.viewCount === 1 ? "view" : "views"}` +
      (thread.locked ? " &middot; closed" : "");

    // The Help button goes on the opening post, for the person who started it.
    helpState = { canAsk: !!data.canRequestClose, waiting: !!thread.closeRequested && !!thread.mine };
    setMentionNames(data.mentionNames ?? []);
    const wantedPost = !jumpedToPost && window.location.hash.startsWith("#p") ? window.location.hash.slice(1) : "";
    isMod = !!data.viewer?.isModerator;
    pollData = data.poll ?? null;
    renderPoll(thread.title);
    renderPosts(posts, data.previouslyReadAt);
    document.getElementById("jump-new")?.classList.toggle("hidden", !document.getElementById("first-new"));
    if (wantedPost) {
      jumpedToPost = true;
      const target = document.getElementById(wantedPost);
      if (target) {
        target.scrollIntoView({ block: "start" });
        target.classList.add("bb-landed");
      }
    }

    // --- a waiting request to close, as moderators see it ---
    if (data.closeRequest) {
      const who = data.closeRequest.by ? escapeHtml(data.closeRequest.by) : "The person who started it";
      modNote.innerHTML = `
        <p><strong>${who} asked the moderators for help with this topic.</strong>
           Their message is in your <a class="underline" href="/board/messages/">Messages</a>, and a note is in the Moderation Forum.</p>
        <p class="mt-2">
          <button type="button" class="bb-btn bb-btn-strong note-close">Close this topic</button>
          <button type="button" class="bb-btn note-dismiss">Dismiss</button>
        </p>`;
      modNote.classList.remove("hidden");
    } else {
      modNote.classList.add("hidden");
    }


    lockedNote.classList.toggle("hidden", !thread.locked);
    replyForm.classList.toggle("hidden", !canReply);
    (document.getElementById("reply-top") as HTMLButtonElement).classList.toggle("hidden", !canReply);
    deleteButton.classList.toggle("hidden", !data.canDelete);
    titleButton.classList.toggle("hidden", !(data.thread?.mine || data.viewer?.isModerator));

    postsEl.onclick = async (event) => {
      const target = event.target as HTMLElement;

      // A photo: show it large instead of leaving the page.
      const photoLink = target.closest("a.bb-photo") as HTMLAnchorElement | null;
      if (photoLink) {
        event.preventDefault();
        openLightbox(photoLink.dataset.full ?? photoLink.href);
        return;
      }

      const button = target.closest("button");
      if (!button) return;
      const row = button.closest("tr") as HTMLElement | null;
      const id = row?.dataset.id;
      if (!id || !row) return;
      const post = posts.find((p) => p.id === id);
      if (!post) return;

      // --- what it said before ---
      if (button.classList.contains("post-history")) {
        const res = await boardFetch(`/api/board/post-history?id=${encodeURIComponent(id)}`, {}, here);
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't load that (${res.status}).`);
          return;
        }
        const h = await res.json();
        (document.getElementById("history-body") as HTMLElement).innerHTML = h.earlier.length
          ? h.earlier
              .map(
                (e: { body: string; by: string; replacedAt: string }) =>
                  `<div class="border-l-4 pl-3 mb-3" style="border-color: var(--bb-gold)"><div class="text-xs text-text-secondary">Before ${escapeHtml(e.by)} changed it, ${escapeHtml(exactly(e.replacedAt))}:</div><div class="bb-body">${renderBody(e.body)}</div></div>`,
              )
              .join("")
          : "<p>No earlier version was kept. It was edited before this was recorded.</p>";
        (document.getElementById("history-dialog") as HTMLDialogElement).showModal();
        return;
      }

      // --- share a link to this post ---
      if (button.classList.contains("post-share")) {
        const link = `${window.location.origin}/board/thread/?id=${encodeURIComponent(threadId)}#p${id}`;
        const nav = navigator as Navigator & { share?: (d: { title?: string; url?: string }) => Promise<void> };
        const label = button as HTMLButtonElement;
        try {
          if (nav.share) {
            await nav.share({ title: titleEl.textContent ?? "Parish board", url: link });
            return;
          }
        } catch {
          // They closed the share sheet; fall through to copying.
        }
        let copied = false;
        try {
          await navigator.clipboard.writeText(link);
          copied = true;
        } catch {
          const probe = document.createElement("textarea");
          probe.value = link;
          document.body.appendChild(probe);
          probe.select();
          copied = document.execCommand("copy");
          probe.remove();
        }
        label.textContent = copied ? "Link copied" : "Copy failed";
        setTimeout(() => (label.textContent = "Share"), 2200);
        return;
      }

      // --- restore a reported post (moderators) ---
      if (button.classList.contains("post-restore")) {
        const res = await boardFetch(
          "/api/board/post-restore",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ postId: id }),
          },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't do that (${res.status}).`);
          return;
        }
        await load();
        return;
      }

      // --- report a post ---
      if (button.classList.contains("post-report")) {
        reportTarget = id;
        (document.getElementById("report-reason") as HTMLTextAreaElement).value = "";
        (document.getElementById("report-status") as HTMLElement).textContent = "";
        (document.getElementById("report-dialog") as HTMLDialogElement).showModal();
        (document.getElementById("report-reason") as HTMLTextAreaElement).focus();
        return;
      }

      // --- lift a suspension ---
      if (button.classList.contains("post-unsuspend") && post.authorId) {
        const res = await boardFetch(
          `/api/board/suspend?userId=${encodeURIComponent(post.authorId)}`,
          { method: "DELETE" },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't do that (${res.status}).`);
          return;
        }
        showNotice(`${post.panel.name} can post again.`);
        await load();
        return;
      }

      // --- suspend the author ---
      if (button.classList.contains("post-suspend") && post.authorId) {
        suspendTarget = { id: post.authorId, name: post.panel.name };
        suspendTitle.textContent = `Suspend ${post.panel.name}`;
        suspendStatus.textContent = "";
        suspendDialog.showModal();
        return;
      }

      // --- Help: open the message window ---
      if (button.classList.contains("post-help")) {
        helpAsk.classList.remove("hidden");
        helpDone.classList.add("hidden");
        helpStatus.textContent = "";
        helpReason.value = "";
        helpDialog.showModal();
        helpReason.focus();
        return;
      }

      // --- take a photo off ---
      if (button.classList.contains("photo-remove") && button.dataset.photoId) {
        const goAhead = await confirmAction({
          message: "Remove this photo from the post? It can't be brought back.",
          confirmLabel: "Remove it",
          cancelLabel: "Keep it",
          danger: true,
        });
        if (!goAhead) return;
        const res = await boardFetch(
          `/api/board/photo?id=${encodeURIComponent(button.dataset.photoId)}`,
          { method: "DELETE" },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't remove that (${res.status}).`);
          return;
        }
        await load();
        return;
      }

      // --- react ---
      if (button.classList.contains("react-open")) {
        button.parentElement?.querySelector(".react-tray")?.classList.toggle("hidden");
        return;
      }
      if (button.classList.contains("bb-react") && button.dataset.emoji) {
        const res = await boardFetch(
          "/api/board/react",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ post: id, emoji: button.dataset.emoji }),
          },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't react (${res.status}).`);
          return;
        }
        await load();
        return;
      }

      // --- quote ---
      if (button.classList.contains("post-quote")) {
        replyForm.classList.remove("hidden");
        const existing = replyBody.value ? replyBody.value.replace(/\n*$/, "\n\n") : "";
        replyBody.value = existing + quoteOf(post.panel.name, post.body);
        replyBody.focus();
        replyBody.setSelectionRange(replyBody.value.length, replyBody.value.length);
        replyForm.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      // --- edit, in place ---
      if (button.classList.contains("post-edit")) {
        const bodyEl = row.querySelector(".post-body") as HTMLElement;
        bodyEl.innerHTML = `
          <textarea rows="8" maxlength="10000" spellcheck="true" autocapitalize="sentences"
                    class="block w-full border border-border-soft bg-cream-bg px-3 py-2">${escapeHtml(post.body)}</textarea>
          <span class="mt-2 inline-flex gap-2">
            <button type="button" class="bb-btn bb-btn-strong edit-save">Save</button>
            <button type="button" class="bb-btn edit-cancel">Cancel</button>
          </span>`;
        const textarea = bodyEl.querySelector("textarea") as HTMLTextAreaElement;
        const smilieMount = document.createElement("div");
        bodyEl.insertBefore(smilieMount, textarea.nextSibling);
        attachSmilies(textarea, smilieMount);
        attachFormatBar(textarea);
        const photoMount = document.createElement("div");
        smilieMount.insertAdjacentElement("afterend", photoMount);
        const editPhotos = attachPhotoPicker(photoMount, post.photos?.length ?? 0);
        textarea.focus();

        (bodyEl.querySelector(".edit-save") as HTMLElement).onclick = async () => {
          const text = textarea.value.trim();
          if (!text) return;
          if (editPhotos.busy()) {
            showError("Hold on, a photo is still being added.");
            return;
          }
          const res = await boardFetch(
            "/api/board/post",
            {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id, body: text, photoIds: editPhotos.ids() }),
            },
            here,
          );
          if (!res) return;
          if (!res.ok) {
            showError((await errorDetail(res)) || `Couldn't save that (${res.status}).`);
            return;
          }
          await load();
        };
        (bodyEl.querySelector(".edit-cancel") as HTMLElement).onclick = async () => {
          await editPhotos.discard();
          await load();
        };
        return;
      }

      // --- delete ---
      if (button.classList.contains("post-delete")) {
        const goAhead = await confirmAction({
          message: "Delete this post? It won't come back.",
          confirmLabel: "Delete it",
          cancelLabel: "Keep it",
          danger: true,
        });
        if (!goAhead) return;

        const res = await boardFetch(
          `/api/board/post?id=${encodeURIComponent(id)}`,
          { method: "DELETE" },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
          return;
        }
        await load();
      }
    };

    titleButton.onclick = () => {
      titleInput.value = titleEl.textContent ?? "";
      (document.getElementById("title-status") as HTMLElement).textContent = "";
      titleDialog.showModal();
      titleInput.select();
    };
    deleteButton.onclick = async () => {
      const goAhead = await confirmAction({
        message: `Delete "${thread.title}" and every post in it? That can't be undone.`,
        confirmLabel: "Delete the topic",
        cancelLabel: "Keep it",
        danger: true,
      });
      if (!goAhead) return;

      const res = await boardFetch(
        `/api/board/thread?id=${encodeURIComponent(threadId)}`,
        { method: "DELETE" },
        here,
      );
      if (!res) return;
      if (!res.ok) {
        showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
        return;
      }
      window.location.assign(backHref);
    };

    loading.classList.add("hidden");
    banner.classList.add("hidden");
    content.classList.remove("hidden");
  }

  function showNotice(message: string) {
    const flash = document.getElementById("flash") as HTMLElement;
    flash.textContent = message;
    flash.classList.remove("hidden");
    flash.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  // ---- edit the title ----
  document.querySelectorAll(".title-close").forEach((b) => b.addEventListener("click", () => titleDialog.close()));
  (document.getElementById("title-form") as HTMLFormElement).addEventListener("submit", async (event) => {
    event.preventDefault();
    const title = titleInput.value.trim();
    if (!title) return;
    if (await patchThreadFlags({ title })) {
      titleDialog.close();
      await load();
    }
  });

  // ---- the poll ----
  document.getElementById("poll")?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).id === "poll-change") {
      pollChanging = true;
      renderPoll(titleEl.textContent ?? "");
    }
  });
  document.getElementById("poll")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!pollData) return;
    const form = event.target as HTMLFormElement;
    const picked = [...form.querySelectorAll("input:checked")].map((i) => (i as HTMLInputElement).value);
    const status = document.getElementById("poll-status") as HTMLElement;
    if (!picked.length) {
      status.textContent = "Pick an answer first.";
      return;
    }
    status.textContent = "Saving…";
    const res = await boardFetch(
      "/api/board/vote",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pollId: pollData.id, optionIds: picked }),
      },
      here,
    );
    if (!res) return;
    if (!res.ok) {
      status.textContent = (await errorDetail(res)) || `Couldn't save that (${res.status}).`;
      return;
    }
    pollChanging = false;
    await load();
  });

  // ---- what a post said before it was edited (moderators) ----
  document.querySelectorAll(".history-close").forEach((b) =>
    b.addEventListener("click", () => (document.getElementById("history-dialog") as HTMLDialogElement).close()),
  );

  // ---- report a post: a reason, and that's all ----
  document.querySelectorAll(".report-close").forEach((b) =>
    b.addEventListener("click", () => (document.getElementById("report-dialog") as HTMLDialogElement).close()),
  );
  (document.getElementById("report-form") as HTMLFormElement).addEventListener("submit", async (event) => {
    event.preventDefault();
    const status = document.getElementById("report-status") as HTMLElement;
    const reason = (document.getElementById("report-reason") as HTMLTextAreaElement).value.trim();
    if (!reason) {
      status.textContent = "Please say why.";
      return;
    }
    status.textContent = "Sending…";
    const res = await boardFetch(
      "/api/board/post-report",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ postId: reportTarget, reason }),
      },
      here,
    );
    if (!res) return;
    if (!res.ok) {
      status.textContent = (await errorDetail(res)) || `Couldn't send that (${res.status}).`;
      return;
    }
    (document.getElementById("report-dialog") as HTMLDialogElement).close();
    await load();
  });

  // ---- suspend: how long, and why ----
  document.querySelectorAll(".suspend-close").forEach((b) =>
    b.addEventListener("click", () => suspendDialog.close()),
  );
  (document.getElementById("suspend-form") as HTMLFormElement).addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!suspendTarget) return;
    suspendStatus.textContent = "Saving…";
    const res = await boardFetch(
      "/api/board/suspend",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          userId: suspendTarget.id,
          days: Number((document.getElementById("suspend-days") as HTMLSelectElement).value),
          reason: (document.getElementById("suspend-reason") as HTMLInputElement).value,
        }),
      },
      here,
    );
    if (!res) return;
    if (!res.ok) {
      suspendStatus.textContent = (await errorDetail(res)) || `Couldn't do that (${res.status}).`;
      return;
    }
    suspendStatus.textContent = "";
    suspendDialog.close();
    showNotice(
      `${suspendTarget.name} is suspended. They can still read the board but can't post, reply, react or message. ` +
        `You can lift it from the board's front page.`,
    );
  });

  // ---- Help: a message window to the moderators and admins ----
  helpDialog.addEventListener("click", (event) => {
    // A click on the dim backdrop (the dialog element itself) puts it away.
    if (event.target === helpDialog) helpDialog.close();
  });
  document.querySelectorAll(".help-close").forEach((b) =>
    b.addEventListener("click", () => helpDialog.close()),
  );
  helpForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const send = helpSend;
    const status = helpStatus;
    send.disabled = true;
    status.textContent = "Sending…";

    const res = await boardFetch(
      "/api/board/close-request",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id: threadId,
          reason: helpReason.value,
        }),
      },
      here,
    );
    send.disabled = false;
    if (!res) return;
    if (!res.ok) {
      status.textContent = (await errorDetail(res)) || `Couldn't send that (${res.status}).`;
      return;
    }
    // Say plainly what happened and what comes next, then redraw the
    // post with "Help requested" where the button was.
    status.textContent = "";
    helpAsk.classList.add("hidden");
    helpDone.classList.remove("hidden");
    await load();
  });

  attachSmilies(replyBody, document.getElementById("reply-smilies") as HTMLElement);
  attachFormatBar(replyBody);
  const replyPhotos = attachPhotoPicker(document.getElementById("reply-photos") as HTMLElement);

  // One lightbox for every photo on the page.
  const lightbox = document.createElement("div");
  lightbox.className = "bb-lightbox hidden";
  lightbox.setAttribute("role", "dialog");
  lightbox.setAttribute("aria-label", "Photo");
  lightbox.innerHTML =
    '<span class="bb-lightbox-frame"><img alt="" /><button type="button" class="bb-lightbox-close" aria-label="Close photo" title="Close">&times;</button></span>';
  document.body.appendChild(lightbox);
  const lightboxImg = lightbox.querySelector("img") as HTMLImageElement;

  function openLightbox(src: string) {
    lightboxImg.src = src;
    lightbox.classList.remove("hidden");
  }
  function closeLightbox() {
    lightbox.classList.add("hidden");
    lightboxImg.removeAttribute("src");
  }
  lightbox.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !lightbox.classList.contains("hidden")) closeLightbox();
  });

  (document.getElementById("reply-top") as HTMLButtonElement).addEventListener("click", () => {
    replyForm.classList.remove("hidden");
    replyBody.focus();
    replyForm.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  replyForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = document.getElementById("reply-submit") as HTMLButtonElement;
    const text = replyBody.value.trim();
    if (!text) {
      replyStatus.textContent = "Nothing to post yet.";
      return;
    }

    if (replyPhotos.busy()) {
      replyStatus.textContent = "Hold on, a photo is still being added.";
      return;
    }

    submit.disabled = true;
    replyStatus.textContent = "Posting…";

    const res = await boardFetch(
      "/api/board/thread",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: threadId, body: text, photoIds: replyPhotos.ids() }),
      },
      here,
    );
    submit.disabled = false;
    if (!res) return;

    if (!res.ok) {
      replyStatus.textContent = (await errorDetail(res)) || `Couldn't post that (${res.status}).`;
      return;
    }

    replyBody.value = "";
    replyPhotos.clear();
    replyStatus.textContent = "";
    await load();
    postsEl.lastElementChild?.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  load();
</script>
