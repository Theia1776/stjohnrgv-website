---
import Layout from "../../layouts/Layout.astro";
import "../../styles/board.css";
---

<Layout
  title="Parish Board"
  description="Somewhere for the parish to talk — the book club, the kitchen, Scripture and the faith."
>
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-1">Parish Board</h1>
    <p class="text-text-secondary text-sm mb-4">
      Pick a room and see what people are talking about.
    </p>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>

    <div
      id="error-banner"
      class="hidden border border-liturgical-red bg-cream-card p-4 mb-6 text-sm"
      role="alert"
    >
    </div>

    <div id="content" class="hidden">
      <section id="today" class="hidden bb-notice">
        <strong id="today-feast"></strong>
        <ul id="today-list" class="mt-1 space-y-1"></ul>
      </section>

      <section id="announcements" class="hidden bb-notice">
        <strong>Announcements</strong>
        <ul id="announcement-list" class="mt-1 space-y-1"></ul>
      </section>

      <form action="/board/search/" method="get" class="flex flex-wrap gap-2 mb-4">
        <input
          name="q"
          type="search"
          maxlength="80"
          autocomplete="off"
          placeholder="Search the board"
          aria-label="Search the board"
          class="flex-1 min-w-[12rem] border border-border-soft bg-cream-bg px-3 py-2"
        />
        <button type="submit" class="bb-btn">Search</button>
      </form>

      <div class="bb-layout">
        <div>
          <table class="bb-table">
            <thead>
              <tr>
                <th colspan="2">Forum</th>
                <th class="bb-num bb-hide-small">Topics</th>
                <th class="bb-num bb-hide-small">Posts</th>
                <th class="bb-last">Last Post</th>
              </tr>
            </thead>
            <tbody id="categories"></tbody>
          </table>

          <p id="empty-state" class="hidden text-center text-text-secondary italic mt-8">
            No categories yet.
          </p>

          <div id="stats" class="bb-stats"></div>
        </div>

        <!-- Your own corner, the way a board always had one. -->
        <aside class="bb-panel" id="you-panel">
          <h2>Your Account</h2>
          <div class="bb-panel-body">
            <span class="bb-panel-you" id="you-name">—</span>
            <span id="you-rank"></span>
            <div id="you-unread" class="mt-2"></div>
          </div>
          <div class="bb-panel-links">
            <a href="/account/">My Account</a>
            <a href="/directory/">Parish Directory</a>
            <a href="/learn/library/">Parish Library</a>
            <a href="/board/messages/" id="messages-link">Messages</a>
            <a href="/board/mentions/" id="mentions-link">Mentions</a>
            <a href="/board/terms/">Board terms</a>
            <a href="/board/new/">New posts</a>
            <a href="#" id="mark-all-read">Mark all topics read</a>
          </div>
          <div class="bb-panel-links" id="signature">
            <strong>My signature</strong>
            <div id="sig-preview" class="bb-sig-preview hidden"></div>
            <a href="#" id="sig-edit">Add a signature</a>
            <form id="sig-form" class="bb-sig-form hidden">
              <textarea
                id="sig-body"
                rows="4"
                maxlength="300"
                spellcheck="true"
                autocapitalize="sentences"
                aria-label="Your signature"
                placeholder="A line or two that goes under every post you write"
              ></textarea>
              <span id="sig-count" class="bb-sig-count">0 / 300 · up to 4 lines</span>
              <div class="mt-2 flex flex-wrap items-center gap-1">
                <button type="submit" id="sig-save" class="bb-btn bb-btn-strong">Save</button>
                <button type="button" id="sig-cancel" class="bb-btn">Cancel</button>
              </div>
              <span id="sig-status" class="bb-sig-count" role="status"></span>
            </form>
          </div>
          <div class="bb-panel-links" id="dates">
            <strong>My special days</strong>
            <p class="bb-sig-count">Optional. Shown to people on the board, with no year.</p>
            <a href="#" id="dates-edit">Add my name day, baptism day or birthday</a>
            <form id="dates-form" class="bb-sig-form hidden">
              <fieldset class="mb-2">
                <legend class="text-xs font-semibold">Name day</legend>
                <input id="nd-saint" type="text" maxlength="60" placeholder="Saint (for example, Philothei)" aria-label="Saint for your name day" class="bb-suspend-select mb-1" />
                <span class="flex gap-1"><select id="nd-month" aria-label="Name day month" class="bb-suspend-select"></select><select id="nd-day" aria-label="Name day" class="bb-suspend-select"></select></span>
              </fieldset>
              <fieldset class="mb-2">
                <legend class="text-xs font-semibold">Baptism day</legend>
                <span class="flex gap-1"><select id="bp-month" aria-label="Baptism month" class="bb-suspend-select"></select><select id="bp-day" aria-label="Baptism day" class="bb-suspend-select"></select></span>
              </fieldset>
              <fieldset class="mb-2">
                <legend class="text-xs font-semibold">Birthday</legend>
                <span class="flex gap-1"><select id="bd-month" aria-label="Birthday month" class="bb-suspend-select"></select><select id="bd-day" aria-label="Birthday day" class="bb-suspend-select"></select></span>
              </fieldset>
              <div class="mt-2 flex flex-wrap items-center gap-1">
                <button type="submit" id="dates-save" class="bb-btn bb-btn-strong">Save</button>
                <button type="button" id="dates-cancel" class="bb-btn">Cancel</button>
              </div>
              <span id="dates-status" class="bb-sig-count" role="status"></span>
            </form>
            <p id="dates-saved" class="bb-sig-count" role="status"></p>
          </div>
        </aside>
      </div>

      <!-- Admin: who helps moderate -->
      <section id="suspended-box" class="hidden mt-10">
        <h2 class="text-lg font-semibold mb-1">Suspended members</h2>
        <p class="text-sm text-text-secondary mb-2">
          They can read but can't post. A timed suspension ends by itself.
        </p>
        <ul id="suspended-list" class="space-y-1 text-sm"></ul>
      </section>

      <section id="mod-tools" class="hidden mt-10">
        <table class="bb-table mb-6">
          <thead>
            <tr>
              <th>Board members (<span id="member-count">0</span>)</th>
              <th>Is</th>
              <th class="bb-hide-small">Joined</th>
              <th class="bb-num">Posts</th>
            </tr>
          </thead>
          <tbody id="member-list"></tbody>
        </table>

        <table class="bb-table">
          <thead>
            <tr><th colspan="2">Moderators</th></tr>
          </thead>
          <tbody id="moderator-list"></tbody>
        </table>
        <p class="text-xs text-text-secondary mt-2">
          A moderator is a member you trust to help. They can pin, close, move and remove
          topics, remove other people's posts and photos, and see the Moderation Forum.
          They can't manage the rooms or see the Admin Forum. Everywhere else on the site
          they're an ordinary member.
        </p>
        <form id="add-moderator" class="flex flex-wrap gap-2 items-end mt-3">
          <label class="flex-1 min-w-[12rem]">
            <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
              Make someone a moderator
            </span>
            <select id="moderator-pick" class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm"></select>
          </label>
          <button type="submit" class="bb-btn bb-btn-strong">Add</button>
          <span id="moderator-status" class="text-sm text-text-secondary" role="status"></span>
        </form>
      </section>

      <!-- Admin: arrange the rooms -->
      <section id="admin-tools" class="hidden mt-10">
        <table class="bb-table">
          <thead>
            <tr><th colspan="2">Manage Categories</th></tr>
          </thead>
          <tbody id="admin-categories"></tbody>
        </table>

        <form id="new-category" class="flex flex-wrap gap-2 items-end mt-3">
          <label class="flex-1 min-w-[10rem]">
            <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
              New category
            </span>
            <input
              id="cat-name"
              type="text"
              maxlength="80"
              spellcheck="true"
              placeholder="Parish Life"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm"
            />
          </label>
          <label class="flex-1 min-w-[12rem]">
            <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
              Description
            </span>
            <input
              id="cat-description"
              type="text"
              maxlength="200"
              spellcheck="true"
              autocapitalize="sentences"
              placeholder="What belongs in here"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm"
            />
          </label>
          <button type="submit" class="bb-btn bb-btn-strong">Add</button>
        </form>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { confirmAction } from "../../lib/confirm";
  import { escapeHtml, renderSignature, when, exactly, errorDetail, boardFetch } from "../../lib/board-ui";

  type Category = {
    slug: string;
    name: string;
    description: string | null;
    hidden: boolean;
    audience?: string;
    threadCount: number;
    postCount: number;
    unreadThreads: number;
    lastPostAt: string | null;
    lastPostBy: string | null;
  };

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;
  const banner = document.getElementById("error-banner") as HTMLElement;
  const body = document.getElementById("categories") as HTMLElement;
  const emptyState = document.getElementById("empty-state") as HTMLElement;
  const statsEl = document.getElementById("stats") as HTMLElement;
  const adminTools = document.getElementById("admin-tools") as HTMLElement;
  const adminList = document.getElementById("admin-categories") as HTMLElement;

  let isAdmin = false;

  function showError(message: string) {
    banner.textContent = message;
    banner.classList.remove("hidden");
    loading.classList.add("hidden");
  }

  /** Who can see a room, when it isn't everybody. */
  function audienceLabel(c: Category): string {
    if (c.audience === "admins") return ' <span class="bb-react-count">(admins only)</span>';
    if (c.audience === "moderators") return ' <span class="bb-react-count">(moderators and admins)</span>';
    return "";
  }

  function renderCategories(categories: Category[]) {
    if (!categories.length) {
      body.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }
    emptyState.classList.add("hidden");

    body.innerHTML = categories
      .map((c, index) => {
        const unread = c.unreadThreads > 0;
        // A pin on whichever category sits at the top. It follows the
        // order rather than being a flag of its own, so moving a
        // category up with the Up button moves the pin with it.
        const pin = index === 0
          ? '<span aria-hidden="true" title="Pinned to the top">📌</span> '
          : "";
        // The folder glyph: full when there's something new in it.
        const icon = unread ? "📬" : "📭";
        const last = c.lastPostAt
          ? `<span title="${escapeHtml(exactly(c.lastPostAt))}">${escapeHtml(when(c.lastPostAt))}</span>` +
            `<br /><span>by ${escapeHtml(c.lastPostBy ?? "")}</span>`
          : "<span>No posts yet</span>";

        return `
          <tr class="${unread ? "bb-unread" : ""}">
            <td class="bb-icon">${icon}</td>
            <td>
              ${pin}<a class="bb-title" href="/board/category/?c=${encodeURIComponent(c.slug)}">${escapeHtml(c.name)}</a>
              ${c.hidden ? ' <span class="bb-react-count">(hidden)</span>' : ""}${audienceLabel(c)}
              ${c.description ? `<span class="bb-desc">${escapeHtml(c.description)}</span>` : ""}
              ${unread ? `<span class="bb-desc">${c.unreadThreads} new ${c.unreadThreads === 1 ? "topic" : "topics"}</span>` : ""}
            </td>
            <td class="bb-num bb-hide-small">${c.threadCount}</td>
            <td class="bb-num bb-hide-small">${c.postCount}</td>
            <td class="bb-last">${last}</td>
          </tr>`;
      })
      .join("");
  }

  function renderAdminList(categories: Category[]) {
    adminList.innerHTML = categories
      .map(
        (c) => `
        <tr data-slug="${escapeHtml(c.slug)}">
          <td>
            ${escapeHtml(c.name)}${c.hidden ? ' <span class="bb-react-count">(hidden)</span>' : ""}${audienceLabel(c)}
            <span class="bb-desc">${c.description ? escapeHtml(c.description) : "<em>no subtitle</em>"}</span>
          </td>
          <td style="width: 20rem; white-space: nowrap;">
            <button type="button" class="bb-btn cat-up">Up</button>
            <button type="button" class="bb-btn cat-down">Down</button>
            <button type="button" class="bb-btn cat-edit">Edit</button>
            <button type="button" class="bb-btn cat-hide">${c.hidden ? "Show" : "Hide"}</button>
            ${c.slug === "moderation" || c.slug === "admin" ? "" : '<button type="button" class="bb-btn bb-btn-danger cat-delete">Delete</button>'}
          </td>
        </tr>`,
      )
      .join("");
  }

  async function patchCategory(slug: string, updates: Record<string, unknown>) {
    const res = await boardFetch("/api/board/categories", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ slug, ...updates }),
    });
    if (!res) return false;
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't save that (${res.status}).`);
      return false;
    }
    return true;
  }

  // Reordering swaps two neighbours, so nobody has to think in numbers.
  async function move(slug: string, direction: -1 | 1, categories: Category[]) {
    const index = categories.findIndex((c) => c.slug === slug);
    const swapWith = index + direction;
    if (index < 0 || swapWith < 0 || swapWith >= categories.length) return;

    const a = categories[index];
    const b = categories[swapWith];
    const positionOf = (i: number) => (i + 1) * 10;

    if (!(await patchCategory(a.slug, { position: positionOf(swapWith) }))) return;
    if (!(await patchCategory(b.slug, { position: positionOf(index) }))) return;
    await load();
  }

  async function load() {
    const res = await boardFetch("/api/board");
    if (!res) return;

    if (res.status === 403) {
      showError(
        (await errorDetail(res)) ||
          "The parish board opens up when Father receives you as a catechumen.",
      );
      return;
    }
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't load the board (${res.status}).`);
      return;
    }

    const data = await res.json();
    const categories: Category[] = data.categories ?? [];
    isAdmin = !!data.viewer?.isAdmin;

    renderCategories(categories);

    (document.getElementById("you-name") as HTMLElement).textContent =
      data.viewer?.displayName ?? "";
    (document.getElementById("you-rank") as HTMLElement).textContent = data.viewer?.rank ?? "";
    (document.getElementById("you-unread") as HTMLElement).innerHTML =
      data.unreadTotal > 0
        ? `<strong>${data.unreadTotal}</strong> ${data.unreadTotal === 1 ? "topic has" : "topics have"} something new.`
        : "You're caught up.";

    const unreadMessages = data.unreadMessages ?? 0;
    (document.getElementById("messages-link") as HTMLElement).innerHTML =
      unreadMessages > 0
        ? `Messages <span class="bb-flag">${unreadMessages} new</span>`
        : "Messages";

    const notes: Array<{ id: string; title: string; room: string }> = data.announcements ?? [];
    (document.getElementById("announcements") as HTMLElement).classList.toggle("hidden", notes.length === 0);
    (document.getElementById("announcement-list") as HTMLElement).innerHTML = notes
      .map(
        (n) =>
          `<li><a class="underline" href="/board/thread/?id=${encodeURIComponent(n.id)}">${escapeHtml(n.title)}</a> <span class="text-text-secondary">in ${escapeHtml(n.room)}</span></li>`,
      )
      .join("");

    renderToday(data.celebrations ?? []);

    const unreadMentions = data.unreadMentions ?? 0;
    (document.getElementById("mentions-link") as HTMLElement).innerHTML =
      unreadMentions > 0
        ? `Mentions <span class="bb-flag">${unreadMentions} new</span>`
        : "Mentions";

    const s = data.stats ?? {};
    statsEl.innerHTML =
      `<strong>${s.posts ?? 0}</strong> ${s.posts === 1 ? "post" : "posts"} in ` +
      `<strong>${s.topics ?? 0}</strong> ${s.topics === 1 ? "topic" : "topics"} &middot; ` +
      `<strong>${s.members ?? 0}</strong> ${s.members === 1 ? "person" : "people"} can post here` +
      (s.newestMember ? ` &middot; newest is <strong>${escapeHtml(s.newestMember)}</strong>` : "");

    if (data.viewer?.isModerator) loadSuspended();
    if (data.viewer?.suspension) {
      const s = data.viewer.suspension;
      (document.getElementById("you-unread") as HTMLElement).insertAdjacentHTML(
        "beforeend",
        `<p class="mt-2"><strong>You're suspended from posting${s.until ? " until " + escapeHtml(new Date(s.until).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })) : ""}.</strong> You can still read.</p>`,
      );
    }

    if (isAdmin) {
      adminTools.classList.remove("hidden");
      renderAdminList(categories);
      loadModerators();
      loadMembers();
    }

    adminList.onclick = async (event) => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      const slug = (button.closest("tr") as HTMLElement | null)?.dataset.slug;
      if (!slug) return;
      const category = categories.find((c) => c.slug === slug);
      if (!category) return;

      if (button.classList.contains("cat-up")) return move(slug, -1, categories);
      if (button.classList.contains("cat-down")) return move(slug, 1, categories);

      if (button.classList.contains("cat-hide")) {
        if (await patchCategory(slug, { hidden: !category.hidden })) await load();
        return;
      }

      if (button.classList.contains("cat-edit")) {
        // Both the name and the line underneath it, edited in place.
        // A browser prompt() freezes the page the way confirm() did,
        // and we took those out.
        const row = button.closest("tr") as HTMLElement;
        const cell = row.firstElementChild as HTMLElement;
        cell.innerHTML = `
          <input type="text" maxlength="80" value="${escapeHtml(category.name)}"
                 aria-label="Category name" spellcheck="true"
                 class="cat-name-input w-full border border-border-soft bg-cream-bg px-2 py-1 text-sm" />
          <input type="text" maxlength="200" value="${escapeHtml(category.description ?? "")}"
                 aria-label="Subtitle" spellcheck="true" autocapitalize="sentences" placeholder="Subtitle — the line under the name"
                 class="cat-desc-input mt-1 w-full border border-border-soft bg-cream-bg px-2 py-1 text-xs" />
          <span class="mt-1 inline-flex gap-1">
            <button type="button" class="bb-btn bb-btn-strong cat-save">Save</button>
            <button type="button" class="bb-btn cat-cancel">Cancel</button>
          </span>`;

        const nameInput = cell.querySelector(".cat-name-input") as HTMLInputElement;
        const descInput = cell.querySelector(".cat-desc-input") as HTMLInputElement;
        nameInput.focus();
        nameInput.select();

        const save = async () => {
          const name = nameInput.value.trim();
          if (!name) {
            showError("A category needs a name.");
            return;
          }
          // Sent together so one save can't leave the name changed and
          // the subtitle not. An empty subtitle clears it.
          if (await patchCategory(slug, { name, description: descInput.value.trim() })) {
            await load();
          }
        };

        (cell.querySelector(".cat-save") as HTMLElement).onclick = save;
        (cell.querySelector(".cat-cancel") as HTMLElement).onclick = () => load();
        for (const input of [nameInput, descInput]) {
          input.onkeydown = (e) => {
            if (e.key === "Enter") { e.preventDefault(); save(); }
            if (e.key === "Escape") load();
          };
        }
        return;
      }

      if (button.classList.contains("cat-delete")) {
        const goAhead = await confirmAction({
          message:
            category.threadCount > 0
              ? `Delete "${category.name}"? It holds ${category.threadCount} ` +
                `${category.threadCount === 1 ? "topic" : "topics"}, and they go with it ` +
                `along with every reply. Hide it instead if you only want it off the board.`
              : `Delete "${category.name}"? It's empty, so nothing written is lost.`,
          confirmLabel: "Delete it",
          cancelLabel: "Keep it",
          danger: true,
        });
        if (!goAhead) return;

        const res = await boardFetch(
          `/api/board/categories?slug=${encodeURIComponent(slug)}&confirm=yes`,
          { method: "DELETE" },
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
          return;
        }
        await load();
      }
    };

    loading.classList.add("hidden");
    banner.classList.add("hidden");
    content.classList.remove("hidden");
  }

  // "Mark all topics read" — opens nothing, just moves every marker to now.
  (document.getElementById("mark-all-read") as HTMLAnchorElement).addEventListener(
    "click",
    async (event) => {
      event.preventDefault();
      const res = await boardFetch("/api/board/read", { method: "POST" });
      if (!res) return;
      if (!res.ok) {
        showError((await errorDetail(res)) || `Couldn't do that (${res.status}).`);
        return;
      }
      await load();
    },
  );

  (document.getElementById("new-category") as HTMLFormElement)?.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();
      const nameInput = document.getElementById("cat-name") as HTMLInputElement;
      const descInput = document.getElementById("cat-description") as HTMLInputElement;
      const name = nameInput.value.trim();
      if (!name) return;

      const res = await boardFetch("/api/board/categories", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, description: descInput.value.trim() || null }),
      });
      if (!res) return;
      if (!res.ok) {
        showError((await errorDetail(res)) || `Couldn't add that (${res.status}).`);
        return;
      }
      nameInput.value = "";
      descInput.value = "";
      await load();
    },
  );

  // ---- moderators (admins only) ------------------------------------------
  const modTools = document.getElementById("mod-tools") as HTMLElement;
  const modList = document.getElementById("moderator-list") as HTMLElement;
  const modPick = document.getElementById("moderator-pick") as HTMLSelectElement;
  const modStatus = document.getElementById("moderator-status") as HTMLElement;

  // ---- today's feast, and who has a special day ----
  async function renderToday(list: Array<{ name: string; what: string; when: string }>) {
    const box = document.getElementById("today") as HTMLElement;
    const feast = document.getElementById("today-feast") as HTMLElement;
    const ul = document.getElementById("today-list") as HTMLElement;

    let feastText = "";
    try {
      const parts = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Chicago" }).format(new Date());
      const res = await fetch(`/api/calendar?date=${parts}`, { cache: "no-store" });
      if (res.ok) {
        const cal = await res.json();
        const names: string[] = (cal.saints ?? []).map((s: { name: string }) => s.name).slice(0, 2);
        feastText = names.length ? `Today: ${names.join(" · ")}` : "";
      }
    } catch {
      feastText = "";
    }
    feast.textContent = feastText;
    ul.innerHTML = list
      .map(
        (c) =>
          `<li>${c.when === "Today" ? "🎉" : "•"} <strong>${escapeHtml(c.name)}</strong> — ${escapeHtml(c.what)}${c.when === "Today" ? " today" : `, ${escapeHtml(c.when)}`}</li>`,
      )
      .join("");
    box.classList.toggle("hidden", !feastText && list.length === 0);
  }

  // ---- my special days ----
  const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const pairs: Array<[string, string]> = [["nd-month", "nd-day"], ["bp-month", "bp-day"], ["bd-month", "bd-day"]];
  for (const [m, d] of pairs) {
    (document.getElementById(m) as HTMLSelectElement).innerHTML =
      `<option value="">Month</option>` + MONTHS.map((n, i) => `<option value="${i + 1}">${n}</option>`).join("");
    (document.getElementById(d) as HTMLSelectElement).innerHTML =
      `<option value="">Day</option>` + Array.from({ length: 31 }, (_, i) => `<option value="${i + 1}">${i + 1}</option>`).join("");
  }
  const datesForm = document.getElementById("dates-form") as HTMLFormElement;
  const datesStatus = document.getElementById("dates-status") as HTMLElement;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
  const setVal = (id: string, v: string | number | undefined) => {
    (document.getElementById(id) as HTMLInputElement).value = v === undefined ? "" : String(v);
  };
  const dayOf = (m: string, d: string) =>
    val(m) && val(d) ? { month: Number(val(m)), day: Number(val(d)) } : null;

  async function loadDates() {
    const res = await boardFetch("/api/board/dates", {}, here);
    if (!res || !res.ok) return;
    const d = await res.json();
    setVal("nd-month", d.nameDay?.month); setVal("nd-day", d.nameDay?.day); setVal("nd-saint", d.nameDay?.saint);
    setVal("bp-month", d.baptism?.month); setVal("bp-day", d.baptism?.day);
    setVal("bd-month", d.birthday?.month); setVal("bd-day", d.birthday?.day);
  }
  document.getElementById("dates-edit")?.addEventListener("click", (e) => {
    e.preventDefault();
    datesForm.classList.toggle("hidden");
  });
  document.getElementById("dates-cancel")?.addEventListener("click", () => datesForm.classList.add("hidden"));
  datesForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    datesStatus.textContent = "Saving…";
    const nd = dayOf("nd-month", "nd-day");
    const res = await boardFetch(
      "/api/board/dates",
      {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nameDay: nd ? { ...nd, saint: val("nd-saint") } : null,
          baptism: dayOf("bp-month", "bp-day"),
          birthday: dayOf("bd-month", "bd-day"),
        }),
      },
      here,
    );
    if (!res) return;
    if (!res.ok) {
      datesStatus.textContent = (await errorDetail(res)) || `Couldn't save that (${res.status}).`;
      return;
    }
    datesStatus.textContent = "";
    (document.getElementById("dates-saved") as HTMLElement).textContent = "Saved. It shows on the board on the day.";
    datesForm.classList.add("hidden");
    await load();
  });
  loadDates();

  // ---- the roll of board members (admins) ----
  async function loadMembers() {
    const res = await boardFetch("/api/board/members", {}, here);
    if (!res || !res.ok) return;
    const members: Array<{ id: string; name: string; rank: string; joined: string; posts: number; suspended: boolean }> =
      (await res.json()).members ?? [];
    (document.getElementById("member-count") as HTMLElement).textContent = String(members.length);
    (document.getElementById("member-list") as HTMLElement).innerHTML = members
      .map(
        (m) => `
        <tr>
          <td>
            <a class="bb-title" href="/board/profile/?id=${encodeURIComponent(m.id)}">${escapeHtml(m.name)}</a>
            ${m.suspended ? '<span class="bb-flag">Suspended</span>' : ""}
          </td>
          <td>${escapeHtml(m.rank)}</td>
          <td class="bb-hide-small">${escapeHtml(new Date(m.joined).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }))}</td>
          <td class="bb-num">${m.posts}</td>
        </tr>`,
      )
      .join("");
  }

  async function loadSuspended() {
    const box = document.getElementById("suspended-box") as HTMLElement;
    const list = document.getElementById("suspended-list") as HTMLElement;
    const res = await boardFetch("/api/board/suspend", {}, here);
    if (!res || !res.ok) return;
    const rows: Array<{ id: string; name: string; until: string | null; reason: string | null }> =
      (await res.json()).suspended ?? [];
    box.classList.toggle("hidden", rows.length === 0);
    list.innerHTML = rows
      .map(
        (r) => `
        <li>
          <strong>${escapeHtml(r.name)}</strong>
          ${r.until ? `until ${escapeHtml(new Date(r.until).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }))}` : "until lifted"}
          ${r.reason ? `<span class="text-text-secondary">(${escapeHtml(r.reason)})</span>` : ""}
          <button type="button" class="bb-btn lift-suspension" data-id="${escapeHtml(r.id)}">Lift</button>
        </li>`,
      )
      .join("");
  }

  document.getElementById("suspended-list")?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest(".lift-suspension") as HTMLElement | null;
    if (!button?.dataset.id) return;
    const res = await boardFetch(
      `/api/board/suspend?userId=${encodeURIComponent(button.dataset.id)}`,
      { method: "DELETE" },
      here,
    );
    if (res?.ok) await loadSuspended();
  });

  async function loadModerators() {
    const res = await boardFetch("/api/board/moderators");
    if (!res || !res.ok) return;
    const data = await res.json();
    modTools.classList.remove("hidden");

    modList.innerHTML = data.moderators.length
      ? data.moderators
          .map(
            (m: { id: string; name: string }) => `
          <tr data-user="${escapeHtml(m.id)}">
            <td>${escapeHtml(m.name)}</td>
            <td style="width: 8rem;"><button type="button" class="bb-btn bb-btn-danger mod-remove">Remove</button></td>
          </tr>`,
          )
          .join("")
      : '<tr><td colspan="2"><em>No moderators yet. You\'re the only one.</em></td></tr>';

    modPick.innerHTML =
      '<option value="">Choose a person…</option>' +
      data.candidates
        .map(
          (p: { id: string; name: string; role: string }) =>
            `<option value="${escapeHtml(p.id)}">${escapeHtml(p.name)} (${escapeHtml(p.role)})</option>`,
        )
        .join("");
  }

  modList.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest(".mod-remove");
    const row = button?.closest("tr") as HTMLElement | null;
    if (!button || !row?.dataset.user) return;
    const name = row.firstElementChild?.textContent ?? "this person";
    const goAhead = await confirmAction({
      message: `Take moderator powers away from ${name}? They stay a member, and nothing they've written is touched.`,
      confirmLabel: "Remove",
      cancelLabel: "Keep them",
      danger: true,
    });
    if (!goAhead) return;
    const res = await boardFetch(
      `/api/board/moderators?userId=${encodeURIComponent(row.dataset.user)}`,
      { method: "DELETE" },
    );
    if (!res) return;
    if (!res.ok) {
      modStatus.textContent = (await errorDetail(res)) || `Couldn't do that (${res.status}).`;
      return;
    }
    modStatus.textContent = `${name} is no longer a moderator.`;
    await loadModerators();
  });

  (document.getElementById("add-moderator") as HTMLFormElement).addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();
      if (!modPick.value) {
        modStatus.textContent = "Choose a person first.";
        return;
      }
      const name = modPick.selectedOptions[0]?.textContent?.replace(/ \(.*\)$/, "") ?? "They";
      const res = await boardFetch("/api/board/moderators", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId: modPick.value }),
      });
      if (!res) return;
      if (!res.ok) {
        modStatus.textContent = (await errorDetail(res)) || `Couldn't do that (${res.status}).`;
        return;
      }
      modStatus.textContent = `${name} is now a moderator.`;
      await loadModerators();
    },
  );

  // ---- my signature -------------------------------------------------------
  const sigPreview = document.getElementById("sig-preview") as HTMLElement;
  const sigEdit = document.getElementById("sig-edit") as HTMLAnchorElement;
  const sigForm = document.getElementById("sig-form") as HTMLFormElement;
  const sigBody = document.getElementById("sig-body") as HTMLTextAreaElement;
  const sigCount = document.getElementById("sig-count") as HTMLElement;
  const sigStatus = document.getElementById("sig-status") as HTMLElement;
  let savedSignature = "";

  function showSignature() {
    sigPreview.innerHTML = renderSignature(savedSignature);
    sigPreview.classList.toggle("hidden", !savedSignature);
    sigEdit.textContent = savedSignature ? "Change my signature" : "Add a signature";
  }

  function closeSignatureForm() {
    sigForm.classList.add("hidden");
    sigEdit.classList.remove("hidden");
  }

  function updateCount() {
    const lines = sigBody.value.replace(/\r\n/g, "\n").trim().split("\n").length;
    sigCount.textContent = `${sigBody.value.length} / 300 · ${sigBody.value.trim() ? lines : 0} of 4 lines`;
  }

  async function loadSignature() {
    const res = await boardFetch("/api/board/signature");
    if (!res || !res.ok) return;
    const data = await res.json();
    savedSignature = typeof data.signature === "string" ? data.signature : "";
    showSignature();
  }

  sigEdit.addEventListener("click", (event) => {
    event.preventDefault();
    sigBody.value = savedSignature;
    sigStatus.textContent = "";
    updateCount();
    sigForm.classList.remove("hidden");
    sigEdit.classList.add("hidden");
    sigBody.focus();
  });
  sigBody.addEventListener("input", updateCount);
  (document.getElementById("sig-cancel") as HTMLButtonElement).addEventListener(
    "click",
    closeSignatureForm,
  );

  sigForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const save = document.getElementById("sig-save") as HTMLButtonElement;
    save.disabled = true;
    sigStatus.textContent = "Saving…";

    const res = await boardFetch("/api/board/signature", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ body: sigBody.value }),
    });
    save.disabled = false;
    if (!res) return;
    if (!res.ok) {
      sigStatus.textContent = (await errorDetail(res)) || `Couldn't save that (${res.status}).`;
      return;
    }

    const data = await res.json();
    savedSignature = typeof data.signature === "string" ? data.signature : "";
    showSignature();
    closeSignatureForm();
    // A confirmation that outlives the form closing.
    sigPreview.insertAdjacentHTML(
      "afterend",
      `<span id="sig-done" class="bb-sig-count" role="status">${
        savedSignature
          ? "Saved. It now goes under every post you write, old ones included."
          : "Removed. Your posts have no signature now."
      }</span>`,
    );
    setTimeout(() => document.getElementById("sig-done")?.remove(), 6000);
  });

  load();
  loadSignature();
</script>
