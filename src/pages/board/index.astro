---
import Layout from "../../layouts/Layout.astro";
import "../../styles/board.css";
---

<Layout
  title="Parish Board"
  description="Somewhere for the parish to talk — the book club, the kitchen, Scripture and the faith."
>
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-1">Parish Board</h1>
    <p class="text-text-secondary text-sm mb-4">
      Pick a room and see what people are talking about.
    </p>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>

    <div
      id="error-banner"
      class="hidden border border-liturgical-red bg-cream-card p-4 mb-6 text-sm"
      role="alert"
    >
    </div>

    <div id="content" class="hidden">
      <div class="bb-layout">
        <div>
          <table class="bb-table">
            <thead>
              <tr>
                <th colspan="2">Forum</th>
                <th class="bb-num bb-hide-small">Topics</th>
                <th class="bb-num bb-hide-small">Posts</th>
                <th class="bb-last">Last Post</th>
              </tr>
            </thead>
            <tbody id="categories"></tbody>
          </table>

          <p id="empty-state" class="hidden text-center text-text-secondary italic mt-8">
            No categories yet.
          </p>

          <div id="stats" class="bb-stats"></div>
        </div>

        <!-- Your own corner, the way a board always had one. -->
        <aside class="bb-panel" id="you-panel">
          <h2>Your Account</h2>
          <div class="bb-panel-body">
            <span class="bb-panel-you" id="you-name">—</span>
            <span id="you-rank"></span>
            <div id="you-unread" class="mt-2"></div>
          </div>
          <div class="bb-panel-links">
            <a href="/account/">My Account</a>
            <a href="/directory/">Parish Directory</a>
            <a href="/learn/library/">Parish Library</a>
            <a href="#" id="mark-all-read">Mark all topics read</a>
          </div>
        </aside>
      </div>

      <!-- Admin: arrange the rooms -->
      <section id="admin-tools" class="hidden mt-10">
        <table class="bb-table">
          <thead>
            <tr><th colspan="2">Manage Categories</th></tr>
          </thead>
          <tbody id="admin-categories"></tbody>
        </table>

        <form id="new-category" class="flex flex-wrap gap-2 items-end mt-3">
          <label class="flex-1 min-w-[10rem]">
            <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
              New category
            </span>
            <input
              id="cat-name"
              type="text"
              maxlength="80"
              spellcheck="true"
              placeholder="Parish Life"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm"
            />
          </label>
          <label class="flex-1 min-w-[12rem]">
            <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
              Description
            </span>
            <input
              id="cat-description"
              type="text"
              maxlength="200"
              spellcheck="true"
              autocapitalize="sentences"
              placeholder="What belongs in here"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm"
            />
          </label>
          <button type="submit" class="bb-btn bb-btn-strong">Add</button>
        </form>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { confirmAction } from "../../lib/confirm";
  import { escapeHtml, when, exactly, errorDetail, boardFetch } from "../../lib/board-ui";

  type Category = {
    slug: string;
    name: string;
    description: string | null;
    hidden: boolean;
    threadCount: number;
    postCount: number;
    unreadThreads: number;
    lastPostAt: string | null;
    lastPostBy: string | null;
  };

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;
  const banner = document.getElementById("error-banner") as HTMLElement;
  const body = document.getElementById("categories") as HTMLElement;
  const emptyState = document.getElementById("empty-state") as HTMLElement;
  const statsEl = document.getElementById("stats") as HTMLElement;
  const adminTools = document.getElementById("admin-tools") as HTMLElement;
  const adminList = document.getElementById("admin-categories") as HTMLElement;

  let isAdmin = false;

  function showError(message: string) {
    banner.textContent = message;
    banner.classList.remove("hidden");
    loading.classList.add("hidden");
  }

  function renderCategories(categories: Category[]) {
    if (!categories.length) {
      body.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }
    emptyState.classList.add("hidden");

    body.innerHTML = categories
      .map((c, index) => {
        const unread = c.unreadThreads > 0;
        // A pin on whichever category sits at the top. It follows the
        // order rather than being a flag of its own, so moving a
        // category up with the Up button moves the pin with it.
        const pin = index === 0
          ? '<span aria-hidden="true" title="Pinned to the top">📌</span> '
          : "";
        // The folder glyph: full when there's something new in it.
        const icon = unread ? "📬" : "📭";
        const last = c.lastPostAt
          ? `<span title="${escapeHtml(exactly(c.lastPostAt))}">${escapeHtml(when(c.lastPostAt))}</span>` +
            `<br /><span>by ${escapeHtml(c.lastPostBy ?? "")}</span>`
          : "<span>No posts yet</span>";

        return `
          <tr class="${unread ? "bb-unread" : ""}">
            <td class="bb-icon">${icon}</td>
            <td>
              ${pin}<a class="bb-title" href="/board/category/?c=${encodeURIComponent(c.slug)}">${escapeHtml(c.name)}</a>
              ${c.hidden ? ' <span class="bb-react-count">(hidden)</span>' : ""}
              ${c.description ? `<span class="bb-desc">${escapeHtml(c.description)}</span>` : ""}
              ${unread ? `<span class="bb-desc">${c.unreadThreads} new ${c.unreadThreads === 1 ? "topic" : "topics"}</span>` : ""}
            </td>
            <td class="bb-num bb-hide-small">${c.threadCount}</td>
            <td class="bb-num bb-hide-small">${c.postCount}</td>
            <td class="bb-last">${last}</td>
          </tr>`;
      })
      .join("");
  }

  function renderAdminList(categories: Category[]) {
    adminList.innerHTML = categories
      .map(
        (c) => `
        <tr data-slug="${escapeHtml(c.slug)}">
          <td>
            ${escapeHtml(c.name)}${c.hidden ? ' <span class="bb-react-count">(hidden)</span>' : ""}
            <span class="bb-desc">${c.description ? escapeHtml(c.description) : "<em>no subtitle</em>"}</span>
          </td>
          <td style="width: 20rem; white-space: nowrap;">
            <button type="button" class="bb-btn cat-up">Up</button>
            <button type="button" class="bb-btn cat-down">Down</button>
            <button type="button" class="bb-btn cat-edit">Edit</button>
            <button type="button" class="bb-btn cat-hide">${c.hidden ? "Show" : "Hide"}</button>
            <button type="button" class="bb-btn bb-btn-danger cat-delete">Delete</button>
          </td>
        </tr>`,
      )
      .join("");
  }

  async function patchCategory(slug: string, updates: Record<string, unknown>) {
    const res = await boardFetch("/api/board/categories", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ slug, ...updates }),
    });
    if (!res) return false;
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't save that (${res.status}).`);
      return false;
    }
    return true;
  }

  // Reordering swaps two neighbours, so nobody has to think in numbers.
  async function move(slug: string, direction: -1 | 1, categories: Category[]) {
    const index = categories.findIndex((c) => c.slug === slug);
    const swapWith = index + direction;
    if (index < 0 || swapWith < 0 || swapWith >= categories.length) return;

    const a = categories[index];
    const b = categories[swapWith];
    const positionOf = (i: number) => (i + 1) * 10;

    if (!(await patchCategory(a.slug, { position: positionOf(swapWith) }))) return;
    if (!(await patchCategory(b.slug, { position: positionOf(index) }))) return;
    await load();
  }

  async function load() {
    const res = await boardFetch("/api/board");
    if (!res) return;

    if (res.status === 403) {
      showError(
        (await errorDetail(res)) ||
          "The parish board opens up when Father receives you as a catechumen.",
      );
      return;
    }
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't load the board (${res.status}).`);
      return;
    }

    const data = await res.json();
    const categories: Category[] = data.categories ?? [];
    isAdmin = !!data.viewer?.isAdmin;

    renderCategories(categories);

    (document.getElementById("you-name") as HTMLElement).textContent =
      data.viewer?.displayName ?? "";
    (document.getElementById("you-rank") as HTMLElement).textContent = data.viewer?.rank ?? "";
    (document.getElementById("you-unread") as HTMLElement).innerHTML =
      data.unreadTotal > 0
        ? `<strong>${data.unreadTotal}</strong> ${data.unreadTotal === 1 ? "topic has" : "topics have"} something new.`
        : "You're caught up.";

    const s = data.stats ?? {};
    statsEl.innerHTML =
      `<strong>${s.posts ?? 0}</strong> ${s.posts === 1 ? "post" : "posts"} in ` +
      `<strong>${s.topics ?? 0}</strong> ${s.topics === 1 ? "topic" : "topics"} &middot; ` +
      `<strong>${s.members ?? 0}</strong> ${s.members === 1 ? "person" : "people"} can post here` +
      (s.newestMember ? ` &middot; newest is <strong>${escapeHtml(s.newestMember)}</strong>` : "");

    if (isAdmin) {
      adminTools.classList.remove("hidden");
      renderAdminList(categories);
    }

    adminList.onclick = async (event) => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      const slug = (button.closest("tr") as HTMLElement | null)?.dataset.slug;
      if (!slug) return;
      const category = categories.find((c) => c.slug === slug);
      if (!category) return;

      if (button.classList.contains("cat-up")) return move(slug, -1, categories);
      if (button.classList.contains("cat-down")) return move(slug, 1, categories);

      if (button.classList.contains("cat-hide")) {
        if (await patchCategory(slug, { hidden: !category.hidden })) await load();
        return;
      }

      if (button.classList.contains("cat-edit")) {
        // Both the name and the line underneath it, edited in place.
        // A browser prompt() freezes the page the way confirm() did,
        // and we took those out.
        const row = button.closest("tr") as HTMLElement;
        const cell = row.firstElementChild as HTMLElement;
        cell.innerHTML = `
          <input type="text" maxlength="80" value="${escapeHtml(category.name)}"
                 aria-label="Category name" spellcheck="true"
                 class="cat-name-input w-full border border-border-soft bg-cream-bg px-2 py-1 text-sm" />
          <input type="text" maxlength="200" value="${escapeHtml(category.description ?? "")}"
                 aria-label="Subtitle" spellcheck="true" autocapitalize="sentences" placeholder="Subtitle — the line under the name"
                 class="cat-desc-input mt-1 w-full border border-border-soft bg-cream-bg px-2 py-1 text-xs" />
          <span class="mt-1 inline-flex gap-1">
            <button type="button" class="bb-btn bb-btn-strong cat-save">Save</button>
            <button type="button" class="bb-btn cat-cancel">Cancel</button>
          </span>`;

        const nameInput = cell.querySelector(".cat-name-input") as HTMLInputElement;
        const descInput = cell.querySelector(".cat-desc-input") as HTMLInputElement;
        nameInput.focus();
        nameInput.select();

        const save = async () => {
          const name = nameInput.value.trim();
          if (!name) {
            showError("A category needs a name.");
            return;
          }
          // Sent together so one save can't leave the name changed and
          // the subtitle not. An empty subtitle clears it.
          if (await patchCategory(slug, { name, description: descInput.value.trim() })) {
            await load();
          }
        };

        (cell.querySelector(".cat-save") as HTMLElement).onclick = save;
        (cell.querySelector(".cat-cancel") as HTMLElement).onclick = () => load();
        for (const input of [nameInput, descInput]) {
          input.onkeydown = (e) => {
            if (e.key === "Enter") { e.preventDefault(); save(); }
            if (e.key === "Escape") load();
          };
        }
        return;
      }

      if (button.classList.contains("cat-delete")) {
        const goAhead = await confirmAction({
          message:
            category.threadCount > 0
              ? `Delete "${category.name}"? It holds ${category.threadCount} ` +
                `${category.threadCount === 1 ? "topic" : "topics"}, and they go with it ` +
                `along with every reply. Hide it instead if you only want it off the board.`
              : `Delete "${category.name}"? It's empty, so nothing written is lost.`,
          confirmLabel: "Delete it",
          cancelLabel: "Keep it",
          danger: true,
        });
        if (!goAhead) return;

        const res = await boardFetch(
          `/api/board/categories?slug=${encodeURIComponent(slug)}&confirm=yes`,
          { method: "DELETE" },
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
          return;
        }
        await load();
      }
    };

    loading.classList.add("hidden");
    banner.classList.add("hidden");
    content.classList.remove("hidden");
  }

  // "Mark all topics read" — opens nothing, just moves every marker to now.
  (document.getElementById("mark-all-read") as HTMLAnchorElement).addEventListener(
    "click",
    async (event) => {
      event.preventDefault();
      const res = await boardFetch("/api/board/read", { method: "POST" });
      if (!res) return;
      if (!res.ok) {
        showError((await errorDetail(res)) || `Couldn't do that (${res.status}).`);
        return;
      }
      await load();
    },
  );

  (document.getElementById("new-category") as HTMLFormElement)?.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();
      const nameInput = document.getElementById("cat-name") as HTMLInputElement;
      const descInput = document.getElementById("cat-description") as HTMLInputElement;
      const name = nameInput.value.trim();
      if (!name) return;

      const res = await boardFetch("/api/board/categories", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, description: descInput.value.trim() || null }),
      });
      if (!res) return;
      if (!res.ok) {
        showError((await errorDetail(res)) || `Couldn't add that (${res.status}).`);
        return;
      }
      nameInput.value = "";
      descInput.value = "";
      await load();
    },
  );

  load();
</script>
