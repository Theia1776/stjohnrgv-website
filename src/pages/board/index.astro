---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Parish Board"
  description="Somewhere for the parish to talk — the book club, the kitchen, Scripture and the faith."
>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">Parish Board</h1>
    <p class="text-text-secondary mb-8">
      Pick a category and see what people are talking about. Anything new since
      you last looked shows in bold.
    </p>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>

    <div
      id="error-banner"
      class="hidden border border-liturgical-red bg-cream-card p-4 mb-6 text-sm"
      role="alert"
    >
    </div>

    <div id="content" class="hidden">
      <ul id="categories" class="space-y-3"></ul>

      <p id="empty-state" class="hidden text-center text-text-secondary italic mt-8">
        No categories yet.
      </p>

      <!-- Admin: arrange the headings -->
      <section id="admin-tools" class="hidden mt-12 border-t border-border-soft pt-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-text-secondary mb-3">
          Categories
        </h2>
        <p class="text-sm text-text-secondary mb-4">
          Yours to arrange. Hiding a category takes it off the board for everyone
          else without deleting anything in it.
        </p>

        <form id="new-category" class="flex flex-wrap gap-2 items-end mb-6">
          <label class="flex-1 min-w-[12rem]">
            <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
              New category
            </span>
            <input
              id="cat-name"
              type="text"
              maxlength="80"
              placeholder="Parish Life"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm"
            />
          </label>
          <label class="flex-1 min-w-[14rem]">
            <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
              Description <span class="normal-case tracking-normal">(optional)</span>
            </span>
            <input
              id="cat-description"
              type="text"
              maxlength="200"
              placeholder="What belongs in here"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm"
            />
          </label>
          <button type="submit" class="btn btn-primary">Add</button>
        </form>

        <ul id="admin-categories" class="space-y-2 text-sm"></ul>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { confirmAction } from "../../lib/confirm";
  import { escapeHtml, when, exactly, errorDetail, boardFetch } from "../../lib/board-ui";

  type Category = {
    slug: string;
    name: string;
    description: string | null;
    hidden: boolean;
    threadCount: number;
    postCount: number;
    unreadThreads: number;
    lastPostAt: string | null;
  };

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;
  const banner = document.getElementById("error-banner") as HTMLElement;
  const list = document.getElementById("categories") as HTMLElement;
  const emptyState = document.getElementById("empty-state") as HTMLElement;
  const adminTools = document.getElementById("admin-tools") as HTMLElement;
  const adminList = document.getElementById("admin-categories") as HTMLElement;

  let isAdmin = false;

  function showError(message: string) {
    banner.textContent = message;
    banner.classList.remove("hidden");
    loading.classList.add("hidden");
  }

  function renderCategories(categories: Category[]) {
    if (!categories.length) {
      list.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }
    emptyState.classList.add("hidden");

    list.innerHTML = categories
      .map((c) => {
        const unread = c.unreadThreads > 0;
        const activity = c.lastPostAt
          ? `<span title="${escapeHtml(exactly(c.lastPostAt))}">Last post ${escapeHtml(when(c.lastPostAt))}</span>`
          : "<span>No posts yet</span>";
        const threads = `${c.threadCount} ${c.threadCount === 1 ? "thread" : "threads"}`;
        const newBadge = unread
          ? `<span class="shrink-0 bg-brand-blue text-cream-card text-xs px-2 py-0.5">${c.unreadThreads} new</span>`
          : "";
        const hiddenNote = c.hidden
          ? '<span class="shrink-0 border border-border-soft text-xs px-2 py-0.5 text-text-secondary">Hidden</span>'
          : "";

        return `
          <li>
            <a href="/board/category/?c=${encodeURIComponent(c.slug)}"
               class="block border border-border-soft bg-cream-card p-4 no-underline hover:bg-brand-blue-pale/40">
              <span class="flex items-start justify-between gap-3">
                <span class="${unread ? "font-bold" : "font-semibold"} text-text-primary">
                  ${escapeHtml(c.name)}
                </span>
                <span class="flex items-center gap-2">${newBadge}${hiddenNote}</span>
              </span>
              ${c.description ? `<span class="block text-sm text-text-secondary mt-1">${escapeHtml(c.description)}</span>` : ""}
              <span class="block text-xs text-text-secondary mt-2">${threads} &middot; ${activity}</span>
            </a>
          </li>
        `;
      })
      .join("");
  }

  function renderAdminList(categories: Category[]) {
    adminList.innerHTML = categories
      .map(
        (c) => `
        <li class="flex flex-wrap items-center gap-2 border border-border-soft bg-cream-card px-3 py-2"
            data-slug="${escapeHtml(c.slug)}">
          <span class="flex-1 min-w-[8rem] ${c.hidden ? "text-text-secondary italic" : ""}">
            ${escapeHtml(c.name)}${c.hidden ? " (hidden)" : ""}
          </span>
          <button type="button" class="btn btn-secondary text-xs cat-up">Up</button>
          <button type="button" class="btn btn-secondary text-xs cat-down">Down</button>
          <button type="button" class="btn btn-secondary text-xs cat-rename">Rename</button>
          <button type="button" class="btn btn-secondary text-xs cat-hide">
            ${c.hidden ? "Show" : "Hide"}
          </button>
          <button type="button" class="btn btn-secondary text-xs cat-delete">Delete</button>
        </li>`,
      )
      .join("");
  }

  async function patchCategory(slug: string, updates: Record<string, unknown>) {
    const res = await boardFetch("/api/board/categories", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ slug, ...updates }),
    });
    if (!res) return false;
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't save that (${res.status}).`);
      return false;
    }
    return true;
  }

  // Reordering works on the list as shown: swapping two neighbours'
  // positions, rather than asking anybody to think in numbers.
  async function move(slug: string, direction: -1 | 1, categories: Category[]) {
    const index = categories.findIndex((c) => c.slug === slug);
    const swapWith = index + direction;
    if (index < 0 || swapWith < 0 || swapWith >= categories.length) return;

    const a = categories[index];
    const b = categories[swapWith];
    const positionOf = (i: number) => (i + 1) * 10;

    if (!(await patchCategory(a.slug, { position: positionOf(swapWith) }))) return;
    if (!(await patchCategory(b.slug, { position: positionOf(index) }))) return;
    await load();
  }

  async function load() {
    const res = await boardFetch("/api/board");
    if (!res) return;

    // A catechumen-and-above page reached by an inquirer: say why,
    // plainly, rather than showing them an error code.
    if (res.status === 403) {
      showError(
        (await errorDetail(res)) ||
          "The parish board opens up when Father receives you as a catechumen.",
      );
      return;
    }
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't load the board (${res.status}).`);
      return;
    }

    const data = await res.json();
    const categories: Category[] = data.categories ?? [];
    isAdmin = !!data.viewer?.isAdmin;

    renderCategories(categories);
    if (isAdmin) {
      adminTools.classList.remove("hidden");
      renderAdminList(categories);
    }

    adminList.onclick = async (event) => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      const slug = button.closest("li")?.dataset.slug;
      if (!slug) return;
      const category = categories.find((c) => c.slug === slug);
      if (!category) return;

      if (button.classList.contains("cat-up")) return move(slug, -1, categories);
      if (button.classList.contains("cat-down")) return move(slug, 1, categories);

      if (button.classList.contains("cat-hide")) {
        if (await patchCategory(slug, { hidden: !category.hidden })) await load();
        return;
      }

      if (button.classList.contains("cat-rename")) {
        // Renaming happens in place. A browser prompt() freezes the
        // whole page the way confirm() did, and we took those out.
        const row = button.closest("li") as HTMLElement;
        row.innerHTML = `
          <input type="text" maxlength="80" value="${escapeHtml(category.name)}"
                 class="flex-1 min-w-[8rem] border border-border-soft bg-cream-bg px-2 py-1" />
          <button type="button" class="btn btn-primary text-xs rename-save">Save</button>
          <button type="button" class="btn btn-secondary text-xs rename-cancel">Cancel</button>`;
        const input = row.querySelector("input") as HTMLInputElement;
        input.focus();
        input.select();

        const save = async () => {
          const name = input.value.trim();
          if (!name) return;
          if (await patchCategory(slug, { name })) await load();
        };
        (row.querySelector(".rename-save") as HTMLElement).onclick = save;
        (row.querySelector(".rename-cancel") as HTMLElement).onclick = () => load();
        input.onkeydown = (e) => {
          if (e.key === "Enter") { e.preventDefault(); save(); }
          if (e.key === "Escape") load();
        };
        return;
      }

      if (button.classList.contains("cat-delete")) {
        const goAhead = await confirmAction({
          message:
            category.threadCount > 0
              ? `Delete "${category.name}"? It holds ${category.threadCount} ` +
                `${category.threadCount === 1 ? "thread" : "threads"}, and they go with it ` +
                `along with every reply. Hide it instead if you only want it off the board.`
              : `Delete "${category.name}"? It's empty, so nothing written is lost.`,
          confirmLabel: "Delete it",
          cancelLabel: "Keep it",
          danger: true,
        });
        if (!goAhead) return;

        const res = await boardFetch(
          `/api/board/categories?slug=${encodeURIComponent(slug)}&confirm=yes`,
          { method: "DELETE" },
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
          return;
        }
        await load();
      }
    };

    loading.classList.add("hidden");
    banner.classList.add("hidden");
    content.classList.remove("hidden");
  }

  (document.getElementById("new-category") as HTMLFormElement)?.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();
      const nameInput = document.getElementById("cat-name") as HTMLInputElement;
      const descInput = document.getElementById("cat-description") as HTMLInputElement;
      const name = nameInput.value.trim();
      if (!name) return;

      const res = await boardFetch("/api/board/categories", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, description: descInput.value.trim() || null }),
      });
      if (!res) return;
      if (!res.ok) {
        showError((await errorDetail(res)) || `Couldn't add that (${res.status}).`);
        return;
      }
      nameInput.value = "";
      descInput.value = "";
      await load();
    },
  );

  load();
</script>
