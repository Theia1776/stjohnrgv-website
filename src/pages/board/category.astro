---
import Layout from "../../layouts/Layout.astro";
import "../../styles/board.css";
---

<Layout title="Parish Board" description="Topics in this part of the parish board.">
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 id="category-name" class="text-3xl font-bold mb-1">Loading…</h1>
    <p id="category-description" class="text-text-secondary text-sm mb-2"></p>

    <div class="bb-crumb">
      <a href="/board/">Parish Board</a>
      <span id="crumb-tail"></span>
    </div>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>

    <div
      id="error-banner"
      class="hidden border border-liturgical-red bg-cream-card p-4 mb-6 text-sm"
      role="alert"
    >
    </div>

    <div id="content" class="hidden">
      <div class="bb-bar">
        <button id="start-toggle" type="button" class="bb-btn bb-btn-strong">New Topic</button>
        <a href="#" id="mark-read" class="bb-btn">Mark topics read</a>
      </div>

      <form id="start-form" class="hidden border border-border-soft bg-cream-card p-4 mb-4 space-y-3">
        <label class="block">
          <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
            Subject
          </span>
          <input
            id="new-title"
            type="text"
            maxlength="160"
            required
            placeholder="What's this about?"
            class="block w-full border border-border-soft bg-cream-bg px-3 py-2"
          />
        </label>
        <label class="block">
          <span class="block text-xs uppercase tracking-widest text-text-secondary mb-1">
            Message
          </span>
          <textarea
            id="new-body"
            rows="7"
            maxlength="10000"
            required
            class="block w-full border border-border-soft bg-cream-bg px-3 py-2"
          ></textarea>
        </label>
        <div class="flex items-center gap-2">
          <button id="start-submit" type="submit" class="bb-btn bb-btn-strong">Submit</button>
          <button id="start-cancel" type="button" class="bb-btn">Cancel</button>
          <span id="start-status" class="text-sm text-text-secondary" role="status"></span>
        </div>
      </form>

      <table class="bb-table">
        <thead>
          <tr>
            <th colspan="2">Topics</th>
            <th class="bb-num bb-hide-small">Replies</th>
            <th class="bb-num bb-hide-small">Views</th>
            <th class="bb-last">Last Post</th>
          </tr>
        </thead>
        <tbody id="threads"></tbody>
      </table>

      <p id="empty-state" class="hidden text-center text-text-secondary italic mt-8">
        No topics here yet. You could start the first one.
      </p>

      <div class="bb-bar">
        <button id="start-toggle-2" type="button" class="bb-btn bb-btn-strong">New Topic</button>
        <a href="/board/" class="bb-btn">All forums</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { confirmAction } from "../../lib/confirm";
  import { escapeHtml, when, exactly, errorDetail, boardFetch } from "../../lib/board-ui";

  type Thread = {
    id: string;
    title: string;
    startedBy: string;
    lastPostBy: string;
    pinned: boolean;
    locked: boolean;
    createdAt: string;
    lastPostAt: string;
    replyCount: number;
    viewCount: number;
    unread: boolean;
    mine: boolean;
  };

  const slug = new URLSearchParams(window.location.search).get("c") ?? "";
  const here = `/board/category/?c=${encodeURIComponent(slug)}`;

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;
  const banner = document.getElementById("error-banner") as HTMLElement;
  const nameEl = document.getElementById("category-name") as HTMLElement;
  const descEl = document.getElementById("category-description") as HTMLElement;
  const crumbTail = document.getElementById("crumb-tail") as HTMLElement;
  const body = document.getElementById("threads") as HTMLElement;
  const emptyState = document.getElementById("empty-state") as HTMLElement;
  const startForm = document.getElementById("start-form") as HTMLFormElement;
  const startStatus = document.getElementById("start-status") as HTMLElement;

  let isAdmin = false;

  function showError(message: string) {
    banner.textContent = message;
    banner.classList.remove("hidden");
    loading.classList.add("hidden");
  }

  function renderThreads(threads: Thread[]) {
    if (!threads.length) {
      body.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }
    emptyState.classList.add("hidden");

    body.innerHTML = threads
      .map((t) => {
        const icon = t.locked ? "🔒" : t.unread ? "📬" : "📭";
        // "Sticky:" the way a board has always flagged a pinned topic.
        const prefix = t.pinned ? '<strong>Sticky:</strong> ' : "";
        const admin = isAdmin
          ? `<div class="mt-1">
               <button type="button" class="bb-btn thread-pin">${t.pinned ? "Unpin" : "Pin"}</button>
               <button type="button" class="bb-btn thread-lock">${t.locked ? "Reopen" : "Close"}</button>
               <button type="button" class="bb-btn bb-btn-danger thread-delete">Delete</button>
             </div>`
          : "";

        return `
          <tr class="${t.unread ? "bb-unread" : ""}" data-id="${escapeHtml(t.id)}">
            <td class="bb-icon">${icon}</td>
            <td>
              ${prefix}<a class="bb-title" href="/board/thread/?id=${encodeURIComponent(t.id)}">${escapeHtml(t.title)}</a>
              <span class="bb-desc">by ${escapeHtml(t.startedBy)}, ${escapeHtml(when(t.createdAt))}</span>
              ${admin}
            </td>
            <td class="bb-num bb-hide-small">${t.replyCount}</td>
            <td class="bb-num bb-hide-small">${t.viewCount}</td>
            <td class="bb-last">
              <span title="${escapeHtml(exactly(t.lastPostAt))}">${escapeHtml(when(t.lastPostAt))}</span>
              <br /><span>by ${escapeHtml(t.lastPostBy)}</span>
            </td>
          </tr>`;
      })
      .join("");
  }

  async function patchThread(id: string, updates: Record<string, unknown>) {
    const res = await boardFetch(
      "/api/board/thread",
      {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id, ...updates }),
      },
      here,
    );
    if (!res) return false;
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't save that (${res.status}).`);
      return false;
    }
    return true;
  }

  async function load() {
    if (!slug) {
      showError("No category in that link. Go back and pick one from the board.");
      return;
    }

    const res = await boardFetch(
      `/api/board/threads?category=${encodeURIComponent(slug)}`,
      {},
      here,
    );
    if (!res) return;

    if (res.status === 403) {
      showError(
        (await errorDetail(res)) ||
          "The parish board opens up when Father receives you as a catechumen.",
      );
      return;
    }
    if (res.status === 404) {
      showError("That category isn't on the board any more.");
      return;
    }
    if (!res.ok) {
      showError((await errorDetail(res)) || `Couldn't load this category (${res.status}).`);
      return;
    }

    const data = await res.json();
    isAdmin = !!data.viewer?.isAdmin;

    const name = data.category?.name ?? "Parish Board";
    nameEl.textContent = name;
    descEl.textContent = data.category?.description ?? "";
    crumbTail.innerHTML = ` &rsaquo; ${escapeHtml(name)}`;
    document.title = `${name} | St. John of Kronstadt Orthodox Mission`;

    const threads: Thread[] = data.threads ?? [];
    renderThreads(threads);

    body.onclick = async (event) => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      const id = (button.closest("tr") as HTMLElement | null)?.dataset.id;
      if (!id) return;
      const thread = threads.find((t) => t.id === id);
      if (!thread) return;

      if (button.classList.contains("thread-pin")) {
        if (await patchThread(id, { pinned: !thread.pinned })) await load();
        return;
      }
      if (button.classList.contains("thread-lock")) {
        if (await patchThread(id, { locked: !thread.locked })) await load();
        return;
      }
      if (button.classList.contains("thread-delete")) {
        const goAhead = await confirmAction({
          message:
            `Delete "${thread.title}"? Every post in it goes too, and that can't ` +
            `be undone. Closing it instead leaves it readable but takes new replies off.`,
          confirmLabel: "Delete the topic",
          cancelLabel: "Keep it",
          danger: true,
        });
        if (!goAhead) return;

        const res = await boardFetch(
          `/api/board/thread?id=${encodeURIComponent(id)}`,
          { method: "DELETE" },
          here,
        );
        if (!res) return;
        if (!res.ok) {
          showError((await errorDetail(res)) || `Couldn't delete that (${res.status}).`);
          return;
        }
        await load();
      }
    };

    loading.classList.add("hidden");
    banner.classList.add("hidden");
    content.classList.remove("hidden");
  }

  // ---- starting a topic ---------------------------------------------------
  function toggleForm() {
    startForm.classList.toggle("hidden");
    if (!startForm.classList.contains("hidden")) {
      (document.getElementById("new-title") as HTMLInputElement).focus();
      startForm.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }
  (document.getElementById("start-toggle") as HTMLButtonElement).addEventListener("click", toggleForm);
  (document.getElementById("start-toggle-2") as HTMLButtonElement).addEventListener("click", toggleForm);

  (document.getElementById("start-cancel") as HTMLButtonElement).addEventListener("click", () => {
    startForm.classList.add("hidden");
    startStatus.textContent = "";
  });

  (document.getElementById("mark-read") as HTMLAnchorElement).addEventListener(
    "click",
    async (event) => {
      event.preventDefault();
      const res = await boardFetch(
        "/api/board/read",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ category: slug }),
        },
        here,
      );
      if (!res) return;
      await load();
    },
  );

  startForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const titleInput = document.getElementById("new-title") as HTMLInputElement;
    const bodyInput = document.getElementById("new-body") as HTMLTextAreaElement;
    const submit = document.getElementById("start-submit") as HTMLButtonElement;

    const title = titleInput.value.trim();
    const text = bodyInput.value.trim();
    if (!title) {
      startStatus.textContent = "Give it a subject first.";
      return;
    }
    if (!text) {
      startStatus.textContent = "Write something to start it off.";
      return;
    }

    submit.disabled = true;
    startStatus.textContent = "Posting…";

    const res = await boardFetch(
      "/api/board/threads",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ category: slug, title, body: text }),
      },
      here,
    );
    submit.disabled = false;
    if (!res) return;

    if (!res.ok) {
      startStatus.textContent = (await errorDetail(res)) || `Couldn't post that (${res.status}).`;
      return;
    }

    const { id } = await res.json();
    window.location.assign(`/board/thread/?id=${encodeURIComponent(id)}`);
  });

  load();
</script>
