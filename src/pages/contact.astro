---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact & Prayer Requests | St. John of Kronstadt Orthodox Mission"
  description="Contact St. John of Kronstadt Orthodox Mission in Bayview, Texas. Speak with Fr. Antonios Altermatt, request prayers, or plan a visit."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs uppercase tracking-widest text-brand-tan-dark">Get in Touch</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Contact &amp; Prayer Requests</h1>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="border border-border-soft bg-cream-card p-6">
        <h2 class="font-display text-xl text-text-primary">St. John of Kronstadt Orthodox Mission</h2>
        <address class="mt-3 not-italic text-text-primary/80">
          39737 Palm Drive<br />
          Bayview, TX 78566
        </address>
        <p class="mt-3 text-text-primary/80">
          <a href="tel:+19564490225">(956) 449-0225</a>
        </p>
      </div>
      <div class="border border-border-soft bg-cream-card p-6">
        <h2 class="font-display text-xl text-text-primary">Fr. Antonios Altermatt</h2>
        <p class="mt-3 text-text-primary/80">Pastor</p>
        <p class="mt-3 text-text-primary/75 text-sm">
          For pastoral conversations, inquirer questions, baptism and chrismation
          preparation, or to request prayers, please call.
        </p>
      </div>
    </div>

    <p class="mt-8 text-text-primary/75">
      An online contact form and prayer request form are coming soon.
    </p>
  </section>
</Layout>
