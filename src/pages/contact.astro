---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact & Prayer Requests | St. John of Kronstadt Orthodox Mission"
  description="Contact St. John of Kronstadt Orthodox Mission in Bayview, Texas. Speak with Fr. Antonios Altermatt, request prayers, or plan a visit."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs uppercase tracking-widest text-gold-dim">Get in Touch</p>
    <h1 class="mt-2 font-display text-3xl text-ink md:text-4xl">Contact &amp; Prayer Requests</h1>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="border border-gold/30 bg-parchment-dark/30 p-6">
        <h2 class="font-display text-xl text-ink">St. John of Kronstadt Orthodox Mission</h2>
        <address class="mt-3 not-italic text-ink/80">
          39737 Palm Drive<br />
          Bayview, TX 78566
        </address>
        <p class="mt-3 text-ink/80">
          <a href="tel:+19564346874" class="text-burgundy underline hover:text-ink">(956) 434-6874</a>
        </p>
      </div>
      <div class="border border-gold/30 bg-parchment-dark/30 p-6">
        <h2 class="font-display text-xl text-ink">Fr. Antonios Altermatt</h2>
        <p class="mt-3 text-ink/80">Pastor</p>
        <p class="mt-3 text-ink/70 text-sm">
          For pastoral conversations, inquirer questions, baptism and chrismation
          preparation, or to request prayers, please call.
        </p>
      </div>
    </div>

    <p class="mt-8 text-ink/70">
      An online contact form and prayer request form are coming soon.
    </p>
  </section>
</Layout>
