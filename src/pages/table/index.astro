---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import euphrosynos from "../../assets/images/st-euphrosynos-the-cook.jpg";

// An Orthodox Table — the front of the parish recipe collection.
// Two shelves, side by side on one row: the fasting book and everything
// else. Deliberately only two choices, because a cook arriving here
// already knows which kind of day it is.
---

<Layout
  title="An Orthodox Table | St. John of Kronstadt Orthodox Mission"
  description="Recipes, and a guide to eating through the Church's year — fasting dishes and everyday cooking shared by our parish."
>
  <main class="mx-auto max-w-5xl px-4 py-12 md:px-6">
    <p class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
      St. John of Kronstadt Orthodox Mission
    </p>
    <h1 class="mt-2 font-display text-4xl text-text-primary md:text-5xl">An Orthodox Table</h1>
    <div class="mt-5 h-px w-24 bg-liturgical-current"></div>
    <!-- The icon floats so the text runs round it rather than sitting
         in a rigid column beside it. Floated and not a grid on
         purpose: the opening line, the paragraph about the fast and
         St. Euphrosynos' own story are different lengths, and a float
         lets them close over the bottom of the picture instead of
         leaving a column of white space wherever the shorter one
         ends.

         On a phone it un-floats and sits above the text, because a
         288px picture beside a paragraph at that width leaves a
         measure nobody can read. -->
    <div class="mt-6">
      <figure class="patron-figure m-0 mb-5 sm:float-left sm:mb-4 sm:mr-7 sm:w-64 md:w-72">
        <Image
          src={euphrosynos}
          alt="An icon of St. Euphrosynos the Cook painted on a wooden kitchen board, hanging on a plaster wall between bunches of drying herbs, garlic and chillies, with a lit beeswax candle before it. The saint holds a branch bearing three apples."
          width={288}
          densities={[1, 2]}
          class="w-full border border-border-soft shadow-sm"
        />
        <figcaption class="mt-2 text-xs italic text-text-secondary">
          St. Euphrosynos the Cook, with the three apples of Paradise.
        </figcaption>
      </figure>

      <p class="font-display text-lg text-text-primary/85 md:text-xl">
        Recipes, and a guide to eating through the Church's year.
      </p>

      <p class="mt-5 text-text-primary/85 leading-relaxed">
        The Church keeps roughly half the year as fast, and a fast is not a
        hardship to be endured in silence — it has its own cooking, handed
        between households for centuries. These are our parish's, shared by
        the people who make them.
      </p>

      <h2 class="mt-7 font-display text-xl text-text-primary">
        St. Euphrosynos the Cook
      </h2>
      <div class="mt-3 h-px w-16 bg-liturgical-current"></div>

      <p class="mt-4 text-text-primary/85 leading-relaxed">
        He was a cook in a Palestinian monastery, and he prayed over the pots.
        He was unlearned, often reproached, and said nothing about it. The
        brothers thought little of him.
      </p>
      <p class="mt-4 text-text-primary/85 leading-relaxed">
        A priest of that monastery asked God to show him what is kept for the
        righteous, and dreamt of Paradise. There, keeping the garden, he found
        the kitchen cook. He asked Euphrosynos how he came to be in such a
        place, and was told: through the great mercy of God. He asked whether
        he might take something back with him, and Euphrosynos picked three
        apples, wrapped them in a cloth, and gave them to him.
      </p>
      <p class="mt-4 text-text-primary/85 leading-relaxed">
        The priest woke with the cloth beside him and the fragrance of the
        fruit still in it. When he told the brethren, Euphrosynos left the
        monastery rather than be honoured for it, and was not seen again.
      </p>
      <p class="mt-4 text-text-primary/85 leading-relaxed">
        He is commemorated on <strong>September 11 / September 24</strong>, and he is why a
        collection of recipes belongs to a parish at all. The cooking is not an
        interruption of the life of prayer. For him it was the whole of it.
      </p>
      <p class="mt-4">
        <!-- A new tab on purpose. His life sits in the saints
             catalogue, which is a different part of the site, and
             somebody halfway through choosing a recipe should not have
             to find their way back here afterwards. -->
        <a
          href="/learn/saints/?saint=euphrosynus-the-cook-of-alexandria"
          target="_blank"
          rel="noopener"
          class="font-semibold text-brand-blue-dark"
        >
          Read his life in full ↗
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </p>

      <!-- Closes the float so the panel below starts on a clean line
           however long the text above it runs. -->
      <div class="clear-both"></div>
    </div>

    <!-- Second on the page, after the patron. A link at the foot of a
         grey box got walked straight past, so this is its own panel
         with a button rather than a sentence that happens to be
         underlined — and it sits before the search and the books,
         because a person new to fasting needs the direction before
         they need three hundred recipes. -->
    <section class="mt-8 max-w-2xl border-2 border-sacred-gold bg-cream-card p-6">
      <p class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
        New to fasting? Start here
      </p>
      <h2 class="mt-2 font-display text-2xl text-text-primary">Keeping the Fast</h2>
      <div class="mt-3 h-px w-16 bg-liturgical-current"></div>
      <p class="mt-4 leading-relaxed text-text-primary/85">
        Getting to know Orthodox eating: where the protein comes from, what to
        keep on hand, how to plan your meals, and who to speak to if you cannot
        keep the fast. It is not meant to be worked out alone from a list of
        recipes.
      </p>
      <p class="mt-5 flex flex-wrap gap-3">
        <a href="/table/keeping-the-fast/" class="btn btn-primary">
          Read Keeping the Fast first
        </a>
        <a href="/table/vegan-eating/" class="btn btn-secondary">
          An Introduction to Vegan Eating
        </a>
      </p>
      <p class="mt-3 text-sm text-text-secondary">
        The first answers what the fast asks of you. The second answers what to
        actually cook.
      </p>
      <p class="mt-5 border-t border-border-soft pt-4 text-sm leading-relaxed text-text-secondary">
        The rule for any <em>given day</em> is on the
        <a href="/calendar/" class="font-semibold text-brand-blue-dark">parish calendar</a> —
        whether the day is a fast, and whether fish, wine or oil are allowed.
        When in doubt, ask Fr. Antonios rather than a website.
      </p>
    </section>

    <!-- One box across both books. A cook knows what is in the fridge,
         not which shelf the dish is on, so searching comes before
         choosing a book. Signed out it reaches the fasting book only —
         the same rule the books themselves keep. -->
    <div class="mt-8">
      <label for="table-search" class="sr-only">Search every recipe</label>
      <input
        id="table-search"
        type="search"
        placeholder="Search every recipe — a name, or something you have on hand…"
        class="block w-full border border-border-soft bg-cream-card px-4 py-3 focus:outline-none focus:ring-2"
      />
      <p id="table-search-note" class="mt-2 text-sm text-text-secondary" role="status"></p>
      <ul id="table-search-results" class="mt-4 space-y-3"></ul>
    </div>

    <!-- Two entry points on one row, as asked. They fall to one column on
         a phone rather than squeezing to half-width each. -->
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <a
        href="/table/fasting/"
        class="group block border border-border-soft bg-cream-card p-7 no-underline shadow-sm transition-colors hover:border-brand-blue-dark"
      >
        <span class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
          Book One · open to all
        </span>
        <h2 class="mt-2 font-display text-2xl text-text-primary group-hover:text-brand-blue-dark">
          Fasting Recipes
        </h2>
        <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
        <p class="mt-4 text-sm text-text-primary/85 leading-relaxed">
          No meat, dairy or eggs. What we cook on Wednesdays and Fridays,
          through Great Lent, and the other fasts of the year.
        </p>
        <p class="mt-5 font-display text-sm uppercase tracking-widest text-brand-blue-dark">
          Open the fasting book →
        </p>
      </a>

      <a
        href="/table/everyday/"
        class="group block border border-border-soft bg-cream-card p-7 no-underline shadow-sm transition-colors hover:border-brand-blue-dark"
      >
        <span class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
          Book Two · parish accounts
        </span>
        <h2 class="mt-2 font-display text-2xl text-text-primary group-hover:text-brand-blue-dark">
          Everyday Recipes
        </h2>
        <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
        <p class="mt-4 text-sm text-text-primary/85 leading-relaxed">
          Feast days, Pascha, coffee hour, and anything else our people
          want to pass along. These are the families' own, kept among the
          parish — a sign-in opens them.
        </p>
        <p class="mt-5 font-display text-sm uppercase tracking-widest text-brand-blue-dark">
          Open the everyday book →
        </p>
      </a>
    </div>

    <!-- Across the row rather than on it. Gluten-free isn't a third
         book — a gluten-free dish sits in whichever book it belongs to
         and is marked — so it reads as a way through both, which is
         what it is. -->
    <a
      href="/table/gluten-free/"
      class="group mt-6 block border border-border-soft bg-cream-card p-6 no-underline shadow-sm transition-colors hover:border-brand-blue-dark"
    >
      <span class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
        Across both books
      </span>
      <h2 class="mt-2 font-display text-xl text-text-primary group-hover:text-brand-blue-dark">
        Gluten-Free Recipes
      </h2>
      <p class="mt-3 max-w-2xl text-sm text-text-primary/85 leading-relaxed">
        Everything from either book made without wheat, barley or rye.
        Coeliac disease doesn't take fast days off, and nobody should have
        to read four hundred recipes to find the ones they can eat.
      </p>
      <p class="mt-4 font-display text-sm uppercase tracking-widest text-brand-blue-dark">
        See the gluten-free recipes →
      </p>
    </a>

    <!-- The parish's older collection, which lives in the library
         rather than here. Linked so a cook looking for fasting food
         finds it, instead of it sitting unread behind a catalogue. -->
    <section class="mt-12 border-t border-border-soft pt-8">
      <h2 class="font-display text-xl text-text-primary">The St Philaret cookbook</h2>
      <p class="mt-3 max-w-2xl text-text-primary/85 leading-relaxed">
        Another parish's collection — around four hundred recipes, most of them
        for the fast, gathered with its contributors named. It lives in the
        parish library as a book rather than here as separate recipes.
        Signed-in members can read it and search inside it.
      </p>
      <p class="mt-5">
        <a
          href="/learn/library/reader/?slug=st-philaret-orthodox-church-family-recipes"
          class="font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
        >
          Open it in the library →
        </a>
      </p>
    </section>

    <section class="mt-12 border-t border-border-soft pt-8">
      <h2 class="font-display text-xl text-text-primary">Share one of yours</h2>
      <p class="mt-3 max-w-2xl text-text-primary/85 leading-relaxed">
        Catechumens and members can add recipes to either book. Fill in the
        form and it comes to the parish office; once it's been looked over
        it goes up with your name on it.
      </p>
      <p class="mt-5">
        <a href="/table/share/" class="btn btn-primary">Share a recipe</a>
      </p>
    </section>

  </main>
</Layout>

<script>
  // Searching both books from the front page. Everything the viewer is
  // allowed to see is fetched once and then filtered here — a parish
  // collection is small, and a dish half-remembered is found by typing
  // rather than by opening two shelves in turn.
  type Recipe = {
    slug: string;
    title: string;
    fasting: boolean;
    gluten_free: boolean;
    category: string | null;
    intro: string | null;
    ingredients: string[];
    total_time: string | null;
    serves: string | null;
  };

  const input = document.getElementById("table-search") as HTMLInputElement;
  const note = document.getElementById("table-search-note") as HTMLParagraphElement;
  const results = document.getElementById("table-search-results") as HTMLUListElement;

  let recipes: Recipe[] = [];
  let loaded = false;

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function normalise(value: unknown): string {
    return String(value ?? "")
      .normalize("NFKD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  /** Which half of the category to show — "Soups", not the whole path. */
  function shortCategory(value: string | null): string {
    if (!value) return "";
    const parts = String(value).split(" — ");
    return parts.length > 1 ? parts.slice(1).join(" ") : parts[0];
  }

  async function ensureLoaded() {
    if (loaded) return;
    // No fasting filter: the server returns what this viewer may see,
    // which is the fasting book alone when signed out.
    const res = await fetch("/api/recipes", { credentials: "same-origin" });
    if (!res.ok) {
      note.textContent = "Could not load the recipes just now.";
      return;
    }
    const data = await res.json();
    recipes = (data.recipes ?? []) as Recipe[];
    loaded = true;
  }

  function render(query: string) {
    const terms = normalise(query).split(/\s+/).filter(Boolean);
    if (terms.length === 0) {
      results.innerHTML = "";
      note.textContent = "";
      return;
    }

    const found = recipes.filter((r) => {
      const hay = normalise([r.title, r.intro, (r.ingredients ?? []).join(" "), r.category].join(" "));
      return terms.every((t) => hay.includes(t));
    });

    if (found.length === 0) {
      results.innerHTML = "";
      note.textContent = `Nothing matches "${query}".`;
      return;
    }

    const fasting = found.filter((r) => r.fasting).length;
    note.textContent =
      `${found.length} ${found.length === 1 ? "recipe" : "recipes"}` +
      (fasting && fasting < found.length ? ` — ${fasting} fasting, ${found.length - fasting} everyday` : "");

    results.innerHTML = found
      .slice(0, 40)
      .map((r) => {
        const bits = [shortCategory(r.category), r.total_time, r.serves ? `serves ${r.serves}` : ""]
          .filter(Boolean)
          .map((b) => escapeHtml(b))
          .join(" · ");
        return `<li class="border border-border-soft bg-cream-card p-4">
          <a href="/table/recipe/?slug=${encodeURIComponent(r.slug)}"
             class="font-display text-lg text-brand-blue-dark no-underline hover:underline">${escapeHtml(r.title)}</a>
          <span class="ml-2 border border-border-soft px-1.5 py-0.5 text-[0.65rem] uppercase tracking-wider text-text-secondary">
            ${r.fasting ? "Fasting" : "Everyday"}
          </span>
          ${r.gluten_free ? '<span class="ml-1 border border-sacred-gold px-1.5 py-0.5 text-[0.65rem] uppercase tracking-wider text-brand-tan-dark">GF</span>' : ""}
          ${bits ? `<p class="mt-1 text-xs text-text-secondary">${bits}</p>` : ""}
        </li>`;
      })
      .join("");

    if (found.length > 40) {
      note.textContent += " — showing the first 40";
    }
  }

  let timer: number | undefined;
  input?.addEventListener("input", () => {
    window.clearTimeout(timer);
    const query = input.value.trim();
    timer = window.setTimeout(async () => {
      if (query) await ensureLoaded();
      render(query);
    }, 180);
  });
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      input.value = "";
      render("");
    }
  });
</script>
