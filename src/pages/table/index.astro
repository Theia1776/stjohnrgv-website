---
import Layout from "../../layouts/Layout.astro";

// An Orthodox Table — the front of the parish recipe collection.
// Two shelves, side by side on one row: the fasting book and everything
// else. Deliberately only two choices, because a cook arriving here
// already knows which kind of day it is.
---

<Layout
  title="An Orthodox Table | St. John of Kronstadt Orthodox Mission"
  description="Recipes and a guide to eating Orthodox — fasting dishes and everyday cooking shared by our parish."
>
  <main class="mx-auto max-w-5xl px-4 py-12 md:px-6">
    <p class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
      St. John of Kronstadt Orthodox Mission
    </p>
    <h1 class="mt-2 font-display text-4xl text-text-primary md:text-5xl">An Orthodox Table</h1>
    <div class="mt-5 h-px w-24 bg-liturgical-current"></div>
    <p class="mt-5 max-w-2xl font-display text-lg text-text-primary/85 md:text-xl">
      Recipes and a guide to eating Orthodox.
    </p>

    <p class="mt-6 max-w-2xl text-text-primary/85 leading-relaxed">
      The Church keeps roughly half the year as fast, and a fast is not a
      hardship to be endured in silence — it has its own cooking, handed
      between households for centuries. These are our parish's, shared by
      the people who make them.
    </p>

    <aside class="mt-8 max-w-2xl border-l-2 border-sacred-gold bg-cream-card p-5">
      <h2 class="font-display text-base text-text-primary">What the fast asks</h2>
      <p class="mt-2 text-sm leading-relaxed text-text-primary/85">
        The fasting rule for any given day is on the
        <a href="/calendar/" class="font-semibold text-brand-blue-dark">parish calendar</a> —
        it says plainly whether the day is a fast, whether fish, wine or oil
        are allowed, and which season it belongs to. When in doubt, ask Fr.
        Antonios rather than a website.
      </p>
      <p class="mt-3 text-sm">
        <a href="/table/keeping-the-fast/" class="font-semibold text-brand-blue-dark">
          Keeping the Fast — practical help →
        </a>
      </p>
    </aside>

    <!-- One box across both books. A cook knows what is in the fridge,
         not which shelf the dish is on, so searching comes before
         choosing a book. Signed out it reaches the fasting book only —
         the same rule the books themselves keep. -->
    <div class="mt-8">
      <label for="table-search" class="sr-only">Search every recipe</label>
      <input
        id="table-search"
        type="search"
        placeholder="Search every recipe — a name, or something in the cupboard…"
        class="block w-full border border-border-soft bg-cream-card px-4 py-3 focus:outline-none focus:ring-2"
      />
      <p id="table-search-note" class="mt-2 text-sm text-text-secondary" role="status"></p>
      <ul id="table-search-results" class="mt-4 space-y-3"></ul>
    </div>

    <!-- Two entry points on one row, as asked. They fall to one column on
         a phone rather than squeezing to half-width each. -->
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <a
        href="/table/fasting/"
        class="group block border border-border-soft bg-cream-card p-7 no-underline shadow-sm transition-colors hover:border-brand-blue-dark"
      >
        <span class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
          Book One · open to all
        </span>
        <h2 class="mt-2 font-display text-2xl text-text-primary group-hover:text-brand-blue-dark">
          Fasting Recipes
        </h2>
        <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
        <p class="mt-4 text-sm text-text-primary/85 leading-relaxed">
          No meat, dairy or eggs. What we cook on Wednesdays and Fridays,
          through Great Lent, and the other fasts of the year.
        </p>
        <p class="mt-5 font-display text-sm uppercase tracking-widest text-brand-blue-dark">
          Open the fasting book →
        </p>
      </a>

      <a
        href="/table/everyday/"
        class="group block border border-border-soft bg-cream-card p-7 no-underline shadow-sm transition-colors hover:border-brand-blue-dark"
      >
        <span class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
          Book Two · parish accounts
        </span>
        <h2 class="mt-2 font-display text-2xl text-text-primary group-hover:text-brand-blue-dark">
          Everyday Recipes
        </h2>
        <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
        <p class="mt-4 text-sm text-text-primary/85 leading-relaxed">
          Feast days, Pascha, coffee hour, and anything else our people
          want to pass along. These are the families' own, kept among the
          parish — a sign-in opens them.
        </p>
        <p class="mt-5 font-display text-sm uppercase tracking-widest text-brand-blue-dark">
          Open the everyday book →
        </p>
      </a>
    </div>

    <section class="mt-12 border-t border-border-soft pt-8">
      <h2 class="font-display text-xl text-text-primary">Share one of yours</h2>
      <p class="mt-3 max-w-2xl text-text-primary/85 leading-relaxed">
        Catechumens and members can add recipes to either book. Fill in the
        form and it comes to the parish office; once it's been looked over
        it goes up with your name on it.
      </p>
      <p class="mt-5">
        <a href="/table/share/" class="btn btn-primary">Share a recipe</a>
      </p>
    </section>

  </main>
</Layout>

<script>
  // Searching both books from the front page. Everything the viewer is
  // allowed to see is fetched once and then filtered here — a parish
  // collection is small, and a dish half-remembered is found by typing
  // rather than by opening two shelves in turn.
  type Recipe = {
    slug: string;
    title: string;
    fasting: boolean;
    category: string | null;
    intro: string | null;
    ingredients: string[];
    total_time: string | null;
    serves: string | null;
  };

  const input = document.getElementById("table-search") as HTMLInputElement;
  const note = document.getElementById("table-search-note") as HTMLParagraphElement;
  const results = document.getElementById("table-search-results") as HTMLUListElement;

  let recipes: Recipe[] = [];
  let loaded = false;

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function normalise(value: unknown): string {
    return String(value ?? "")
      .normalize("NFKD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  /** Which half of the category to show — "Soups", not the whole path. */
  function shortCategory(value: string | null): string {
    if (!value) return "";
    const parts = String(value).split(" — ");
    return parts.length > 1 ? parts.slice(1).join(" ") : parts[0];
  }

  async function ensureLoaded() {
    if (loaded) return;
    // No fasting filter: the server returns what this viewer may see,
    // which is the fasting book alone when signed out.
    const res = await fetch("/api/recipes", { credentials: "same-origin" });
    if (!res.ok) {
      note.textContent = "Could not load the recipes just now.";
      return;
    }
    const data = await res.json();
    recipes = (data.recipes ?? []) as Recipe[];
    loaded = true;
  }

  function render(query: string) {
    const terms = normalise(query).split(/\s+/).filter(Boolean);
    if (terms.length === 0) {
      results.innerHTML = "";
      note.textContent = "";
      return;
    }

    const found = recipes.filter((r) => {
      const hay = normalise([r.title, r.intro, (r.ingredients ?? []).join(" "), r.category].join(" "));
      return terms.every((t) => hay.includes(t));
    });

    if (found.length === 0) {
      results.innerHTML = "";
      note.textContent = `Nothing matches "${query}".`;
      return;
    }

    const fasting = found.filter((r) => r.fasting).length;
    note.textContent =
      `${found.length} ${found.length === 1 ? "recipe" : "recipes"}` +
      (fasting && fasting < found.length ? ` — ${fasting} fasting, ${found.length - fasting} everyday` : "");

    results.innerHTML = found
      .slice(0, 40)
      .map((r) => {
        const bits = [shortCategory(r.category), r.total_time, r.serves ? `serves ${r.serves}` : ""]
          .filter(Boolean)
          .map((b) => escapeHtml(b))
          .join(" · ");
        return `<li class="border border-border-soft bg-cream-card p-4">
          <a href="/table/recipe/?slug=${encodeURIComponent(r.slug)}"
             class="font-display text-lg text-brand-blue-dark no-underline hover:underline">${escapeHtml(r.title)}</a>
          <span class="ml-2 border border-border-soft px-1.5 py-0.5 text-[0.65rem] uppercase tracking-wider text-text-secondary">
            ${r.fasting ? "Fasting" : "Everyday"}
          </span>
          ${bits ? `<p class="mt-1 text-xs text-text-secondary">${bits}</p>` : ""}
        </li>`;
      })
      .join("");

    if (found.length > 40) {
      note.textContent += " — showing the first 40";
    }
  }

  let timer: number | undefined;
  input?.addEventListener("input", () => {
    window.clearTimeout(timer);
    const query = input.value.trim();
    timer = window.setTimeout(async () => {
      if (query) await ensureLoaded();
      render(query);
    }, 180);
  });
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      input.value = "";
      render("");
    }
  });
</script>
