---
import Layout from "../../layouts/Layout.astro";

// One issue of the parish newsletter.
//
// Two presentations of one issue, from one set of data:
//
//   On screen it scrolls — a masthead, a lead with a drop cap, then
//   sections that alternate their photographs left and right so the
//   page does not read as one long column of grey text. A newsletter
//   nobody wants to look at is a newsletter nobody reads.
//
//   On paper it becomes a printed newsletter: two columns, the lead
//   across the top, sections kept off page breaks, and the parish's
//   name and address at the foot of every sheet. Printed for the
//   noticeboard and for parishioners who do not use email.
//
// The rendering is in the browser rather than at build time because an
// issue is a database row — posting one must not need a deploy.
---

<Layout title="Parish Newsletter | St. John of Kronstadt Orthodox Mission">
  <meta slot="head" name="robots" content="noindex" />

  <style is:global>
    /* ---------- On screen ---------- */

    /* The opening letter of the lead, as a printed newsletter sets it. */
    .nl-lead::first-letter {
      float: left;
      font-family: var(--font-display, serif);
      font-size: 3.6rem;
      line-height: 0.82;
      padding: 0.1rem 0.5rem 0 0;
      color: var(--color-brand-tan-dark);
    }

    /* The gold rule that stands before every headline. */
    .nl-head {
      border-left: 4px solid var(--color-sacred-gold);
      padding-left: 0.85rem;
    }

    .nl-body p { margin-bottom: 1em; }
    .nl-body p:last-child { margin-bottom: 0; }

    /* ---------- On paper ---------- */
    @media print {
      header, footer, nav, .no-print { display: none !important; }

      body, .nl-sheet {
        background: #fff !important;
        box-shadow: none !important;
        color: #000 !important;
      }

      @page {
        margin: 14mm 12mm 16mm;
      }

      .nl-sheet { border: 0 !important; padding: 0 !important; max-width: none !important; }

      /* The masthead spans both columns at the top of the first sheet. */
      .nl-masthead { border-bottom: 2px solid #000; }
      .nl-lead::first-letter { color: #000; }

      /* Two columns, the way a newsletter is read on paper. A single
         measure across a sheet of A4 is far too wide for comfort. */
      .nl-columns {
        column-count: 2;
        column-gap: 10mm;
        column-rule: 1px solid #ddd;
      }

      /* A headline must not be the last thing on a page, and a section
         should not be split across sheets if it can be helped. */
      .nl-section { break-inside: avoid-page; }
      .nl-head { break-after: avoid-page; }
      figure, blockquote { break-inside: avoid; }

      .nl-print-footer { display: block !important; }
      a[href]::after { content: ""; }
      img { max-width: 100% !important; }
    }
  </style>

  <main class="mx-auto max-w-4xl px-4 py-10 md:px-6">
    <p class="no-print font-display text-xs uppercase tracking-widest text-brand-tan-dark">
      <a href="/newsletter/" class="text-brand-tan-dark no-underline hover:underline">
        ← All issues
      </a>
    </p>

    <p id="issue-loading" class="mt-8 text-sm italic text-text-secondary">Loading…</p>
    <div id="issue-error" hidden role="alert" class="mt-8 text-sm"></div>

    <p
      id="issue-draft"
      hidden
      class="no-print mt-6 border-l-2 border-liturgical-red bg-cream-card p-4 text-sm"
    >
      <strong class="text-text-primary">This issue is still a draft.</strong>
      Only admins can see this page, and it has not been emailed to anyone.
    </p>

    <article id="issue-sheet" hidden class="nl-sheet mt-6">
      <!-- Masthead -->
      <header class="nl-masthead border-b-2 border-sacred-gold pb-5">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p id="issue-label" class="font-display text-xs uppercase tracking-[0.2em] text-brand-tan-dark"></p>
          <p id="issue-date" class="font-display text-xs uppercase tracking-[0.2em] text-brand-tan-dark"></p>
        </div>
        <h1
          id="issue-title"
          class="mt-3 font-display text-4xl leading-tight text-text-primary md:text-5xl"
        ></h1>
        <p class="mt-2 font-display text-[0.7rem] uppercase tracking-[0.3em] text-text-secondary">
          St. John of Kronstadt Orthodox Mission
        </p>
      </header>

      <figure id="issue-hero" hidden class="mt-6 m-0">
        <img id="issue-hero-img" alt="" class="w-full border border-border-soft" />
        <figcaption
          id="issue-hero-caption"
          class="mt-2 text-xs italic text-text-secondary"
        ></figcaption>
      </figure>

      <div id="issue-intro" class="nl-lead nl-body mt-7 text-lg leading-relaxed text-text-primary/90"></div>

      <div id="issue-sections" class="nl-columns"></div>

      <div
        id="issue-closing"
        hidden
        class="nl-body mt-10 border-t-2 border-sacred-gold bg-cream-card p-5 leading-relaxed text-text-primary/85"
      ></div>

      <!-- Only on paper. A sheet pinned to a noticeboard has to say
           whose it is and how to find them. -->
      <div class="nl-print-footer mt-10 hidden border-t border-border-soft pt-4 text-xs text-text-secondary">
        <p>
          St. John of Kronstadt Orthodox Mission · 39737 Palm Lane, Bayview, TX 78566 ·
          (956) 434-6874
        </p>
        <p class="mt-1">stjohnrgv.org</p>
      </div>
    </article>

    <div id="issue-actions" hidden class="no-print mt-8 flex flex-wrap items-center gap-3">
      <button type="button" id="print-issue" class="btn btn-secondary">Print this issue</button>
      <span class="text-sm text-text-secondary">
        Prints as a newsletter — two columns, with the parish's details at the foot.
      </span>
    </div>
  </main>
</Layout>

<script>
  import { pairSections } from "../../lib/newsletter";

  type Section = {
    key?: string;
    heading: string;
    body: string;
    /** Unticked in the admin form — kept in the draft, not printed. */
    include?: boolean;
    image?: string;
    image_alt?: string;
    image_caption?: string;
    quote?: string;
    quote_by?: string;
  };
  type Issue = {
    slug: string;
    title: string;
    issue_label: string | null;
    intro: string | null;
    sections: Section[] | null;
    closing: string | null;
    hero_image?: string | null;
    hero_image_alt?: string | null;
    published_at: string | null;
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  /** Blank lines part paragraphs — the only formatting there is. */
  function paragraphs(text: string | null | undefined): string {
    return String(text ?? "")
      .split(/\n{2,}/)
      .map((p) => p.trim())
      .filter(Boolean)
      .map((p) => `<p>${escapeHtml(p).replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  /** Stored as an R2 key; an absolute URL passes through. */
  function imageSrc(key: string | null | undefined): string {
    const k = String(key ?? "").trim();
    if (!k) return "";
    if (/^https?:\/\//i.test(k)) return k;
    return `/api/newsletter/image?key=${encodeURIComponent(k)}`;
  }

  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  const slug = new URLSearchParams(location.search).get("slug") ?? "";
  const errorEl = document.getElementById("issue-error") as HTMLDivElement;

  function showError(html: string, gentle = false) {
    (document.getElementById("issue-loading") as HTMLElement).hidden = true;
    errorEl.className = gentle
      ? "mt-8 border-l-2 border-sacred-gold bg-cream-card p-5 text-sm leading-relaxed"
      : "mt-8 text-sm text-liturgical-red";
    errorEl.innerHTML = html;
    errorEl.hidden = false;
  }

  /**
   * One section. The photograph alternates side by side with the text
   * and swaps sides down the page, which is what stops a long issue
   * looking like a wall. A section with no photograph simply runs the
   * full measure.
   */
  function sectionHtml(s: Section, bare = false, withFigure = true): string {
    const img = withFigure ? imageSrc(s.image) : "";
    // The whole picture, every time. This used to be forced into a
    // 3:1 letterbox with object-cover, which threw away half of a
    // painting somebody had commissioned and composed — the subject
    // along with it. It is capped in width instead, so a tall-ish
    // picture is small rather than cut.
    const figure = img
      ? `<figure class="m-0 mx-auto max-w-[640px]">
           <img src="${escapeHtml(img)}" alt="${escapeHtml(s.image_alt ?? "")}"
                class="block h-auto w-full border border-border-soft" loading="lazy" />
           ${
             s.image_caption
               ? `<figcaption class="mt-1.5 text-center text-xs italic text-text-secondary">${escapeHtml(s.image_caption)}</figcaption>`
               : ""
           }
         </figure>`
      : "";

    const quote = s.quote
      ? `<blockquote class="mt-5 border-y border-border-soft py-4 text-center">
           <p class="font-display text-lg italic leading-relaxed text-text-primary/90">
             &ldquo;${escapeHtml(s.quote)}&rdquo;
           </p>
           ${
             s.quote_by
               ? `<cite class="mt-2 block text-xs uppercase not-italic tracking-widest text-brand-tan-dark">${escapeHtml(s.quote_by)}</cite>`
               : ""
           }
         </blockquote>`
      : "";

    const prose = `<div class="nl-body leading-relaxed text-text-primary/85">${paragraphs(s.body)}</div>`;

    // A banner across the top of the section, above its headline —
    // not a photograph beside the text. Two reasons. Email strips
    // side-by-side layout, so this is the one arrangement where the
    // page and the inbox look the same. And a wide, short image reads
    // as a section marker, which is what it is being asked to do.
    // `bare` drops the wrapper so a paired section can supply its
    // own — otherwise the pair's margin and each half's would stack.
    const body = `${figure}
      ${
        s.heading
          ? `<h2 class="nl-head mt-4 font-display text-2xl text-text-primary">${escapeHtml(s.heading)}</h2>`
          : ""
      }
      <div class="mt-4">${prose}</div>
      ${quote}`;
    return bare ? body : `<section class="nl-section mt-10 break-inside-avoid">${body}</section>`;
  }

  (async () => {
    if (!slug) {
      showError(
        'No issue was named. <a href="/newsletter/" class="font-semibold text-brand-blue-dark">See all issues</a>.',
      );
      return;
    }
    try {
      const res = await fetch(`/api/newsletter?slug=${encodeURIComponent(slug)}`, {
        credentials: "same-origin",
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        // Not an error — this issue simply isn't theirs to read yet.
        if (res.status === 403 && body.needs_account) {
          showError(
            `${escapeHtml(body.error)} ` +
              `<a href="/login/?next=${encodeURIComponent(location.pathname + location.search)}" class="font-semibold text-brand-blue-dark">Sign in</a> or ` +
              '<a href="/register" class="font-semibold text-brand-blue-dark">create an account</a>.',
            true,
          );
          return;
        }
        showError(escapeHtml(body.error ?? `Could not load this issue (${res.status}).`));
        return;
      }

      const issue = body.issue as Issue;
      if (body.draft) (document.getElementById("issue-draft") as HTMLElement).hidden = false;
      document.title = `${issue.title} | Parish Newsletter`;
      setText("issue-label", issue.issue_label ?? "");
      setText("issue-title", issue.title);
      setText(
        "issue-date",
        issue.published_at
          ? new Date(issue.published_at).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          : "",
      );

      const hero = imageSrc(issue.hero_image);
      if (hero) {
        (document.getElementById("issue-hero") as HTMLElement).hidden = false;
        const heroImg = document.getElementById("issue-hero-img") as HTMLImageElement;
        heroImg.src = hero;
        heroImg.alt = issue.hero_image_alt ?? "";
        const cap = document.getElementById("issue-hero-caption") as HTMLElement;
        cap.textContent = issue.hero_image_alt ?? "";
        cap.hidden = !issue.hero_image_alt;
      }

      (document.getElementById("issue-intro") as HTMLElement).innerHTML = paragraphs(issue.intro);

      // The permanent sections are stored every month whether or not
      // they are used, so what is printed is only the ones ticked and
      // actually written. A heading with nothing under it would reach
      // the parish as a title followed by blank space.
      const sections = (Array.isArray(issue.sections) ? issue.sections : []).filter(
        (s) => s.include !== false && (s.body || s.image),
      );
      // The two prayer lists sit side by side; everything else runs
      // the full measure. pairSections() is shared with the email, so
      // the page and the inbox can't drift on which sections pair.
      (document.getElementById("issue-sections") as HTMLElement).innerHTML = pairSections(sections)
        .map((slot) =>
          slot.pair
            ? `<section class="nl-section mt-10 break-inside-avoid">
                 ${
                   imageSrc(slot.left.image || slot.right.image)
                     ? `<figure class="m-0 mx-auto mb-5 max-w-[640px]">
                          <img src="${escapeHtml(imageSrc(slot.left.image || slot.right.image))}"
                               alt="${escapeHtml(slot.left.image_alt ?? slot.right.image_alt ?? "")}"
                               class="block h-auto w-full border border-border-soft" loading="lazy" />
                        </figure>`
                     : ""
                 }
                 <div class="grid gap-6 sm:grid-cols-2 sm:divide-x sm:divide-border-soft">
                   <div>${sectionHtml(slot.left, true, false)}</div>
                   <div class="sm:pl-6">${sectionHtml(slot.right, true, false)}</div>
                 </div>
               </section>`
            : sectionHtml(slot.section),
        )
        .join("");

      if (issue.closing) {
        const closing = document.getElementById("issue-closing") as HTMLElement;
        closing.hidden = false;
        closing.innerHTML = paragraphs(issue.closing);
      }

      (document.getElementById("issue-loading") as HTMLElement).hidden = true;
      (document.getElementById("issue-sheet") as HTMLElement).hidden = false;
      (document.getElementById("issue-actions") as HTMLElement).hidden = false;
    } catch (err) {
      showError(
        escapeHtml(
          `Could not load this issue: ${err instanceof Error ? err.message : String(err)}`,
        ),
      );
    }
  })();

  document.getElementById("print-issue")?.addEventListener("click", () => window.print());
</script>
