---
import Layout from "../../layouts/Layout.astro";

// One issue of the parish newsletter.
//
// Two presentations of one issue, from one set of data:
//
//   On screen it scrolls — a masthead, a lead with a drop cap, then
//   sections that alternate their photographs left and right so the
//   page does not read as one long column of grey text. A newsletter
//   nobody wants to look at is a newsletter nobody reads.
//
//   On paper it becomes a printed newsletter: two columns, the lead
//   across the top, sections kept off page breaks, and the parish's
//   name and address at the foot of every sheet. Printed for the
//   noticeboard and for parishioners who do not use email.
//
// The rendering is in the browser rather than at build time because an
// issue is a database row — posting one must not need a deploy.
---

<Layout title="Parish Newsletter | St. John of Kronstadt Orthodox Mission">
  <meta slot="head" name="robots" content="noindex" />

  <style is:global>
    /* ================= THE NEWSLETTER =================
       Built against the page the parish laid out herself, which is
       the only specification that has actually worked: a band across
       the top, the picture full width and about two inches tall, the
       opening in a navy box on the left with the contents boxed
       beside it, and all of it on a sheet of letter paper. */

    .nl-paper {
      width: 100%;
      max-width: 8.5in;
      min-height: 11in;
      margin-inline: auto;
      background: #FFFFFF;
      border: 1px solid var(--color-border-soft, #e0d9c8);
      box-shadow: 0 2px 18px rgba(44, 62, 80, 0.13);
      display: flex;
      flex-direction: column;
      /* Paper in both themes: the text tokens follow the theme and
         this surface does not. */
      --color-text-primary: #2C3E50;
      --color-text-secondary: #5C6B7A;
      color: #2C3E50;
    }
    #issue-sheets > .nl-paper + .nl-paper { margin-top: 2rem; }
    @media (max-width: 900px) { .nl-paper { min-height: 0; } }

    /* The band. */
    .nl-band {
      background: #1F3A5F;
      color: #FFFFFF;
      padding: 1.1rem 1.4rem 0.8rem;
      position: relative;
    }
    .nl-band h1 {
      font-size: clamp(1.3rem, 3.6vw, 2.1rem);
      line-height: 1.05;
      white-space: nowrap;
    }
    .nl-band .nl-where { font-size: 0.8rem; color: #CBD9E8; }
    .nl-band .nl-when {
      position: absolute;
      right: 1.4rem;
      bottom: 0.7rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: #E8C877;
    }

    /* The picture: the whole width, about two inches tall. Cropped on
       purpose — a two-inch band from a 3:2 painting has to be. */
    .nl-hero {
      display: block;
      width: 100%;
      height: 2in;
      object-fit: cover;
      object-position: center;
    }
    @media (max-width: 640px) { .nl-hero { height: 1.4in; } }

    .nl-inner { flex: 1 1 auto; padding: 0.85rem 1.4rem 1rem; }

    /* The lead row: the opening wide on the left, the contents
       narrower on the right, as the parish set it. */
    .nl-lead-row {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: 0.85rem;
      align-items: start;
    }
    .nl-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
      align-items: start;
      margin-top: 0.85rem;
    }
    @media (max-width: 640px) {
      .nl-lead-row, .nl-row { grid-template-columns: minmax(0, 1fr); }
    }

    /* A navy panel, for the lead and for any section set in colour. */
    .nl-panel {
      background: #1F3A5F;
      color: #F2F6FA;
      padding: 0.9rem 1rem;
    }
    .nl-panel h2 { color: #FFFFFF; }

    /* A bordered white box, for the contents and for lists. */
    .nl-box {
      border: 2px solid #1F3A5F;
      padding: 0.9rem 1rem;
    }
    .nl-box h2 { color: #1F3A5F; }

    .nl-block { break-inside: avoid; }
    .nl-head { break-after: avoid; }

    /* Newsletter type is small — that is how a page of words fits on
       a page. */
    .nl-body { font-size: 0.76rem; line-height: 1.45; }
    .nl-body p { margin-bottom: 0.7em; }
    .nl-body p:last-child { margin-bottom: 0; }

    .nl-foot {
      padding: 0.5rem 1.4rem;
      border-top: 2px solid #1F3A5F;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #5C6B7A;
    }

    /* ---------- On paper ---------- */
    @media print {
      header:not(.nl-band), footer, nav, .no-print { display: none !important; }
      html, body { background: #fff !important; }
      @page { size: letter; margin: 0; }
      .nl-paper {
        width: 8.5in !important;
        max-width: none !important;
        border: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
        break-after: page;
      }
      .nl-paper:last-child { break-after: auto; }
      a[href]::after { content: ""; }
      img { max-width: 100% !important; }
    }
  </style>

  <main class="mx-auto max-w-[920px] px-4 py-10 md:px-6">
    <p class="no-print font-display text-xs uppercase tracking-widest text-brand-tan-dark">
      <a href="/newsletter/" class="text-brand-tan-dark no-underline hover:underline">
        &larr; All issues
      </a>
    </p>

    <p id="issue-loading" class="mt-8 text-sm italic text-text-secondary">Loading&hellip;</p>
    <div id="issue-error" hidden role="alert" class="mt-8 text-sm"></div>

    <p
      id="issue-draft"
      hidden
      class="no-print mt-6 border-l-2 border-liturgical-red bg-cream-card p-4 text-sm"
    >
      <strong class="text-text-primary">This issue is still a draft.</strong>
      Only admins can see this page, and it has not been emailed to anyone.
    </p>

    <!-- The sheets are built in script: how many there are depends on
         how much was written, so they cannot be laid out here. -->
    <div id="issue-sheets" class="mt-6"></div>

    <div id="issue-actions" hidden class="no-print mt-8 flex flex-wrap items-center gap-3">
      <button type="button" id="download-pdf" class="btn btn-secondary">Download as PDF</button>
      <span id="pdf-hint" class="text-sm text-text-secondary">
        One sheet to a page. Choose <strong>Save as PDF</strong> when the dialog opens.
      </span>
    </div>
  </main>
</Layout>

<script>
  import { pairSections } from "../../lib/newsletter";

  type Section = {
    key?: string;
    heading: string;
    body: string;
    /** Unticked in the admin form — kept in the draft, not printed. */
    include?: boolean;
    image?: string;
    image_alt?: string;
    image_caption?: string;
    quote?: string;
    quote_by?: string;
  };
  type Issue = {
    slug: string;
    title: string;
    issue_label: string | null;
    intro: string | null;
    sections: Section[] | null;
    closing: string | null;
    hero_image?: string | null;
    hero_image_alt?: string | null;
    published_at: string | null;
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  /** Blank lines part paragraphs — the only formatting there is. */
  function paragraphs(text: string | null | undefined): string {
    return String(text ?? "")
      .split(/\n{2,}/)
      .map((p) => p.trim())
      .filter(Boolean)
      .map((p) => `<p>${escapeHtml(p).replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  /** Stored as an R2 key; an absolute URL passes through. */
  function imageSrc(key: string | null | undefined): string {
    const k = String(key ?? "").trim();
    if (!k) return "";
    if (/^https?:\/\//i.test(k)) return k;
    return `/api/newsletter/image?key=${encodeURIComponent(k)}`;
  }


  const slug = new URLSearchParams(location.search).get("slug") ?? "";
  const errorEl = document.getElementById("issue-error") as HTMLDivElement;

  function showError(html: string, gentle = false) {
    (document.getElementById("issue-loading") as HTMLElement).hidden = true;
    errorEl.className = gentle
      ? "mt-8 border-l-2 border-sacred-gold bg-cream-card p-5 text-sm leading-relaxed"
      : "mt-8 text-sm text-liturgical-red";
    errorEl.innerHTML = html;
    errorEl.hidden = false;
  }

  // ================= THE ISSUE =================
  //
  // One newsletter, laid in columns, that the browser breaks wherever
  // it needs to — on screen by scrolling, on paper by turning the
  // page.
  //
  // What was here before paginated by hand: it measured sheets, moved
  // pieces between them, swept empty ones away before printing. All of
  // that fought the print engine, which relays the whole document for
  // paper with a different width and different fonts, so the sheets
  // were never the pages. Every fix moved the breakage somewhere else.
  // There is no pagination left to go wrong.

  function issueDateLabel(value: string | null | undefined): string {
    if (!value) return "";
    const d = new Date(value);
    return Number.isNaN(d.getTime())
      ? ""
      : d.toLocaleDateString("en-US", { year: "numeric", month: "short" });
  }

  /** The name a section is printed under. */
  function sectionTitle(s: Section): string {
    if (s.key === "prayer" || s.key === "memorial") {
      return (s.heading || "").split(/\s+[—–-]\s+/)[0];
    }
    return s.heading || "";
  }

  /** A list — service times, a rota, names — rather than prose. */
  function isList(s: Section): boolean {
    const lines = (s.body || "").split("\n").filter((l) => l.trim());
    if (lines.length < 2) return false;
    return lines.filter((l) => l.trim().length < 80).length / lines.length > 0.7;
  }

  function figure(s: Section): string {
    const src = imageSrc(s.image);
    if (!src) return "";
    return `<figure class="m-0 mb-2">
      <img src="${escapeHtml(src)}" alt="${escapeHtml(s.image_alt ?? "")}"
           class="block h-auto w-full" loading="lazy" />
      ${s.image_caption ? `<figcaption class="mt-1 text-[0.6rem] italic text-text-secondary">${escapeHtml(s.image_caption)}</figcaption>` : ""}
    </figure>`;
  }

  /** One section, as a box or a panel. */
  function blockHtml(s: Section): string {
    const title = sectionTitle(s);
    const boxed = isList(s);
    return `<section class="nl-block ${boxed ? "nl-box" : ""}">
      ${figure(s)}
      ${title ? `<h2 class="nl-head font-display text-base leading-tight ${boxed ? "" : "text-text-primary"}">${escapeHtml(title)}</h2>` : ""}
      <div class="nl-body mt-1.5">${paragraphs(s.body)}</div>
      ${
        s.quote
          ? `<blockquote class="mt-2 border-y border-border-soft py-2 text-center">
               <p class="font-display text-sm italic leading-snug">&ldquo;${escapeHtml(s.quote)}&rdquo;</p>
               ${s.quote_by ? `<cite class="mt-1 block text-[0.55rem] uppercase not-italic tracking-widest text-brand-tan-dark">${escapeHtml(s.quote_by)}</cite>` : ""}
             </blockquote>`
          : ""
      }
    </section>`;
  }

  function contentsHtml(headings: string[]): string {
    if (!headings.length) return "";
    const rows = headings
      .map((h) => `<li class="border-b border-[#D6E0EA] py-1.5">${escapeHtml(h)}</li>`)
      .join("");
    return `<aside class="nl-block nl-box">
      <h2 class="font-display text-lg leading-tight">Inside This Issue:</h2>
      <ul class="nl-body mt-2 list-none">${rows}</ul>
      <p class="mt-2 text-[0.6rem] leading-relaxed text-text-secondary">
        39737 Palm Lane, Bayview, TX 78566<br />(956) 434-6874<br />stjohnrgv.org
      </p>
    </aside>`;
  }

  function renderIssue(issue: Issue, slots: ReturnType<typeof pairSections>) {
    const host = document.getElementById("issue-sheets") as HTMLElement;

    const headings: string[] = [];
    const blocks: string[] = [];

    for (const slot of slots) {
      if (slot.pair) {
        const title = sectionTitle(slot.left);
        headings.push(title);
        blocks.push(`<section class="nl-block nl-box" style="grid-column:1/-1">
          <h2 class="nl-head font-display text-base leading-tight">${escapeHtml(title)}</h2>
          <div class="mt-2 grid gap-3 sm:grid-cols-2">
            <div class="nl-body">
              <p class="mb-1 font-display text-[0.6rem] uppercase tracking-widest text-brand-tan-dark">For the Living</p>
              ${paragraphs(slot.left.body)}
            </div>
            <div class="nl-body">
              <p class="mb-1 font-display text-[0.6rem] uppercase tracking-widest text-brand-tan-dark">In Memory</p>
              ${paragraphs(slot.right.body)}
            </div>
          </div>
        </section>`);
      } else {
        const title = sectionTitle(slot.section);
        if (title) headings.push(title);
        blocks.push(blockHtml(slot.section));
      }
    }

    const hero = imageSrc(issue.hero_image);
    const band = `<header class="nl-band">
        <h1 class="font-display">St. John of Kronstadt</h1>
        <p class="nl-where">Orthodox Mission, Bayview, Texas</p>
        <span class="nl-when">${escapeHtml(issue.issue_label || issueDateLabel(issue.published_at))}</span>
      </header>
      ${hero ? `<img class="nl-hero" src="${escapeHtml(hero)}" alt="${escapeHtml(issue.hero_image_alt ?? "")}" />` : ""}`;

    const foot = (n: string) => `<div class="nl-foot">
        <span>St. John of Kronstadt &middot; Orthodox Mission &middot; RGV</span>
        <span>${n}</span>
      </div>`;

    // The opening in a navy panel, the contents boxed beside it —
    // the arrangement the parish laid out by hand.
    const leadRow = `<div class="nl-lead-row">
      <section class="nl-block nl-panel">
        <h2 class="font-display text-lg leading-tight">${escapeHtml(issue.title)}</h2>
        <div class="nl-body mt-2">${paragraphs(issue.intro)}</div>
      </section>
      ${contentsHtml(headings)}
    </div>`;

    // Two to a row, two rows to a page after the first — no
    // measuring, so nothing can drift.
    const pages: string[] = [];
    let page: string[] = [];
    const rows: string[] = [];
    for (let i = 0; i < blocks.length; i += 2) {
      rows.push(`<div class="nl-row">${blocks.slice(i, i + 2).join("")}</div>`);
    }
    if ((issue.closing ?? "").trim()) {
      rows.push(`<div class="nl-row"><section class="nl-block" style="grid-column:1/-1"><div class="nl-body border-t-2 border-[#1F3A5F] pt-2">${paragraphs(issue.closing)}</div></section></div>`);
    }

    // Page one carries the band, the picture, the opening and the
    // contents — and nothing else, which is how the parish laid it
    // out. Putting a row of sections on it as well made the sheet
    // fifteen inches long.
    pages.push(`${band}<div class="nl-inner">${leadRow}</div>`);
    // One row of two sections to a page after that. Two rows ran a
    // sheet to fourteen inches; a page is eleven.
    while (rows.length) {
      page = rows.splice(0, 1);
      pages.push(`<div class="nl-inner">${page.join("")}</div>`);
    }

    host.innerHTML = pages
      .map((inner, i) => `<article class="nl-paper">${inner}${foot(`${i + 1} / ${pages.length}`)}</article>`)
      .join("");
  }

  (async () => {
    if (!slug) {
      showError(
        'No issue was named. <a href="/newsletter/" class="font-semibold text-brand-blue-dark">See all issues</a>.',
      );
      return;
    }
    try {
      const res = await fetch(`/api/newsletter?slug=${encodeURIComponent(slug)}`, {
        credentials: "same-origin",
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        // Not an error — this issue simply isn't theirs to read yet.
        if (res.status === 403 && body.needs_account) {
          showError(
            `${escapeHtml(body.error)} ` +
              `<a href="/login/?next=${encodeURIComponent(location.pathname + location.search)}" class="font-semibold text-brand-blue-dark">Sign in</a> or ` +
              '<a href="/register" class="font-semibold text-brand-blue-dark">create an account</a>.',
            true,
          );
          return;
        }
        showError(escapeHtml(body.error ?? `Could not load this issue (${res.status}).`));
        return;
      }

      const issue = body.issue as Issue;
      if (body.draft) (document.getElementById("issue-draft") as HTMLElement).hidden = false;
      document.title = `${issue.title} | Parish Newsletter`;
      // The permanent sections are stored every month whether or not
      // they are used, so what is printed is only the ones ticked and
      // actually written. A heading with nothing under it would reach
      // the parish as a title followed by blank space.
      const sections = (Array.isArray(issue.sections) ? issue.sections : []).filter(
        (s) => s.include !== false && (s.body || s.image),
      );
      // pairSections() is shared with the email, so the page and the
      // inbox cannot drift on which sections sit together.
      renderIssue(issue, pairSections(sections));

      (document.getElementById("issue-loading") as HTMLElement).hidden = true;
      (document.getElementById("issue-actions") as HTMLElement).hidden = false;
    } catch (err) {
      showError(
        escapeHtml(
          `Could not load this issue: ${err instanceof Error ? err.message : String(err)}`,
        ),
      );
    }
  })();

  /**
   * Hand over a PDF.
   *
   * Nobody is going to print this on paper, so the button says what
   * people actually want. There is no server here that can render a
   * PDF — that needs a headless browser the site does not have — so
   * this opens the browser's own print dialog, where "Save as PDF" is
   * the default destination on a desktop and produces a far better
   * file than anything a JavaScript library would draw. The hint says
   * so plainly rather than letting the dialog be a surprise.
   */
  document.getElementById("download-pdf")?.addEventListener("click", () => window.print());
</script>
