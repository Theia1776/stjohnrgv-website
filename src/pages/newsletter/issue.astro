---
import Layout from "../../layouts/Layout.astro";

// One issue of the parish newsletter.
//
// Two presentations of one issue, from one set of data:
//
//   On screen it scrolls — a masthead, a lead with a drop cap, then
//   sections that alternate their photographs left and right so the
//   page does not read as one long column of grey text. A newsletter
//   nobody wants to look at is a newsletter nobody reads.
//
//   On paper it becomes a printed newsletter: two columns, the lead
//   across the top, sections kept off page breaks, and the parish's
//   name and address at the foot of every sheet. Printed for the
//   noticeboard and for parishioners who do not use email.
//
// The rendering is in the browser rather than at build time because an
// issue is a database row — posting one must not need a deploy.
---

<Layout title="Parish Newsletter | St. John of Kronstadt Orthodox Mission">
  <meta slot="head" name="robots" content="noindex" />

  <style is:global>
    /* ================= THE NEWSLETTER =================
       One sheet of paper that goes on as long as the issue does.
       There are no pages here: the browser breaks it, by scrolling on
       a screen and by turning the page on paper, and both of those it
       does well. Everything that used to measure and cut it into
       pages is gone — that machinery could not agree with the print
       engine about where a page ends, and every attempt to make it
       agree broke something else. */
    .nl-paper {
      background: #FFFFFF;
      border: 1px solid var(--color-border-soft, #e0d9c8);
      box-shadow: 0 2px 18px rgba(44, 62, 80, 0.13);
      padding: 2.75rem 2.5rem 1.5rem;
      /* Paper in both themes. The text tokens flip with the theme and
         this surface does not, so they are pinned here. */
      --color-text-primary: #2C3E50;
      --color-text-secondary: #5C6B7A;
      --color-brand-blue-dark: #2A5E84;
      color: #2C3E50;
    }
    @media (max-width: 639px) {
      .nl-paper { padding: 1.5rem 1.25rem 1rem; }
    }

    /* The parish on one line, whatever the width. */
    .nl-title {
      font-size: clamp(1.1rem, 3.4vw, 2rem);
      white-space: nowrap;
    }

    /* Three inches of picture under the masthead, not half a page.
       Held by width so the whole painting is there — the title is
       inside it and cropping would take the title off. */
    .nl-hero { max-width: 26rem; }

    /* Two columns, one on a phone. */
    .nl-flow { column-count: 2; column-gap: 2rem; column-rule: 1px solid #e7e1d4; }
    @media (max-width: 639px) { .nl-flow { column-count: 1; } }

    /* What must not be split: a picture with its headline, a quote
       box, the contents. Prose is free to run between columns, which
       is what fills the measure instead of leaving one empty. */
    .nl-keep, figure, blockquote, .nl-contents {
      break-inside: avoid;
      -webkit-column-break-inside: avoid;
    }
    .nl-head {
      break-after: avoid;
      border-left: 4px solid var(--color-sacred-gold, #C9A84C);
      padding-left: 0.85rem;
    }

    .nl-lead::first-letter {
      float: left;
      font-family: var(--font-display, serif);
      font-size: 3.4rem;
      line-height: 0.82;
      padding: 0.1rem 0.5rem 0 0;
      color: var(--color-brand-tan-dark, #A88758);
    }

    .nl-body p { margin-bottom: 0.9em; }
    .nl-body p:last-child { margin-bottom: 0; }

    .nl-foot {
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #e7e1d4;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #8a8577;
    }

    /* ---------- On paper ----------
       Nothing is forced. The paper decides where the pages are. */
    @media print {
      header, footer, nav, .no-print { display: none !important; }
      /* html, not just body. The site's cream lives on <html>, and
         that is what paints the page canvas — which is why a pale
         block kept printing below the end of the issue. It was never
         part of the newsletter. */
      html, body { background: #fff !important; }
      @page { margin: 13mm 11mm 15mm; }

      .nl-paper {
        border: 0 !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      /* A list of what is in the issue is for finding your way about
         a screen. On paper it is a coloured block taking up a column
         for nothing. */
      .nl-contents { display: none !important; }
      .nl-foot { display: none !important; }
      .nl-masthead { break-after: avoid; }
      .nl-hero { max-width: 20rem; }
      .nl-lead::first-letter { color: #000; }
      a[href]::after { content: ""; }
      img { max-width: 100% !important; }
    }
  </style>

  <main class="mx-auto max-w-[920px] px-4 py-10 md:px-6">
    <p class="no-print font-display text-xs uppercase tracking-widest text-brand-tan-dark">
      <a href="/newsletter/" class="text-brand-tan-dark no-underline hover:underline">
        &larr; All issues
      </a>
    </p>

    <p id="issue-loading" class="mt-8 text-sm italic text-text-secondary">Loading&hellip;</p>
    <div id="issue-error" hidden role="alert" class="mt-8 text-sm"></div>

    <p
      id="issue-draft"
      hidden
      class="no-print mt-6 border-l-2 border-liturgical-red bg-cream-card p-4 text-sm"
    >
      <strong class="text-text-primary">This issue is still a draft.</strong>
      Only admins can see this page, and it has not been emailed to anyone.
    </p>

    <!-- The sheets are built in script: how many there are depends on
         how much was written, so they cannot be laid out here. -->
    <div id="issue-sheets" class="mt-6"></div>

    <div id="issue-actions" hidden class="no-print mt-8 flex flex-wrap items-center gap-3">
      <button type="button" id="download-pdf" class="btn btn-secondary">Download as PDF</button>
      <span id="pdf-hint" class="text-sm text-text-secondary">
        One sheet to a page. Choose <strong>Save as PDF</strong> when the dialog opens.
      </span>
    </div>
  </main>
</Layout>

<script>
  import { pairSections } from "../../lib/newsletter";

  type Section = {
    key?: string;
    heading: string;
    body: string;
    /** Unticked in the admin form — kept in the draft, not printed. */
    include?: boolean;
    image?: string;
    image_alt?: string;
    image_caption?: string;
    quote?: string;
    quote_by?: string;
  };
  type Issue = {
    slug: string;
    title: string;
    issue_label: string | null;
    intro: string | null;
    sections: Section[] | null;
    closing: string | null;
    hero_image?: string | null;
    hero_image_alt?: string | null;
    published_at: string | null;
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  /** Blank lines part paragraphs — the only formatting there is. */
  function paragraphs(text: string | null | undefined): string {
    return String(text ?? "")
      .split(/\n{2,}/)
      .map((p) => p.trim())
      .filter(Boolean)
      .map((p) => `<p>${escapeHtml(p).replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  /** Stored as an R2 key; an absolute URL passes through. */
  function imageSrc(key: string | null | undefined): string {
    const k = String(key ?? "").trim();
    if (!k) return "";
    if (/^https?:\/\//i.test(k)) return k;
    return `/api/newsletter/image?key=${encodeURIComponent(k)}`;
  }


  const slug = new URLSearchParams(location.search).get("slug") ?? "";
  const errorEl = document.getElementById("issue-error") as HTMLDivElement;

  function showError(html: string, gentle = false) {
    (document.getElementById("issue-loading") as HTMLElement).hidden = true;
    errorEl.className = gentle
      ? "mt-8 border-l-2 border-sacred-gold bg-cream-card p-5 text-sm leading-relaxed"
      : "mt-8 text-sm text-liturgical-red";
    errorEl.innerHTML = html;
    errorEl.hidden = false;
  }

  // ================= THE ISSUE =================
  //
  // One newsletter, laid in columns, that the browser breaks wherever
  // it needs to — on screen by scrolling, on paper by turning the
  // page.
  //
  // What was here before paginated by hand: it measured sheets, moved
  // pieces between them, swept empty ones away before printing. All of
  // that fought the print engine, which relays the whole document for
  // paper with a different width and different fonts, so the sheets
  // were never the pages. Every fix moved the breakage somewhere else.
  // There is no pagination left to go wrong.

  function issueDateLabel(value: string | null | undefined): string {
    if (!value) return "";
    const d = new Date(value);
    return Number.isNaN(d.getTime())
      ? ""
      : d.toLocaleDateString("en-US", { year: "numeric", month: "long" });
  }

  /** The name a section is printed under. */
  function sectionTitle(s: Section): string {
    // "Prayer Requests — For the Living" standing on its own is just
    // Prayer Requests. The halves only need telling apart when both
    // are there, side by side, and then the column headings do it.
    if (s.key === "prayer" || s.key === "memorial") {
      return (s.heading || "").split(/\s+[—–-]\s+/)[0];
    }
    return s.heading || "";
  }

  function figureHtml(src: string, alt: string, caption?: string): string {
    if (!src) return "";
    return `<figure class="m-0 mb-3">
      <img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}"
           class="block h-auto w-full border border-border-soft" loading="lazy" />
      ${
        caption
          ? `<figcaption class="mt-1.5 text-xs italic text-text-secondary">${escapeHtml(caption)}</figcaption>`
          : ""
      }
    </figure>`;
  }

  /**
   * One section.
   *
   * The picture and the headline are one block that cannot be split,
   * so a photograph can never end up in a different column from the
   * title it belongs to — which is what went wrong when the sections
   * were allowed to break anywhere. The prose below them runs between
   * columns freely, which is what fills a page.
   */
  function sectionHtml(s: Section, titleOverride?: string): string {
    const title = titleOverride ?? sectionTitle(s);
    const head = `<div class="nl-keep">
      ${figureHtml(imageSrc(s.image), s.image_alt ?? "", s.image_caption)}
      ${title ? `<h2 class="nl-head font-display text-2xl text-text-primary">${escapeHtml(title)}</h2>` : ""}
    </div>`;

    const quote = s.quote
      ? `<blockquote class="nl-keep my-5 border-y border-border-soft py-4 text-center">
           <p class="font-display text-lg italic leading-relaxed text-text-primary/90">
             &ldquo;${escapeHtml(s.quote)}&rdquo;
           </p>
           ${
             s.quote_by
               ? `<cite class="mt-2 block text-xs uppercase not-italic tracking-widest text-brand-tan-dark">${escapeHtml(s.quote_by)}</cite>`
               : ""
           }
         </blockquote>`
      : "";

    return `<section class="mb-8">
      ${head}
      <div class="nl-body mt-3 leading-relaxed text-text-primary/85">${paragraphs(s.body)}</div>
      ${quote}
    </section>`;
  }

  function contentsHtml(headings: string[]): string {
    if (headings.length < 2) return "";
    const rows = headings
      .map(
        (h) =>
          `<li class="flex items-baseline gap-2 text-sm"><span class="text-text-primary">${escapeHtml(h)}</span><span aria-hidden="true" class="min-w-[1rem] flex-1 translate-y-[-0.2rem] border-b border-dotted border-[#cdbfa0]"></span></li>`,
      )
      .join("");
    return `<aside class="nl-contents nl-keep mb-7 border-2 border-sacred-gold bg-[#FBF7EC] p-4">
      <p class="font-display text-sm uppercase tracking-[0.18em] text-brand-tan-dark">In This Issue</p>
      <ul class="mt-3 space-y-1.5">${rows}</ul>
      <p class="mt-4 border-t border-[#e0d4b8] pt-3 text-[0.7rem] leading-relaxed text-text-secondary">
        39737 Palm Lane, Bayview, TX 78566<br />
        (956) 434-6874<br />
        stjohnrgv.org
      </p>
    </aside>`;
  }

  function renderIssue(issue: Issue, slots: ReturnType<typeof pairSections>) {
    const host = document.getElementById("issue-sheets") as HTMLElement;

    const headings: string[] = [];
    const body: string[] = [];

    for (const slot of slots) {
      if (slot.pair) {
        const title = sectionTitle(slot.left);
        headings.push(title);
        const banner = imageSrc(slot.left.image || slot.right.image);
        body.push(`<section class="mb-8">
          <div class="nl-keep">
            ${figureHtml(banner, slot.left.image_alt ?? slot.right.image_alt ?? "")}
            <h2 class="nl-head font-display text-2xl text-text-primary">${escapeHtml(title)}</h2>
          </div>
          <div class="mt-3 grid gap-5 sm:grid-cols-2 sm:divide-x sm:divide-border-soft">
            <div class="nl-body leading-relaxed text-text-primary/85">
              <p class="mb-1 font-display text-xs uppercase tracking-widest text-brand-tan-dark">For the Living</p>
              ${paragraphs(slot.left.body)}
            </div>
            <div class="nl-body leading-relaxed text-text-primary/85 sm:pl-5">
              <p class="mb-1 font-display text-xs uppercase tracking-widest text-brand-tan-dark">In Memory</p>
              ${paragraphs(slot.right.body)}
            </div>
          </div>
        </section>`);
      } else {
        const title = sectionTitle(slot.section);
        if (title) headings.push(title);
        body.push(sectionHtml(slot.section, title));
      }
    }

    const hero = imageSrc(issue.hero_image);
    const heroHtml = hero
      ? `<figure class="nl-hero m-0 mx-auto mt-5">
           <img src="${escapeHtml(hero)}" alt="${escapeHtml(issue.hero_image_alt ?? "")}"
                class="block h-auto w-full border border-border-soft" />
         </figure>`
      : "";
    const closingHtml = (issue.closing ?? "").trim()
      ? `<div class="nl-keep mt-2 border-t-2 border-sacred-gold pt-4 nl-body leading-relaxed text-text-primary/85">${paragraphs(issue.closing)}</div>`
      : "";

    host.innerHTML = `<article class="nl-paper">
      <header class="nl-masthead border-b-[3px] border-sacred-gold pb-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2 text-[0.7rem] uppercase tracking-[0.2em] text-brand-tan-dark">
          <span>${escapeHtml(issue.issue_label ?? "")}</span>
          <span>${escapeHtml(issueDateLabel(issue.published_at))}</span>
        </div>
        <h1 class="nl-title mt-2 text-center font-display leading-tight text-text-primary">
          St. John of Kronstadt Orthodox Mission
        </h1>
      </header>
      ${heroHtml}
      <div class="nl-flow mt-6">
        ${issue.intro ? `<div class="nl-lead nl-body mb-6 leading-relaxed text-text-primary/90">${paragraphs(issue.intro)}</div>` : ""}
        ${contentsHtml(headings)}
        ${body.join("")}
        ${closingHtml}
      </div>
      <div class="nl-foot">
        <span>St. John of Kronstadt &middot; Orthodox Mission &middot; RGV</span>
        <span>stjohnrgv.org</span>
      </div>
    </article>`;
  }

  (async () => {
    if (!slug) {
      showError(
        'No issue was named. <a href="/newsletter/" class="font-semibold text-brand-blue-dark">See all issues</a>.',
      );
      return;
    }
    try {
      const res = await fetch(`/api/newsletter?slug=${encodeURIComponent(slug)}`, {
        credentials: "same-origin",
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        // Not an error — this issue simply isn't theirs to read yet.
        if (res.status === 403 && body.needs_account) {
          showError(
            `${escapeHtml(body.error)} ` +
              `<a href="/login/?next=${encodeURIComponent(location.pathname + location.search)}" class="font-semibold text-brand-blue-dark">Sign in</a> or ` +
              '<a href="/register" class="font-semibold text-brand-blue-dark">create an account</a>.',
            true,
          );
          return;
        }
        showError(escapeHtml(body.error ?? `Could not load this issue (${res.status}).`));
        return;
      }

      const issue = body.issue as Issue;
      if (body.draft) (document.getElementById("issue-draft") as HTMLElement).hidden = false;
      document.title = `${issue.title} | Parish Newsletter`;
      // The permanent sections are stored every month whether or not
      // they are used, so what is printed is only the ones ticked and
      // actually written. A heading with nothing under it would reach
      // the parish as a title followed by blank space.
      const sections = (Array.isArray(issue.sections) ? issue.sections : []).filter(
        (s) => s.include !== false && (s.body || s.image),
      );
      // pairSections() is shared with the email, so the page and the
      // inbox cannot drift on which sections sit together.
      renderIssue(issue, pairSections(sections));

      (document.getElementById("issue-loading") as HTMLElement).hidden = true;
      (document.getElementById("issue-actions") as HTMLElement).hidden = false;
    } catch (err) {
      showError(
        escapeHtml(
          `Could not load this issue: ${err instanceof Error ? err.message : String(err)}`,
        ),
      );
    }
  })();

  /**
   * Hand over a PDF.
   *
   * Nobody is going to print this on paper, so the button says what
   * people actually want. There is no server here that can render a
   * PDF — that needs a headless browser the site does not have — so
   * this opens the browser's own print dialog, where "Save as PDF" is
   * the default destination on a desktop and produces a far better
   * file than anything a JavaScript library would draw. The hint says
   * so plainly rather than letting the dialog be a surprise.
   */
  document.getElementById("download-pdf")?.addEventListener("click", () => window.print());
</script>
