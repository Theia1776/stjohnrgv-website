---
import Layout from "../../layouts/Layout.astro";

// One issue of the parish newsletter.
//
// Two presentations of one issue, from one set of data:
//
//   On screen it scrolls — a masthead, a lead with a drop cap, then
//   sections that alternate their photographs left and right so the
//   page does not read as one long column of grey text. A newsletter
//   nobody wants to look at is a newsletter nobody reads.
//
//   On paper it becomes a printed newsletter: two columns, the lead
//   across the top, sections kept off page breaks, and the parish's
//   name and address at the foot of every sheet. Printed for the
//   noticeboard and for parishioners who do not use email.
//
// The rendering is in the browser rather than at build time because an
// issue is a database row — posting one must not need a deploy.
---

<Layout title="Parish Newsletter | St. John of Kronstadt Orthodox Mission">
  <meta slot="head" name="robots" content="noindex" />

  <style is:global>
    /* ================= THE NEWSLETTER =================
       A grid of blocks, not a river of text.

       Every newsletter the parish has shown me works this way: each
       story sits in its own bounded region, pictures beside the
       headline they belong to, lists in tinted boxes. None of them
       flows a paragraph from the foot of one column into the top of
       the next.

       This page used to. That one choice caused nearly all of its
       trouble — text stranded in a column, photographs separated from
       their headings, words running off the edge, pages breaking
       mid-sentence. A block cannot do any of those things: it cannot
       split, so it cannot strand, orphan or overflow. */

    .nl-paper {
      background: #FFFFFF;
      border: 1px solid var(--color-border-soft, #e0d9c8);
      box-shadow: 0 2px 18px rgba(44, 62, 80, 0.13);
      /* Paper in both themes; the text tokens follow the theme and
         this surface does not. */
      --color-text-primary: #2C3E50;
      --color-text-secondary: #5C6B7A;
      --color-brand-blue-dark: #2A5E84;
      color: #2C3E50;
    }
    #issue-sheets > .nl-paper + .nl-paper { margin-top: 2rem; }

    /* The masthead band, as every one of those templates has. */
    .nl-band {
      background: #1F3A5F;
      color: #FAF7F0;
      padding: 1.5rem 2rem 1.25rem;
    }
    .nl-band .nl-edition { color: #C9A84C; }
    .nl-title {
      font-size: clamp(1.15rem, 3.2vw, 2rem);
      white-space: nowrap;
      color: #FAF7F0;
    }

    .nl-inner { padding: 1.75rem 2rem 1.25rem; }
    @media (max-width: 639px) {
      .nl-band { padding: 1.25rem 1.25rem 1rem; }
      .nl-inner { padding: 1.25rem 1.25rem 1rem; }
    }

    /* The grid. Two columns of blocks on a screen, one on a phone.
       A block may take the full width when it has a lot to say. */
    .nl-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: start;
    }
    @media (max-width: 639px) { .nl-grid { grid-template-columns: minmax(0, 1fr); } }
    .nl-wide { grid-column: 1 / -1; }

    /* A block. Bounded, never split. */
    .nl-block { break-inside: avoid; }
    .nl-boxed {
      background: #FBF7EC;
      border-left: 4px solid var(--color-sacred-gold, #C9A84C);
      padding: 1rem 1.1rem;
    }
    .nl-head {
      border-left: 4px solid var(--color-sacred-gold, #C9A84C);
      padding-left: 0.85rem;
      break-after: avoid;
    }

    .nl-lead::first-letter {
      float: left;
      font-family: var(--font-display, serif);
      font-size: 3.2rem;
      line-height: 0.82;
      padding: 0.1rem 0.5rem 0 0;
      color: var(--color-brand-tan-dark, #A88758);
    }

    .nl-body p { margin-bottom: 0.85em; }
    .nl-body p:last-child { margin-bottom: 0; }

    .nl-foot {
      background: #1F3A5F;
      color: #D8CBA8;
      padding: 0.7rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* ---------- On paper ----------
       Blocks do not split, so the paper breaks between them on its
       own. Nothing is forced and nothing needs measuring. */
    @media print {
      header:not(.nl-band), footer, nav, .no-print { display: none !important; }
      html, body { background: #fff !important; }
      @page { margin: 12mm 10mm 14mm; }

      .nl-paper {
        border: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
      }
      #issue-sheets > .nl-paper + .nl-paper { margin-top: 0 !important; }
      .nl-paper + .nl-paper .nl-band { display: none !important; }
      .nl-inner { padding: 0 !important; }
      .nl-contents { display: none !important; }
      .nl-foot { display: none !important; }
      .nl-band { break-after: avoid; }
      .nl-lead::first-letter { color: #000; }
      a[href]::after { content: ""; }
      img { max-width: 100% !important; }
    }
  </style>

  <main class="mx-auto max-w-[920px] px-4 py-10 md:px-6">
    <p class="no-print font-display text-xs uppercase tracking-widest text-brand-tan-dark">
      <a href="/newsletter/" class="text-brand-tan-dark no-underline hover:underline">
        &larr; All issues
      </a>
    </p>

    <p id="issue-loading" class="mt-8 text-sm italic text-text-secondary">Loading&hellip;</p>
    <div id="issue-error" hidden role="alert" class="mt-8 text-sm"></div>

    <p
      id="issue-draft"
      hidden
      class="no-print mt-6 border-l-2 border-liturgical-red bg-cream-card p-4 text-sm"
    >
      <strong class="text-text-primary">This issue is still a draft.</strong>
      Only admins can see this page, and it has not been emailed to anyone.
    </p>

    <!-- The sheets are built in script: how many there are depends on
         how much was written, so they cannot be laid out here. -->
    <div id="issue-sheets" class="mt-6"></div>

    <div id="issue-actions" hidden class="no-print mt-8 flex flex-wrap items-center gap-3">
      <button type="button" id="download-pdf" class="btn btn-secondary">Download as PDF</button>
      <span id="pdf-hint" class="text-sm text-text-secondary">
        One sheet to a page. Choose <strong>Save as PDF</strong> when the dialog opens.
      </span>
    </div>
  </main>
</Layout>

<script>
  import { pairSections } from "../../lib/newsletter";

  type Section = {
    key?: string;
    heading: string;
    body: string;
    /** Unticked in the admin form — kept in the draft, not printed. */
    include?: boolean;
    image?: string;
    image_alt?: string;
    image_caption?: string;
    quote?: string;
    quote_by?: string;
  };
  type Issue = {
    slug: string;
    title: string;
    issue_label: string | null;
    intro: string | null;
    sections: Section[] | null;
    closing: string | null;
    hero_image?: string | null;
    hero_image_alt?: string | null;
    published_at: string | null;
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  /** Blank lines part paragraphs — the only formatting there is. */
  function paragraphs(text: string | null | undefined): string {
    return String(text ?? "")
      .split(/\n{2,}/)
      .map((p) => p.trim())
      .filter(Boolean)
      .map((p) => `<p>${escapeHtml(p).replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  /** Stored as an R2 key; an absolute URL passes through. */
  function imageSrc(key: string | null | undefined): string {
    const k = String(key ?? "").trim();
    if (!k) return "";
    if (/^https?:\/\//i.test(k)) return k;
    return `/api/newsletter/image?key=${encodeURIComponent(k)}`;
  }


  const slug = new URLSearchParams(location.search).get("slug") ?? "";
  const errorEl = document.getElementById("issue-error") as HTMLDivElement;

  function showError(html: string, gentle = false) {
    (document.getElementById("issue-loading") as HTMLElement).hidden = true;
    errorEl.className = gentle
      ? "mt-8 border-l-2 border-sacred-gold bg-cream-card p-5 text-sm leading-relaxed"
      : "mt-8 text-sm text-liturgical-red";
    errorEl.innerHTML = html;
    errorEl.hidden = false;
  }

  // ================= THE ISSUE =================
  //
  // One newsletter, laid in columns, that the browser breaks wherever
  // it needs to — on screen by scrolling, on paper by turning the
  // page.
  //
  // What was here before paginated by hand: it measured sheets, moved
  // pieces between them, swept empty ones away before printing. All of
  // that fought the print engine, which relays the whole document for
  // paper with a different width and different fonts, so the sheets
  // were never the pages. Every fix moved the breakage somewhere else.
  // There is no pagination left to go wrong.

  function issueDateLabel(value: string | null | undefined): string {
    if (!value) return "";
    const d = new Date(value);
    return Number.isNaN(d.getTime())
      ? ""
      : d.toLocaleDateString("en-US", { year: "numeric", month: "long" });
  }

  /** The name a section is printed under. */
  function sectionTitle(s: Section): string {
    // "Prayer Requests — For the Living" standing alone is just
    // Prayer Requests. The halves need telling apart only when both
    // are there, and then the two columns do it.
    if (s.key === "prayer" || s.key === "memorial") {
      return (s.heading || "").split(/\s+[—–-]\s+/)[0];
    }
    return s.heading || "";
  }

  /**
   * Is this section a list rather than prose?
   *
   * Service times, coffee hour, upcoming events, a list of names —
   * every newsletter sets those in a tinted box rather than running
   * them as paragraphs, because that is how a reader finds them
   * again.
   */
  function isList(s: Section): boolean {
    const lines = (s.body || "").split("\n").filter((l) => l.trim());
    if (lines.length < 2) return false;
    const short = lines.filter((l) => l.trim().length < 80).length;
    return short / lines.length > 0.7;
  }

  function imageHtml(s: Section): string {
    const src = imageSrc(s.image);
    if (!src) return "";
    return `<figure class="m-0 mb-3">
      <img src="${escapeHtml(src)}" alt="${escapeHtml(s.image_alt ?? "")}"
           class="block h-auto w-full border border-border-soft" loading="lazy" />
      ${
        s.image_caption
          ? `<figcaption class="mt-1.5 text-xs italic text-text-secondary">${escapeHtml(s.image_caption)}</figcaption>`
          : ""
      }
    </figure>`;
  }

  function quoteHtml(s: Section): string {
    if (!s.quote) return "";
    return `<blockquote class="mt-4 border-y border-border-soft py-3 text-center">
      <p class="font-display text-base italic leading-relaxed text-text-primary/90">&ldquo;${escapeHtml(s.quote)}&rdquo;</p>
      ${
        s.quote_by
          ? `<cite class="mt-1.5 block text-[0.65rem] uppercase not-italic tracking-widest text-brand-tan-dark">${escapeHtml(s.quote_by)}</cite>`
          : ""
      }
    </blockquote>`;
  }

  /** One block. Self-contained: picture, headline, words. */
  function blockHtml(s: Section): string {
    const title = sectionTitle(s);
    // Never full width. A measure that runs the whole page is hard
    // to read and none of the templates sets prose that way — a long
    // section simply makes a tall block in its column.
    const boxed = isList(s);
    return `<section class="nl-block">
      ${imageHtml(s)}
      ${title ? `<h2 class="nl-head font-display text-xl text-text-primary md:text-2xl">${escapeHtml(title)}</h2>` : ""}
      <div class="nl-body mt-3 leading-relaxed text-text-primary/85 ${boxed ? "nl-boxed" : ""}">${paragraphs(s.body)}</div>
      ${quoteHtml(s)}
    </section>`;
  }

  function contentsHtml(headings: string[]): string {
    if (headings.length < 2) return "";
    const rows = headings
      .map(
        (h) =>
          `<li class="flex items-baseline gap-2 text-sm"><span>${escapeHtml(h)}</span><span aria-hidden="true" class="min-w-[1rem] flex-1 translate-y-[-0.2rem] border-b border-dotted border-[#cdbfa0]"></span></li>`,
      )
      .join("");
    return `<aside class="nl-block nl-contents nl-boxed">
      <p class="font-display text-sm uppercase tracking-[0.18em] text-brand-tan-dark">In This Issue</p>
      <ul class="mt-2.5 space-y-1.5 text-text-primary">${rows}</ul>
      <p class="mt-3 border-t border-[#e0d4b8] pt-2.5 text-[0.7rem] leading-relaxed text-text-secondary">
        39737 Palm Lane, Bayview, TX 78566<br />(956) 434-6874<br />stjohnrgv.org
      </p>
    </aside>`;
  }

  function renderIssue(issue: Issue, slots: ReturnType<typeof pairSections>) {
    const host = document.getElementById("issue-sheets") as HTMLElement;

    const headings: string[] = [];
    const blocks: string[] = [];

    for (const slot of slots) {
      if (slot.pair) {
        const title = sectionTitle(slot.left);
        headings.push(title);
        blocks.push(`<section class="nl-block nl-wide">
          ${imageHtml(slot.left.image ? slot.left : slot.right)}
          <h2 class="nl-head font-display text-xl text-text-primary md:text-2xl">${escapeHtml(title)}</h2>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="nl-boxed nl-body leading-relaxed text-text-primary/85">
              <p class="mb-1.5 font-display text-xs uppercase tracking-widest text-brand-tan-dark">For the Living</p>
              ${paragraphs(slot.left.body)}
            </div>
            <div class="nl-boxed nl-body leading-relaxed text-text-primary/85">
              <p class="mb-1.5 font-display text-xs uppercase tracking-widest text-brand-tan-dark">In Memory</p>
              ${paragraphs(slot.right.body)}
            </div>
          </div>
        </section>`);
      } else {
        const title = sectionTitle(slot.section);
        if (title) headings.push(title);
        blocks.push(blockHtml(slot.section));
      }
    }

    const hero = imageSrc(issue.hero_image);
    const lead = issue.intro
      ? `<section class="nl-block">
           <div class="nl-lead nl-body leading-relaxed text-text-primary/90">${paragraphs(issue.intro)}</div>
         </section>`
      : "";
    const closing = (issue.closing ?? "").trim()
      ? `<section class="nl-block nl-wide border-t-2 border-sacred-gold pt-4">
           <div class="nl-body leading-relaxed text-text-primary/85">${paragraphs(issue.closing)}</div>
         </section>`
      : "";

    host.innerHTML = `<article class="nl-paper">
      <header class="nl-band">
        <div class="flex flex-wrap items-baseline justify-between gap-2 text-[0.7rem] uppercase tracking-[0.2em]">
          <span class="nl-edition">${escapeHtml(issue.issue_label ?? "")}</span>
          <span class="nl-edition">${escapeHtml(issueDateLabel(issue.published_at))}</span>
        </div>
        <h1 class="nl-title mt-1.5 text-center font-display leading-tight">
          St. John of Kronstadt Orthodox Mission
        </h1>
      </header>

      <div class="nl-inner">
        ${
          hero
            ? `<figure class="m-0 mb-5"><img src="${escapeHtml(hero)}" alt="${escapeHtml(issue.hero_image_alt ?? "")}" class="block h-auto w-full border border-border-soft" /></figure>`
            : ""
        }
        <div class="nl-grid">
          ${lead}
          ${contentsHtml(headings)}
          ${blocks.join("")}
          ${closing}
        </div>
      </div>

      <div class="nl-foot">
        <span>St. John of Kronstadt &middot; Orthodox Mission &middot; RGV</span>
        <span>stjohnrgv.org</span>
      </div>
    </article>`;
  }

  (async () => {
    if (!slug) {
      showError(
        'No issue was named. <a href="/newsletter/" class="font-semibold text-brand-blue-dark">See all issues</a>.',
      );
      return;
    }
    try {
      const res = await fetch(`/api/newsletter?slug=${encodeURIComponent(slug)}`, {
        credentials: "same-origin",
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        // Not an error — this issue simply isn't theirs to read yet.
        if (res.status === 403 && body.needs_account) {
          showError(
            `${escapeHtml(body.error)} ` +
              `<a href="/login/?next=${encodeURIComponent(location.pathname + location.search)}" class="font-semibold text-brand-blue-dark">Sign in</a> or ` +
              '<a href="/register" class="font-semibold text-brand-blue-dark">create an account</a>.',
            true,
          );
          return;
        }
        showError(escapeHtml(body.error ?? `Could not load this issue (${res.status}).`));
        return;
      }

      const issue = body.issue as Issue;
      if (body.draft) (document.getElementById("issue-draft") as HTMLElement).hidden = false;
      document.title = `${issue.title} | Parish Newsletter`;
      // The permanent sections are stored every month whether or not
      // they are used, so what is printed is only the ones ticked and
      // actually written. A heading with nothing under it would reach
      // the parish as a title followed by blank space.
      const sections = (Array.isArray(issue.sections) ? issue.sections : []).filter(
        (s) => s.include !== false && (s.body || s.image),
      );
      // pairSections() is shared with the email, so the page and the
      // inbox cannot drift on which sections sit together.
      renderIssue(issue, pairSections(sections));

      (document.getElementById("issue-loading") as HTMLElement).hidden = true;
      (document.getElementById("issue-actions") as HTMLElement).hidden = false;
    } catch (err) {
      showError(
        escapeHtml(
          `Could not load this issue: ${err instanceof Error ? err.message : String(err)}`,
        ),
      );
    }
  })();

  /**
   * Hand over a PDF.
   *
   * Nobody is going to print this on paper, so the button says what
   * people actually want. There is no server here that can render a
   * PDF — that needs a headless browser the site does not have — so
   * this opens the browser's own print dialog, where "Save as PDF" is
   * the default destination on a desktop and produces a far better
   * file than anything a JavaScript library would draw. The hint says
   * so plainly rather than letting the dialog be a surprise.
   */
  document.getElementById("download-pdf")?.addEventListener("click", () => window.print());
</script>
