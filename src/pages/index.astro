---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import stjohnIcon from "../assets/images/stjohn-of-kronstadt.jpg";
import { getLiturgicalSeason } from "../lib/liturgical.ts";
import { saints } from "../lib/saints-lookup";

// Inline the parish saints database for the Saint of the Day card.
// The card's client-side script reads this JSON, computes today's
// Julian date (Gregorian − 13 days), and picks the first saint whose
// feasts array contains the matching "Month Day" string. Same
// `<` escape pattern calendar.astro uses to keep saint life text
// containing "</script>" from breaking out.
const saintsJson = JSON.stringify(saints).replace(/</g, "\\u003c");

const parishSchema = {
  "@context": "https://schema.org",
  "@type": ["Church", "LocalBusiness"],
  "name": "St. John of Kronstadt Orthodox Mission",
  "alternateName": ["St. John RGV", "St. John of Kronstadt Orthodox Mission Texas"],
  "description":
    "True Orthodox Christian mission church serving the Rio Grande Valley on the traditional Julian Calendar. Member of the Orthodox Metropolia and Avlona Synod USA.",
  "url": "https://stjohnrgv.org",
  "telephone": "+1-956-449-0225",
  "email": "parishoffice@stjohnrgv.org",
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "contactType": "pastoral",
      "email": "shepherd@stjohnrgv.org",
    },
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "39737 Palm Drive",
    "addressLocality": "Bayview",
    "addressRegion": "TX",
    "postalCode": "78566",
    "addressCountry": "US",
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 26.10,
    "longitude": -97.42,
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Sunday",
      "opens": "09:00",
      "closes": "12:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "18:00",
      "closes": "19:30",
    },
  ],
  "memberOf": [
    {
      "@type": "Organization",
      "name": "Orthodox Metropolia",
      "url": "https://orthodoxmetropolia.org",
    },
    {
      "@type": "Organization",
      "name": "Avlona Synod USA",
      "url": "https://avlonasynodusa.com",
    },
  ],
  "sameAs": [
    "https://orthodoxmetropolia.org",
    "https://avlonasynodusa.com",
    "https://ipckatakomb.ru",
  ],
};

// Compute today's liturgical season for the banner. Layout.astro also
// computes it (for the dynamic CSS vars); the calls return identical values
// within a single render. Banner content updates via the client script in
// Layout if the user's local date crosses a season boundary post-build.
const season = getLiturgicalSeason(new Date());
const isPaschal = ["pascha-day", "bright-week", "paschal-season"].includes(season.seasonKey);
const seasonLabel = `${season.label} — ${season.vestmentName} vestments`;

// Upcoming feasts — corrected for Pascha 2026 = April 12 NS (= March 30 OS).
const upcomingFeasts = [
  {
    name: "Great and Holy Pascha",
    osDate: "March 30 OS",
    nsDate: "April 12 NS",
    note: "The Resurrection of Our Lord",
  },
  {
    name: "Bright Week",
    osDate: "March 31 – April 5 OS",
    nsDate: "April 13 – 18 NS",
    note: "Daily Paschal services",
  },
  {
    name: "Mid-Pentecost",
    osDate: "April 23 OS",
    nsDate: "May 6 NS",
    note: "The middle of the Paschal season",
  },
  {
    name: "Ascension of Our Lord",
    osDate: "May 8 OS",
    nsDate: "May 21 NS",
    note: "Forty days after Pascha",
  },
];

const services = [
  { name: "Divine Liturgy", when: "Sunday · 9:00 AM", note: "All are welcome" },
  { name: "Vespers", when: "Saturday · 6:00 PM", note: "Eve of the Lord's Day" },
  { name: "Great Feast Days", when: "Per Julian Calendar", note: "See calendar for upcoming feasts" },
  { name: "Confession", when: "By Appointment", note: "Speak with Fr. Antonios" },
];
---

<Layout
  title="St. John of Kronstadt Orthodox Mission | Orthodox Church Rio Grande Valley, TX"
  description="Orthodox Christian church serving the Rio Grande Valley in Bayview, TX. Traditional Julian Calendar services, weekly Divine Liturgy, and a welcoming parish. Fr. Antonios Altermatt. Call (956) 449-0225."
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(parishSchema)}
  />

  <!-- ==================== HERO ==================== -->
  <section class="bg-cream-bg">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 md:grid-cols-2 md:items-center md:gap-16 md:px-6 md:py-28">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-tan-dark">Rio Grande Valley, Texas</p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-text-primary md:text-5xl lg:text-6xl">
          St. John of Kronstadt<br />
          <span class="text-brand-blue-dark">Orthodox Mission</span>
        </h1>
        <div class="mt-6 h-px w-24 bg-liturgical-current"></div>
        <p class="mt-6 font-display italic text-lg text-text-primary/80 md:text-xl">
          Anchored in Ancient Faith · Welcoming All Seekers
        </p>
        <p class="mt-6 max-w-xl text-text-secondary leading-relaxed">
          A True Orthodox parish serving the Rio Grande Valley from Bayview, Texas, on
          the traditional Julian Calendar — preserving the unbroken liturgical life of
          the Apostles and Church Fathers.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#schedule" class="btn btn-primary btn-lg">
            Service Schedule
          </a>
          <a href="/contact/" class="btn btn-secondary btn-lg">
            Plan Your Visit
          </a>
        </div>
        <p class="mt-6 text-center text-sm text-text-secondary">
          Our Patron: <a href="/learn/st-john-of-kronstadt/">St. John of Kronstadt</a>
          · celebrating the Divine Liturgy of <a href="/learn/st-john-chrysostom/">St. John Chrysostom</a>
        </p>
      </div>

      <!-- Icon of St. John of Kronstadt — accent size, not focal -->
      <div class="flex justify-center md:justify-end">
        <div
          class="flex aspect-[3/4] w-full max-w-[14rem] flex-col items-center justify-center border-2 border-sacred-gold bg-cream-card text-center shadow-sm"
        >
          <Image
            src={stjohnIcon}
            alt="Icon of St. John of Kronstadt"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
      </div>

      <!-- Scroll hint — gentle vertical bounce, full-width grid row -->
      <div class="mt-6 flex justify-center md:col-span-2 md:mt-10">
        <span class="scroll-hint inline-block text-3xl text-brand-tan" aria-hidden="true">↓</span>
      </div>
    </div>
  </section>

  <style>
    @keyframes scroll-hint-bounce {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(8px); }
    }
    .scroll-hint {
      animation: scroll-hint-bounce 2s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .scroll-hint { animation: none; }
    }
  </style>

  <!-- ==================== SAINT OF THE DAY ====================
       Hidden by default; the inline script below pulls today's Julian
       date (Gregorian − 13 days) and reveals the section only if a
       saint in src/data/saints/ has a matching "Month Day" feast. -->
  <section id="saint-of-day-section" hidden class="bg-cream-bg">
    <div class="mx-auto max-w-3xl px-4 py-12 md:py-16">
      <article class="border border-brand-tan bg-cream-card p-6 shadow-sm md:p-8">
        <div class="text-2xl text-sacred-gold" aria-hidden="true">☩</div>
        <p class="mt-3 text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Saint of the Day</p>
        <h2 id="saint-of-day-name" class="mt-2 font-display text-2xl text-text-primary md:text-3xl"></h2>
        <p id="saint-of-day-feast" class="mt-1 text-sm text-text-secondary"></p>
        <div class="mt-4 h-px w-12 bg-liturgical-current"></div>
        <p id="saint-of-day-life" hidden class="mt-4 leading-relaxed text-text-primary/85"></p>
        <p class="mt-6">
          <a
            href="/learn/saints/"
            class="font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline transition-colors"
          >
            View all saints →
          </a>
        </p>
      </article>
    </div>
  </section>

  <!-- Saints data baked in for the Saint of the Day card. -->
  <script type="application/json" id="saints-data" is:inline set:html={saintsJson}></script>

  <script is:inline>
    (function () {
      const dataEl = document.getElementById('saints-data');
      const section = document.getElementById('saint-of-day-section');
      if (!dataEl || !section) return;

      const saints = JSON.parse(dataEl.textContent);
      const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

      // Today's Julian date = Gregorian − 13 days. Subtracting raw
      // milliseconds is fine for this offset; DST rolls don't change
      // the calendar day for a 13-day shift.
      const now = new Date();
      const julian = new Date(now.getTime() - 13 * 24 * 60 * 60 * 1000);
      const feastKey = MONTHS[julian.getMonth()] + ' ' + julian.getDate();

      const match = saints.find(s =>
        Array.isArray(s.feasts) && s.feasts.includes(feastKey),
      );
      if (!match) return;

      document.getElementById('saint-of-day-name').textContent = match.name || '';
      document.getElementById('saint-of-day-feast').textContent =
        'Commemorated on ' + feastKey;

      // Skip the placeholder life text used for stub entries.
      const isStub =
        typeof match.life === 'string' &&
        match.life.startsWith('Little is known about this saint beyond their commemoration');
      if (match.life && !isStub) {
        // First two sentences. The regex captures runs of non-
        // sentence-ending characters followed by ./!/? so each
        // match is a complete sentence with its trailing punctuation.
        const sentences = match.life.match(/[^.!?]+[.!?]+/g) || [];
        const preview = sentences.slice(0, 2).join(' ').trim();
        if (preview) {
          const lifeEl = document.getElementById('saint-of-day-life');
          lifeEl.textContent = preview;
          lifeEl.hidden = false;
        }
      }

      section.hidden = false;
    })();
  </script>

  <!-- ==================== CURRENT SEASON BANNER ====================
       Background and text colors track the active liturgical season via
       --liturgical-current. Headline / subline / label all carry data
       attributes so the client hydration script in Layout.astro can swap
       their text content if the user's local date is in a different season
       than the build day.
  -->
  <section
    id="liturgical-banner"
    data-season-key={season.seasonKey}
    class:list={[
      /* Paschal banner: hardcoded pure white text, regardless of the
         liturgical-current-text variable (which would otherwise resolve to
         the warm cream-bg #FAF7F0 and read as gold-tinted on the red).
         Other seasons keep using the dynamic var. */
      isPaschal ? "text-cream-card paschal-banner-bg" : "bg-liturgical-current text-[var(--color-liturgical-current-text)]",
    ]}
  >
    <div class="mx-auto max-w-6xl px-4 py-8 text-center md:px-6 md:py-10">
      <p
        data-banner-eyebrow
        class:list={[
          "text-xs font-semibold uppercase",
          /* Paschal: Cinzel face, +0.35em tracking, dark text-shadow for
             readability against the red. Other seasons keep the default
             tracked-out 70%-opacity small caps. */
          isPaschal ? "paschal-eyebrow" : "tracking-[0.3em] opacity-70",
        ]}
      >Current Season</p>
      <p
        data-banner-headline
        class:list={[
          "mt-3 font-display text-2xl md:text-3xl",
          /* Paschal headline: sacred-gold (#C9A84C) for visual focus,
             plus the bold weight & dark text-shadow from .paschal-headline.
             Other banner text stays white. */
          isPaschal ? "text-sacred-gold paschal-headline" : "",
        ]}
      >
        {season.bannerHeadline}
      </p>
      {season.bannerSubline && (
        <p data-banner-subline class="mt-2 italic text-base md:text-lg">
          {season.bannerSubline}
        </p>
      )}
      <p
        data-banner-label
        class:list={[
          "mt-4 font-semibold uppercase tracking-widest",
          isPaschal
            ? "text-base paschal-label"               /* +30% size, pure white, light shadow */
            : "text-xs opacity-70",                    /* default size for non-paschal seasons */
        ]}
      >
        {seasonLabel}
      </p>
    </div>
  </section>

  {isPaschal && (
    <!-- ==================== PASCHAL ANASTASIS + TROPARION (Pascha only) ====================
         Renders only when getLiturgicalSeason returns pascha-day, bright-week,
         or paschal-season. The Anastasis icon's home — full proportions, not
         cropped, framed in sacred-gold — paired with the Paschal troparion in
         ceremonial type. Two columns on desktop (icon left, troparion right);
         stacked on mobile (icon top, troparion below).
    -->
    <section id="paschal-anastasis" class="bg-cream-bg">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-12">
          <figure class="m-0">
            <img
              src="/images/icons/anastasis.jpg"
              alt="The Anastasis — Christ harrowing Hades, raising Adam and Eve from death"
              class="block w-full border-2 border-sacred-gold shadow-md"
              width="1351"
              height="588"
              loading="eager"
            />
            <figcaption class="mt-3 text-center text-sm italic text-text-secondary">
              The Anastasis — Christ harrowing Hades, raising Adam and Eve from death.
            </figcaption>
          </figure>

          <blockquote class="m-0">
            <p class="font-display text-xl leading-relaxed text-text-primary md:text-2xl lg:text-3xl">
              Christ is risen from the dead, trampling down death by death,
              and upon those in the tombs bestowing life.
            </p>
            <footer class="mt-4 text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">
              The Paschal Troparion
            </footer>
          </blockquote>
        </div>
      </div>
    </section>
  )}

  <!-- ==================== JUMP LINKS (homepage only) ==================== -->
  <nav class="border-b border-border-soft bg-cream-bg" aria-label="On this page">
    <div class="mx-auto max-w-6xl px-4 py-3 md:px-6">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-xs uppercase tracking-widest">
        <li>
          <a href="#schedule" class="font-semibold text-text-secondary no-underline hover:text-brand-blue-dark transition-colors">
            Schedule
          </a>
        </li>
        <li>
          <a href="#readings" class="font-semibold text-text-secondary no-underline hover:text-brand-blue-dark transition-colors">
            Readings
          </a>
        </li>
        <li>
          <a href="#visit" class="font-semibold text-text-secondary no-underline hover:text-brand-blue-dark transition-colors">
            Visit Us
          </a>
        </li>
        <li>
          <a href="#about" class="font-semibold text-text-secondary no-underline hover:text-brand-blue-dark transition-colors">
            About
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- ==================== WELCOME ==================== -->
  <section id="about" class="bg-cream-bg scroll-mt-20">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center md:px-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Welcome</p>
      <h2 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">A Living Tradition in the Rio Grande Valley</h2>
      <div class="mx-auto mt-6 h-px w-16 bg-liturgical-current"></div>
      <p class="mt-8 text-lg leading-relaxed text-text-primary/85">
        St. John of Kronstadt Orthodox Mission gathers each Lord's Day to celebrate the
        Divine Liturgy of St. John Chrysostom according to the traditional Julian
        Calendar, the ancient liturgical reckoning of the Orthodox Church.
      </p>
      <p class="mt-6 leading-relaxed text-text-primary/75">
        Whether you are an inquirer encountering Orthodoxy for the first time, a
        catechumen preparing for baptism or chrismation, or an Orthodox Christian
        visiting the Valley, you are warmly welcome to come and pray with us.
      </p>
    </div>
  </section>

  <hr class="mx-auto h-px w-full max-w-6xl border-0 bg-liturgical-current opacity-40" />

  <!-- ==================== SERVICE TIMES ==================== -->
  <section id="schedule" class="bg-brand-blue-pale scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6">
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Divine Services</p>
        <h2 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Weekly Schedule</h2>
        <div class="mx-auto mt-6 h-px w-16 bg-liturgical-current"></div>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <div class="border border-border-soft bg-cream-card p-6 shadow-sm transition-colors hover:border-brand-tan">
            <div class="text-2xl text-sacred-gold" aria-hidden="true">☩</div>
            <h3 class="mt-3 font-display text-xl text-text-primary">{s.name}</h3>
            <p class="mt-2 text-brand-blue-dark">{s.when}</p>
            <p class="mt-2 text-sm text-text-secondary">{s.note}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/about/#schedule" class="font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline transition-colors">
          Full schedule and feast days →
        </a>
      </div>
    </div>
  </section>

  <hr class="mx-auto h-px w-full max-w-6xl border-0 bg-liturgical-current opacity-40" />

  <!-- ==================== TODAY'S READINGS (placeholder) ==================== -->
  <section id="readings" class="bg-cream-bg scroll-mt-20">
    <div class="mx-auto max-w-3xl px-4 py-20 md:px-6">
      <div class="border border-border-soft bg-cream-card p-8 shadow-sm md:p-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Today's Readings</p>
        <h2 class="mt-2 font-display text-2xl text-text-primary md:text-3xl">Daily Scripture from the Julian Calendar</h2>
        <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
        <p class="mt-6 text-text-primary/85">
          Daily readings will appear here, drawn from the Julian Calendar via
          <a href="https://orthocal.info" rel="noopener external">orthocal.info</a>.
        </p>
        <p class="mt-3 italic text-text-secondary">Coming soon.</p>
      </div>
    </div>
  </section>

  <hr class="mx-auto h-px w-full max-w-6xl border-0 bg-liturgical-current opacity-40" />

  <!-- ==================== UPCOMING FEASTS ==================== -->
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6">
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Liturgical Year</p>
        <h2 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Upcoming Feast Days</h2>
        <div class="mx-auto mt-6 h-px w-16 bg-liturgical-current"></div>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {upcomingFeasts.map((f) => (
          <article class="border border-border-soft bg-cream-card p-6 shadow-sm transition-colors hover:border-brand-blue">
            <h3 class="font-display text-xl text-text-primary">{f.name}</h3>
            <p class="mt-2 text-sm text-brand-blue-dark">
              <span class="font-display">{f.osDate}</span>
              <span class="mx-2 text-brand-tan-dark">·</span>
              <span class="font-display">{f.nsDate}</span>
            </p>
            <p class="mt-3 text-sm text-text-secondary">{f.note}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/calendar/" class="font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline transition-colors">
          Full Julian Calendar →
        </a>
      </div>
    </div>
  </section>

  <hr class="mx-auto h-px w-full max-w-6xl border-0 bg-liturgical-current opacity-40" />

  <!-- ==================== PARISH PRIEST ==================== -->
  <section class="bg-cream-bg">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 py-20 md:grid-cols-[auto,1fr] md:items-center md:px-6">
      <div
        class="mx-auto flex aspect-square w-48 items-center justify-center border-2 border-brand-tan bg-cream-card md:mx-0"
        aria-label="Placeholder for photograph of Fr. Antonios Altermatt"
      >
        <span aria-hidden="true" class="text-5xl text-sacred-gold">☩</span>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Our Pastor</p>
        <h2 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Fr. Antonios Altermatt</h2>
        <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
        <p class="mt-6 text-text-primary/85 leading-relaxed">
          Fr. Antonios serves as priest of St. John of Kronstadt Orthodox Mission, leading the
          parish's liturgical life and offering pastoral counsel to inquirers, catechumens, and
          parishioners across the Rio Grande Valley.
        </p>
        <p class="mt-4 text-text-primary/75">
          To speak with Fr. Antonios, please call
          <a href="tel:+19564490225">(956) 449-0225</a>
          or <a href="/contact/">send a message</a>.
        </p>
      </div>
    </div>
  </section>

  <hr class="mx-auto h-px w-full max-w-6xl border-0 bg-liturgical-current opacity-40" />

  <!-- ==================== CONTACT / LOCATION STRIP ==================== -->
  <section id="visit" class="bg-brand-blue-pale scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6">
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Visit Us</p>
        <h2 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Find the Parish</h2>
        <div class="mx-auto mt-6 h-px w-16 bg-liturgical-current"></div>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="border border-border-soft bg-cream-card p-6 text-center shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Address</p>
          <address class="mt-3 not-italic font-display text-lg text-text-primary">
            39737 Palm Drive<br />
            Bayview, TX 78566
          </address>
        </div>
        <div class="border border-border-soft bg-cream-card p-6 text-center shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Phone</p>
          <p class="mt-3 font-display text-lg">
            <a href="tel:+19564490225" class="text-brand-blue-dark transition-colors">
              (956) 449-0225
            </a>
          </p>
        </div>
        <div class="border border-border-soft bg-cream-card p-6 text-center shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Pastor</p>
          <p class="mt-3 font-display text-lg text-text-primary">Fr. Antonios Altermatt</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
