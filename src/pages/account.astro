---
import Layout from "../layouts/Layout.astro";
---

<Layout title="My Account">
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">My Account</h1>

    <!-- ============== MY LEARNING ==============
         Catechism lessons posted by an admin from /admin/catechism/.
         Populated at runtime from /api/catechism/lessons so a new
         lesson shows up here the moment it's uploaded — no rebuild.
         Lessons open in the reader at /account/lesson/?slug=…  -->
    <section
      class="mb-10 border border-border-soft bg-cream-card p-6 shadow-sm md:p-7"
      aria-labelledby="learning-heading"
    >
      <div class="flex items-baseline justify-between gap-4 border-b pb-2 mb-4">
        <h2 id="learning-heading" class="text-lg font-semibold">My Learning</h2>
        <span id="learning-count" class="text-xs uppercase tracking-widest text-text-secondary"></span>
      </div>

      <p class="text-sm text-gray-500 mb-4">
        Catechism lessons shared with the parish. Click any lesson to read it here on the site.
      </p>

      <p id="learning-loading" class="text-sm text-text-secondary italic">Loading lessons…</p>
      <p id="learning-error" hidden role="alert" class="text-sm text-liturgical-red"></p>
      <p id="learning-empty" hidden class="text-sm text-text-secondary italic">
        No lessons have been posted yet. They'll appear here as soon as they are.
      </p>

      <ul id="learning-list" class="divide-y divide-border-soft"></ul>
    </section>

    <!-- Profile Photo -->
    <div class="flex flex-col items-center gap-3 mb-10">
      <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-brand-blue-dark bg-cream-card">
        <img id="avatar-img" alt="Profile photo" class="w-full h-full object-cover hidden" />
        <!-- viewBox cropped to the inner circle's bounding box (cx=340 cy=207 r=191)
             so the placeholder fills the round container without letterboxing. -->
        <svg id="avatar-fallback" viewBox="149 16 382 382" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
          <defs>
            <clipPath id="cc"><circle cx="340" cy="207" r="188"/></clipPath>
            <linearGradient id="wd" gradientUnits="userSpaceOnUse" x1="210" y1="0" x2="470" y2="0">
              <stop offset="0%" stop-color="#3E2006"/>
              <stop offset="18%" stop-color="#8C6222"/>
              <stop offset="42%" stop-color="#C4A044"/>
              <stop offset="58%" stop-color="#A07428"/>
              <stop offset="82%" stop-color="#6E4818"/>
              <stop offset="100%" stop-color="#3E2006"/>
            </linearGradient>
          </defs>
          <circle cx="340" cy="207" r="191" fill="#1A2F5E"/>
          <g clip-path="url(#cc)">
            <g fill="#F0CC50" fill-opacity="0.17">
              <polygon points="340,207 307,-13 373,-13"/>
              <polygon points="340,207 494,10 540,58"/>
              <polygon points="340,207 590,174 590,240"/>
              <polygon points="340,207 540,358 494,404"/>
              <polygon points="340,207 373,427 307,427"/>
              <polygon points="340,207 186,404 140,358"/>
              <polygon points="340,207 90,240 90,174"/>
              <polygon points="340,207 140,58 186,10"/>
            </g>
            <rect x="210" y="150" width="260" height="54" fill="url(#wd)"/>
            <rect x="210" y="150" width="260" height="6" fill="#DCC068" fill-opacity="0.55"/>
            <rect x="210" y="150" width="6" height="54" fill="#DCC068" fill-opacity="0.32"/>
            <rect x="464" y="150" width="6" height="54" fill="#180800" fill-opacity="0.48"/>
            <rect x="210" y="198" width="260" height="6" fill="#180800" fill-opacity="0.48"/>
            <g transform="rotate(-15,340,274)">
              <rect x="259" y="254" width="162" height="42" fill="url(#wd)"/>
              <rect x="259" y="254" width="162" height="5" fill="#DCC068" fill-opacity="0.55"/>
              <rect x="259" y="254" width="5" height="42" fill="#DCC068" fill-opacity="0.32"/>
              <rect x="416" y="254" width="5" height="42" fill="#180800" fill-opacity="0.48"/>
              <rect x="259" y="291" width="162" height="5" fill="#180800" fill-opacity="0.48"/>
            </g>
            <rect x="287" y="58" width="106" height="57" fill="url(#wd)"/>
            <rect x="287" y="58" width="106" height="6" fill="#DCC068" fill-opacity="0.55"/>
            <rect x="287" y="58" width="6" height="57" fill="#DCC068" fill-opacity="0.32"/>
            <rect x="387" y="58" width="6" height="57" fill="#180800" fill-opacity="0.48"/>
            <rect x="287" y="109" width="106" height="6" fill="#180800" fill-opacity="0.48"/>
            <rect x="312" y="40" width="56" height="332" fill="url(#wd)"/>
            <rect x="312" y="40" width="6" height="332" fill="#DCC068" fill-opacity="0.26"/>
            <rect x="362" y="40" width="6" height="332" fill="#180800" fill-opacity="0.40"/>
          </g>
          <circle cx="340" cy="207" r="191" fill="none" stroke="#243C6E" stroke-width="2"/>
        </svg>
      </div>
      <p class="font-semibold text-lg"><span id="display-name"></span></p>
      <label id="avatar-button" class="btn btn-secondary cursor-pointer text-sm">
        <span id="avatar-button-label">Change Photo</span>
        <input type="file" id="avatar-input" accept="image/jpeg,image/png,image/webp" class="hidden" />
      </label>
      <p id="avatar-status" class="text-sm hidden"></p>
    </div>

    <form id="profile-form" class="space-y-8">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">

      <!-- Left column: directory opt-in + Save -->
      <div class="space-y-6">

      <!-- Communications + Directory -->
      <section>
        <h2 class="text-lg font-semibold border-b pb-2 mb-4">Parish Communications</h2>

        <label class="flex items-start gap-3 cursor-pointer">
          <input id="opt_in_communications" name="opt_in_communications" type="checkbox"
            class="mt-0.5 h-4 w-4 rounded border-gray-300" />
          <span>
            <span class="text-sm font-medium text-text-primary">Announcements &amp; New Materials</span>
            <span class="mt-0.5 block text-sm text-gray-500">Optional.</span>
          </span>
        </label>

        <!-- Checked and locked, with nothing said about it. Sitting
             beside a box marked "Optional", a box you can't uncheck
             makes its own point. Disabled inputs aren't submitted, and
             nothing reads this id, so it never touches the profile. -->
        <label class="flex items-start gap-3 mt-4">
          <input id="parish_admin_emails" type="checkbox" checked disabled
            class="mt-0.5 h-4 w-4 rounded border-gray-300" />
          <span class="text-sm font-medium text-text-primary">Parish Administration Emails</span>
        </label>

        <div class="border border-gray-200 rounded p-4 mt-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input id="opt_in_directory" name="opt_in_directory" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-gray-300" />
            <div>
              <span class="font-medium text-text-primary">Include me in the parish directory</span>
              <p class="text-sm text-gray-500 mt-0.5">
                Your name will appear in the directory shared with fellow parishioners.
                Choose below which contact details to share.
              </p>
            </div>
          </label>

          <div id="directory-options" class="mt-3 ml-7 grid gap-2 hidden">
            <label class="flex items-center gap-2 text-sm cursor-pointer">
              <input id="directory_show_phone" name="directory_show_phone" type="checkbox" class="h-4 w-4 rounded border-gray-300" />
              Share my phone number
            </label>
            <label class="flex items-center gap-2 text-sm cursor-pointer">
              <input id="directory_show_address" name="directory_show_address" type="checkbox" class="h-4 w-4 rounded border-gray-300" />
              Share my mailing address
            </label>
            <div class="flex items-center gap-2 text-sm flex-wrap">
              <label for="dir_email_choice">Include</label>
              <select id="dir_email_choice" class="border rounded px-2 py-1 text-sm">
                <option value="">no email</option>
                <option value="primary">my primary email</option>
                <option value="secondary">my secondary email</option>
              </select>
              <span>in the directory</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Save -->
      <div class="flex items-center gap-4 pt-2">
        <button type="submit" class="btn btn-primary">
          Save Changes
        </button>
        <span id="save-status" class="text-sm hidden"></span>
      </div>

      </div><!-- /left column -->

      <!-- Contact info (right column) -->
      <div class="space-y-8">

      <!-- Basic Info -->
      <section>
        <h2 class="text-lg font-semibold border-b pb-2 mb-4">Basic Information</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1" for="first_name">First Name</label>
            <input id="first_name" name="first_name" type="text"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1" for="last_name">Last Name</label>
            <input id="last_name" name="last_name" type="text"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium mb-1" for="email">Primary Email</label>
          <input id="email" name="email" type="email" autocomplete="email"
            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          <p class="text-xs text-gray-500 mt-1">Used to sign in and to receive password resets.</p>
        </div>

        <div class="mt-4">
          <label class="block text-sm font-medium mb-1" for="public_email">Secondary Email <span class="text-gray-400 font-normal">(optional)</span></label>
          <input id="public_email" name="public_email" type="email" autocomplete="off" placeholder="e.g. parishoffice@stjohnrgv.org"
            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          <p class="text-xs text-gray-500 mt-1">An optional second email you can list in the directory instead of your primary.</p>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium mb-1" for="phone">Phone Number <span class="text-gray-400 font-normal">(optional)</span></label>
          <input id="phone" name="phone" type="tel" placeholder="(956) 555-0100"
            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
        </div>
      </section>

      <!-- Home Address -->
      <section>
        <h2 class="text-lg font-semibold border-b pb-2 mb-4">Home Address <span class="text-gray-400 font-normal text-sm">(optional)</span></h2>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium mb-1" for="address_line1">Street Address</label>
            <input id="address_line1" name="address_line1" type="text" placeholder="123 Main St"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1" for="address_line2">Apt / Unit <span class="text-gray-400 font-normal">(optional)</span></label>
            <input id="address_line2" name="address_line2" type="text"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-1">
              <label class="block text-sm font-medium mb-1" for="city">City</label>
              <input id="city" name="city" type="text"
                class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="state">State</label>
              <input id="state" name="state" type="text" maxlength="2" placeholder="TX"
                class="w-full border rounded-md px-3 py-2 text-sm uppercase focus:outline-none focus:ring-2" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="zip">ZIP</label>
              <input id="zip" name="zip" type="text" maxlength="10"
                class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
            </div>
          </div>
        </div>
      </section>

      <!-- Emergency Contact 1 -->
      <section>
        <h2 class="text-lg font-semibold border-b pb-2 mb-4">Emergency Contact <span class="text-gray-400 font-normal text-sm">(optional)</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1" for="emergency_name">Name</label>
            <input id="emergency_name" name="emergency_name" type="text"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1" for="emergency_relationship">Relationship</label>
            <input id="emergency_relationship" name="emergency_relationship" type="text"
              placeholder="Spouse, Parent, Sibling…"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium mb-1" for="emergency_phone">Phone</label>
          <input id="emergency_phone" name="emergency_phone" type="tel"
            placeholder="(956) 555-0100"
            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
        </div>
      </section>

      <!-- Emergency Contact 2 -->
      <section>
        <h2 class="text-lg font-semibold border-b pb-2 mb-4">Second Emergency Contact <span class="text-gray-400 font-normal text-sm">(optional)</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1" for="emergency_name_2">Name</label>
            <input id="emergency_name_2" name="emergency_name_2" type="text"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1" for="emergency_relationship_2">Relationship</label>
            <input id="emergency_relationship_2" name="emergency_relationship_2" type="text"
              placeholder="Spouse, Parent, Sibling…"
              class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium mb-1" for="emergency_phone_2">Phone</label>
          <input id="emergency_phone_2" name="emergency_phone_2" type="tel"
            placeholder="(956) 555-0100"
            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2" />
        </div>
      </section>

      </div><!-- /contact info (right column) -->
      </div><!-- /grid -->

    </form>
  </main>
</Layout>

<script>
  function setInputValue(id: string, value: unknown) {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (el) el.value = typeof value === "string" ? value : "";
  }

  function setChecked(id: string, value: unknown) {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (el) el.checked = Boolean(value);
  }

  function showAvatar(url: string | null) {
    const img = document.getElementById("avatar-img") as HTMLImageElement | null;
    const fallback = document.getElementById("avatar-fallback");
    if (!img || !fallback) return;
    if (url) {
      img.src = url;
      img.classList.remove("hidden");
      fallback.classList.add("hidden");
    } else {
      img.classList.add("hidden");
      fallback.classList.remove("hidden");
    }
  }

  async function loadProfile() {
    const res = await fetch("/api/profile", {
      credentials: "same-origin",
      cache: "no-store",
    });

    if (res.status === 401) {
      window.location.assign("/login/?next=/account/");
      return;
    }
    if (!res.ok) return;

    const profile = await res.json();

    setInputValue("first_name", profile.first_name);
    setInputValue("last_name", profile.last_name);
    setInputValue("email", profile.email);
    setInputValue("public_email", profile.public_email);
    setInputValue("phone", profile.phone);

    setInputValue("address_line1", profile.address_line1);
    setInputValue("address_line2", profile.address_line2);
    setInputValue("city", profile.city);
    setInputValue("state", profile.state);
    setInputValue("zip", profile.zip);

    setInputValue("emergency_name", profile.emergency_name);
    setInputValue("emergency_relationship", profile.emergency_relationship);
    setInputValue("emergency_phone", profile.emergency_phone);
    setInputValue("emergency_name_2", profile.emergency_name_2);
    setInputValue("emergency_relationship_2", profile.emergency_relationship_2);
    setInputValue("emergency_phone_2", profile.emergency_phone_2);

    setChecked("opt_in_communications", profile.opt_in_communications);
    setChecked("opt_in_directory", profile.opt_in_directory);
    setChecked("directory_show_phone", profile.directory_show_phone);
    setChecked("directory_show_address", profile.directory_show_address);
    // Email-in-directory choice: none / primary / secondary.
    const dirEmailSelect = document.getElementById("dir_email_choice") as HTMLSelectElement | null;
    if (dirEmailSelect) {
      dirEmailSelect.value = !profile.directory_show_email
        ? ""
        : profile.directory_use_secondary_email ? "secondary" : "primary";
    }

    if (profile.opt_in_directory) {
      document.getElementById("directory-options")?.classList.remove("hidden");
    }

    const displayName = document.getElementById("display-name");
    if (displayName) {
      const parts = [profile.first_name, profile.last_name].filter(Boolean);
      displayName.textContent = parts.join(" ");
    }

    if (typeof profile.avatar_url === "string" && profile.avatar_url) {
      showAvatar(profile.avatar_url);
    }
  }

  loadProfile();

  // Directory opt-in: master checkbox toggles visibility of sub-options.
  // When unchecked, also clear the sub-options so a save doesn't keep
  // leaking fields the user thought they hid.
  const dirMaster = document.getElementById("opt_in_directory") as HTMLInputElement | null;
  dirMaster?.addEventListener("change", () => {
    const panel = document.getElementById("directory-options");
    if (panel) panel.classList.toggle("hidden", !dirMaster.checked);
    if (!dirMaster.checked) {
      setChecked("directory_show_phone", false);
      setChecked("directory_show_address", false);
      const sel = document.getElementById("dir_email_choice") as HTMLSelectElement | null;
      if (sel) sel.value = "";
    }
  });

  // Avatar upload — single button, auto-uploads as soon as a file is picked.
  const avatarInput = document.getElementById("avatar-input") as HTMLInputElement | null;
  const avatarButton = document.getElementById("avatar-button") as HTMLLabelElement | null;
  const avatarButtonLabel = document.getElementById("avatar-button-label");
  const avatarStatus = document.getElementById("avatar-status") as HTMLParagraphElement | null;

  function setAvatarStatus(message: string, kind: "ok" | "error" | "info") {
    if (!avatarStatus) return;
    avatarStatus.textContent = message;
    avatarStatus.classList.remove("hidden", "text-green-600", "text-red-600", "text-gray-500");
    if (kind === "ok") avatarStatus.classList.add("text-green-600");
    else if (kind === "error") avatarStatus.classList.add("text-red-600");
    else avatarStatus.classList.add("text-gray-500");
  }

  function setAvatarBusy(busy: boolean) {
    if (avatarInput) avatarInput.disabled = busy;
    if (avatarButtonLabel) avatarButtonLabel.textContent = busy ? "Uploading…" : "Change Photo";
    if (avatarButton) {
      avatarButton.style.opacity = busy ? "0.6" : "";
      avatarButton.style.pointerEvents = busy ? "none" : "";
      avatarButton.style.cursor = busy ? "not-allowed" : "";
    }
  }

  avatarInput?.addEventListener("change", async () => {
    const file = avatarInput.files?.[0];
    if (!file) return;

    // Show local preview immediately so the user sees instant feedback,
    // then upload in the background.
    const previewUrl = URL.createObjectURL(file);
    showAvatar(previewUrl);
    avatarStatus?.classList.add("hidden");
    setAvatarBusy(true);

    const fd = new FormData();
    fd.append("avatar", file);

    let res: Response;
    try {
      res = await fetch("/api/profile", {
        method: "POST",
        body: fd,
        credentials: "same-origin",
        cache: "no-store",
      });
    } catch (err) {
      setAvatarBusy(false);
      avatarInput.value = "";
      setAvatarStatus(`❌ Network error: ${err instanceof Error ? err.message : String(err)}`, "error");
      return;
    }

    setAvatarBusy(false);
    avatarInput.value = "";

    if (res.ok) {
      const data = await res.json().catch(() => ({}));
      if (typeof data.avatar_url === "string") showAvatar(data.avatar_url);
      setAvatarStatus("✓ Photo saved", "ok");
    } else {
      const detail = await res.text().catch(() => "");
      setAvatarStatus(
        detail ? `❌ Upload failed (${res.status}): ${detail}` : `❌ Upload failed (${res.status})`,
        "error",
      );
    }
  });

  // Profile save
  const form = document.getElementById("profile-form") as HTMLFormElement;
  const status = document.getElementById("save-status") as HTMLSpanElement;

  function strOrNull(value: FormDataEntryValue | null): string | null {
    if (typeof value !== "string") return null;
    const trimmed = value.trim();
    return trimmed === "" ? null : trimmed;
  }

  function checked(id: string): boolean {
    const el = document.getElementById(id) as HTMLInputElement | null;
    return Boolean(el?.checked);
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const stateRaw = strOrNull(data.get("state"));
    const dirEmailChoice = (document.getElementById("dir_email_choice") as HTMLSelectElement | null)?.value ?? "";
    const payload: Record<string, unknown> = {
      first_name: strOrNull(data.get("first_name")),
      last_name: strOrNull(data.get("last_name")),
      email: strOrNull(data.get("email")),
      public_email: strOrNull(data.get("public_email")),
      phone: strOrNull(data.get("phone")),

      address_line1: strOrNull(data.get("address_line1")),
      address_line2: strOrNull(data.get("address_line2")),
      city: strOrNull(data.get("city")),
      state: stateRaw ? stateRaw.toUpperCase() : null,
      zip: strOrNull(data.get("zip")),

      emergency_name: strOrNull(data.get("emergency_name")),
      emergency_relationship: strOrNull(data.get("emergency_relationship")),
      emergency_phone: strOrNull(data.get("emergency_phone")),
      emergency_name_2: strOrNull(data.get("emergency_name_2")),
      emergency_relationship_2: strOrNull(data.get("emergency_relationship_2")),
      emergency_phone_2: strOrNull(data.get("emergency_phone_2")),

      opt_in_communications: checked("opt_in_communications"),
      opt_in_directory: checked("opt_in_directory"),
      directory_show_phone: checked("directory_show_phone"),
      directory_show_email: dirEmailChoice !== "",
      directory_use_secondary_email: dirEmailChoice === "secondary",
      directory_show_address: checked("directory_show_address"),
    };

    let res: Response;
    try {
      res = await fetch("/api/profile", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        cache: "no-store",
        body: JSON.stringify(payload),
      });
    } catch (err) {
      status.classList.remove("hidden", "text-green-600");
      status.classList.add("text-red-600");
      status.textContent = `Network error: ${err instanceof Error ? err.message : String(err)}`;
      return;
    }

    status.classList.remove("hidden", "text-green-600", "text-red-600");
    if (res.ok) {
      status.textContent = "✓ Saved";
      status.classList.add("text-green-600");
      setTimeout(() => status.classList.add("hidden"), 3000);
    } else {
      let detail = "";
      try {
        detail = await res.text();
      } catch {}
      status.textContent = detail
        ? `Save failed (${res.status}): ${detail}`
        : `Save failed (${res.status})`;
      status.classList.add("text-red-600");
    }
  });

  // ============== MY LEARNING ==============
  // Renders the catechism lessons an admin has posted from
  // /admin/catechism/. Its own fetch, wrapped in its own try/catch, so a
  // hiccup loading lessons never disturbs the profile form above.
  // (Lives in this same script block on purpose — a second top-level
  // <script> on this page is dropped from the build.)
  type Lesson = {
    slug: string;
    title: string;
    teacher: string | null;
    series: string | null;
    lesson_date: string | null;
    description: string | null;
    published: boolean;
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // Lesson dates are plain YYYY-MM-DD strings. Parsing them with the
  // Date constructor would shift them a day in US time zones, so we
  // split the string instead.
  function formatLessonDate(value: string | null): string {
    if (!value) return "";
    const [y, m, d] = value.split("-").map(Number);
    if (!y || !m || !d) return value;
    const months = ["January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"];
    return `${months[m - 1]} ${d}, ${y}`;
  }

  function lessonRow(lesson: Lesson): string {
    // Series / teacher / date, whichever the admin filled in.
    const meta = [lesson.series, lesson.teacher, formatLessonDate(lesson.lesson_date)]
      .filter(Boolean)
      .map((part) => escapeHtml(part))
      .join(" · ");
    // Admins also see their own unposted drafts; members never do.
    const draftTag = lesson.published
      ? ""
      : ` <span class="ml-2 border border-border-soft px-1.5 py-0.5 text-[0.65rem] uppercase tracking-wider text-text-secondary align-middle">Draft</span>`;

    return `<li class="py-3">
      <a
        href="/account/lesson/?slug=${encodeURIComponent(lesson.slug)}"
        class="font-semibold text-brand-blue-dark no-underline hover:underline"
      >${escapeHtml(lesson.title)}</a>${draftTag}
      ${meta ? `<p class="mt-0.5 text-xs text-text-secondary">${meta}</p>` : ""}
      ${lesson.description ? `<p class="mt-1 text-sm text-text-primary/85">${escapeHtml(lesson.description)}</p>` : ""}
    </li>`;
  }

  (async () => {
    const loadingEl = document.getElementById("learning-loading") as HTMLParagraphElement | null;
    const errorEl = document.getElementById("learning-error") as HTMLParagraphElement | null;
    const emptyEl = document.getElementById("learning-empty") as HTMLParagraphElement | null;
    const listEl = document.getElementById("learning-list") as HTMLUListElement | null;
    const countEl = document.getElementById("learning-count") as HTMLSpanElement | null;
    if (!loadingEl || !errorEl || !emptyEl || !listEl) return;

    try {
      const res = await fetch("/api/catechism/lessons", {
        credentials: "same-origin",
        cache: "no-store",
      });
      // A 401 here is handled by the profile loader above, which sends
      // the visitor to /login — nothing more to do in that case.
      if (res.status === 401) return;

      loadingEl.hidden = true;

      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        errorEl.textContent = `Could not load your lessons: ${body.error ?? res.status}`;
        errorEl.hidden = false;
        return;
      }

      const data = await res.json();
      const lessons = (data.lessons ?? []) as Lesson[];

      if (lessons.length === 0) {
        emptyEl.hidden = false;
        return;
      }

      listEl.innerHTML = lessons.map(lessonRow).join("");
      if (countEl) {
        countEl.textContent = `${lessons.length} ${lessons.length === 1 ? "lesson" : "lessons"}`;
      }
    } catch (err) {
      loadingEl.hidden = true;
      errorEl.textContent = `Could not load your lessons: ${err instanceof Error ? err.message : String(err)}`;
      errorEl.hidden = false;
    }
  })();
</script>