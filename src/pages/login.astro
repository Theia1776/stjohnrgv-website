---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Sign In | St. John of Kronstadt Orthodox Mission"
  description="Sign in or register for parish access to the catechumen learning materials and parish library."
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <section class="bg-cream-bg">
    <div class="mx-auto max-w-md px-4 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Parish Access</p>
      <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Sign In</h1>
      <div class="mt-6 h-px w-24 bg-liturgical-current"></div>

      <p class="mt-6 text-text-primary/85 leading-relaxed">
        The catechumen learning section and parish library are available to
        registered members of the parish. Sign in below, or register and we
        will approve your account shortly.
      </p>

      <!-- ============== TABS ============== -->
      <div
        role="tablist"
        aria-label="Sign in or register"
        class="mt-8 flex border-b border-border-soft"
      >
        <button
          id="tab-login"
          role="tab"
          type="button"
          aria-selected="true"
          aria-controls="panel-login"
          class="-mb-px border-b-2 border-brand-blue-dark px-4 py-2 font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark"
        >
          Sign In
        </button>
        <button
          id="tab-register"
          role="tab"
          type="button"
          aria-selected="false"
          aria-controls="panel-register"
          class="-mb-px border-b-2 border-transparent px-4 py-2 font-display text-sm font-semibold uppercase tracking-widest text-text-secondary hover:text-text-primary"
        >
          Register
        </button>
      </div>

      <!-- ============== LOGIN PANEL ============== -->
      <div id="panel-login" role="tabpanel" aria-labelledby="tab-login" class="mt-8">
        <form id="login-form" class="space-y-5" novalidate>
          <div>
            <label for="login-email" class="block text-sm font-semibold text-text-primary">
              Email <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="login-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
          </div>

          <div>
            <label for="login-password" class="block text-sm font-semibold text-text-primary">
              Password <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="login-password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
          </div>

          <div>
            <button id="login-submit" type="submit" class="btn btn-primary btn-lg">
              Sign In
            </button>
            <p
              id="login-error"
              role="alert"
              hidden
              class="mt-3 text-sm font-semibold text-liturgical-red"
            ></p>
          </div>
        </form>

        <p class="mt-6 text-sm text-text-secondary">
          <a href="/reset-password/" class="font-semibold text-brand-blue-dark underline">
            Forgot your password?
          </a>
        </p>
      </div>

      <!-- ============== REGISTER PANEL ============== -->
      <div id="panel-register" role="tabpanel" aria-labelledby="tab-register" class="mt-8" hidden>
        <div class="mb-6 border-l-2 border-sacred-gold bg-cream-card p-4 text-sm text-text-primary/85">
          <p>
            Accounts are reserved for members of St. John of Kronstadt Orthodox Mission.
          </p>
        </div>
        <form id="register-form" class="space-y-5" novalidate>
          <div>
            <label for="register-name" class="block text-sm font-semibold text-text-primary">
              Full Name <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="register-name"
              name="full_name"
              type="text"
              required
              autocomplete="name"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
          </div>

          <div>
            <label for="register-email" class="block text-sm font-semibold text-text-primary">
              Email <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="register-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
          </div>

          <div>
            <label for="register-password" class="block text-sm font-semibold text-text-primary">
              Password <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="register-password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
            <p class="mt-1.5 text-xs text-text-secondary">At least 8 characters.</p>
          </div>

          <div>
            <button id="register-submit" type="submit" class="btn btn-primary btn-lg">
              Create Account
            </button>
            <p
              id="register-error"
              role="alert"
              hidden
              class="mt-3 text-sm font-semibold text-liturgical-red"
            ></p>
          </div>
        </form>

        <div
          id="register-success"
          hidden
          role="status"
          aria-live="polite"
          class="mt-6 border-2 border-sacred-gold bg-cream-card p-6 shadow-sm"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Pending Approval</p>
          <h2 class="mt-2 font-display text-xl text-text-primary">Account created.</h2>
          <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
          <p class="mt-4 text-text-primary/85 leading-relaxed">
            The parish has been notified and will approve your registration
            shortly. You will be able to sign in once your account is approved.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // ============================================================
    // TABS
    // ============================================================
    const tabLogin = document.getElementById("tab-login") as HTMLButtonElement;
    const tabRegister = document.getElementById("tab-register") as HTMLButtonElement;
    const panelLogin = document.getElementById("panel-login") as HTMLDivElement;
    const panelRegister = document.getElementById("panel-register") as HTMLDivElement;

    function activateTab(which: "login" | "register") {
      const isLogin = which === "login";
      tabLogin.setAttribute("aria-selected", String(isLogin));
      tabRegister.setAttribute("aria-selected", String(!isLogin));
      tabLogin.classList.toggle("border-brand-blue-dark", isLogin);
      tabLogin.classList.toggle("text-brand-blue-dark", isLogin);
      tabLogin.classList.toggle("border-transparent", !isLogin);
      tabLogin.classList.toggle("text-text-secondary", !isLogin);
      tabRegister.classList.toggle("border-brand-blue-dark", !isLogin);
      tabRegister.classList.toggle("text-brand-blue-dark", !isLogin);
      tabRegister.classList.toggle("border-transparent", isLogin);
      tabRegister.classList.toggle("text-text-secondary", isLogin);
      panelLogin.hidden = !isLogin;
      panelRegister.hidden = isLogin;
    }
    tabLogin.addEventListener("click", () => activateTab("login"));
    tabRegister.addEventListener("click", () => activateTab("register"));

    // If we landed here with ?next=/learn/something, the middleware
    // bounced an unauthenticated visitor — default to the login tab
    // (which is already the default, but explicit is fine).
    const params = new URLSearchParams(location.search);
    const next = params.get("next") || "/learn/";

    // ============================================================
    // LOGIN
    // ============================================================
    const loginForm = document.getElementById("login-form") as HTMLFormElement;
    const loginErr = document.getElementById("login-error") as HTMLParagraphElement;
    const loginBtn = document.getElementById("login-submit") as HTMLButtonElement;

    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      loginErr.hidden = true;
      loginErr.textContent = "";
      loginBtn.disabled = true;
      const originalLabel = loginBtn.textContent ?? "Sign In";
      loginBtn.textContent = "Signing in…";

      try {
        const res = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: (document.getElementById("login-email") as HTMLInputElement).value,
            password: (document.getElementById("login-password") as HTMLInputElement).value,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok) {
          // Cookie is set; bounce to the original destination.
          location.assign(next);
          return;
        }
        loginErr.textContent = json.error || "Sign-in failed. Try again.";
        loginErr.hidden = false;
      } catch {
        loginErr.textContent = "Couldn't reach the server. Check your connection.";
        loginErr.hidden = false;
      } finally {
        loginBtn.disabled = false;
        loginBtn.textContent = originalLabel;
      }
    });

    // ============================================================
    // REGISTER
    // ============================================================
    const registerForm = document.getElementById("register-form") as HTMLFormElement;
    const registerErr = document.getElementById("register-error") as HTMLParagraphElement;
    const registerBtn = document.getElementById("register-submit") as HTMLButtonElement;
    const registerSuccess = document.getElementById("register-success") as HTMLDivElement;

    registerForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      registerErr.hidden = true;
      registerErr.textContent = "";
      registerBtn.disabled = true;
      const originalLabel = registerBtn.textContent ?? "Create Account";
      registerBtn.textContent = "Creating account…";

      try {
        const res = await fetch("/api/auth/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            full_name: (document.getElementById("register-name") as HTMLInputElement).value,
            email: (document.getElementById("register-email") as HTMLInputElement).value,
            password: (document.getElementById("register-password") as HTMLInputElement).value,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok) {
          registerForm.hidden = true;
          registerSuccess.hidden = false;
          registerSuccess.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }
        registerErr.textContent = json.error || "Registration failed. Try again.";
        registerErr.hidden = false;
      } catch {
        registerErr.textContent = "Couldn't reach the server. Check your connection.";
        registerErr.hidden = false;
      } finally {
        registerBtn.disabled = false;
        registerBtn.textContent = originalLabel;
      }
    });
  </script>
</Layout>
