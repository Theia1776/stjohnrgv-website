---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Library Admin | St. John of Kronstadt"
  description="Upload and manage books in the parish digital library."
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <!-- PDF.js — pinned to the same version the reader uses. Used here to
       pull the text out of a book in the browser at upload time, so the
       server never has to parse a 300-page PDF. -->
  <script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
  ></script>

  <main class="mx-auto max-w-5xl px-4 py-8">
    <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Admin</p>
    <h1 class="font-display text-3xl text-text-primary mb-2 md:text-4xl">Parish Library</h1>
    <p class="text-text-secondary mb-6">
      Upload new books and edit or remove existing ones. New uploads default to
      <strong>Hidden (staging)</strong> — stored safely but visible only to admins —
      so you can promote each one to parishioners or the public when you're ready.
    </p>

    <div id="loading" class="text-text-secondary">Loading…</div>
    <div id="error-msg" class="text-liturgical-red hidden mb-4" role="alert"></div>

    <div id="app" class="hidden">
      <!-- ============== UPLOAD CARD ============== -->
      <section
        class="mb-10 border border-border-soft bg-cream-card p-6 shadow-sm md:p-7"
        aria-labelledby="upload-heading"
      >
        <h2 id="upload-heading" class="font-display text-xl text-text-primary mb-1">
          Add a New Book
        </h2>
        <p class="text-sm text-text-secondary mb-5">
          Choose a PDF and the rest fills itself in — title, author, category and
          languages are read out of the book, and can be corrected before you
          upload. The book's text is pulled out here in your browser at the same
          time, which gives readers a searchable plain-text version alongside the
          original pages. Scanned books have no text to pull, and upload just the
          same.
        </p>

        <form id="upload-form" class="space-y-4">
          <div>
            <label for="pdf" class="block text-sm font-semibold mb-1">PDF file *</label>
            <input
              id="pdf"
              name="pdf"
              type="file"
              accept="application/pdf"
              required
              class="block w-full text-sm text-text-primary file:mr-3 file:border file:border-border-soft file:bg-brand-blue-pale file:px-3 file:py-1.5 file:text-xs file:uppercase file:tracking-widest file:text-brand-blue-dark file:cursor-pointer hover:file:bg-brand-blue-pale/70"
            />
            <p class="mt-1 text-xs text-text-secondary">Up to 50 MB.</p>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label for="title" class="block text-sm font-semibold mb-1">Title *</label>
              <input
                id="title"
                name="title"
                type="text"
                required
                class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for="author" class="block text-sm font-semibold mb-1">Author</label>
              <input
                id="author"
                name="author"
                type="text"
                class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
              />
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label for="category" class="block text-sm font-semibold mb-1">Category *</label>
              <select
                id="category"
                name="category"
                required
                class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
              >
                <option value="Hagiography">Hagiography — lives of saints</option>
                <option value="Liturgical Texts">Liturgical Texts — service books, prayer books</option>
                <option value="Patristics">Patristics — writings of the Church Fathers</option>
                <option value="Scripture">Scripture — Bible texts and commentaries</option>
                <option value="History">History — Church history, parish history</option>
                <option value="Theology / Doctrine">Theology / Doctrine — catechisms, doctrinal works</option>
                <option value="Spiritual Life">Spiritual Life — prayer, asceticism, monastic writings</option>
                <option value="Other">Other — anything that doesn't fit above</option>
              </select>
            </div>
            <div>
              <label for="languages" class="block text-sm font-semibold mb-1">Languages *</label>
              <input
                id="languages"
                name="languages"
                type="text"
                required
                value="English"
                placeholder="English, Greek, Church Slavonic"
                class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
              />
              <p class="mt-1 text-xs text-text-secondary">Comma-separated.</p>
            </div>
          </div>

          <div>
            <label for="description" class="block text-sm font-semibold mb-1">Description</label>
            <textarea
              id="description"
              name="description"
              rows="3"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
            ></textarea>
          </div>

          <div>
            <label for="slug" class="block text-sm font-semibold mb-1">URL slug (optional)</label>
            <input
              id="slug"
              name="slug"
              type="text"
              placeholder="auto-generated from title"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2"
            />
          </div>

          <div>
            <label for="visibility" class="block text-sm font-semibold mb-1">Visibility</label>
            <select
              id="visibility"
              name="visibility"
              class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
            >
              <option value="hidden" selected>Hidden — staging (admins only)</option>
              <option value="parish">Parishioners only (logged-in)</option>
              <option value="public">Public (anyone, even logged-out)</option>
            </select>
            <p class="mt-1 text-xs text-text-secondary">
              New books default to Hidden so they're stored safely until you promote them.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <button id="upload-btn" type="submit" class="btn btn-primary">
              Upload Book
            </button>
            <span id="upload-status" class="text-sm text-text-secondary"></span>
          </div>
        </form>
      </section>

      <!-- ============== EDIT MODAL ============== -->
      <!-- Hidden by default; .removeAttribute("hidden") to show. Backdrop -->
      <!-- click and Escape both close. Form submit PATCHes the row.       -->
      <div
        id="edit-modal"
        hidden
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-modal-title"
        class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-black/50 p-4"
      >
        <div class="my-8 w-full max-w-2xl border border-border-soft bg-cream-card p-6 shadow-lg md:p-8">
          <div class="mb-4 flex items-start justify-between gap-4">
            <h3 id="edit-modal-title" class="font-display text-xl text-text-primary">Edit Book</h3>
            <button
              type="button"
              id="edit-close"
              aria-label="Close"
              class="text-2xl leading-none text-text-secondary hover:text-text-primary"
            >&times;</button>
          </div>

          <form id="edit-form" class="space-y-4">
            <input type="hidden" id="edit-id" />

            <div>
              <label for="edit-title" class="block text-sm font-semibold mb-1">Title *</label>
              <input id="edit-title" type="text" required class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2" />
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label for="edit-author" class="block text-sm font-semibold mb-1">Author</label>
                <input id="edit-author" type="text" class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2" />
              </div>
              <div>
                <label for="edit-category" class="block text-sm font-semibold mb-1">Category *</label>
                <select id="edit-category" required class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2">
                  <option value="Hagiography">Hagiography — lives of saints</option>
                  <option value="Liturgical Texts">Liturgical Texts — service books, prayer books</option>
                  <option value="Patristics">Patristics — writings of the Church Fathers</option>
                  <option value="Scripture">Scripture — Bible texts and commentaries</option>
                  <option value="History">History — Church history, parish history</option>
                  <option value="Theology / Doctrine">Theology / Doctrine — catechisms, doctrinal works</option>
                  <option value="Spiritual Life">Spiritual Life — prayer, asceticism, monastic writings</option>
                  <option value="Other">Other — anything that doesn't fit above</option>
                </select>
              </div>
            </div>

            <div>
              <label for="edit-languages" class="block text-sm font-semibold mb-1">Languages *</label>
              <input id="edit-languages" type="text" required class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2" />
              <p class="mt-1 text-xs text-text-secondary">Comma-separated.</p>
            </div>

            <div>
              <label for="edit-description" class="block text-sm font-semibold mb-1">Description</label>
              <textarea id="edit-description" rows="3" class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"></textarea>
            </div>

            <div>
              <label for="edit-slug" class="block text-sm font-semibold mb-1">URL slug</label>
              <input id="edit-slug" type="text" class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2" />
              <p class="mt-1 text-xs text-text-secondary">Changing this breaks existing links to the book.</p>
            </div>

            <div>
              <label for="edit-visibility" class="block text-sm font-semibold mb-1">Visibility</label>
              <select id="edit-visibility" class="block w-full border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2">
                <option value="hidden">Hidden — staging (admins only)</option>
                <option value="parish">Parishioners only (logged-in)</option>
                <option value="public">Public (anyone, even logged-out)</option>
              </select>
            </div>

            <div class="flex items-center justify-end gap-3 border-t border-border-soft pt-4">
              <span id="edit-status" class="text-sm text-text-secondary mr-auto"></span>
              <button type="button" id="edit-cancel" class="btn btn-secondary">Cancel</button>
              <button type="submit" id="edit-save" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
      </div>

      <!-- ============== MANAGE LIST ============== -->
      <section aria-labelledby="manage-heading">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
          <h2 id="manage-heading" class="font-display text-xl text-text-primary">
            Current Catalog (<span id="book-count">0</span>)
          </h2>
          <span id="backfill-summary" class="text-sm text-text-secondary"></span>
        </div>

        <!-- The occasional jobs, folded away. Day to day this page is
             for finding a book and changing its visibility; these are
             for after a batch of books arrives, and having them all out
             on the page made the ordinary work harder to see. -->
        <details class="mb-4 border border-border-soft bg-cream-card">
          <summary class="cursor-pointer px-4 py-2 font-display text-xs uppercase tracking-widest text-text-secondary hover:text-brand-blue-dark">
            Library jobs
          </summary>
          <div class="border-t border-border-soft px-4 py-4">
            <p class="mb-3 text-sm text-text-secondary">
              After new books arrive, run these in order. Each one is safe to
              repeat — anything already done is skipped.
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <button type="button" id="register-btn" class="btn btn-secondary text-sm">
                1. Add books found in storage
              </button>
              <button type="button" id="backfill-btn" class="btn btn-secondary text-sm" hidden>
                2. Prepare text
              </button>
              <button type="button" id="r2-btn" class="btn btn-secondary text-sm">
                Copy books to Cloudflare
              </button>
            </div>
            <p id="register-status" class="mt-3 text-sm text-text-secondary" hidden></p>
            <p id="backfill-status" class="mt-3 text-sm text-text-secondary" hidden></p>
            <p id="r2-status" class="mt-3 text-sm text-text-secondary" hidden></p>
          </div>
        </details>

        <!-- Finding one book among hundreds. Filters the table below by
             title, author, slug, category or language; the dropdown
             narrows by visibility or by whether a text version exists. -->
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <label for="catalog-search" class="sr-only">Search the catalog</label>
          <input
            id="catalog-search"
            type="search"
            autocomplete="off"
            placeholder="Search title, author, slug, category…"
            class="min-w-[18rem] flex-1 border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
          />
          <label for="catalog-filter" class="sr-only">Filter</label>
          <select
            id="catalog-filter"
            class="border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
          >
            <option value="">All books</option>
            <option value="hidden">Hidden (staging)</option>
            <option value="parish">Parishioners only</option>
            <option value="public">Public</option>
            <option value="has-text">Has a text version</option>
            <option value="no-text">No text version</option>
            <option value="scan">Scans (no text to pull)</option>
            <option value="failed">Failed to read</option>
            <option value="no-pages">Text without page numbers</option>
            <option value="untried">Text not tried yet</option>
          </select>
          <button type="button" id="catalog-clear" class="btn btn-secondary text-sm" hidden>Clear</button>
          <!-- For working on the books outside the site — a reading list,
               a spreadsheet, or handing the catalogue to something that
               helps with citations but can't sign in to see the library
               for itself. Exports whatever the table is currently
               showing, so a filter narrows the export too. -->
          <label for="catalog-export" class="sr-only">Export the list</label>
          <select
            id="catalog-export"
            class="border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
          >
            <option value="">Export list…</option>
            <option value="csv">Spreadsheet (.csv)</option>
            <option value="md">Reading list (.md)</option>
            <option value="text">Full text of these books (.txt)</option>
          </select>
        </div>
        <p id="catalog-count" class="mb-3 text-sm text-text-secondary"></p>
        <p id="export-status" class="mb-3 text-sm text-text-secondary" hidden></p>
        <div class="overflow-x-auto border border-border-soft rounded">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-brand-blue-dark text-cream-bg text-left">
                <th class="p-2">Title</th>
                <th class="p-2">Author</th>
                <th class="p-2">Category</th>
                <th class="p-2">Languages</th>
                <th class="p-2">Visibility</th>
                <th class="p-2">Text</th>
                <th class="p-2 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="books-tbody"></tbody>
          </table>
        </div>
        <p id="books-empty" class="text-text-secondary mt-4 hidden">
          No books in the catalog yet — upload one above.
        </p>
      </section>
    </div>
  </main>
</Layout>

<script>
  type Book = {
    id: string;
    slug: string;
    title: string;
    author: string | null;
    category: string;
    languages: string[];
    description: string | null;
    pdf_storage_key: string;
    public_access: boolean;
    hidden: boolean;
    text_chars: number | null;
    text_status: string | null;
    text_pages: number | null;
    created_at: string;
    updated_at: string;
  };

  let books: Book[] = [];

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function showError(message: string) {
    const el = document.getElementById("error-msg");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
    // Auto-clear after a bit so the banner doesn't haunt later actions.
    setTimeout(() => el.classList.add("hidden"), 8000);
  }

  function setUploadStatus(text: string, isError = false) {
    const el = document.getElementById("upload-status");
    if (!el) return;
    el.textContent = text;
    el.className = isError
      ? "text-sm text-liturgical-red"
      : "text-sm text-text-secondary";
  }

  async function loadBooks() {
    const res = await fetch("/api/admin/library", {
      credentials: "same-origin",
      cache: "no-store",
    });
    if (res.status === 401 || res.status === 403) {
      window.location.assign("/");
      return;
    }
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showError(`Couldn't load books: ${body.error ?? res.status}`);
      return;
    }
    const data = await res.json();
    books = (data.books ?? []) as Book[];
    render();
  }

  // ====================== SEARCH / FILTER ======================
  // Fold accents and lowercase so capitalisation and diacritics never
  // stand between you and a book. Punctuation becomes a space, because a
  // book gets typed the way it's spoken — "Andreyev, Orthodox Apologetic
  // Theology" — and a trailing comma shouldn't stop the word matching.
  function normalize(value: string): string {
    return String(value ?? "")
      .normalize("NFKD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function bookHaystack(b: Book): string {
    return normalize(
      [b.title, b.author ?? "", b.slug, b.category, ...(b.languages ?? [])].join(" "),
    );
  }

  function matchesFilter(b: Book, filter: string): boolean {
    switch (filter) {
      case "hidden": return b.hidden;
      case "parish": return !b.hidden && !b.public_access;
      case "public": return !b.hidden && b.public_access;
      case "has-text": return b.text_status === "ok";
      case "no-text": return b.text_status !== "ok";
      case "scan": return b.text_status === "empty";
      // Not scans: files PDF.js couldn't open at all — protected,
      // damaged, or oddly built. Worth looking at individually.
      case "failed": return b.text_status === "error";
      case "no-pages": return b.text_status === "ok" && !Number(b.text_pages ?? 0);
      case "untried": return !b.text_status;
      default: return true;
    }
  }

  // The books the table is currently showing. Every word typed must
  // appear somewhere, in any order.
  function visibleBooks(): Book[] {
    const query = (document.getElementById("catalog-search") as HTMLInputElement | null)?.value.trim() ?? "";
    const filter = (document.getElementById("catalog-filter") as HTMLSelectElement | null)?.value ?? "";
    const terms = normalize(query).split(/\s+/).filter(Boolean);
    const inFilter = books.filter((b) => matchesFilter(b, filter));
    if (terms.length === 0) return inFilter;

    const exact = inFilter.filter((b) => {
      const hay = bookHaystack(b);
      return terms.every((t) => hay.includes(t));
    });
    if (exact.length > 0 || terms.length < 2) return exact;

    // Nothing carries every word. Rather than an empty table, show the
    // books carrying the most of them — only the closest, or one word
    // out of four would drag in every book with "orthodox" on it.
    const scored = inFilter
      .map((b) => {
        const hay = bookHaystack(b);
        return { book: b, score: terms.filter((t) => hay.includes(t)).length };
      })
      .filter((s) => s.score > 0);
    if (scored.length === 0) return [];
    // At least two words must land. One out of four is not a near miss —
    // it's "there" containing "here" — and a wrong book is worse than none.
    const best = Math.max(...scored.map((s) => s.score));
    if (best < 2) return [];
    return scored.filter((s) => s.score === best).map((s) => s.book);
  }

  function render() {
    const tbody = document.getElementById("books-tbody");
    const empty = document.getElementById("books-empty");
    const countEl = document.getElementById("book-count");
    if (!tbody || !empty) return;

    if (countEl) countEl.textContent = String(books.length);

    const shown = visibleBooks();
    const searchEl = document.getElementById("catalog-search") as HTMLInputElement | null;
    const filterEl = document.getElementById("catalog-filter") as HTMLSelectElement | null;
    const clearBtn = document.getElementById("catalog-clear") as HTMLButtonElement | null;
    const isFiltered = Boolean(searchEl?.value.trim()) || Boolean(filterEl?.value);
    if (clearBtn) clearBtn.hidden = !isFiltered;
    const countLine = document.getElementById("catalog-count");
    if (countLine) {
      countLine.textContent = isFiltered
        ? `Showing ${shown.length} of ${books.length} books`
        : "";
    }

    if (books.length === 0) {
      tbody.innerHTML = "";
      empty.classList.remove("hidden");
      renderBackfillControl();
      return;
    }
    empty.classList.add("hidden");

    renderBackfillControl();

    // Nothing matched the search — say so in the table rather than
    // leaving an empty box that looks broken.
    if (shown.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-sm italic text-text-secondary">No books match that search.</td></tr>`;
      return;
    }

    tbody.innerHTML = shown
      .map(
        (b) => `<tr class="border-b border-border-soft hover:bg-brand-blue-pale/40" data-id="${escapeHtml(b.id)}">
          <td class="p-2">
            <a href="/learn/library/reader/?slug=${encodeURIComponent(b.slug)}&from=admin" class="text-brand-blue-dark hover:underline" target="_blank" rel="noopener">${escapeHtml(b.title)}</a>
            <div class="text-xs text-text-secondary font-mono">${escapeHtml(b.slug)}</div>
          </td>
          <td class="p-2">${escapeHtml(b.author ?? "—")}</td>
          <td class="p-2">${escapeHtml(b.category)}</td>
          <td class="p-2 text-xs">${escapeHtml((b.languages ?? []).join(", "))}</td>
          <td class="p-2">
            <select class="visibility-select border border-border-soft bg-cream-bg px-2 py-1 text-xs focus:outline-none focus:ring-2" data-id="${escapeHtml(b.id)}" aria-label="Visibility">
              <option value="hidden"${b.hidden ? " selected" : ""}>Hidden</option>
              <option value="parish"${!b.hidden && !b.public_access ? " selected" : ""}>Parishioners</option>
              <option value="public"${!b.hidden && b.public_access ? " selected" : ""}>Public</option>
            </select>
          </td>
          <td class="p-2 whitespace-nowrap text-xs">${textCell(b)}</td>
          <!-- One dropdown rather than three buttons: with hundreds of
               rows, three wide buttons each pushed the titles off the
               side of the table. -->
          <td class="p-2 text-right whitespace-nowrap">
            <select
              class="row-action border border-border-soft bg-cream-bg px-2 py-1 text-xs focus:outline-none focus:ring-2"
              data-id="${escapeHtml(b.id)}"
              data-slug="${escapeHtml(b.slug)}"
              data-title="${escapeHtml(b.title)}"
              aria-label="Actions for ${escapeHtml(b.title)}"
            >
              <option value="">Actions…</option>
              <option value="edit">Edit details</option>
              ${b.text_status === "ok" ? `<option value="text">Download .txt</option>` : ""}
              <option value="delete">Delete book</option>
            </select>
          </td>
        </tr>`,
      )
      .join("");
  }

  // A catalog of hundreds of rows: the floating back-to-top button
  // should jump, not glide.
  document.documentElement.style.scrollBehavior = "auto";
  document.documentElement.dataset.instantScroll = "true";

  // ====================== TEXT EXTRACTION ======================
  // PDF.js gives us the text layer of a PDF. Books that were typeset
  // digitally hand it over cleanly; books that are photographs of pages
  // have none to give, and come back empty — that's a scan, not a
  // failure, and it's recorded as such so the backfill doesn't keep
  // retrying them.
  const pdfjsLib = (window as unknown as { pdfjsLib: any }).pdfjsLib;
  if (pdfjsLib) {
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
  }

  // Beyond this we keep the beginning rather than refusing the book.
  // Matches the cap on the server.
  const MAX_TEXT_CHARS = 3_000_000;

  type Extraction = { text: string; status: "ok" | "empty" | "error"; pages: number };

  async function extractText(
    source: { data: ArrayBuffer } | { url: string },
    onProgress?: (page: number, total: number) => void,
  ): Promise<Extraction> {
    if (!pdfjsLib) return { text: "", status: "error", pages: 0 };
    try {
      const pdf = await pdfjsLib.getDocument(source).promise;

      // Many PDFs carry real page labels — i, ii, iii through the front
      // matter, then 1, 2, 3 — and those are what's printed on the paper,
      // which is what a citation needs. Where a book has none, its
      // position in the file is the honest fallback.
      let labels: string[] | null = null;
      try {
        labels = await pdf.getPageLabels();
      } catch {
        labels = null;
      }

      const parts: string[] = [];
      let chars = 0;
      let pagesWithText = 0;
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        // One page per line keeps some sense of where you are; PDF.js
        // hands back positioned fragments, so they're joined with spaces.
        const pageText = content.items.map((it: any) => it.str).join(" ").replace(/\s+/g, " ").trim();
        if (pageText) {
          const label = labels && labels[i - 1] ? String(labels[i - 1]) : String(i);
          // The marker carries what to show and where to go: the printed
          // label, then the page's position in the file. U+241E is a
          // character no book contains, so it can never be mistaken for
          // the text itself. The reader strips these out on load.
          parts.push(`␞${label}|${i}␞\n${pageText}`);
          chars += pageText.length;
          pagesWithText++;
        }
        onProgress?.(i, pdf.numPages);
        if (chars > MAX_TEXT_CHARS) break;
      }
      // A blank line between pages, so the text view has some sense of
      // where one page ended and the next began.
      const text = parts.join("\n\n").slice(0, MAX_TEXT_CHARS);
      // pages counts the pages the text actually carries markers for —
      // that's what tells the backfill this book has page numbers.
      return { text, status: text ? "ok" : "empty", pages: text ? pagesWithText : 0 };
    } catch (err) {
      console.error("Text extraction failed:", err);
      return { text: "", status: "error", pages: 0 };
    }
  }

  // ====================== READING THE BOOK'S OWN DETAILS ======================
  // Choosing a category for a book you haven't read is a guess, and the
  // PDF usually knows more about itself than the form asks for. So when a
  // file is picked we read it once: its embedded title and author, the
  // large type on its title page, which alphabets appear in it, and which
  // subject its vocabulary points to. Everything is a suggestion — each
  // field is filled only if it's still empty, and all of it can be typed
  // over.

  type Analysis = {
    title: string;
    author: string;
    category: string;
    languages: string[];
    description: string;
  };

  // Distinctive words per category, weighted: three for a term that
  // belongs to one subject and almost nowhere else, one for a term that
  // merely leans that way. Scored over the book's own text, so a passing
  // mention loses to a book about the thing.
  const CATEGORY_TERMS: Record<string, [string, number][]> = {
    "Liturgical Texts": [
      ["divine liturgy", 3], ["vespers", 3], ["matins", 3], ["orthros", 3],
      ["troparion", 3], ["kontakion", 3], ["prokeimenon", 3], ["akathist", 3],
      ["horologion", 3], ["euchologion", 3], ["typikon", 3], ["menaion", 3],
      ["service book", 3], ["prayer book", 2], ["the hours", 2], ["litany", 2],
      ["celebrant", 2], ["deacon:", 2], ["priest:", 2], ["choir:", 2],
    ],
    Hagiography: [
      ["life of saint", 3], ["lives of the saints", 3], ["holy martyr", 3],
      ["venerable father", 3], ["wonderworker", 3], ["his relics", 3],
      ["glorification", 2], ["ascetic feats", 2], ["monastery of", 1],
      ["was born in", 1], ["reposed", 2], ["commemorated", 2],
    ],
    Patristics: [
      ["homily", 3], ["homilies", 3], ["church fathers", 3], ["chrysostom", 2],
      ["basil the great", 3], ["gregory the theologian", 3], ["isaac the syrian", 3],
      ["ephraim the syrian", 3], ["discourse", 2], ["treatise", 2],
      ["on the incarnation", 3], ["patristic", 3],
    ],
    Scripture: [
      ["gospel according", 3], ["new testament", 3], ["old testament", 3],
      ["the psalter", 3], ["epistle to the", 3], ["holy scripture", 2],
      ["chapter and verse", 2], ["evangelist", 2], ["septuagint", 3],
    ],
    History: [
      ["church history", 3], ["ecumenical council", 3], ["the schism", 3],
      ["patriarchate", 2], ["in the year", 1], ["century", 1], ["synod", 2],
      ["chronicle", 2], ["emperor", 2], ["persecution", 1],
    ],
    "Theology / Doctrine": [
      ["catechism", 3], ["dogma", 3], ["doctrine", 2], ["symbol of faith", 3],
      ["the creed", 3], ["heresy", 2], ["apologetic", 3], ["theology", 2],
      ["trinity", 2], ["orthodox faith", 2],
    ],
    "Spiritual Life": [
      ["the passions", 3], ["asceticism", 3], ["monastic life", 3],
      ["spiritual life", 3], ["the elder", 2], ["repentance", 2],
      ["prayer of the heart", 3], ["jesus prayer", 3], ["philokalia", 3],
      ["confession", 2], ["fasting", 2], ["humility", 2],
    ],
  };

  /** Which subject the book's own vocabulary points to. */
  function guessCategory(text: string, title: string): string {
    // The opening pages carry title, contents and preface — the most
    // telling part — and scoring a whole book is needless work.
    const sample = (title + " " + text.slice(0, 60000)).toLowerCase();
    let best = "";
    let bestScore = 0;
    for (const [category, terms] of Object.entries(CATEGORY_TERMS)) {
      let score = 0;
      for (const [term, weight] of terms) {
        // Count up to five occurrences per term, so one word repeated
        // hundreds of times can't decide the whole book.
        let found = 0;
        let at = sample.indexOf(term);
        while (at !== -1 && found < 5) {
          found++;
          at = sample.indexOf(term, at + term.length);
        }
        score += found * weight;
      }
      if (score > bestScore) {
        bestScore = score;
        best = category;
      }
    }
    // A weak signal is worse than none: "Other" is honest, and it's the
    // first thing an admin will look at.
    return bestScore >= 6 ? best : "Other";
  }

  /** Which alphabets actually appear, in enough quantity to count. */
  function guessLanguages(text: string, hint: string): string[] {
    const sample = text.slice(0, 200000);
    const count = (re: RegExp) => (sample.match(re) ?? []).length;

    const latin = count(/[A-Za-z]/g);
    const greek = count(/[Ͱ-Ͽἀ-῿]/g);
    const cyrillic = count(/[Ѐ-ӿ]/g);
    // Letters that dropped out of Russian but remain in Church Slavonic.
    const slavonicMarks = count(/[ѣѳѵѦѧѻѱ]/g);

    const languages: string[] = [];
    if (latin > 200) languages.push("English");
    if (greek > 200) languages.push("Greek");
    if (cyrillic > 200) {
      // The archaic letters settle it when they survive extraction. They
      // often don't, since Slavonic fonts tend to carry private
      // encodings — so Cyrillic in a service book is taken as Slavonic,
      // which is what a parish library's service books are.
      const slavonic = slavonicMarks > 20 || hint === "Liturgical Texts";
      languages.push(slavonic ? "Church Slavonic" : "Russian");
    }
    return languages.length ? languages : ["English"];
  }

  /**
   * Text that came out of the PDF garbled. Church Slavonic and old Greek
   * are often set in fonts with private encodings, so a title page's
   * largest line can extract as "Б9eственнаz літургjа" — digits and two
   * alphabets fused into single words. A title like that is worse than
   * none.
   */
  function looksMangled(value: string): boolean {
    for (const word of value.split(/\s+/)) {
      if (word.length < 3) continue;
      if (/[A-Za-zЀ-ӿ][0-9]|[0-9][A-Za-zЀ-ӿ]/.test(word)) return true;
      const scripts = [/[A-Za-z]/, /[Ѐ-ӿ]/, /[Ͱ-Ͽἀ-῿]/].filter((re) => re.test(word));
      if (scripts.length > 1) return true;
    }
    return false;
  }

  /** Rubbish that PDF producers leave in the Title field. */
  function looksLikeRealTitle(value: string): boolean {
    const v = value.trim();
    if (v.length < 4 || v.length > 150) return false;
    if (/^(microsoft word|untitled|document\d*|book\d*|print|scan)/i.test(v)) return false;
    if (/\.(pdf|docx?|indd|qxd)$/i.test(v)) return false;
    return true;
  }

  /**
   * The largest type on the title page, which is nearly always the title,
   * and the line beneath it, which is often the author. PDF.js gives each
   * fragment a transform whose scale is its rendered size.
   */
  async function readTitlePage(pdf: any): Promise<{ title: string; author: string }> {
    try {
      const page = await pdf.getPage(1);
      const content = await page.getTextContent();
      const lines: { size: number; text: string }[] = [];
      for (const item of content.items) {
        const text = String(item.str ?? "").trim();
        if (text.length < 2) continue;
        const size = Math.abs(Number(item.transform?.[3] ?? 0));
        lines.push({ size, text });
      }
      if (lines.length === 0) return { title: "", author: "" };

      // Group fragments into lines of type by size, largest first. The
      // title is nearly always the biggest thing on the page — but when
      // it extracts as gibberish (Slavonic and old Greek fonts often
      // do), the next size down is usually the same title in English.
      const sizes = [...new Set(lines.map((l) => Math.round(l.size * 2) / 2))].sort((a, b) => b - a);
      let title = "";
      for (const size of sizes.slice(0, 4)) {
        const candidate = lines
          .filter((l) => Math.abs(Math.round(l.size * 2) / 2 - size) < 0.01)
          .map((l) => l.text)
          .join(" ")
          .replace(/\s+/g, " ")
          .trim();
        if (candidate.length >= 4 && candidate.length <= 150 && !looksMangled(candidate)) {
          title = candidate;
          break;
        }
      }

      // An author line either announces itself, or carries a title of
      // office that only ever precedes a name.
      const byLine = lines.find((l) => /^(by|written by|compiled by|translated by)\b/i.test(l.text));
      const clergyLine = lines.find(
        (l) =>
          /^(fr\.|father|priest|archpriest|hieromonk|archimandrite|bishop|archbishop|metropolitan|st\.|saint|monk|nun)\s+\S/i.test(l.text) &&
          l.text.length <= 80 &&
          !looksMangled(l.text),
      );
      const author = byLine
        ? byLine.text.replace(/^(by|written by|compiled by|translated by)\s+/i, "").trim()
        : clergyLine?.text.trim() ?? "";
      return { title, author };
    } catch {
      return { title: "", author: "" };
    }
  }

  /**
   * Filenames in this library are descriptive — "The Ladder of Divine
   * Ascent - St John Klimakos.pdf" — and a name someone typed on purpose
   * beats a metadata field written by whatever produced the file.
   */
  function parseFilename(filename: string): { title: string; author: string } {
    const base = filename
      .replace(/\.pdf$/i, "")
      .replace(/[_]+/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    // "Title - Author" is the common shape; a spaced hyphen or en dash
    // separates them, while hyphens inside words are left alone.
    const split = base.split(/\s+[-–—]\s+/);
    if (split.length >= 2) {
      return { title: split[0].trim(), author: split.slice(1).join(" - ").trim() };
    }
    return { title: base, author: "" };
  }

  /** Does this name look like a person, rather than whoever owned the laptop? */
  function looksLikeAuthor(value: string): boolean {
    const v = value.trim();
    if (v.length < 4 || v.length > 120) return false;
    if (/^(unknown|user|admin|owner|guest|windows|microsoft|acrobat|scanner)$/i.test(v)) return false;
    // A title of office is enough on its own.
    if (/\b(st\.?|saint|fr\.?|father|priest|archpriest|hieromonk|archimandrite|bishop|archbishop|metropolitan|monk|nun|elder|pope)\b/i.test(v)) {
      return true;
    }
    // Otherwise it needs at least a forename and a surname. "Janice" is
    // the person who made the PDF, not the author of the book.
    return v.split(/\s+/).filter((w) => w.length > 1).length >= 2;
  }

  /**
   * How much of a candidate title actually appears in the book's opening
   * pages. A real title is printed in its own book; a cataloguer's
   * shorthand like "Clim. Ladder, tr.Lazarus Moore" is not.
   */
  function titleSupport(candidate: string, text: string): number {
    const words = candidate.toLowerCase().match(/[a-z]{4,}/g) ?? [];
    if (words.length === 0) return 0;
    const opening = text.slice(0, 8000).toLowerCase();
    const found = words.filter((w) => opening.includes(w)).length;
    return found / words.length;
  }

  /** Pick the most title-like of the candidates we have. */
  function chooseTitle(candidates: string[], text: string): string {
    let best = "";
    let bestScore = -Infinity;
    for (const raw of candidates) {
      const candidate = raw.trim();
      if (!candidate || candidate.length < 4 || candidate.length > 150) continue;

      let score = titleSupport(candidate, text) * 4;
      const words = candidate.split(/\s+/).filter(Boolean);
      if (words.length >= 3) score += 1;
      if (looksMangled(candidate)) score -= 5;
      // Cataloguing shorthand: "Clim. Ladder, tr.Lazarus Moore".
      if (/\b(tr|ed|trans|vol|pt|comp)\.\s*/i.test(candidate)) score -= 4;
      // Abbreviated words are a shorthand tell too.
      const abbreviations = (candidate.match(/\b[A-Za-z]{2,5}\./g) ?? []).length;
      if (abbreviations >= 1 && !/^(st|fr|ss)\.$/i.test(candidate.match(/\b[A-Za-z]{2,5}\./)?.[0] ?? "")) {
        score -= abbreviations;
      }
      if (score > bestScore) {
        bestScore = score;
        best = candidate;
      }
    }
    return best;
  }

  async function analysePdf(pdf: any, text: string, filename: string): Promise<Analysis> {
    let info: any = {};
    try {
      const meta = await pdf.getMetadata();
      info = meta?.info ?? {};
    } catch {
      info = {};
    }

    const fromPage = await readTitlePage(pdf);
    const fromName = parseFilename(filename);

    // Three sources, none reliably best: the embedded title is often a
    // cataloguer's shorthand, the title page is often set in a font that
    // won't extract, and the filename is whatever someone typed. Score
    // them against the book's own opening pages and take the winner.
    const embeddedTitle = String(info.Title ?? "").trim();
    const title = chooseTitle(
      [
        looksLikeRealTitle(embeddedTitle) ? embeddedTitle : "",
        fromPage.title,
        fromName.title,
      ],
      text,
    );

    // Authors are left blank far more readily than titles. A wrong name
    // on a book is worse than no name — it gets cited — and the sources
    // are poor: the Author field is usually whoever made the file, and
    // the half of a filename after the dash is as likely to be a
    // translator, a publisher or a note as an author.
    //
    // So a candidate must both look like a name AND have its surname
    // appear in the book's own opening pages. A book prints its author's
    // name inside it; "Janice" is nowhere in The Ladder of Divine Ascent.
    const embeddedAuthor = String(info.Author ?? "").trim();
    const opening = text.slice(0, 8000).toLowerCase();
    const namedInBook = (candidate: string): boolean => {
      const words = candidate.toLowerCase().match(/[a-zà-ÿ]{3,}/g) ?? [];
      // Honorifics prove nothing, and forenames prove little: "John"
      // appears in nearly every Orthodox book ever printed. The surname
      // is what has to be there.
      const names = words.filter(
        (w) => !/^(father|priest|saint|elder|bishop|monk|nun|archpriest|hieromonk|archimandrite|metropolitan)$/.test(w),
      );
      const surname = names[names.length - 1];
      return Boolean(surname) && surname.length >= 4 && opening.includes(surname);
    };
    const author =
      [fromName.author, fromPage.author, embeddedAuthor].find(
        (candidate) => candidate && looksLikeAuthor(candidate) && namedInBook(candidate),
      ) ?? "";

    // Subject and Keywords are where a description would live if the book
    // has one; the body text is not a description and reads terribly as
    // one, so nothing is invented when they're absent.
    const subject = String(info.Subject ?? "").trim();
    // A "description" that merely repeats the title tells a reader
    // nothing, and producers set Subject to the title all the time.
    const flatten = (v: string) => v.toLowerCase().replace(/[^a-z0-9]+/g, "");
    const echoesTitle =
      Boolean(title) &&
      (flatten(subject).includes(flatten(title)) || flatten(title).includes(flatten(subject)));
    const description =
      subject.length > 10 && subject.length <= 500 && !echoesTitle ? subject : "";

    // Category first: it settles what a Cyrillic service book is written in.
    const category = guessCategory(text, title);

    return {
      title,
      author,
      category,
      languages: guessLanguages(text, category),
      description,
    };
  }

  /** Fill a field only when it's empty, so nothing typed is overwritten. */
  function fillIfEmpty(id: string, value: string): boolean {
    if (!value) return false;
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    if (!el || el.value.trim()) return false;
    el.value = value;
    return true;
  }

  function textCell(b: Book): string {
    if (b.text_status === "ok") {
      const pages = Number(b.text_pages ?? 0);
      if (pages > 0) {
        return `<span class="text-text-secondary">${pages.toLocaleString()} pages</span>`;
      }
      // Text from before page markers existed — the backfill will
      // re-read it.
      return `<span class="text-brand-tan-dark">no page numbers</span>`;
    }
    if (b.text_status === "empty") return `<span class="text-text-secondary">scan — no text</span>`;
    if (b.text_status === "error") return `<span class="text-liturgical-red">failed</span>`;
    return `<span class="text-text-secondary">—</span>`;
  }

  // ====================== BACKFILL ======================
  // Books uploaded before text extraction existed. Each one is fetched
  // through its signed URL, read in this browser, and PATCHed back. It
  // runs in the open tab; closing the tab stops it, and re-running picks
  // up where it left off because finished books no longer qualify.
  function booksNeedingText(): Book[] {
    return books.filter((b) => {
      // Never tried.
      if (!b.text_status) return true;
      // Has text, but from before page markers existed — re-reading it
      // is what gives citations their page numbers.
      if (b.text_status === "ok" && !Number(b.text_pages ?? 0)) return true;
      return false;
    });
  }

  function renderBackfillControl() {
    const btn = document.getElementById("backfill-btn") as HTMLButtonElement | null;
    const summary = document.getElementById("backfill-summary");
    if (!btn || !summary) return;
    const pending = booksNeedingText().length;
    const withText = books.filter((b) => b.text_status === "ok").length;
    const withPages = books.filter((b) => Number(b.text_pages ?? 0) > 0).length;
    summary.textContent = books.length
      ? `${withText} of ${books.length} have text, ${withPages} with page numbers` +
        (pending ? ` · ${pending} to read` : "")
      : "";
    btn.hidden = pending === 0;
    // Keep the step number: this button is the second of the jobs.
    btn.textContent = `2. Prepare text for ${pending} book${pending === 1 ? "" : "s"}`;
  }

  function setBackfillStatus(text: string, isError = false) {
    const el = document.getElementById("backfill-status");
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
    el.className = isError ? "mb-4 text-sm text-liturgical-red" : "mb-4 text-sm text-text-secondary";
  }

  document.getElementById("backfill-btn")?.addEventListener("click", async () => {
    const btn = document.getElementById("backfill-btn") as HTMLButtonElement;
    const queue = booksNeedingText();
    if (queue.length === 0) return;
    if (!window.confirm(`Read the text out of ${queue.length} book${queue.length === 1 ? "" : "s"}? Keep this tab open while it runs.`)) return;

    btn.disabled = true;
    let done = 0;
    let withText = 0;
    let scans = 0;
    let failed = 0;

    for (const book of queue) {
      setBackfillStatus(`Reading “${book.title}” (${done + 1} of ${queue.length})…`);
      try {
        const signed = await fetch(`/api/library/pdf?key=${encodeURIComponent(book.pdf_storage_key)}`, {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        });
        if (!signed.ok) throw new Error(`could not open the PDF (${signed.status})`);
        const { url } = await signed.json();

        const result = await extractText({ url });
        if (result.status === "ok") withText++;
        else if (result.status === "empty") scans++;
        else failed++;

        const res = await fetch(`/api/admin/library/${encodeURIComponent(book.id)}`, {
          method: "PATCH",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            text_content: result.text,
            text_status: result.status,
            text_pages: result.pages,
          }),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error ?? `save failed (${res.status})`);
        }
      } catch (err) {
        failed++;
        console.error(`Backfill failed for ${book.title}:`, err);
      }
      done++;
    }

    setBackfillStatus(
      `Done: ${withText} with text, ${scans} scanned (nothing to pull), ${failed} failed.`,
      failed > 0,
    );
    btn.disabled = false;
    await loadBooks();
  });

  document.getElementById("catalog-search")?.addEventListener("input", render);
  document.getElementById("catalog-filter")?.addEventListener("change", render);
  document.getElementById("catalog-clear")?.addEventListener("click", () => {
    const searchEl = document.getElementById("catalog-search") as HTMLInputElement;
    const filterEl = document.getElementById("catalog-filter") as HTMLSelectElement;
    searchEl.value = "";
    filterEl.value = "";
    searchEl.focus();
    render();
  });

  // Reading a 300-page book takes a moment, so it happens once — when
  // the file is chosen — and the result is kept for the upload itself.
  let pending: { key: string; extraction: Extraction; analysis: Analysis } | null = null;

  function fileKey(file: File): string {
    return `${file.name}:${file.size}:${file.lastModified}`;
  }

  document.getElementById("pdf")?.addEventListener("change", async (ev) => {
    const input = ev.target as HTMLInputElement;
    const file = input.files?.[0];
    pending = null;
    if (!file || !pdfjsLib) return;

    setUploadStatus("Reading the book…");
    try {
      const buffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: buffer }).promise;

      // The same extraction the upload needs, done now rather than twice.
      const extraction = await extractText({ data: await file.arrayBuffer() }, (page, total) => {
        setUploadStatus(`Reading the book — page ${page} of ${total}…`);
      });
      const analysis = await analysePdf(pdf, extraction.text, file.name);
      pending = { key: fileKey(file), extraction, analysis };

      const filled: string[] = [];
      if (fillIfEmpty("title", analysis.title)) filled.push("title");
      if (fillIfEmpty("author", analysis.author)) filled.push("author");
      if (fillIfEmpty("description", analysis.description)) filled.push("note");

      // Languages always carries "English" by default, so it's replaced
      // rather than filled — but only when the book says otherwise.
      const langEl = document.getElementById("languages") as HTMLInputElement;
      const langs = analysis.languages.join(", ");
      if (langEl && (langEl.value.trim() === "" || langEl.value.trim() === "English") && langs !== "English") {
        langEl.value = langs;
        filled.push("languages");
      }

      const catEl = document.getElementById("category") as HTMLSelectElement;
      if (catEl && analysis.category && analysis.category !== "Other") {
        catEl.value = analysis.category;
        filled.push("category");
      }

      const pagesRead = extraction.pages ? `${extraction.pages} pages of text` : "no text (a scan)";
      setUploadStatus(
        filled.length
          ? `Read the book: ${pagesRead}. Filled in ${filled.join(", ")} — please check before uploading.`
          : `Read the book: ${pagesRead}.`,
      );
    } catch (err) {
      setUploadStatus(`Couldn't read that PDF: ${err instanceof Error ? err.message : String(err)}`, true);
    }
  });

  // ====================== COPY TO CLOUDFLARE (R2) ======================
  // Moves the library's PDFs off Supabase's 1 GB allowance onto R2's
  // 10 GB, where downloads are also free. One book per request; books
  // already copied come back instantly, so stopping and restarting costs
  // nothing. Originals stay in Supabase until the R2 path is proven, and
  // the site serves whichever place has the book — so the library keeps
  // working throughout.
  function setR2Status(text: string, isError = false) {
    const el = document.getElementById("r2-status");
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
    el.className = isError ? "mb-4 text-sm text-liturgical-red" : "mb-4 text-sm text-text-secondary";
  }

  document.getElementById("r2-btn")?.addEventListener("click", async () => {
    const btn = document.getElementById("r2-btn") as HTMLButtonElement;
    if (books.length === 0) return;
    if (!window.confirm(`Copy ${books.length} book(s) to Cloudflare storage? Keep this tab open while it runs.`)) return;

    btn.disabled = true;
    let copied = 0;
    let already = 0;
    let failed = 0;
    let bytes = 0;

    for (const [i, book] of books.entries()) {
      setR2Status(`Copying “${book.title}” (${i + 1} of ${books.length})…`);
      try {
        const res = await fetch("/api/admin/library/copy-to-r2", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ key: book.pdf_storage_key }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          failed++;
          // A missing binding would fail every book identically, so stop
          // rather than grind through hundreds of the same error.
          if (res.status === 503) {
            setR2Status(data.error ?? "Cloudflare storage isn't connected yet.", true);
            break;
          }
          console.error(`R2 copy failed for ${book.title}:`, data.error);
          continue;
        }
        if (data.copied) copied++;
        else already++;
        bytes += Number(data.size ?? 0);
      } catch (err) {
        failed++;
        console.error(`R2 copy failed for ${book.title}:`, err);
      }
    }

    if (copied || already) {
      setR2Status(
        `Done: ${copied} copied, ${already} already there, ${failed} failed. ` +
          `${(bytes / 1024 / 1024).toFixed(0)} MB now in Cloudflare storage.`,
        failed > 0,
      );
    }
    btn.disabled = false;
  });

  // ============ ADD BOOKS FOUND IN STORAGE ============
  // Books pushed straight into Cloudflare storage — the MEGA archive
  // arriving in bulk — have files but no catalogue entry, so the site
  // can't see them. This asks the server to look for such files and
  // write the rows, using its own database key. Everything lands Hidden.
  function setRegisterStatus(text: string, isError = false) {
    const el = document.getElementById("register-status");
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
    el.className = isError ? "mb-4 text-sm text-liturgical-red" : "mb-4 text-sm text-text-secondary";
  }

  document.getElementById("register-btn")?.addEventListener("click", async () => {
    const btn = document.getElementById("register-btn") as HTMLButtonElement;
    btn.disabled = true;
    setRegisterStatus("Looking through storage…");

    let total = 0;
    let skipped = 0;
    try {
      // The server works in batches so no single request runs long; keep
      // asking until it reports nothing left.
      for (let round = 0; round < 40; round++) {
        const res = await fetch("/api/admin/library/register-storage", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ limit: 50 }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          setRegisterStatus(data.error ?? `Failed (${res.status}).`, true);
          break;
        }
        total += Number(data.added ?? 0);
        skipped += Number(data.skipped ?? 0);
        setRegisterStatus(`Added ${total} book(s)… ${data.remaining ?? 0} still to look at.`);
        if (!data.added && !data.remaining) break;
      }

      if (total > 0) {
        setRegisterStatus(
          `Added ${total} book(s) as Hidden${skipped ? `, ${skipped} skipped` : ""}. ` +
            "Use “Prepare text” next to give them text and page numbers.",
        );
        await loadBooks();
      } else if (!skipped) {
        setRegisterStatus("Nothing new in storage — every file already has a catalogue entry.");
      }
    } catch (err) {
      setRegisterStatus(`Failed: ${err instanceof Error ? err.message : String(err)}`, true);
    } finally {
      btn.disabled = false;
    }
  });

  // ====================== EXPORTS ======================
  // For working on the books away from the site: a catalogue to read or
  // hand to something that helps with citations, and a book's text with
  // its page numbers left in, so a quotation can be cited to a page and
  // checked against the scan.

  function downloadFile(filename: string, content: string, type: string) {
    const url = URL.createObjectURL(new Blob([content], { type }));
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  }

  /** One CSV field: quotes doubled, the whole thing quoted. */
  function csvField(value: unknown): string {
    return `"${String(value ?? "").replace(/"/g, '""')}"`;
  }

  /**
   * How a book can be read. It matters to anyone working from this list:
   * a book with text can be quoted and cited to a printed page, a scan
   * can only be read.
   */
  function textNote(b: Book): string {
    if (b.text_status === "ok") {
      return b.text_pages ? `text, ${b.text_pages} pages` : "text, no page numbers";
    }
    return b.text_status === "empty" ? "scan only" : "no text";
  }

  function visibilityNote(b: Book): string {
    return b.hidden ? "Staging" : b.public_access ? "Public" : "Parishioners";
  }

  /** The catalogue as a spreadsheet. */
  function exportCsv(shown: Book[]) {
    const header = ["Title", "Author", "Category", "Languages", "Visibility", "Text", "Read at"];
    const rows = shown.map((b) => [
      b.title,
      b.author ?? "",
      b.category,
      (b.languages ?? []).join("; "),
      visibilityNote(b),
      textNote(b),
      `${location.origin}/learn/library/reader/?slug=${encodeURIComponent(b.slug)}`,
    ]);
    const csv = [header, ...rows].map((r) => r.map(csvField).join(",")).join("\r\n");
    // A byte-order mark, so Excel opens accented titles properly instead
    // of turning them into nonsense.
    downloadFile("parish-library.csv", "﻿" + csv, "text/csv;charset=utf-8");
  }

  /**
   * The catalogue as something to read, or to hand to a chat that can't
   * come through the sign-in and see the library for itself. Grouped by
   * category, one line a book, no links — a link it can't open is just
   * noise; the title is what lets it name the book and be looked up.
   */
  function exportList(shown: Book[]) {
    const withText = shown.filter((b) => b.text_status === "ok").length;
    const withPages = shown.filter((b) => b.text_status === "ok" && b.text_pages).length;
    const byCategory = new Map<string, Book[]>();
    for (const b of shown) {
      const key = b.category || "Other";
      if (!byCategory.has(key)) byCategory.set(key, []);
      byCategory.get(key)!.push(b);
    }

    const lines = [
      "# St John the Forerunner — parish library",
      "",
      `${shown.length} books. ${withText} have a searchable text version, ${withPages} of those`,
      "with page numbers, so a passage can be quoted and cited to the printed page.",
      "The rest are scans: readable on the site page by page, but not quotable",
      "without transcribing.",
      "",
      "The library is behind a member sign-in, so these can't be opened from a",
      "link alone. This list says what the parish holds, so a book can be named",
      "and then looked up on the site.",
      "",
    ];

    for (const category of [...byCategory.keys()].sort()) {
      const group = byCategory.get(category)!;
      lines.push(`## ${category} (${group.length})`, "");
      for (const b of group) {
        lines.push(`- **${b.title}**${b.author ? ` — ${b.author}` : ""} · ${textNote(b)}`);
      }
      lines.push("");
    }

    downloadFile("parish-library.md", lines.join("\n"), "text/markdown;charset=utf-8");
  }

  /**
   * The full text of several books at once, in one file.
   *
   * The books are read for school and quoted in class, and a reader
   * working outside the site — or a chat that can't come through the
   * sign-in — needs the words, not a link. Whatever the table is
   * showing is what goes in, so a search narrows it to a topic first.
   *
   * Scans are left out: there's nothing to put in for them.
   */
  async function exportFullText(shown: Book[]) {
    const status = document.getElementById("export-status");
    const withText = shown.filter((b) => b.text_status === "ok");
    if (withText.length === 0) {
      showError("None of the books showing have a text version — they're scans.");
      return;
    }

    // Every book's length is already known, so the size can be named
    // before anything is fetched rather than discovered afterwards.
    const chars = withText.reduce((sum, b) => sum + (b.text_chars ?? 0), 0);
    const mb = chars / 1_000_000;
    const skipped = shown.length - withText.length;
    if (
      !window.confirm(
        `Put the full text of ${withText.length} book${withText.length === 1 ? "" : "s"} ` +
          `into one file, about ${mb < 1 ? "under 1" : Math.round(mb)} MB?` +
          (skipped > 0 ? `\n\n${skipped} showing are scans and will be left out.` : "") +
          `\n\nSearch first to narrow it down if that's more than you want.`,
      )
    ) {
      return;
    }

    const parts = [
      `Parish library of St John the Forerunner — ${withText.length} books`,
      "Page numbers below are each book's own printed pages, where the PDF records them,",
      "so a quotation can be cited to the page it appears on.",
      "",
    ];
    let failed = 0;

    if (status) status.hidden = false;
    try {
      for (let i = 0; i < withText.length; i++) {
        const b = withText[i];
        if (status) status.textContent = `Fetching ${i + 1} of ${withText.length}: ${b.title}`;
        try {
          const res = await fetch(`/api/library/text?slug=${encodeURIComponent(b.slug)}`, {
            credentials: "same-origin",
            cache: "no-store",
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            failed++;
            continue;
          }
          parts.push(
            "",
            "================================================================",
            `${b.title}${b.author ? ` — ${b.author}` : ""}`,
            `${location.origin}/learn/library/reader/?slug=${encodeURIComponent(b.slug)}`,
            "================================================================",
            "",
            readablePages(data.text).trim(),
            "",
          );
        } catch {
          failed++;
        }
      }

      downloadFile("parish-library-text.txt", parts.join("\n") + "\n", "text/plain;charset=utf-8");
      if (status) {
        status.textContent =
          `Downloaded ${withText.length - failed} book${withText.length - failed === 1 ? "" : "s"}` +
          (failed > 0 ? `; ${failed} couldn't be read.` : ".");
      }
    } finally {
      if (status && !status.textContent) status.hidden = true;
    }
  }

  document.getElementById("catalog-export")?.addEventListener("change", (ev) => {
    const select = ev.target as HTMLSelectElement;
    const choice = select.value;
    // Snap back, so the same export can be taken twice.
    select.value = "";
    if (!choice) return;

    const shown = visibleBooks();
    if (shown.length === 0) {
      showError("Nothing to export — no books are showing.");
      return;
    }
    if (choice === "csv") exportCsv(shown);
    else if (choice === "md") exportList(shown);
    else void exportFullText(shown);
  });

  /**
   * The page markers become something a reader can see — "[page 12]" on
   * its own line — so a quotation can be cited to a page.
   */
  function readablePages(text: string): string {
    return String(text ?? "").replace(
      /␞([^␞|]*)\|?[^␞]*␞\n?/g,
      (_match: string, pageLabel: string) => `\n[page ${pageLabel}]\n`,
    );
  }

  /** Download one book's text, page markers turned into readable lines. */
  async function downloadBookText(slug: string, title: string) {
    try {
      const res = await fetch(`/api/library/text?slug=${encodeURIComponent(slug)}`, {
        credentials: "same-origin",
        cache: "no-store",
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(`Couldn't get the text: ${data.error ?? res.status}`);
        return;
      }
      const readable = readablePages(data.text);
      const lines = [
        String(data.title ?? title),
        data.author ? String(data.author) : "",
        `Parish library — ${location.origin}/learn/library/reader/?slug=${encodeURIComponent(slug)}`,
        "Page numbers below are the book's own printed pages where the PDF records them.",
        "",
        "",
      ].filter((line, i) => line !== "" || i > 1);
      downloadFile(
        `${slug}.txt`,
        lines.join("\n") + readable.trim() + "\n",
        "text/plain;charset=utf-8",
      );
    } catch (err) {
      showError(`Couldn't get the text: ${err instanceof Error ? err.message : String(err)}`);
    }
  }

  // ====================== ROW ACTIONS (delegated) ======================
  // Edit, download, delete all hang off one dropdown per row.
  document.getElementById("books-tbody")?.addEventListener("change", async (ev) => {
    const select = (ev.target as HTMLElement | null)?.closest(".row-action") as HTMLSelectElement | null;
    if (!select) return;

    const action = select.value;
    const id = select.dataset.id ?? "";
    const slug = select.dataset.slug ?? "";
    const title = select.dataset.title || "this book";
    // Snap back to "Actions…" so the same choice can be made twice.
    select.value = "";
    if (!action) return;

    if (action === "edit") {
      const book = books.find((b) => b.id === id);
      if (book) openEditModal(book);
      return;
    }

    if (action === "text") {
      select.disabled = true;
      await downloadBookText(slug, title);
      select.disabled = false;
      return;
    }

    if (action === "delete") {
      if (!window.confirm(`Delete "${title}" from the library? The PDF will also be removed from storage.`)) return;
      select.disabled = true;
      const res = await fetch(`/api/admin/library/${encodeURIComponent(id)}`, {
        method: "DELETE",
        credentials: "same-origin",
        cache: "no-store",
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        showError(`Couldn't delete: ${body.error ?? res.status}`);
        select.disabled = false;
        return;
      }
      books = books.filter((b) => b.id !== id);
      render();
    }
  });

  // ====================== VISIBILITY DROPDOWN (delegated change) ======================
  document.getElementById("books-tbody")?.addEventListener("change", async (ev) => {
    const sel = (ev.target as HTMLElement | null)?.closest(".visibility-select") as HTMLSelectElement | null;
    if (!sel) return;
    const id = sel.dataset.id;
    if (!id) return;

    const v = sel.value;
    const hidden = v === "hidden";
    const public_access = v === "public";

    sel.disabled = true;
    try {
      const res = await fetch(`/api/admin/library/${encodeURIComponent(id)}`, {
        method: "PATCH",
        credentials: "same-origin",
        cache: "no-store",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ hidden, public_access }),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        showError(`Couldn't update visibility: ${body.error ?? res.status}`);
        // Re-render to snap the dropdown back to the stored value.
        render();
        return;
      }
      const idx = books.findIndex((b) => b.id === id);
      if (idx !== -1) {
        books[idx].hidden = hidden;
        books[idx].public_access = public_access;
      }
    } finally {
      sel.disabled = false;
    }
  });

  // ============= MODAL-BASED EDITOR =============
  // Replaces the old chain of window.prompt() calls, which Chrome
  // silently kills after the second prompt via its "block additional
  // dialogs from this page" guard. The modal shows all fields at once
  // and submits a single PATCH.
  const editModal = document.getElementById("edit-modal") as HTMLDivElement;
  const editForm = document.getElementById("edit-form") as HTMLFormElement;
  const editIdEl = document.getElementById("edit-id") as HTMLInputElement;
  const editTitleEl = document.getElementById("edit-title") as HTMLInputElement;
  const editAuthorEl = document.getElementById("edit-author") as HTMLInputElement;
  const editCategoryEl = document.getElementById("edit-category") as HTMLSelectElement;
  const editLanguagesEl = document.getElementById("edit-languages") as HTMLInputElement;
  const editDescriptionEl = document.getElementById("edit-description") as HTMLTextAreaElement;
  const editSlugEl = document.getElementById("edit-slug") as HTMLInputElement;
  const editVisibilityEl = document.getElementById("edit-visibility") as HTMLSelectElement;
  const editStatusEl = document.getElementById("edit-status") as HTMLSpanElement;
  const editSaveBtn = document.getElementById("edit-save") as HTMLButtonElement;
  const editCloseBtn = document.getElementById("edit-close") as HTMLButtonElement;
  const editCancelBtn = document.getElementById("edit-cancel") as HTMLButtonElement;

  function openEditModal(book: Book) {
    editIdEl.value = book.id;
    editTitleEl.value = book.title;
    editAuthorEl.value = book.author ?? "";
    editCategoryEl.value = book.category;
    // If the row's category isn't in the dropdown (legacy data),
    // fall back to "Other" rather than leaving an empty selection.
    if (!editCategoryEl.value) editCategoryEl.value = "Other";
    editLanguagesEl.value = (book.languages ?? []).join(", ");
    editDescriptionEl.value = book.description ?? "";
    editSlugEl.value = book.slug;
    editVisibilityEl.value = book.hidden ? "hidden" : book.public_access ? "public" : "parish";
    editStatusEl.textContent = "";
    editSaveBtn.disabled = false;
    editModal.removeAttribute("hidden");
    // Focus the title so keyboard users can immediately type.
    setTimeout(() => editTitleEl.focus(), 0);
  }

  function closeEditModal() {
    editModal.setAttribute("hidden", "");
    editForm.reset();
  }

  editCloseBtn.addEventListener("click", closeEditModal);
  editCancelBtn.addEventListener("click", closeEditModal);
  // Click on the backdrop (the modal container itself, not its inner
  // panel) closes the modal — matches the convention people expect.
  editModal.addEventListener("click", (ev) => {
    if (ev.target === editModal) closeEditModal();
  });
  document.addEventListener("keydown", (ev) => {
    if (ev.key === "Escape" && !editModal.hasAttribute("hidden")) closeEditModal();
  });

  editForm.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const id = editIdEl.value;
    if (!id) return;

    editSaveBtn.disabled = true;
    editStatusEl.textContent = "Saving…";

    const payload = {
      title: editTitleEl.value.trim(),
      author: editAuthorEl.value.trim(),
      category: editCategoryEl.value.trim(),
      languages: editLanguagesEl.value.split(",").map((s) => s.trim()).filter(Boolean),
      description: editDescriptionEl.value.trim(),
      slug: editSlugEl.value.trim(),
      hidden: editVisibilityEl.value === "hidden",
      public_access: editVisibilityEl.value === "public",
    };

    try {
      const res = await fetch(`/api/admin/library/${encodeURIComponent(id)}`, {
        method: "PATCH",
        credentials: "same-origin",
        cache: "no-store",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        editStatusEl.textContent = `Failed: ${body.error ?? res.status}`;
        editSaveBtn.disabled = false;
        return;
      }
      const idx = books.findIndex((b) => b.id === id);
      if (idx !== -1 && body.book) books[idx] = body.book;
      render();
      closeEditModal();
    } catch (err) {
      editStatusEl.textContent = `Error: ${err instanceof Error ? err.message : String(err)}`;
      editSaveBtn.disabled = false;
    }
  });

  async function init() {
    await loadBooks();
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("app")?.classList.remove("hidden");
  }
  init();
</script>
