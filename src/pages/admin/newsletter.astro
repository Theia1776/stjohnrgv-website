---
import Layout from "../../layouts/Layout.astro";
import FileDrop from "../../components/FileDrop.astro";

// Writing the parish newsletter.
//
// Three separate presses on purpose — save, publish, send — because
// they undo differently. A saved draft is private. A published issue
// can be un-published. An email that has gone out cannot be recalled
// from anybody's inbox, so sending is its own deliberate act with its
// own confirmation, and never a side effect of saving.
---

<Layout
  title="Newsletter | St. John of Kronstadt"
  description="Write and send the parish newsletter."
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <main class="mx-auto max-w-4xl px-4 py-8 md:px-6">
    <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Admin</p>
    <h1 class="mb-2 font-display text-3xl text-text-primary md:text-4xl">Parish Newsletter</h1>
    <p class="mb-6 text-text-secondary">
      Write it once. It gets a page on the site and goes out by email to
      everyone with a parish account.
    </p>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>
    <div id="error-msg" hidden role="alert" class="mb-4 text-liturgical-red"></div>

    <div id="app" hidden>
      <div id="email-warning" hidden class="mb-6 border-l-2 border-liturgical-red bg-cream-card p-4 text-sm">
        <strong class="text-text-primary">Email isn't set up on the server.</strong>
        Issues can be written and published, but nothing can be sent until
        <code>RESEND_API_KEY</code> is set in Cloudflare.
      </div>

      <div id="pending-warning" hidden class="mb-6 border-l-2 border-liturgical-red bg-cream-card p-4 text-sm leading-relaxed">
        <strong class="text-text-primary">The newsletter table isn't in the database yet.</strong>
        Run <code>021_newsletters.sql</code> in the Supabase SQL editor and
        reload this page.
      </div>

      <!-- Writing. One issue at a time; the editor fills with whichever
           issue is being worked on and is otherwise a blank new one. -->
      <section class="mb-8 border border-border-soft bg-cream-card p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="editor-heading" class="font-display text-xl text-text-primary">A new issue</h2>
          <button type="button" id="new-issue" hidden class="btn btn-secondary text-sm">
            Start a new one instead
          </button>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <label class="block text-xs uppercase tracking-widest text-text-secondary">
            Edition
            <input id="f-label" type="text" maxlength="100" placeholder="November 2026"
              class="mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary" />
            <span class="mt-1 block normal-case tracking-normal text-[0.7rem] text-text-secondary">
              Fills in the month and year on its own. Change it if you want something else.
            </span>
          </label>
          <label class="sm:col-span-2 block text-xs uppercase tracking-widest text-text-secondary">
            Title <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            <input id="f-title" type="text" maxlength="200" placeholder="The Nativity Fast Begins"
              class="mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary" />
          </label>
        </div>

        <!-- The photograph under the masthead. One picture at the top
             does more for whether somebody reads an issue than
             anything else on this form. -->
        <fieldset class="mt-4 border border-border-soft p-3">
          <legend class="px-1 text-xs uppercase tracking-widest text-text-secondary">
            Picture under the masthead
          </legend>
          <div class="flex flex-wrap items-center gap-2">
            <input id="hero-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="text-xs" />
            <button type="button" id="hero-upload" class="btn btn-secondary text-xs">Upload</button>
            <span id="hero-status" class="text-xs text-text-secondary" role="status"></span>
          </div>
          <img id="hero-preview" class="mt-2 max-h-40 border border-border-soft" alt="" hidden />
          <input id="f-hero" type="hidden" />
          <input
            id="f-hero-alt"
            type="text"
            maxlength="300"
            placeholder="What the picture shows — for anyone who can't see it"
            class="mt-2 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm"
          />
        </fieldset>

        <label class="mt-4 block text-xs uppercase tracking-widest text-text-secondary">
          Opening
          <textarea id="f-intro" rows="3" placeholder="A line or two to begin with."
            class="mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"></textarea>
        </label>

        <div class="mt-5">
          <p class="text-xs uppercase tracking-widest text-text-secondary">Sections</p>
          <p class="mt-1 text-xs leading-relaxed text-text-secondary">
            The six standing sections are always here. Untick one and it stays
            saved but doesn't go out, so a quiet month costs you nothing you
            wrote. Add your own below them for anything else.
          </p>
          <div id="sections" class="mt-3 space-y-4"></div>
          <button type="button" id="add-section" class="btn btn-secondary mt-3 text-sm">
            Add another section
          </button>
        </div>

        <label class="mt-5 block text-xs uppercase tracking-widest text-text-secondary">
          Closing
          <textarea id="f-closing" rows="2" placeholder="Service times, a closing line."
            class="mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"></textarea>
        </label>

        <fieldset class="mt-5 border border-border-soft p-4">
          <legend class="px-1 text-xs uppercase tracking-widest text-text-secondary">Who may read it</legend>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="audience" value="parish" checked class="mt-1 h-4 w-4" />
            <span>
              <span class="text-sm font-semibold text-text-primary">Our parish</span>
              <span class="mt-0.5 block text-xs text-text-secondary">
                Signed-in accounts only. Right for anything naming our people —
                who is ill, who is traveling, whose child was baptized.
              </span>
            </span>
          </label>
          <label class="mt-3 flex items-start gap-3 cursor-pointer">
            <input type="radio" name="audience" value="public" class="mt-1 h-4 w-4" />
            <span>
              <span class="text-sm font-semibold text-text-primary">Anyone</span>
              <span class="mt-0.5 block text-xs text-text-secondary">
                Readable by the whole internet, and findable by search. Only for
                an issue you have read back with that in mind.
              </span>
            </span>
          </label>
        </fieldset>

        <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-border-soft pt-4">
          <button type="button" id="save-issue" class="btn btn-primary text-sm">Save draft</button>
          <a id="preview-link" hidden href="#" target="_blank" rel="noopener" class="btn btn-secondary text-sm">
            Preview the page
          </a>
          <span id="editor-status" class="text-sm text-text-secondary" role="status"></span>
        </div>
      </section>

      <h2 class="mb-3 font-display text-xl text-text-primary">Issues</h2>
      <p id="issues-empty" hidden class="text-sm italic text-text-secondary">
        Nothing written yet.
      </p>
      <div id="issue-rows" class="space-y-4"></div>
    </div>
  </main>
  <FileDrop />
</Layout>

<script>
  type Section = {
    /** Which standing section this is, or "" for one of her own. */
    key?: string;
    heading: string;
    body: string;
    /** Unticked: kept in the draft, left out of the issue. */
    include?: boolean;
    image?: string;
    image_alt?: string;
    image_caption?: string;
    quote?: string;
    quote_by?: string;
  };
  type Issue = {
    id: string;
    slug: string;
    title: string;
    issue_label: string | null;
    intro: string | null;
    sections: Section[] | null;
    closing: string | null;
    hero_image: string | null;
    hero_image_alt: string | null;
    audience: string;
    published: boolean;
    published_at: string | null;
    sent_at: string | null;
    sent_count: number;
    sent_attempted: number;
    send_error: string | null;
    written_by_name: string | null;
    created_at: string;
  };

  let issues: Issue[] = [];
  /** The issue being edited, or null for a new one. */
  let editingId: string | null = null;

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const input = (id: string) => document.getElementById(id) as HTMLInputElement;
  const area = (id: string) => document.getElementById(id) as HTMLTextAreaElement;

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function when(value: string | null): string {
    if (!value) return "";
    const d = new Date(value);
    return Number.isNaN(d.getTime())
      ? ""
      : d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
  }

  function say(message: string, bad = false) {
    const el = $("editor-status");
    el.textContent = message;
    el.className = bad ? "text-sm text-liturgical-red" : "text-sm text-text-secondary";
  }

  // ============== THE SECTION ROWS ==============

  /**
   * The standing sections. The issue has the same shape every month,
   * so these are always on the form and always saved — the tick box
   * decides whether one goes out, not whether it exists.
   *
   * `aliases` are old headings that mean the same section, so a draft
   * written before this existed finds its slot instead of appearing
   * twice. They are matched with punctuation and case ignored.
   */
  const FIXED: { key: string; heading: string; hint: string; aliases: string[] }[] = [
    {
      key: "narthex",
      heading: "Notes From the Narthex",
      hint: "Fr.'s note",
      aliases: [
        "a letter from fr antonios",
        "a letter from father antonios",
        "from the desk of fr antonios",
        "from the desk of father antonios",
        "from the desk",
      ],
    },
    { key: "table", heading: "An Orthodox Table", hint: "Matushka's section", aliases: ["orthodox table"] },
    {
      key: "online",
      heading: "Come and See, Online",
      hint: "news from the website",
      aliases: ["website news", "from the website", "news from the website"],
    },
    { key: "prayer", heading: "Prayer Requests", hint: "", aliases: ["prayer list", "prayers"] },
    {
      key: "services",
      heading: "Service Schedule",
      hint: "",
      aliases: ["service changes", "services", "service times"],
    },
    { key: "events", heading: "Upcoming Events", hint: "", aliases: ["upcoming", "events"] },
  ];

  const slotOf = (key: string | undefined) => FIXED.find((f) => f.key === key) ?? null;

  /** Headings compared the way a person would: case and punctuation off. */
  const normalize = (s: string) =>
    String(s ?? "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();

  /** Which standing section an old heading was, if any. */
  function matchSlot(heading: string): string {
    const h = normalize(heading);
    if (!h) return "";
    for (const f of FIXED) {
      if (h === normalize(f.heading)) return f.key;
      if (f.aliases.some((a) => h === normalize(a))) return f.key;
    }
    return "";
  }

  /**
   * The rows to show for an issue: whatever was saved, in the order it
   * was saved, with any standing section it is missing added on the
   * end. A draft written before the standing sections existed comes
   * back with its headings recognised rather than duplicated.
   */
  function buildSections(stored: Section[]): Section[] {
    const used = new Set<string>();
    const out: Section[] = [];

    for (const s of stored) {
      const key = slotOf(s.key) ? s.key! : matchSlot(s.heading);
      if (key && !used.has(key)) {
        used.add(key);
        out.push({ ...s, key, heading: slotOf(key)!.heading });
      } else {
        out.push({ ...s, key: "" });
      }
    }
    for (const f of FIXED) {
      if (!used.has(f.key)) out.push({ key: f.key, heading: f.heading, body: "", include: true });
    }
    return out;
  }

  function sectionRow(section: Section = { heading: "", body: "" }): HTMLDivElement {
    const slot = slotOf(section.key);
    const row = document.createElement("div");
    row.className = "section-row border border-border-soft bg-cream-bg p-3";
    if (slot) row.dataset.key = slot.key;

    // A standing section's heading is fixed, so it is shown rather than
    // typed. One she added herself keeps an editable box. Either way
    // the value lives on `.s-heading`, so everything downstream reads
    // it the same way.
    const headingField = slot
      ? `<span class="min-w-0 flex-1 py-1.5">
           <span class="block font-display text-sm text-text-primary">${escapeHtml(slot.heading)}</span>
           ${slot.hint ? `<span class="block text-xs text-text-secondary">${escapeHtml(slot.hint)}</span>` : ""}
         </span>
         <input type="hidden" class="s-heading" />`
      : `<input type="text" maxlength="200" placeholder="Heading"
                class="s-heading min-w-0 flex-1 border border-border-soft bg-cream-card px-2 py-1.5 text-sm" />`;

    row.innerHTML = `
      <div class="flex items-start gap-2">
        <span class="s-number mt-1.5 w-5 shrink-0 text-right text-xs text-text-secondary"></span>
        ${headingField}
        <button type="button" class="s-up btn btn-secondary px-2 text-xs" aria-label="Move this section up" title="Move up">&uarr;</button>
        <button type="button" class="s-down btn btn-secondary px-2 text-xs" aria-label="Move this section down" title="Move down">&darr;</button>
        ${
          slot
            ? ""
            : `<button type="button" class="s-remove btn btn-secondary text-xs" aria-label="Remove this section">Remove</button>`
        }
      </div>

      <label class="s-include-label mt-2 ml-7 flex cursor-pointer items-center gap-2 text-xs text-text-secondary">
        <input type="checkbox" class="s-include h-4 w-4" checked />
        <span class="s-include-text">In this issue</span>
      </label>

      <textarea rows="4" placeholder="What this section says."
                class="s-body mt-2 block w-full border border-border-soft bg-cream-card px-2 py-1.5 text-sm"></textarea>

      <details class="mt-2">
        <summary class="cursor-pointer text-xs font-semibold uppercase tracking-widest text-brand-blue-dark">
          Picture and pull-quote
        </summary>

        <div class="mt-3 border-l-2 border-border-soft pl-3">
          <div class="flex flex-wrap items-center gap-2">
            <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="s-file text-xs" />
            <button type="button" class="s-upload btn btn-secondary text-xs">Upload</button>
            <span class="s-upload-status text-xs text-text-secondary" role="status"></span>
          </div>
          <img class="s-preview mt-2 max-h-32 border border-border-soft" alt="" hidden />
          <input type="hidden" class="s-image" />
          <input type="text" maxlength="300" placeholder="What the picture shows — for anyone who can't see it"
                 class="s-image-alt mt-2 block w-full border border-border-soft bg-cream-card px-2 py-1.5 text-sm" />
          <input type="text" maxlength="200" placeholder="Caption printed under it (optional)"
                 class="s-image-caption mt-2 block w-full border border-border-soft bg-cream-card px-2 py-1.5 text-sm" />

          <input type="text" maxlength="300" placeholder="A line to pull out and set large (optional)"
                 class="s-quote mt-3 block w-full border border-border-soft bg-cream-card px-2 py-1.5 text-sm" />
          <input type="text" maxlength="120" placeholder="Who said it"
                 class="s-quote-by mt-2 block w-full border border-border-soft bg-cream-card px-2 py-1.5 text-sm" />
        </div>
      </details>`;

    (row.querySelector(".s-heading") as HTMLInputElement).value = slot
      ? slot.heading
      : section.heading ?? "";
    (row.querySelector(".s-include") as HTMLInputElement).checked = section.include !== false;
    (row.querySelector(".s-body") as HTMLTextAreaElement).value = section.body ?? "";
    (row.querySelector(".s-image") as HTMLInputElement).value = section.image ?? "";
    (row.querySelector(".s-image-alt") as HTMLInputElement).value = section.image_alt ?? "";
    (row.querySelector(".s-image-caption") as HTMLInputElement).value = section.image_caption ?? "";
    (row.querySelector(".s-quote") as HTMLInputElement).value = section.quote ?? "";
    (row.querySelector(".s-quote-by") as HTMLInputElement).value = section.quote_by ?? "";

    // Show what is already attached, so an issue being edited doesn't
    // look as though its pictures were lost.
    if (section.image) {
      const preview = row.querySelector(".s-preview") as HTMLImageElement;
      preview.src = imageSrc(section.image);
      preview.hidden = false;
      (row.querySelector(".s-upload-status") as HTMLElement).textContent = "Attached.";
    }

    row.querySelector(".s-remove")?.addEventListener("click", () => {
      row.remove();
      renumberSections();
    });
    row.querySelector(".s-up")?.addEventListener("click", () => moveSection(row, -1));
    row.querySelector(".s-down")?.addEventListener("click", () => moveSection(row, 1));
    row.querySelector(".s-upload")?.addEventListener("click", () => uploadImage(row));
    row.querySelector(".s-include")?.addEventListener("change", () => markIncluded(row));
    markIncluded(row);
    return row;
  }

  /**
   * Show at a glance whether a section is going out.
   *
   * A tick box on its own is easy to miss on a long form — the row
   * itself fades, so scrolling the page shows which sections are in
   * this issue without reading every box.
   */
  function markIncluded(row: HTMLElement) {
    const on = (row.querySelector(".s-include") as HTMLInputElement | null)?.checked !== false;
    row.classList.toggle("opacity-60", !on);
    const text = row.querySelector(".s-include-text");
    if (text) text.textContent = on ? "In this issue" : "Left out of this issue — still saved";
  }

  /**
   * Move a section one place up or down.
   *
   * The order of the rows in the page IS the order of the issue —
   * readSections() walks them top to bottom — so moving the element is
   * the whole of it. Nothing is saved until Save draft is pressed, the
   * same as every other edit on this form.
   */
  function moveSection(row: HTMLElement, direction: -1 | 1) {
    const sibling =
      direction === -1 ? row.previousElementSibling : row.nextElementSibling;
    if (!sibling) return;
    if (direction === -1) sibling.before(row);
    else sibling.after(row);
    renumberSections();
    // Keep it under the cursor: a row that jumps off screen is a row
    // you have to go looking for again.
    row.scrollIntoView({ block: "nearest", behavior: "smooth" });
    // A standing section's heading is a hidden input, so focus goes to
    // the text instead — otherwise the keyboard is left nowhere.
    const target = (row.querySelector('.s-heading:not([type="hidden"])') ??
      row.querySelector(".s-body")) as HTMLElement | null;
    target?.focus({ preventScroll: true });
  }

  /**
   * Number the rows, and grey out the arrows that would do nothing.
   * Without the numbers a long issue is hard to keep straight while
   * shuffling it.
   */
  function renumberSections() {
    const rows = Array.from(document.querySelectorAll<HTMLElement>(".section-row"));
    rows.forEach((r, i) => {
      const n = r.querySelector(".s-number");
      if (n) n.textContent = String(i + 1);
      const up = r.querySelector(".s-up") as HTMLButtonElement | null;
      const down = r.querySelector(".s-down") as HTMLButtonElement | null;
      if (up) {
        up.disabled = i === 0;
        up.classList.toggle("opacity-30", i === 0);
      }
      if (down) {
        down.disabled = i === rows.length - 1;
        down.classList.toggle("opacity-30", i === rows.length - 1);
      }
    });
  }

  /** An R2 key becomes a path; an absolute URL is left alone. */
  function imageSrc(key: string): string {
    const k = String(key ?? "").trim();
    if (!k) return "";
    if (/^https?:\/\//i.test(k)) return k;
    return `/api/newsletter/image?key=${encodeURIComponent(k)}`;
  }

  /**
   * Upload the chosen file and attach its key to this section.
   *
   * Reports what happened rather than going quiet: a file picker that
   * appears to do nothing is how somebody ends up sending an issue with
   * no pictures in it.
   */
  async function uploadImage(row: HTMLElement) {
    const fileEl = row.querySelector(".s-file") as HTMLInputElement;
    const status = row.querySelector(".s-upload-status") as HTMLElement;
    const btn = row.querySelector(".s-upload") as HTMLButtonElement;
    const file = fileEl.files?.[0];

    if (!file) {
      status.textContent = "Choose a file first.";
      status.className = "s-upload-status text-xs text-liturgical-red";
      return;
    }

    btn.disabled = true;
    status.className = "s-upload-status text-xs text-text-secondary";
    status.textContent = `Uploading ${file.name}…`;
    try {
      const form = new FormData();
      form.append("file", file);
      form.append("slug", input("f-title").value.trim() || "issue");
      const res = await fetch("/api/admin/newsletter/image", {
        method: "POST",
        credentials: "same-origin",
        body: form,
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        status.textContent = body.error ?? `Upload failed (${res.status}).`;
        status.className = "s-upload-status text-xs text-liturgical-red";
        return;
      }
      (row.querySelector(".s-image") as HTMLInputElement).value = body.key;
      const preview = row.querySelector(".s-preview") as HTMLImageElement;
      preview.src = body.url;
      preview.hidden = false;
      status.textContent =
        `${file.name} attached (${Math.round(body.bytes / 1024)} KB). ` +
        "Now describe it below, then save the draft.";
    } catch (err) {
      status.textContent = `Upload failed: ${err instanceof Error ? err.message : String(err)}`;
      status.className = "s-upload-status text-xs text-liturgical-red";
    } finally {
      btn.disabled = false;
    }
  }

  /**
   * What to save, what will print, and what is being left behind.
   *
   * A standing section is always saved, empty or unticked, because it
   * is part of the issue's shape and rebuilding it every month is the
   * work this form is meant to take off her. One she added herself is
   * dropped if it has nothing under it — but dropped *out loud*, in
   * the save confirmation, because silently throwing away something
   * somebody typed is how a person comes to distrust a form.
   */
  function readSections(): { kept: Section[]; dropped: string[]; holding: string[] } {
    const val = (row: HTMLElement, cls: string) =>
      (row.querySelector(cls) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? "";
    const all = Array.from(document.querySelectorAll<HTMLDivElement>(".section-row")).map((row) => ({
      key: row.dataset.key ?? "",
      heading: val(row, ".s-heading"),
      body: val(row, ".s-body"),
      include: (row.querySelector(".s-include") as HTMLInputElement | null)?.checked !== false,
      image: val(row, ".s-image"),
      image_alt: val(row, ".s-image-alt"),
      image_caption: val(row, ".s-image-caption"),
      quote: val(row, ".s-quote"),
      quote_by: val(row, ".s-quote-by"),
    }));

    const kept = all.filter((s) => s.key || s.body || s.image);
    return {
      kept,
      dropped: all.filter((s) => !s.key && s.heading && !s.body && !s.image).map((s) => s.heading),
      // Written, but not going out this month. An empty standing
      // section isn't worth naming — there was nothing in it.
      holding: kept
        .filter((s) => !s.include && (s.body || s.image))
        .map((s) => s.heading || "an untitled section"),
    };
  }

  document.getElementById("add-section")?.addEventListener("click", () => {
    const row = sectionRow();
    $("sections").appendChild(row);
    renumberSections();
    (row.querySelector(".s-heading") as HTMLInputElement)?.focus();
    row.scrollIntoView({ block: "nearest", behavior: "smooth" });
  });

  // ============== LOADING ONE INTO THE EDITOR ==============

  /** "November 2026" — the edition an issue belongs to. */
  function monthLabel(value?: string | null): string {
    const d = value ? new Date(value) : new Date();
    const when = Number.isNaN(d.getTime()) ? new Date() : d;
    return when.toLocaleDateString("en-US", { month: "long", year: "numeric" });
  }

  function loadIntoEditor(issue: Issue | null) {
    editingId = issue?.id ?? null;
    // Every edition is its month and year, so it fills itself in: this
    // month for a new issue, its own month for one already written.
    // Still a plain text box — type over it for anything else.
    input("f-label").value =
      issue?.issue_label || monthLabel(issue?.published_at ?? issue?.created_at ?? null);
    input("f-title").value = issue?.title ?? "";
    area("f-intro").value = issue?.intro ?? "";
    area("f-closing").value = issue?.closing ?? "";
    input("f-hero").value = issue?.hero_image ?? "";
    input("f-hero-alt").value = issue?.hero_image_alt ?? "";
    {
      const preview = $("hero-preview") as HTMLImageElement;
      const status = $("hero-status");
      if (issue?.hero_image) {
        preview.src = imageSrc(issue.hero_image);
        preview.hidden = false;
        status.textContent = "Attached.";
      } else {
        preview.hidden = true;
        preview.removeAttribute("src");
        status.textContent = "";
      }
      status.className = "text-xs text-text-secondary";
      (($("hero-file") as HTMLInputElement)).value = "";
    }

    const audience = issue?.audience === "public" ? "public" : "parish";
    (document.querySelector(`input[name="audience"][value="${audience}"]`) as HTMLInputElement).checked = true;

    const holder = $("sections");
    holder.innerHTML = "";
    const existing = Array.isArray(issue?.sections) ? issue!.sections! : [];
    for (const s of buildSections(existing)) holder.appendChild(sectionRow(s));
    renumberSections();

    $("editor-heading").textContent = issue ? `Editing: ${issue.title}` : "A new issue";
    ($("new-issue") as HTMLElement).hidden = !issue;
    const preview = $("preview-link") as HTMLAnchorElement;
    if (issue) {
      preview.hidden = false;
      preview.href = `/newsletter/issue/?slug=${encodeURIComponent(issue.slug)}`;
    } else {
      preview.hidden = true;
    }
    say("");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  document.getElementById("new-issue")?.addEventListener("click", () => loadIntoEditor(null));

  document.getElementById("hero-upload")?.addEventListener("click", async () => {
    const fileEl = $("hero-file") as HTMLInputElement;
    const status = $("hero-status");
    const btn = $("hero-upload") as HTMLButtonElement;
    const file = fileEl.files?.[0];
    if (!file) {
      status.textContent = "Choose a file first.";
      status.className = "text-xs text-liturgical-red";
      return;
    }
    btn.disabled = true;
    status.className = "text-xs text-text-secondary";
    status.textContent = `Uploading ${file.name}…`;
    try {
      const form = new FormData();
      form.append("file", file);
      form.append("slug", input("f-title").value.trim() || "issue");
      const res = await fetch("/api/admin/newsletter/image", {
        method: "POST",
        credentials: "same-origin",
        body: form,
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        status.textContent = body.error ?? `Upload failed (${res.status}).`;
        status.className = "text-xs text-liturgical-red";
        return;
      }
      input("f-hero").value = body.key;
      const preview = $("hero-preview") as HTMLImageElement;
      preview.src = body.url;
      preview.hidden = false;
      status.textContent =
        `${file.name} attached (${Math.round(body.bytes / 1024)} KB). ` +
        "Describe it below, then save the draft.";
    } catch (err) {
      status.textContent = `Upload failed: ${err instanceof Error ? err.message : String(err)}`;
      status.className = "text-xs text-liturgical-red";
    } finally {
      btn.disabled = false;
    }
  });

  // ============== SAVING ==============

  document.getElementById("save-issue")?.addEventListener("click", async () => {
    const title = input("f-title").value.trim();
    if (!title) {
      say("The issue needs a title.", true);
      input("f-title").focus();
      return;
    }

    const { kept, dropped, holding } = readSections();
    const payload = {
      title,
      issue_label: input("f-label").value.trim(),
      intro: area("f-intro").value.trim(),
      closing: area("f-closing").value.trim(),
      hero_image: input("f-hero").value.trim(),
      hero_image_alt: input("f-hero-alt").value.trim(),
      sections: kept,
      audience:
        (document.querySelector('input[name="audience"]:checked') as HTMLInputElement)?.value === "public"
          ? "public"
          : "parish",
    };

    const btn = document.getElementById("save-issue") as HTMLButtonElement;
    btn.disabled = true;
    say("Saving…");
    try {
      const res = await fetch(
        editingId ? `/api/admin/newsletter/${encodeURIComponent(editingId)}` : "/api/admin/newsletter",
        {
          method: editingId ? "PATCH" : "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        },
      );
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        say(body.error ?? `Couldn't save it (${res.status}).`, true);
        return;
      }
      const saved = body.issue as Issue;
      // Named back, with the counts, so it is plain that the right
      // thing was saved and not an empty form — and so that anything
      // held back is held back where she can see it.
      const stored = (saved.sections ?? []) as Section[];
      const printing = stored.filter((s) => s.include !== false && (s.body || s.image)).length;
      const pictures = stored.filter((s) => s.image).length;
      say(
        `Saved "${saved.title}" — ${printing} ${printing === 1 ? "section goes" : "sections go"} out, ` +
          `${stored.length} kept on the form, ` +
          `${pictures ? `${pictures} ${pictures === 1 ? "picture" : "pictures"} attached, ` : "no pictures yet, "}` +
          `${saved.audience === "public" ? "readable by anyone" : "for our parish"}. ` +
          (saved.published ? "It is live on the site." : "Still a draft; publish it below.") +
          (holding.length ? ` Left out this month: ${holding.join(", ")}.` : "") +
          (dropped.length
            ? ` Threw away ${dropped.length === 1 ? "a heading with nothing under it" : "headings with nothing under them"}: ${dropped.join(", ")}.`
            : ""),
      );
      await loadIssues();
      loadIntoEditor(issues.find((i) => i.id === saved.id) ?? saved);
    } catch (err) {
      say(`Couldn't save it: ${err instanceof Error ? err.message : String(err)}`, true);
    } finally {
      btn.disabled = false;
    }
  });

  // ============== THE LIST ==============

  function row(issue: Issue): string {
    const sent = issue.sent_at
      ? `Emailed to ${issue.sent_count} on ${escapeHtml(when(issue.sent_at))}` +
        (issue.sent_count < issue.sent_attempted
          ? ` — ${issue.sent_attempted - issue.sent_count} failed`
          : "")
      : "Not emailed yet";

    return `<article class="border ${issue.published ? "border-border-soft" : "border-sacred-gold"} bg-cream-card p-5 shadow-sm" data-id="${escapeHtml(issue.id)}">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h3 class="font-display text-lg text-text-primary">${escapeHtml(issue.title)}</h3>
          <p class="mt-1 text-xs uppercase tracking-widest text-text-secondary">
            ${issue.issue_label ? `${escapeHtml(issue.issue_label)} · ` : ""}${issue.audience === "public" ? "Anyone may read" : "Our parish"}${issue.published_at ? ` · ${escapeHtml(when(issue.published_at))}` : ""}
          </p>
          <p class="mt-1 text-xs ${issue.send_error ? "text-liturgical-red" : "text-text-secondary"}">${sent}</p>
        </div>
        <span class="whitespace-nowrap border px-2 py-0.5 text-[0.65rem] uppercase tracking-wider ${
          issue.published ? "border-border-soft text-text-secondary" : "border-sacred-gold text-brand-tan-dark"
        }">${issue.published ? "Published" : "Draft"}</span>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-border-soft pt-4">
        <button type="button" class="btn btn-secondary text-sm" data-action="edit">Open</button>
        <button type="button" class="btn ${issue.published ? "btn-secondary" : "btn-primary"} text-sm" data-action="toggle-published">
          ${issue.published ? "Un-publish" : "Publish"}
        </button>
        ${
          issue.published
            ? `<button type="button" class="btn btn-primary text-sm" data-action="send">
                 ${issue.sent_at ? "Send again" : "Send to the parish"}
               </button>
               <a href="/newsletter/issue/?slug=${encodeURIComponent(issue.slug)}" target="_blank" rel="noopener" class="btn btn-secondary text-sm">View</a>`
            : ""
        }
        ${issue.sent_at ? "" : `<button type="button" class="btn btn-secondary text-sm ml-auto" data-action="delete">Delete</button>`}
        <span class="row-status w-full text-sm text-text-secondary" role="status"></span>
      </div>
    </article>`;
  }

  function render() {
    $("issue-rows").innerHTML = issues.map(row).join("");
    ($("issues-empty") as HTMLElement).hidden = issues.length > 0;
  }

  async function patch(id: string, changes: Record<string, unknown>, statusEl: HTMLElement | null) {
    if (statusEl) statusEl.textContent = "Saving…";
    const res = await fetch(`/api/admin/newsletter/${encodeURIComponent(id)}`, {
      method: "PATCH",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(changes),
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      if (statusEl) {
        statusEl.textContent = body.error ?? `Failed (${res.status})`;
        statusEl.className = "row-status w-full text-sm text-liturgical-red";
      }
      return false;
    }
    await loadIssues();
    return true;
  }

  $("issue-rows").addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement | null)?.closest("[data-action]") as HTMLElement | null;
    if (!btn) return;
    const article = btn.closest("article") as HTMLElement | null;
    const id = article?.dataset.id;
    if (!id) return;
    const issue = issues.find((i) => i.id === id);
    if (!issue) return;
    const statusEl = article?.querySelector(".row-status") as HTMLElement | null;

    switch (btn.dataset.action) {
      case "edit":
        loadIntoEditor(issue);
        break;

      case "toggle-published": {
        if (issue.published && issue.sent_at) {
          const ok = window.confirm(
            [
              `"${issue.title}" has already been emailed to ${issue.sent_count}.`,
              "",
              "Un-publishing takes its page down. Every copy in a parishioner's",
              "inbox links to that page, and those links will stop working.",
              "",
              "Un-publish it anyway?",
            ].join("\u000a"),
          );
          if (!ok) return;
        }
        await patch(id, { published: !issue.published }, statusEl);
        break;
      }

      case "send": {
        // The one action on this site that cannot be undone. It asks
        // plainly, with the number of people and where it is going
        // from, and asks a second time if it has gone before.
        const again = Boolean(issue.sent_at);
        const first = window.confirm(
          [
            again
              ? `"${issue.title}" already went out to ${issue.sent_count} on ${when(issue.sent_at)}.`
              : `Email "${issue.title}" to everyone with a parish account?`,
            "",
            again
              ? "Sending again delivers a SECOND copy to every one of them."
              : "It goes out from the parish office, with everybody on BCC so",
            again ? "" : "nobody sees another member's address.",
            "",
            "An email cannot be recalled once it has gone.",
          ]
            .filter((l) => l !== "")
            .join("\u000a"),
        );
        if (!first) return;

        if (statusEl) {
          statusEl.textContent = "Sending…";
          statusEl.className = "row-status w-full text-sm text-text-secondary";
        }
        const res = await fetch("/api/admin/newsletter/send", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, sender: "office", again }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (statusEl) {
            statusEl.textContent = body.error ?? `Couldn't send it (${res.status}).`;
            statusEl.className = "row-status w-full text-sm text-liturgical-red";
          }
          return;
        }
        if (statusEl) {
          statusEl.textContent =
            `Sent to ${body.delivered} of ${body.attempted}, from ${body.sender_address}.` +
            (body.error ? ` Some failed: ${body.error}` : "") +
            (body.log_error ? ` (The send wasn't recorded: ${body.log_error})` : "");
          statusEl.className = `row-status w-full text-sm ${body.error ? "text-liturgical-red" : "text-text-secondary"}`;
        }
        await loadIssues();
        break;
      }

      case "delete": {
        if (!window.confirm(`Delete the draft "${issue.title}"? This can't be undone.`)) return;
        if (statusEl) statusEl.textContent = "Deleting…";
        const res = await fetch(`/api/admin/newsletter/${encodeURIComponent(id)}`, {
          method: "DELETE",
          credentials: "same-origin",
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (statusEl) {
            statusEl.textContent = body.error ?? `Failed (${res.status})`;
            statusEl.className = "row-status w-full text-sm text-liturgical-red";
          }
          return;
        }
        if (editingId === id) loadIntoEditor(null);
        await loadIssues();
        break;
      }
    }
  });

  // ============== LOADING ==============

  async function loadIssues() {
    const res = await fetch("/api/admin/newsletter", { credentials: "same-origin", cache: "no-store" });
    if (res.status === 401 || res.status === 403) {
      window.location.assign("/");
      return;
    }
    $("loading").hidden = true;
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      // The table not existing is the expected state until migration
      // 021 is run, and saying so beats a raw Postgres error.
      const missing = /newsletters/.test(String(body.error ?? "")) && /does not exist|schema cache/i.test(String(body.error ?? ""));
      if (missing) {
        $("app").hidden = false;
        ($("pending-warning") as HTMLElement).hidden = false;
        return;
      }
      const el = $("error-msg");
      el.textContent = `Couldn't load the newsletter: ${body.error ?? res.status}`;
      el.hidden = false;
      return;
    }
    issues = (body.issues ?? []) as Issue[];
    ($("email-warning") as HTMLElement).hidden = body.email_configured !== false;
    $("app").hidden = false;
    render();
  }

  (async () => {
    try {
      await loadIssues();
      if (!editingId) loadIntoEditor(null);
    } catch (err) {
      $("loading").hidden = true;
      const el = $("error-msg");
      el.textContent = `Couldn't load the newsletter: ${err instanceof Error ? err.message : String(err)}`;
      el.hidden = false;
    }
  })();
</script>
