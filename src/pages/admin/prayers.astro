---
import Layout from "../../layouts/Layout.astro";

// The prayer list, as the office sees it.
//
// This is the only page on the site that can show these rows. The
// table has no select policy, so nothing short of the admin API with
// the service role can read it — not a signed-in member, not even the
// person who sent one in.
---

<Layout title="Prayer Requests | St. John of Kronstadt" description="Prayer requests sent in by the parish.">
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <main class="mx-auto max-w-4xl px-4 py-8 md:px-6">
    <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Admin</p>
    <h1 class="mb-2 font-display text-3xl text-text-primary md:text-4xl">Prayer Requests</h1>
    <p class="mb-6 text-text-secondary">
      Sent in from the website and the newsletter. Mark one
      <strong class="text-text-primary">included</strong> once it has gone into an
      issue, so next month you can see at a glance what is new.
    </p>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>
    <div id="error-msg" hidden role="alert" class="mb-4 text-liturgical-red"></div>

    <div id="pending-warning" hidden class="mb-6 border-l-2 border-liturgical-red bg-cream-card p-4 text-sm leading-relaxed">
      <strong class="text-text-primary">The prayer list isn't in the database yet.</strong>
      Run <code>023_prayer_requests.sql</code> in the Supabase SQL editor and reload.
    </div>

    <div id="app" hidden>
      <div class="mb-6 flex flex-wrap gap-3">
        <p class="border border-border-soft bg-cream-card px-4 py-2 text-sm">
          <strong id="count-living" class="font-display text-lg text-text-primary">0</strong>
          <span class="ml-1 text-text-secondary">new for the living</span>
        </p>
        <p class="border border-border-soft bg-cream-card px-4 py-2 text-sm">
          <strong id="count-departed" class="font-display text-lg text-text-primary">0</strong>
          <span class="ml-1 text-text-secondary">new memorials</span>
        </p>
        <button type="button" id="copy-living" class="btn btn-secondary text-sm">Copy the living list</button>
        <button type="button" id="copy-departed" class="btn btn-secondary text-sm">Copy the memorial list</button>
      </div>
      <p id="copy-status" role="status" class="mb-4 text-sm text-text-secondary"></p>

      <p id="empty" hidden class="text-sm italic text-text-secondary">Nothing has come in yet.</p>
      <div id="rows" class="space-y-3"></div>
    </div>
  </main>
</Layout>

<script>
  type Req = {
    id: string;
    kind: "living" | "departed";
    name: string;
    requested_by: string | null;
    contact: string | null;
    note: string | null;
    status: "new" | "included" | "archived";
    created_at: string;
  };

  let requests: Req[] = [];
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  function escapeHtml(v: unknown): string {
    return String(v ?? "")
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function when(v: string): string {
    const d = new Date(v);
    return Number.isNaN(d.getTime())
      ? ""
      : d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
  }

  function row(r: Req): string {
    const faded = r.status !== "new" ? "opacity-60" : "";
    return `<article class="border border-border-soft bg-cream-card p-4 ${faded}" data-id="${escapeHtml(r.id)}">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="font-display text-lg text-text-primary">${escapeHtml(r.name)}</p>
          <p class="mt-0.5 text-xs uppercase tracking-widest text-brand-tan-dark">
            ${r.kind === "departed" ? "Memorial" : "For the living"} · ${escapeHtml(when(r.created_at))}
          </p>
          ${r.requested_by ? `<p class="mt-1 text-sm text-text-secondary">asked by ${escapeHtml(r.requested_by)}${r.contact ? ` · ${escapeHtml(r.contact)}` : ""}</p>` : ""}
          ${r.note ? `<p class="mt-2 border-l-2 border-border-soft pl-3 text-sm italic text-text-primary/85">${escapeHtml(r.note)}</p>` : ""}
        </div>
        <span class="whitespace-nowrap border px-2 py-0.5 text-[0.65rem] uppercase tracking-wider ${
          r.status === "new" ? "border-sacred-gold text-brand-tan-dark" : "border-border-soft text-text-secondary"
        }">${escapeHtml(r.status)}</span>
      </div>
      <div class="mt-3 flex flex-wrap gap-2 border-t border-border-soft pt-3">
        ${r.status !== "included" ? `<button type="button" class="btn btn-secondary text-xs" data-set="included">Mark included</button>` : ""}
        ${r.status !== "archived" ? `<button type="button" class="btn btn-secondary text-xs" data-set="archived">Archive</button>` : ""}
        ${r.status !== "new" ? `<button type="button" class="btn btn-secondary text-xs" data-set="new">Back to new</button>` : ""}
      </div>
    </article>`;
  }

  function render() {
    $("rows").innerHTML = requests.map(row).join("");
    ($("empty") as HTMLElement).hidden = requests.length > 0;
    $("count-living").textContent = String(
      requests.filter((r) => r.kind === "living" && r.status === "new").length,
    );
    $("count-departed").textContent = String(
      requests.filter((r) => r.kind === "departed" && r.status === "new").length,
    );
  }

  /**
   * The new names, as one line, ready to paste into the newsletter.
   * Copying them by hand off a list of cards is how a name gets missed.
   */
  async function copyList(kind: "living" | "departed") {
    const names = requests.filter((r) => r.kind === kind && r.status === "new").map((r) => r.name);
    const text = names.join(", ");
    const note = $("copy-status");
    if (!names.length) {
      note.textContent = `Nothing new on the ${kind === "departed" ? "memorial" : "living"} list.`;
      return;
    }
    try {
      await navigator.clipboard.writeText(text);
      note.textContent = `Copied ${names.length} ${names.length === 1 ? "name" : "names"}: ${text}`;
    } catch {
      // Clipboard refused — show it so it can still be selected.
      note.textContent = `Copy these: ${text}`;
    }
  }

  document.getElementById("copy-living")?.addEventListener("click", () => copyList("living"));
  document.getElementById("copy-departed")?.addEventListener("click", () => copyList("departed"));

  $("rows").addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement | null)?.closest("[data-set]") as HTMLElement | null;
    if (!btn) return;
    const id = btn.closest("article")?.dataset.id;
    if (!id) return;
    const res = await fetch("/api/admin/prayer-requests", {
      method: "PATCH",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, status: btn.dataset.set }),
    });
    if (res.ok) await load();
  });

  async function load() {
    const res = await fetch("/api/admin/prayer-requests", { credentials: "same-origin", cache: "no-store" });
    if (res.status === 401 || res.status === 403) {
      window.location.assign("/");
      return;
    }
    $("loading").hidden = true;
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      if (body.pending) {
        $("app").hidden = false;
        ($("pending-warning") as HTMLElement).hidden = false;
        return;
      }
      const el = $("error-msg");
      el.textContent = `Couldn't load the prayer list: ${body.error ?? res.status}`;
      el.hidden = false;
      return;
    }
    requests = (body.requests ?? []) as Req[];
    $("app").hidden = false;
    render();
  }

  load().catch((err) => {
    $("loading").hidden = true;
    const el = $("error-msg");
    el.textContent = `Couldn't load the prayer list: ${err instanceof Error ? err.message : String(err)}`;
    el.hidden = false;
  });
</script>
