---
import Layout from "../../layouts/Layout.astro";

// Admin screen for An Orthodox Table. The ones waiting come first,
// because clearing the queue is what this page is opened for.
//
// A recipe can be read in full here without leaving the page: deciding
// whether a dish really is fasting means reading the ingredients, and
// nobody should have to open a second tab to do it.
---

<Layout
  title="Recipes Admin | St. John of Kronstadt"
  description="Review and post recipes shared with the parish."
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <main class="mx-auto max-w-5xl px-4 py-8 md:px-6">
    <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Admin</p>
    <h1 class="mb-2 font-display text-3xl text-text-primary md:text-4xl">An Orthodox Table</h1>
    <p class="mb-6 text-text-secondary">
      Recipes shared by catechumens and members. Nothing appears on the site
      until it's posted here — read the ingredients before posting one to the
      fasting book.
    </p>

    <div id="loading" class="text-sm text-text-secondary">Loading…</div>
    <div id="error-msg" hidden role="alert" class="mb-4 text-liturgical-red"></div>

    <div id="app" hidden>
      <!-- Loading the parish's own collection, prepared from the old
           recipe cards. Folded away because it is used once or twice,
           not every visit. -->
      <details class="mb-6 border border-border-soft bg-cream-card p-4">
        <summary class="cursor-pointer font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark">
          Import a recipe file
        </summary>
        <div class="mt-4">
          <p class="text-sm text-text-secondary">
            Takes the JSON produced by <code>scripts/sort-recipes-for-books.py</code>.
            Everything arrives as a draft, nothing is posted, and running it
            twice adds nothing twice.
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <input
              id="import-file"
              type="file"
              accept="application/json,.json"
              class="text-sm"
            />
            <button type="button" id="import-btn" class="btn btn-secondary text-sm">Import</button>
          </div>
          <p id="import-status" class="mt-3 text-sm text-text-secondary" role="status"></p>

        </div>
      </details>

      <p id="queue-count" class="mb-3 font-display text-sm uppercase tracking-widest text-brand-tan-dark"></p>

      <!-- Three hundred recipes is too many to scroll. Searches titles,
           ingredients and categories, with a filter for the states that
           actually need finding: what is waiting, and what is unfiled. -->
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <label for="admin-search" class="sr-only">Search the recipes</label>
        <input
          id="admin-search"
          type="search"
          placeholder="Search title, ingredient or category…"
          class="min-w-0 flex-1 border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2"
        />
        <label for="admin-filter" class="sr-only">Filter</label>
        <select id="admin-filter" class="border border-border-soft bg-cream-bg px-3 py-2 text-sm focus:outline-none focus:ring-2">
          <option value="">All recipes</option>
          <option value="waiting">Waiting to be posted</option>
          <option value="posted">Posted</option>
          <option value="fasting">Fasting book</option>
          <option value="everyday">Everyday book</option>
          <option value="unfiled">Not yet filed</option>
        </select>
        <span id="admin-shown" class="text-sm text-text-secondary" role="status"></span>
      </div>

      <!-- The two jobs worth doing to the whole queue at once, in plain
           sight: three hundred recipes is too many to file or post one
           at a time, and a button for it hidden in a fold is no button. -->
      <div id="bulk-actions" class="mb-6 flex flex-wrap items-center gap-3 border border-border-soft bg-cream-card p-4">
        <button type="button" id="categorise-btn" class="btn btn-secondary text-sm">
          File the unfiled by title
        </button>
        <button type="button" id="post-all-btn" class="btn btn-primary text-sm">
          Post everything waiting
        </button>
        <p id="bulk-status" class="w-full text-sm text-text-secondary" role="status"></p>
        <p class="w-full text-xs text-text-secondary">
          Filing reads each title and places the obvious ones, touching only
          recipes with no category — anything you've already sorted is left
          alone. Posting puts them on the site: fasting recipes are public,
          everyday ones are for signed-in members.
        </p>
      </div>
      <div id="recipe-rows" class="space-y-4"></div>
      <p id="empty" hidden class="text-sm italic text-text-secondary">
        No recipes yet. They'll appear here as people send them in.
      </p>
    </div>
  </main>
</Layout>

<script>
  import { RECIPE_CATEGORIES, categoryOf, categoryValue } from "../../lib/recipe-categories";

  type Recipe = {
    id: string;
    slug: string;
    title: string;
    fasting: boolean;
    category: string | null;
    hands_on: string | null;
    total_time: string | null;
    serves: string | null;
    preheat: string | null;
    intro: string | null;
    ingredients: string[];
    directions: string[];
    notes: string | null;
    submitted_by_name: string | null;
    published: boolean;
    created_at: string;
  };

  let recipes: Recipe[] = [];

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function showError(message: string) {
    const el = document.getElementById("error-msg") as HTMLDivElement;
    el.textContent = message;
    el.hidden = false;
  }

  function formatDate(value: string): string {
    try {
      return new Date(value).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    } catch {
      return value;
    }
  }

  function row(r: Recipe): string {
    const meta = [r.hands_on, r.total_time, r.serves ? `serves ${r.serves}` : "", r.preheat]
      .filter(Boolean)
      .map((m) => escapeHtml(m))
      .join(" · ");

    return `<article class="border ${r.published ? "border-border-soft" : "border-sacred-gold"} bg-cream-card p-5 shadow-sm" data-id="${escapeHtml(r.id)}">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="font-display text-xl text-text-primary">${escapeHtml(r.title)}</h2>
          <p class="mt-1 text-xs uppercase tracking-widest text-text-secondary">
            ${r.fasting ? "Fasting" : "Everyday"}${r.category ? ` · ${escapeHtml(categoryOf(r.category))}` : " · unfiled"}
            ${r.submitted_by_name ? ` · from ${escapeHtml(r.submitted_by_name)}` : ""}
            · ${escapeHtml(formatDate(r.created_at))}
          </p>
          ${meta ? `<p class="mt-1 text-xs text-text-secondary">${meta}</p>` : ""}
        </div>
        <span class="whitespace-nowrap border px-2 py-0.5 text-[0.65rem] uppercase tracking-wider ${
          r.published
            ? "border-border-soft text-text-secondary"
            : "border-sacred-gold text-brand-tan-dark"
        }">${r.published ? "Posted" : "Waiting"}</span>
      </div>

      ${r.intro ? `<p class="mt-3 text-sm italic text-text-primary/85">${escapeHtml(r.intro)}</p>` : ""}

      <!-- Read it here. Judging a fasting recipe means reading what's in
           it, and that shouldn't need a second tab. -->
      <details class="mt-3">
        <summary class="cursor-pointer text-sm font-semibold text-brand-blue-dark">
          Read the recipe
        </summary>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <div>
            <h3 class="text-xs uppercase tracking-widest text-text-secondary">Ingredients</h3>
            <ul class="mt-2 space-y-1 text-sm">
              ${(r.ingredients ?? []).map((i) => `<li>${escapeHtml(i)}</li>`).join("")}
            </ul>
          </div>
          <div>
            <h3 class="text-xs uppercase tracking-widest text-text-secondary">Directions</h3>
            <ol class="mt-2 space-y-2 text-sm">
              ${(r.directions ?? []).map((d, i) => `<li><span class="text-brand-tan-dark">${i + 1}.</span> ${escapeHtml(d)}</li>`).join("")}
            </ol>
          </div>
        </div>
        ${r.notes ? `<p class="mt-3 text-sm text-text-primary/85"><span class="text-xs uppercase tracking-widest text-text-secondary">Notes</span><br>${escapeHtml(r.notes)}</p>` : ""}
      </details>

      <details class="mt-3">
        <summary class="cursor-pointer text-sm font-semibold text-brand-blue-dark">
          Edit the details
        </summary>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="sm:col-span-2 block text-xs uppercase tracking-widest text-text-secondary">
            Title
            <input type="text" class="edit-field mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"
                   data-field="title" value="${escapeHtml(r.title)}" />
          </label>
          <label class="block text-xs uppercase tracking-widest text-text-secondary">
            Hands-on
            <input type="text" class="edit-field mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"
                   data-field="hands_on" value="${escapeHtml(r.hands_on ?? "")}" />
          </label>
          <label class="block text-xs uppercase tracking-widest text-text-secondary">
            Total time
            <input type="text" class="edit-field mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"
                   data-field="total_time" value="${escapeHtml(r.total_time ?? "")}" />
          </label>
          <label class="block text-xs uppercase tracking-widest text-text-secondary">
            Serves
            <input type="text" class="edit-field mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"
                   data-field="serves" value="${escapeHtml(r.serves ?? "")}" />
          </label>
          <label class="block text-xs uppercase tracking-widest text-text-secondary">
            Oven
            <input type="text" class="edit-field mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"
                   data-field="preheat" value="${escapeHtml(r.preheat ?? "")}" />
          </label>
          <label class="sm:col-span-2 block text-xs uppercase tracking-widest text-text-secondary">
            Notes
            <textarea rows="2" class="edit-field mt-1 block w-full border border-border-soft bg-cream-bg px-2 py-1.5 text-sm normal-case tracking-normal text-text-primary"
                      data-field="notes">${escapeHtml(r.notes ?? "")}</textarea>
          </label>
          <div class="sm:col-span-2">
            <button type="button" class="btn btn-secondary text-sm" data-action="save-details">Save details</button>
          </div>
        </div>
      </details>

      <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-border-soft pt-4">
        <label class="sr-only" for="cat-${escapeHtml(r.id)}">Kind of dish</label>
        <select id="cat-${escapeHtml(r.id)}" class="recipe-category border border-border-soft bg-cream-bg px-2 py-1 text-xs focus:outline-none focus:ring-2">
          <option value="">— no category —</option>
          ${RECIPE_CATEGORIES.map(
            (g) => `<optgroup label="${escapeHtml(g.group)}">${g.categories
              .map((c) => {
                const value = categoryValue(g.group, c);
                return `<option value="${escapeHtml(value)}"${r.category === value ? " selected" : ""}>${escapeHtml(c)}</option>`;
              })
              .join("")}</optgroup>`,
          ).join("")}
        </select>
        <button type="button" class="btn ${r.published ? "btn-secondary" : "btn-primary"} text-sm" data-action="toggle-posted">
          ${r.published ? "Un-post" : "Post it"}
        </button>
        <button type="button" class="btn btn-secondary text-sm" data-action="toggle-book">
          Move to ${r.fasting ? "Everyday" : "Fasting"}
        </button>
        ${r.published ? `<a href="/table/recipe/?slug=${encodeURIComponent(r.slug)}" target="_blank" rel="noopener" class="btn btn-secondary text-sm">View</a>` : ""}
        <button type="button" class="btn btn-secondary text-sm ml-auto" data-action="delete">Delete</button>
        <span class="row-status text-sm text-text-secondary"></span>
      </div>
    </article>`;
  }

  /** Accents folded and punctuation dropped, as elsewhere on the site. */
  function normalise(value: unknown): string {
    return String(value ?? "")
      .normalize("NFKD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function visibleRecipes(): Recipe[] {
    const query = (document.getElementById("admin-search") as HTMLInputElement | null)?.value ?? "";
    const filter = (document.getElementById("admin-filter") as HTMLSelectElement | null)?.value ?? "";
    const terms = normalise(query).split(/\s+/).filter(Boolean);

    return recipes.filter((r) => {
      switch (filter) {
        case "waiting": if (r.published) return false; break;
        case "posted": if (!r.published) return false; break;
        case "fasting": if (!r.fasting) return false; break;
        case "everyday": if (r.fasting) return false; break;
        case "unfiled": if (r.category) return false; break;
      }
      if (terms.length === 0) return true;
      const hay = normalise(
        [r.title, r.category, r.intro, (r.ingredients ?? []).join(" "), r.submitted_by_name].join(" "),
      );
      return terms.every((t) => hay.includes(t));
    });
  }

  function render() {
    const rows = document.getElementById("recipe-rows") as HTMLDivElement;
    const empty = document.getElementById("empty") as HTMLParagraphElement;
    const count = document.getElementById("queue-count") as HTMLParagraphElement;
    const shown = visibleRecipes();
    const shownEl = document.getElementById("admin-shown");

    rows.innerHTML = shown.map(row).join("");
    empty.hidden = recipes.length > 0;
    if (shownEl) {
      shownEl.textContent =
        shown.length === recipes.length
          ? ""
          : `${shown.length} of ${recipes.length}`;
    }

    const waiting = recipes.filter((r) => !r.published).length;
    count.textContent = waiting
      ? `${waiting} waiting to be posted`
      : `${recipes.length} ${recipes.length === 1 ? "recipe" : "recipes"}, all posted`;
  }

  async function loadRecipes() {
    const res = await fetch("/api/admin/recipes", { credentials: "same-origin", cache: "no-store" });
    if (res.status === 401 || res.status === 403) {
      window.location.assign("/");
      return;
    }
    (document.getElementById("loading") as HTMLDivElement).hidden = true;
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showError(`Couldn't load the recipes: ${body.error ?? res.status}`);
      return;
    }
    const data = await res.json();
    // Waiting first, newest within each group. The API orders them this
    // way too, but the page shouldn't depend on that — the queue coming
    // first is the whole point of opening it.
    recipes = ((data.recipes ?? []) as Recipe[]).sort((a, b) => {
      if (a.published !== b.published) return a.published ? 1 : -1;
      return (b.created_at ?? "").localeCompare(a.created_at ?? "");
    });
    (document.getElementById("app") as HTMLDivElement).hidden = false;
    render();
  }

  async function patch(id: string, changes: Record<string, unknown>, statusEl: HTMLElement | null) {
    if (statusEl) statusEl.textContent = "Saving…";
    const res = await fetch(`/api/admin/recipes/${encodeURIComponent(id)}`, {
      method: "PATCH",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(changes),
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      if (statusEl) statusEl.textContent = body.error ?? `Failed (${res.status})`;
      return false;
    }
    await loadRecipes();
    return true;
  }

  document.getElementById("recipe-rows")?.addEventListener("change", async (event) => {
    const select = (event.target as HTMLElement | null)?.closest(".recipe-category") as HTMLSelectElement | null;
    if (!select) return;
    const article = select.closest("article") as HTMLElement | null;
    const id = article?.dataset.id ?? "";
    if (!id) return;
    await patch(id, { category: select.value }, article?.querySelector(".row-status") as HTMLElement | null);
  });

  document.getElementById("recipe-rows")?.addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement | null)?.closest("[data-action]") as HTMLElement | null;
    if (!btn) return;
    const article = btn.closest("article") as HTMLElement | null;
    const id = article?.dataset.id ?? "";
    if (!id) return;
    const recipe = recipes.find((r) => r.id === id);
    if (!recipe) return;
    const statusEl = article?.querySelector(".row-status") as HTMLElement | null;

    switch (btn.dataset.action) {
      case "toggle-posted":
        await patch(id, { published: !recipe.published }, statusEl);
        break;
      case "save-details": {
        const changes: Record<string, string> = {};
        for (const field of article!.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(".edit-field")) {
          changes[field.dataset.field!] = field.value.trim();
        }
        if (!changes.title) {
          if (statusEl) statusEl.textContent = "A title is needed.";
          return;
        }
        await patch(id, changes, statusEl);
        break;
      }
      case "toggle-book":
        await patch(id, { fasting: !recipe.fasting }, statusEl);
        break;
      case "delete": {
        if (!window.confirm(`Delete "${recipe.title}"? This can't be undone.`)) return;
        if (statusEl) statusEl.textContent = "Deleting…";
        const res = await fetch(`/api/admin/recipes/${encodeURIComponent(id)}`, {
          method: "DELETE",
          credentials: "same-origin",
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          if (statusEl) statusEl.textContent = body.error ?? `Failed (${res.status})`;
          return;
        }
        await loadRecipes();
        break;
      }
    }
  });

  void loadRecipes();

  // ============== IMPORTING THE PARISH COLLECTION ==============
  // Sent a few dozen at a time: each row is an insert, and one request
  // asked to do three hundred of them runs out of room part way — which
  // is how the duplicate cleanup once stopped at 48 of 68.

  function setImportStatus(message: string, bad = false) {
    const el = document.getElementById("import-status");
    if (!el) return;
    el.textContent = message;
    el.className = bad ? "mt-3 text-sm text-liturgical-red" : "mt-3 text-sm text-text-secondary";
  }

  document.getElementById("import-btn")?.addEventListener("click", async () => {
    const input = document.getElementById("import-file") as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) {
      setImportStatus("Choose the file first.", true);
      return;
    }

    let rows: unknown[];
    try {
      const parsed = JSON.parse(await file.text());
      rows = Array.isArray(parsed) ? parsed : (parsed.recipes ?? []);
    } catch (err) {
      setImportStatus(`That file isn't readable JSON: ${err instanceof Error ? err.message : String(err)}`, true);
      return;
    }
    if (rows.length === 0) {
      setImportStatus("No recipes in that file.", true);
      return;
    }
    if (!window.confirm(`Import ${rows.length} recipes as drafts? Nothing will be posted.`)) return;

    const btn = document.getElementById("import-btn") as HTMLButtonElement;
    btn.disabled = true;
    const BATCH = 40;
    let added = 0;
    let skipped = 0;
    const failed: { title: string; why: string }[] = [];

    try {
      for (let i = 0; i < rows.length; i += BATCH) {
        const slice = rows.slice(i, i + BATCH);
        setImportStatus(`Importing… ${Math.min(i + slice.length, rows.length)} of ${rows.length}`);
        const res = await fetch("/api/admin/recipes/import", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ recipes: slice }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          setImportStatus(body.error ?? `Import failed (${res.status}).`, true);
          return;
        }
        added += body.added ?? 0;
        skipped += body.skipped ?? 0;
        failed.push(...((body.failed ?? []) as { title: string; why: string }[]));
      }

      setImportStatus(
        `Added ${added} as drafts.` +
          (skipped ? ` ${skipped} were already here.` : "") +
          (failed.length ? ` ${failed.length} could not be read — see the console.` : ""),
        failed.length > 0,
      );
      if (failed.length) console.warn("Recipes that could not be imported:", failed);
      await loadRecipes();
    } catch (err) {
      setImportStatus(`Import failed: ${err instanceof Error ? err.message : String(err)}`, true);
    } finally {
      btn.disabled = false;
    }
  });

  // ============== FILING THE UNFILED ==============

  document.getElementById("categorise-btn")?.addEventListener("click", async () => {
    const btn = document.getElementById("categorise-btn") as HTMLButtonElement;
    const status = document.getElementById("bulk-status") as HTMLParagraphElement;
    const say = (message: string, bad = false) => {
      status.textContent = message;
      status.className = bad ? "w-full text-sm text-liturgical-red" : "w-full text-sm text-text-secondary";
    };

    btn.disabled = true;
    let filed = 0;
    let stillUnfiled = 0;
    let examples: { title: string; category: string }[] = [];

    try {
      // Loops until nothing is left, the way the other jobs do.
      for (let round = 0; round < 20; round++) {
        say(`Reading titles… ${filed} filed so far`);
        const res = await fetch("/api/admin/recipes/categorise", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ limit: 80 }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          say(body.error ?? `Couldn't file them (${res.status}).`, true);
          return;
        }
        filed += body.filed ?? 0;
        // Counted from the table, not summed across rounds: a recipe
        // whose title says nothing appears in every round, and adding
        // those up once reported 193 unfiled out of 314 recipes.
        stillUnfiled = body.still_unfiled ?? 0;
        if (examples.length === 0) examples = body.examples ?? [];
        if ((body.remaining ?? 0) === 0) break;
        // Nothing moved and nothing left to try: stop rather than spin.
        if ((body.filed ?? 0) === 0 && (body.left_alone ?? 0) === 0) break;
      }

      say(
        `Filed ${filed}.` +
          (stillUnfiled
            ? ` ${stillUnfiled} still unfiled — ${stillUnfiled === 1 ? "its title doesn't" : "their titles don't"} say what ${stillUnfiled === 1 ? "it is" : "they are"}.`
            : " Everything has a category now."),
      );
      if (examples.length) console.info("Examples of what it filed:", examples);
      await loadRecipes();
    } catch (err) {
      say(`Couldn't file them: ${err instanceof Error ? err.message : String(err)}`, true);
    } finally {
      btn.disabled = false;
    }
  });

  // ============== POSTING THE WHOLE QUEUE ==============
  // Three hundred recipes is three hundred presses otherwise. Done a few
  // at a time, the way every other job on this site works.

  document.getElementById("post-all-btn")?.addEventListener("click", async () => {
    const waiting = recipes.filter((r) => !r.published);
    if (waiting.length === 0) {
      setBulkStatus("Nothing is waiting.");
      return;
    }
    const fasting = waiting.filter((r) => r.fasting).length;
    const unfiled = waiting.filter((r) => !r.category).length;

    if (
      !window.confirm(
        [
          waiting.length === 1
            ? "Post the one waiting recipe?"
            : `Post all ${waiting.length} waiting recipes?`,
          "",
          `${fasting} ${fasting === 1 ? "goes" : "go"} to the fasting book, which anyone can read.`,
          `${waiting.length - fasting} ${waiting.length - fasting === 1 ? "goes" : "go"} to the everyday book, for signed-in members.`,
          ...(unfiled
            ? ["", `${unfiled} ${unfiled === 1 ? "has" : "have"} no category yet, and will show under "Not yet filed".`]
            : []),
        ].join("\n"),
      )
    ) {
      return;
    }

    const btn = document.getElementById("post-all-btn") as HTMLButtonElement;
    btn.disabled = true;
    let posted = 0;
    const failed: string[] = [];

    try {
      for (const recipe of waiting) {
        setBulkStatus(`Posting… ${posted + 1} of ${waiting.length}`);
        const res = await fetch(`/api/admin/recipes/${encodeURIComponent(recipe.id)}`, {
          method: "PATCH",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ published: true }),
        });
        if (res.ok) posted++;
        else failed.push(recipe.title);
      }
      setBulkStatus(
        `Posted ${posted}.` + (failed.length ? ` ${failed.length} failed — see the console.` : ""),
        failed.length > 0,
      );
      if (failed.length) console.warn("Recipes that would not post:", failed);
      await loadRecipes();
    } catch (err) {
      setBulkStatus(`Stopped: ${err instanceof Error ? err.message : String(err)}`, true);
    } finally {
      btn.disabled = false;
    }
  });

  function setBulkStatus(message: string, bad = false) {
    const el = document.getElementById("bulk-status");
    if (!el) return;
    el.textContent = message;
    el.className = bad ? "w-full text-sm text-liturgical-red" : "w-full text-sm text-text-secondary";
  }

  // Re-render on every keystroke and filter change. The whole collection
  // is already in the page, so this costs nothing and finding one recipe
  // among three hundred stops being a scroll.
  document.getElementById("admin-search")?.addEventListener("input", render);
  document.getElementById("admin-filter")?.addEventListener("change", render);
</script>
