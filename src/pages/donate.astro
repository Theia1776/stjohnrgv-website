---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Support the Mission | St. John of Kronstadt Orthodox Mission"
  description="Support St. John of Kronstadt Orthodox Mission with tithes, candles, and offerings — sustaining parish life in the Rio Grande Valley, Bayview TX."
>
  <!-- Zeffy modal launcher. Bound to any element carrying a
       zeffy-form-link="…" attribute (the two card CTAs below) and opens
       the form in an overlay so the visitor stays on this page.
       is:inline keeps Astro from bundling the external loader. -->
  <script
    slot="head"
    src="https://zeffy-scripts.s3.ca-central-1.amazonaws.com/embed-form-script.min.js"
    is:inline
  ></script>

  <!-- ==================== PAGE HEADER (centered) ==================== -->
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center md:px-6 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Tithes &amp; Offerings</p>
      <h1 class="mt-2 font-display text-4xl text-text-primary md:text-5xl">Support the Mission</h1>
      <div class="mx-auto mt-6 h-px w-24 bg-liturgical-current"></div>
      <p class="mt-6 text-lg leading-relaxed text-text-primary/85">
        Your offerings sustain the life of the parish — the services, the
        sacraments, and the work of making Orthodoxy present in the Rio
        Grande Valley.
      </p>
    </div>
  </section>

  <!-- ==================== TRANSPARENCY + CARDS + FOOTER ==================== -->
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-5xl px-4 pb-20 md:px-6 md:pb-28">

      <!-- Zeffy transparency callout — brand-blue left border on cream-card -->
      <aside
        class="border-l-4 border-brand-blue bg-cream-card p-5 shadow-sm md:p-6"
        aria-label="About Zeffy"
      >
        <p class="leading-relaxed text-text-primary/85">
          We use Zeffy, a free donation platform. During checkout, Zeffy
          may suggest an optional tip to support themselves — you can set
          it to $0. 100% of your offering goes directly to the parish.
        </p>
      </aside>

      <!-- Subheading -->
      <h2 class="mt-12 font-display text-2xl text-text-primary md:text-3xl">Choose how to give</h2>
      <div class="mt-4 h-px w-16 bg-liturgical-current"></div>

      <!-- Card grid — duplicate <article> below to add another campaign -->
      <div class="mt-8 grid gap-6 md:grid-cols-3 md:gap-8">

        <!-- Card: Tithe -->
        <article class="border border-brand-tan bg-cream-card p-6 shadow-sm md:p-8">
          <span aria-hidden="true" class="mb-3 block text-3xl leading-none text-sacred-gold">✦</span>
          <h3 class="font-display text-2xl text-text-primary">Tithe/Offering</h3>
          <div class="mt-4 h-px w-12 bg-liturgical-current"></div>
          <p class="mt-4 leading-relaxed text-text-primary/85">
            The life and growth of our parish rely on the generosity of
            our faithful. No gift of any amount is insignificant to aid
            in this mission.
          </p>
          <blockquote class="mt-4 italic leading-relaxed text-text-primary/85">
            <p>
              "So let each one give as he purposes in his heart, not
              grudgingly or of necessity; for God loves a cheerful giver."
            </p>
            <cite class="mt-2 block text-sm not-italic text-text-secondary">
              — 2 Corinthians 9:7 (NKJV)
            </cite>
          </blockquote>
          <p class="mt-6">
            <a
              zeffy-form-link="https://www.zeffy.com/embed/donation-form/tithe-58?modal=true"
              role="button"
              tabindex="0"
              class="cursor-pointer font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
            >
              Give now →
            </a>
          </p>
        </article>

        <!-- Card: Prayer Candles -->
        <article class="border border-brand-tan bg-cream-card p-6 shadow-sm md:p-8">
          <span aria-hidden="true" class="mb-3 block text-3xl leading-none">🕯</span>
          <h3 class="font-display text-2xl text-text-primary">Prayer Candles</h3>
          <div class="mt-4 h-px w-12 bg-liturgical-current"></div>
          <p class="mt-4 leading-relaxed text-text-primary/85">
            $1.00 each. Conveniently purchase your candles online and pick
            them up at any service.
          </p>
          <blockquote class="mt-4 italic leading-relaxed text-text-primary/85">
            <p>
              "Your word is a lamp to my feet and a light to my path."
            </p>
            <cite class="mt-2 block text-sm not-italic text-text-secondary">
              — Psalm 119:105 (NKJV)
            </cite>
          </blockquote>
          <p class="mt-6">
            <a
              zeffy-form-link="https://www.zeffy.com/embed/ticketing/prayer-candles?modal=true"
              role="button"
              tabindex="0"
              class="cursor-pointer font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
            >
              Purchase candles →
            </a>
          </p>
        </article>

        <!-- Card: Floor Repair Fund -->
        <article class="border border-brand-tan bg-cream-card p-6 shadow-sm md:p-8">
          <span aria-hidden="true" class="mb-3 block text-3xl leading-none">🔨</span>
          <h3 class="font-display text-2xl text-text-primary">Floor Repair Fund</h3>
          <div class="mt-4 h-px w-12 bg-liturgical-current"></div>
          <p class="mt-4 leading-relaxed text-text-primary/85">
            Help restore the floor of our mission church — the ground
            where we stand to pray and gather as a community. Goal:
            $6,300.
          </p>
          <blockquote class="mt-4 italic leading-relaxed text-text-primary/85">
            <p>
              "Go up to the mountains and bring wood and build the temple,
              that I may take pleasure in it and be glorified, says the
              Lord."
            </p>
            <cite class="mt-2 block text-sm not-italic text-text-secondary">
              — Haggai 1:8 (NKJV)
            </cite>
          </blockquote>
          <p class="mt-6">
            <a
              zeffy-form-link="https://www.zeffy.com/embed/donation-form/floor-repairs?modal=true"
              role="button"
              tabindex="0"
              class="cursor-pointer font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
            >
              Give toward repairs →
            </a>
          </p>
        </article>

      </div>

      <!-- Footer line -->
      <p class="mt-12 text-sm text-text-secondary">
        Questions about giving?
        <a href="mailto:parishoffice@stjohnrgv.org">parishoffice@stjohnrgv.org</a>
        <span aria-hidden="true" class="mx-2 text-brand-tan-dark">·</span>
        <a href="tel:+19564490225">(956) 449-0225</a>
      </p>

    </div>
  </section>
</Layout>
