---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Support Our Mission | St. John of Kronstadt Orthodox Mission"
  description="Support St. John of Kronstadt Orthodox Mission — a True Orthodox parish serving the Rio Grande Valley. Online giving coming soon."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs uppercase tracking-widest text-brand-tan-dark">Support the Mission</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Donate</h1>
    <p class="mt-6 text-lg text-text-primary/80">
      Online giving for St. John of Kronstadt Orthodox Mission is coming soon, pending
      completion of our nonprofit verification.
    </p>
    <p class="mt-4 text-text-primary/75">
      In the meantime, gifts may be brought in person at services or arranged by phone with
      Fr. Antonios at <a href="tel:+19564490225">(956) 449-0225</a>.
      Your generosity sustains the daily liturgical life of the parish and the mission's
      welcome to seekers throughout the Rio Grande Valley.
    </p>
  </section>
</Layout>
