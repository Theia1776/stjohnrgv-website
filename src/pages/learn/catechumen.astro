---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Catechumen Learning | Orthodox Inquirers, Bayview TX"
  description="Become Orthodox: catechumen path for inquirers — sacraments, doctrine, prayer life. St. John of Kronstadt Orthodox Mission, Bayview TX, Rio Grande Valley."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">For Inquirers</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Catechumen Learning</h1>
    <p class="mt-6 text-lg text-text-primary/80">
      Coming soon. This section will contain introductory materials for those exploring the Orthodox faith.
    </p>
    <p class="mt-4 text-text-primary/75">
      If you are exploring Orthodoxy and would like to speak with someone,
      <a href="/contact/">reach out to Fr. Antonios</a>.
    </p>
  </section>
</Layout>
