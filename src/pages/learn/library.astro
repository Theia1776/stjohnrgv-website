---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Parish Library | St. John of Kronstadt Orthodox Mission"
  description="Parish library — texts, sermons, and Orthodox documents. St. John of Kronstadt Orthodox Mission, Bayview TX, Rio Grande Valley."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Resources</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Parish Library</h1>
    <p class="mt-6 text-lg text-text-primary/80">
      Coming soon. This section will contain texts, sermons, and documents from the parish and the wider Orthodox tradition.
    </p>
    <p class="mt-4 text-text-primary/75">
      In the meantime, <a href="/contact/">reach out to Fr. Antonios</a> for reading recommendations.
    </p>
  </section>
</Layout>
