---
import Layout from "../../layouts/Layout.astro";

// The page itself is static; book cards are populated at runtime
// from /api/library/books so newly-uploaded titles appear without
// a rebuild. The /learn/library middleware gates access.

// Fixed filter set per spec — even categories that aren't yet present in
// the catalog show as tabs so the shape of the library is visible.
const categories = ["All", "Hagiography", "Liturgical Texts", "Patristics", "Scripture"];
---

<Layout
  title="Parish Library | Orthodox Texts, Bayview TX"
  description="Orthodox Christian texts, patristic writings, sermons, and True Orthodoxy documents — St. John of Kronstadt Orthodox Mission, Bayview TX, Rio Grande Valley."
>
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Parish Resources</p>
      <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Parish Library</h1>
      <div class="mt-6 h-px w-24 bg-liturgical-current"></div>

      <p class="mt-6 max-w-2xl text-text-primary/85 leading-relaxed">
        Texts for prayer and study, available to registered members of the
        parish. Click a title to open the in-browser reader.
      </p>

      <p id="library-error" hidden class="mt-6 border border-liturgical-red bg-cream-card p-4 text-sm text-liturgical-red" role="alert"></p>

      <!-- ============== FILTER TABS ============== -->
      <div
        role="tablist"
        aria-label="Filter library by category"
        class="mt-10 flex flex-wrap gap-x-1 gap-y-2 border-b border-border-soft"
      >
        {categories.map((cat, i) => (
          <button
            type="button"
            role="tab"
            data-filter={cat}
            aria-selected={i === 0 ? "true" : "false"}
            class:list={[
              "library-tab -mb-px border-b-2 px-3 py-2 font-display text-sm font-semibold uppercase tracking-widest",
              i === 0
                ? "border-brand-blue-dark text-brand-blue-dark"
                : "border-transparent text-text-secondary hover:text-text-primary",
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- ============== CARD GRID ============== -->
      <div id="library-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <p id="library-loading" class="md:col-span-2 lg:col-span-3 text-center text-text-secondary italic">
          Loading library…
        </p>
      </div>

      <!-- Empty-state for filters that select an empty category -->
      <p
        id="library-empty"
        hidden
        class="mt-10 text-center text-text-secondary italic"
      >
        No texts in this category yet.
      </p>
    </div>
  </section>

  <script>
    type Book = {
      slug: string;
      title: string;
      author: string | null;
      category: string;
      languages: string[];
      description: string | null;
    };

    const grid = document.getElementById("library-grid") as HTMLDivElement;
    const loadingEl = document.getElementById("library-loading") as HTMLParagraphElement;
    const errorEl = document.getElementById("library-error") as HTMLParagraphElement;
    const emptyEl = document.getElementById("library-empty") as HTMLParagraphElement;
    const tabs = document.querySelectorAll<HTMLButtonElement>(".library-tab");

    let currentFilter = "All";
    let books: Book[] = [];

    function escapeHtml(value: unknown): string {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function renderCards() {
      const visible = currentFilter === "All"
        ? books
        : books.filter((b) => b.category === currentFilter);

      emptyEl.hidden = visible.length !== 0;

      if (visible.length === 0) {
        grid.innerHTML = "";
        return;
      }

      grid.innerHTML = visible
        .map(
          (book) => `<article
            data-category="${escapeHtml(book.category)}"
            class="library-card flex flex-col border border-border-soft bg-cream-card p-6 shadow-sm md:p-7"
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">${escapeHtml(book.category)}</p>
            <h2 class="mt-2 font-display text-xl text-text-primary leading-snug">${escapeHtml(book.title)}</h2>
            <p class="mt-2 text-sm italic text-text-secondary">${escapeHtml(book.author ?? "")}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              ${(book.languages ?? []).map((lang) => `<span class="border border-border-soft px-2 py-0.5 text-xs uppercase tracking-wider text-text-secondary">${escapeHtml(lang)}</span>`).join("")}
            </div>
            <p class="mt-5 text-sm text-text-primary/85 leading-relaxed">${escapeHtml(book.description ?? "")}</p>
            <div class="mt-6 flex-grow"></div>
            <p>
              <a
                href="/learn/library/reader/?slug=${encodeURIComponent(book.slug)}"
                class="font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
              >Read →</a>
            </p>
          </article>`,
        )
        .join("");
    }

    function showError(message: string) {
      loadingEl.hidden = true;
      grid.innerHTML = "";
      errorEl.textContent = `Could not load the library: ${message}`;
      errorEl.hidden = false;
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        currentFilter = tab.dataset.filter || "All";
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute("aria-selected", String(active));
          t.classList.toggle("border-brand-blue-dark", active);
          t.classList.toggle("text-brand-blue-dark", active);
          t.classList.toggle("border-transparent", !active);
          t.classList.toggle("text-text-secondary", !active);
        });
        renderCards();
      });
    });

    (async () => {
      try {
        const res = await fetch("/api/library/books", { credentials: "same-origin", cache: "no-store" });
        if (res.status === 401 || res.status === 403) {
          // Middleware should already have redirected — fall through to login as a safety net.
          window.location.assign(`/login/?next=${encodeURIComponent(location.pathname)}`);
          return;
        }
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          showError(body.error ?? `HTTP ${res.status}`);
          return;
        }
        const data = await res.json();
        books = (data.books ?? []) as Book[];
        loadingEl.remove();
        if (books.length === 0) {
          grid.innerHTML = `<p class="md:col-span-2 lg:col-span-3 text-center text-text-secondary italic">The library is empty. Check back soon.</p>`;
          return;
        }
        renderCards();
      } catch (err) {
        showError(err instanceof Error ? err.message : String(err));
      }
    })();
  </script>
</Layout>
