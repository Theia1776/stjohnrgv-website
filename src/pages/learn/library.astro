---
import Layout from "../../layouts/Layout.astro";

// The page itself is static; book cards are populated at runtime
// from /api/library/books so newly-uploaded titles appear without
// a rebuild. The /learn/library middleware gates access.

// The canonical category list. Must match the admin upload
// dropdown ([src/pages/admin/library.astro]) — drift here would
// leave books invisible to the gateway because their category
// wouldn't be a known tile.
const categories = [
  "Hagiography",
  "Liturgical Texts",
  "Patristics",
  "Scripture",
  "History",
  "Theology / Doctrine",
  "Spiritual Life",
  "Other",
];
---

<Layout
  title="Parish Library | Orthodox Texts, Bayview TX"
  description="Orthodox Christian texts, patristic writings, sermons, and True Orthodoxy documents — St. John of Kronstadt Orthodox Mission, Bayview TX, Rio Grande Valley."
>
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Parish Resources</p>
      <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Parish Library</h1>
      <div class="mt-6 h-px w-24 bg-liturgical-current"></div>

      <p id="intro-parishioner" hidden class="mt-6 max-w-2xl text-text-primary/85 leading-relaxed">
        Texts for prayer and study from our parish library. Choose a category
        to browse its texts.
      </p>
      <p id="intro-visitor" hidden class="mt-6 max-w-2xl text-text-primary/85 leading-relaxed">
        A small selection of texts from our parish library, freely available
        to all visitors.
      </p>
      <p id="visitor-parishioner-hint" hidden class="mt-3 max-w-2xl text-sm italic text-text-secondary">
        Parishioners of St. John of Kronstadt with an account:
        <a href="/login/?next=/learn/library/" class="font-semibold text-brand-blue-dark hover:underline not-italic">sign in</a>
        to see the rest of the library.
      </p>

      <!-- ============== SEARCH ==============
           Searches every text the viewer is allowed to see — title,
           author, description, category, language — across all
           categories at once. Clearing it returns you to whatever you
           were looking at. Hidden until the catalog has loaded. -->
      <div id="search-bar" hidden class="mt-8 max-w-2xl">
        <label for="library-search" class="sr-only">Search the library</label>
        <div class="flex items-center gap-3">
          <input
            id="library-search"
            type="search"
            autocomplete="off"
            placeholder="Search by title, author, subject…"
            class="min-w-0 flex-1 border border-border-soft bg-cream-card px-4 py-2.5 text-text-primary placeholder:text-text-secondary focus:outline-none focus:ring-2"
          />
          <button
            type="button"
            id="search-clear"
            hidden
            class="shrink-0 border border-border-soft bg-cream-card px-3 py-2.5 font-display text-xs font-semibold uppercase tracking-widest text-text-secondary hover:text-brand-blue-dark"
          >
            Clear
          </button>
        </div>
        <p id="search-count" class="mt-2 text-sm text-text-secondary" aria-live="polite"></p>
      </div>

      <p id="library-error" hidden class="mt-6 border border-liturgical-red bg-cream-card p-4 text-sm text-liturgical-red" role="alert"></p>

      <p id="library-loading" class="mt-12 text-center text-text-secondary italic">
        Loading library…
      </p>

      <!-- ============== SEARCH RESULTS ============== -->
      <div id="search-results" hidden class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
      <p id="search-empty" hidden class="mt-10 text-center text-text-secondary italic">
        Nothing matched that search.
      </p>

      <!-- ============== VISITOR FLAT LIST (anonymous users) ============== -->
      <div id="visitor-grid" hidden class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
      <p id="visitor-empty" hidden class="mt-10 text-center text-text-secondary italic">
        No texts are publicly available yet.
      </p>

      <!-- ============== CATEGORY GATEWAY ============== -->
      <div
        id="category-gateway"
        hidden
        class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
        aria-label="Library categories"
      >
        {categories.map((cat) => (
          <button
            type="button"
            data-category={cat}
            class="category-tile flex flex-col items-start border border-border-soft bg-cream-card p-6 text-left shadow-sm transition-colors hover:border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-blue-dark md:p-7"
          >
            <span class="text-2xl text-sacred-gold" aria-hidden="true">☩</span>
            <h2 class="mt-3 font-display text-xl text-text-primary">{cat}</h2>
            <p class="mt-2 text-sm text-text-secondary category-count">0 texts</p>
          </button>
        ))}
        <button
          type="button"
          data-category="__all__"
          class="category-tile flex flex-col items-start border border-border-soft bg-cream-card p-6 text-left shadow-sm transition-colors hover:border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-blue-dark md:p-7"
        >
          <span class="text-2xl text-sacred-gold" aria-hidden="true">☩</span>
          <h2 class="mt-3 font-display text-xl text-text-primary">All Texts</h2>
          <p class="mt-2 text-sm text-text-secondary" id="all-count">0 texts</p>
        </button>
      </div>

      <!-- ============== CATEGORY DETAIL ============== -->
      <div id="category-detail" hidden class="mt-10">
        <button
          type="button"
          id="back-to-categories"
          class="mb-6 inline-flex items-center gap-1 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark hover:underline"
        >
          ← Back to categories
        </button>
        <h2 id="category-detail-heading" class="font-display text-2xl text-text-primary md:text-3xl">Category</h2>
        <div class="mt-6 h-px w-16 bg-liturgical-current"></div>

        <div id="library-grid" class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>

        <p id="library-empty" hidden class="mt-10 text-center text-text-secondary italic">
          No texts in this category yet.
        </p>
      </div>
    </div>
  </section>

  <script>
    type Book = {
      slug: string;
      title: string;
      author: string | null;
      category: string;
      languages: string[];
      description: string | null;
      /** True when a cleaned-up text version has been prepared. */
      has_text?: boolean;
    };

    const loadingEl = document.getElementById("library-loading") as HTMLParagraphElement;
    const errorEl = document.getElementById("library-error") as HTMLParagraphElement;
    const introParishioner = document.getElementById("intro-parishioner") as HTMLParagraphElement;
    const introVisitor = document.getElementById("intro-visitor") as HTMLParagraphElement;
    const visitorParishionerHint = document.getElementById("visitor-parishioner-hint") as HTMLParagraphElement;
    const gateway = document.getElementById("category-gateway") as HTMLDivElement;
    const detail = document.getElementById("category-detail") as HTMLDivElement;
    const detailHeading = document.getElementById("category-detail-heading") as HTMLHeadingElement;
    const grid = document.getElementById("library-grid") as HTMLDivElement;
    const emptyEl = document.getElementById("library-empty") as HTMLParagraphElement;
    const backBtn = document.getElementById("back-to-categories") as HTMLButtonElement;
    const allCountEl = document.getElementById("all-count") as HTMLParagraphElement;
    const tiles = document.querySelectorAll<HTMLButtonElement>(".category-tile");
    const visitorGrid = document.getElementById("visitor-grid") as HTMLDivElement;
    const visitorEmpty = document.getElementById("visitor-empty") as HTMLParagraphElement;
    const searchBar = document.getElementById("search-bar") as HTMLDivElement;
    const searchInput = document.getElementById("library-search") as HTMLInputElement;
    const searchClear = document.getElementById("search-clear") as HTMLButtonElement;
    const searchCount = document.getElementById("search-count") as HTMLParagraphElement;
    const searchResults = document.getElementById("search-results") as HTMLDivElement;
    const searchEmpty = document.getElementById("search-empty") as HTMLParagraphElement;

    let books: Book[] = [];
    // Whether the viewer is a signed-in parishioner decides what we
    // return to when a search is cleared: the category gateway, or the
    // visitor's flat list.
    let viewerAuthenticated = false;

    function escapeHtml(value: unknown): string {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function bookCard(book: Book): string {
      // Languages now sit with the author as a quiet line, and the space
      // they used to occupy carries the link to the cleaned-up text
      // version — the original scanned pages are always still there
      // under "Read".
      const languages = (book.languages ?? []).filter(Boolean).map(escapeHtml).join(" · ");
      const textLink = book.has_text
        ? `<a
            href="/learn/library/reader/?slug=${encodeURIComponent(book.slug)}&view=text"
            class="font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
          >Read as text →</a>
          <span class="mt-1 block text-xs text-text-secondary">Reflows to your screen; type size adjustable.</span>`
        : `<span class="text-xs italic text-text-secondary">Scanned pages — no text version.</span>`;

      return `<article
        data-category="${escapeHtml(book.category)}"
        class="library-card flex flex-col border border-border-soft bg-cream-card p-6 shadow-sm md:p-7"
      >
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">${escapeHtml(book.category)}</p>
        <h3 class="mt-2 font-display text-xl text-text-primary leading-snug">${escapeHtml(book.title)}</h3>
        <p class="mt-2 text-sm italic text-text-secondary">${escapeHtml(book.author ?? "")}</p>
        ${languages ? `<p class="mt-1 text-xs uppercase tracking-wider text-text-secondary">${languages}</p>` : ""}
        <div class="mt-4">${textLink}</div>
        <p class="mt-5 text-sm text-text-primary/85 leading-relaxed">${escapeHtml(book.description ?? "")}</p>
        <div class="mt-6 flex-grow"></div>
        <p>
          <a
            href="/learn/library/reader/?slug=${encodeURIComponent(book.slug)}"
            class="font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
          >Read original pages →</a>
        </p>
      </article>`;
    }

    function updateCounts() {
      // Per-category counts on each tile (filtered) + the All Texts total.
      tiles.forEach((tile) => {
        const cat = tile.dataset.category || "";
        if (cat === "__all__") return;
        const count = books.filter((b) => b.category === cat).length;
        const countEl = tile.querySelector(".category-count") as HTMLParagraphElement | null;
        if (countEl) countEl.textContent = `${count} ${count === 1 ? "text" : "texts"}`;
      });
      allCountEl.textContent = `${books.length} ${books.length === 1 ? "text" : "texts"}`;
    }

    function showGateway() {
      detail.hidden = true;
      gateway.hidden = false;
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function showCategory(category: string) {
      const visible = category === "__all__"
        ? books
        : books.filter((b) => b.category === category);
      const heading = category === "__all__" ? "All Texts" : category;
      detailHeading.textContent = heading;

      if (visible.length === 0) {
        grid.innerHTML = "";
        emptyEl.hidden = false;
      } else {
        emptyEl.hidden = true;
        grid.innerHTML = visible.map(bookCard).join("");
      }

      gateway.hidden = true;
      detail.hidden = false;
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function showError(message: string) {
      loadingEl.hidden = true;
      errorEl.textContent = `Could not load the library: ${message}`;
      errorEl.hidden = false;
    }

    tiles.forEach((tile) => {
      tile.addEventListener("click", () => {
        const cat = tile.dataset.category || "__all__";
        showCategory(cat);
      });
    });
    backBtn.addEventListener("click", showGateway);

    function renderVisitorFlat() {
      if (books.length === 0) {
        visitorEmpty.hidden = false;
      } else {
        visitorGrid.innerHTML = books.map(bookCard).join("");
        visitorGrid.hidden = false;
      }
    }

    // ============== SEARCH ==============
    // Fold accents and lowercase, so "Nektarios" finds "Nektários" and
    // capitalisation never matters. Punctuation becomes a space: people
    // type a book the way they'd say it — "Andreyev, Orthodox Apologetic
    // Theology" — and a trailing comma shouldn't stop the word matching.
    function normalize(value: string): string {
      return value
        .normalize("NFKD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, " ")
        .trim();
    }

    // Everything worth matching on, in one string per book.
    function haystack(book: Book): string {
      return normalize(
        [book.title, book.author ?? "", book.description ?? "", book.category, ...(book.languages ?? [])].join(" "),
      );
    }

    // Every word must appear somewhere, in any order — so "nektarios
    // life" finds the same book as "life of nektarios".
    function matches(book: Book, terms: string[]): boolean {
      const hay = haystack(book);
      return terms.every((term) => hay.includes(term));
    }

    /** How many of the words this book carries. */
    function matchScore(book: Book, terms: string[]): number {
      const hay = haystack(book);
      return terms.filter((term) => hay.includes(term)).length;
    }

    /**
     * Search results, best first, and never empty when something is
     * close.
     *
     * Requiring every word is right when it works, but it dead-ends on
     * the way people actually remember a book: "Ivan Andreyev, Orthodox
     * Apologetic Theology" finds nothing if the catalogue filed that
     * book under its title alone. So when no book carries every word,
     * fall back to the books carrying the most — which is the one being
     * looked for, nearly always.
     */
    function searchBooks(books: Book[], terms: string[]): { hits: Book[]; loosened: boolean } {
      const exact = books.filter((b) => matches(b, terms));
      if (exact.length > 0 || terms.length < 2) return { hits: exact, loosened: false };

      const scored = books
        .map((b) => ({ book: b, score: matchScore(b, terms) }))
        .filter((s) => s.score > 0);
      if (scored.length === 0) return { hits: [], loosened: false };

      // Only the closest, and only when at least two words landed. One
      // word out of four is not a near miss — it's "there" containing
      // "here", and answering a dead end with a wrong book is worse than
      // answering it with nothing.
      const best = Math.max(...scored.map((s) => s.score));
      if (best < 2) return { hits: [], loosened: false };
      return { hits: scored.filter((s) => s.score === best).map((s) => s.book), loosened: true };
    }

    function hideBrowseViews() {
      gateway.hidden = true;
      detail.hidden = true;
      visitorGrid.hidden = true;
      visitorEmpty.hidden = true;
    }

    // Back to whatever this viewer sees when they aren't searching.
    function restoreBrowseView() {
      searchResults.hidden = true;
      searchEmpty.hidden = true;
      searchCount.textContent = "";
      if (viewerAuthenticated) {
        detail.hidden = true;
        gateway.hidden = false;
      } else {
        visitorGrid.hidden = books.length === 0;
        visitorEmpty.hidden = books.length > 0;
      }
    }

    function runSearch() {
      const query = searchInput.value.trim();
      searchClear.hidden = query === "";

      if (!query) {
        restoreBrowseView();
        return;
      }

      const terms = normalize(query).split(/\s+/).filter(Boolean);
      const { hits: found, loosened } = searchBooks(books, terms);

      hideBrowseViews();
      searchCount.textContent = loosened
        ? `No text matches all of “${query}”. ${found.length} closest ${found.length === 1 ? "match" : "matches"}:`
        : `${found.length} ${found.length === 1 ? "text" : "texts"} matching “${query}”`;

      if (found.length === 0) {
        searchResults.hidden = true;
        searchResults.innerHTML = "";
        searchEmpty.hidden = false;
        return;
      }
      searchEmpty.hidden = true;
      searchResults.innerHTML = found.map(bookCard).join("");
      searchResults.hidden = false;
    }

    searchInput.addEventListener("input", runSearch);
    searchInput.addEventListener("keydown", (e) => {
      // Escape clears the search rather than only blurring the field.
      if (e.key === "Escape" && searchInput.value) {
        e.preventDefault();
        searchInput.value = "";
        runSearch();
      }
    });
    searchClear.addEventListener("click", () => {
      searchInput.value = "";
      searchInput.focus();
      runSearch();
    });

    (async () => {
      try {
        const res = await fetch("/api/library/books", { credentials: "same-origin", cache: "no-store" });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          showError(body.error ?? `HTTP ${res.status}`);
          return;
        }
        const data = await res.json();
        books = (data.books ?? []) as Book[];
        const isAuthed = !!data.viewer_authenticated;
        viewerAuthenticated = isAuthed;

        loadingEl.hidden = true;
        // Only useful once there's something to search.
        if (books.length > 0) searchBar.hidden = false;

        if (isAuthed) {
          introParishioner.hidden = false;
          gateway.hidden = false;
          updateCounts();
        } else {
          introVisitor.hidden = false;
          visitorParishionerHint.hidden = false;
          renderVisitorFlat();
        }
      } catch (err) {
        showError(err instanceof Error ? err.message : String(err));
      }
    })();
  </script>
</Layout>
