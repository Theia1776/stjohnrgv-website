---
import Layout from "../../layouts/Layout.astro";

// The page itself is static; book cards are populated at runtime
// from /api/library/books so newly-uploaded titles appear without
// a rebuild. The /learn/library middleware gates access.

// The canonical category list. Must match the admin upload
// dropdown ([src/pages/admin/library.astro]) — drift here would
// leave books invisible to the gateway because their category
// wouldn't be a known tile.
const categories = [
  "Hagiography",
  "Liturgical Texts",
  "Patristics",
  "Scripture",
  "History",
  "Theology / Doctrine",
  "Spiritual Life",
  "Other",
];
---

<Layout
  title="Parish Library | Orthodox Texts, Bayview TX"
  description="Orthodox Christian texts, patristic writings, sermons, and True Orthodoxy documents — St. John of Kronstadt Orthodox Mission, Bayview TX, Rio Grande Valley."
>
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Parish Resources</p>
      <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Parish Library</h1>
      <div class="mt-6 h-px w-24 bg-liturgical-current"></div>

      <p id="intro-parishioner" hidden class="mt-6 max-w-2xl text-text-primary/85 leading-relaxed">
        Texts for prayer and study from our parish library. Choose a category
        to browse its texts.
      </p>
      <p id="intro-visitor" hidden class="mt-6 max-w-2xl text-text-primary/85 leading-relaxed">
        A small selection of texts from our parish library, freely available
        to all visitors.
      </p>

      <p id="library-error" hidden class="mt-6 border border-liturgical-red bg-cream-card p-4 text-sm text-liturgical-red" role="alert"></p>

      <p id="library-loading" class="mt-12 text-center text-text-secondary italic">
        Loading library…
      </p>

      <!-- ============== VISITOR FLAT LIST (anonymous users) ============== -->
      <div id="visitor-grid" hidden class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
      <p id="visitor-empty" hidden class="mt-10 text-center text-text-secondary italic">
        No texts are publicly available yet.
      </p>

      <!-- ============== CATEGORY GATEWAY ============== -->
      <div
        id="category-gateway"
        hidden
        class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
        aria-label="Library categories"
      >
        {categories.map((cat) => (
          <button
            type="button"
            data-category={cat}
            class="category-tile flex flex-col items-start border border-border-soft bg-cream-card p-6 text-left shadow-sm transition-colors hover:border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-blue-dark md:p-7"
          >
            <span class="text-2xl text-sacred-gold" aria-hidden="true">☩</span>
            <h2 class="mt-3 font-display text-xl text-text-primary">{cat}</h2>
            <p class="mt-2 text-sm text-text-secondary category-count">0 texts</p>
          </button>
        ))}
        <button
          type="button"
          data-category="__all__"
          class="category-tile flex flex-col items-start border border-border-soft bg-cream-card p-6 text-left shadow-sm transition-colors hover:border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-blue-dark md:p-7"
        >
          <span class="text-2xl text-sacred-gold" aria-hidden="true">☩</span>
          <h2 class="mt-3 font-display text-xl text-text-primary">All Texts</h2>
          <p class="mt-2 text-sm text-text-secondary" id="all-count">0 texts</p>
        </button>
      </div>

      <!-- ============== CATEGORY DETAIL ============== -->
      <div id="category-detail" hidden class="mt-10">
        <button
          type="button"
          id="back-to-categories"
          class="mb-6 inline-flex items-center gap-1 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark hover:underline"
        >
          ← Back to categories
        </button>
        <h2 id="category-detail-heading" class="font-display text-2xl text-text-primary md:text-3xl">Category</h2>
        <div class="mt-6 h-px w-16 bg-liturgical-current"></div>

        <div id="library-grid" class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>

        <p id="library-empty" hidden class="mt-10 text-center text-text-secondary italic">
          No texts in this category yet.
        </p>
      </div>
    </div>
  </section>

  <script>
    type Book = {
      slug: string;
      title: string;
      author: string | null;
      category: string;
      languages: string[];
      description: string | null;
    };

    const loadingEl = document.getElementById("library-loading") as HTMLParagraphElement;
    const errorEl = document.getElementById("library-error") as HTMLParagraphElement;
    const introParishioner = document.getElementById("intro-parishioner") as HTMLParagraphElement;
    const introVisitor = document.getElementById("intro-visitor") as HTMLParagraphElement;
    const gateway = document.getElementById("category-gateway") as HTMLDivElement;
    const detail = document.getElementById("category-detail") as HTMLDivElement;
    const detailHeading = document.getElementById("category-detail-heading") as HTMLHeadingElement;
    const grid = document.getElementById("library-grid") as HTMLDivElement;
    const emptyEl = document.getElementById("library-empty") as HTMLParagraphElement;
    const backBtn = document.getElementById("back-to-categories") as HTMLButtonElement;
    const allCountEl = document.getElementById("all-count") as HTMLParagraphElement;
    const tiles = document.querySelectorAll<HTMLButtonElement>(".category-tile");
    const visitorGrid = document.getElementById("visitor-grid") as HTMLDivElement;
    const visitorEmpty = document.getElementById("visitor-empty") as HTMLParagraphElement;

    let books: Book[] = [];

    function escapeHtml(value: unknown): string {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function bookCard(book: Book): string {
      return `<article
        data-category="${escapeHtml(book.category)}"
        class="library-card flex flex-col border border-border-soft bg-cream-card p-6 shadow-sm md:p-7"
      >
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">${escapeHtml(book.category)}</p>
        <h3 class="mt-2 font-display text-xl text-text-primary leading-snug">${escapeHtml(book.title)}</h3>
        <p class="mt-2 text-sm italic text-text-secondary">${escapeHtml(book.author ?? "")}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          ${(book.languages ?? []).map((lang) => `<span class="border border-border-soft px-2 py-0.5 text-xs uppercase tracking-wider text-text-secondary">${escapeHtml(lang)}</span>`).join("")}
        </div>
        <p class="mt-5 text-sm text-text-primary/85 leading-relaxed">${escapeHtml(book.description ?? "")}</p>
        <div class="mt-6 flex-grow"></div>
        <p>
          <a
            href="/learn/library/reader/?slug=${encodeURIComponent(book.slug)}"
            class="font-display text-sm font-semibold uppercase tracking-widest text-brand-blue-dark no-underline hover:underline"
          >Read →</a>
        </p>
      </article>`;
    }

    function updateCounts() {
      // Per-category counts on each tile (filtered) + the All Texts total.
      tiles.forEach((tile) => {
        const cat = tile.dataset.category || "";
        if (cat === "__all__") return;
        const count = books.filter((b) => b.category === cat).length;
        const countEl = tile.querySelector(".category-count") as HTMLParagraphElement | null;
        if (countEl) countEl.textContent = `${count} ${count === 1 ? "text" : "texts"}`;
      });
      allCountEl.textContent = `${books.length} ${books.length === 1 ? "text" : "texts"}`;
    }

    function showGateway() {
      detail.hidden = true;
      gateway.hidden = false;
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function showCategory(category: string) {
      const visible = category === "__all__"
        ? books
        : books.filter((b) => b.category === category);
      const heading = category === "__all__" ? "All Texts" : category;
      detailHeading.textContent = heading;

      if (visible.length === 0) {
        grid.innerHTML = "";
        emptyEl.hidden = false;
      } else {
        emptyEl.hidden = true;
        grid.innerHTML = visible.map(bookCard).join("");
      }

      gateway.hidden = true;
      detail.hidden = false;
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function showError(message: string) {
      loadingEl.hidden = true;
      errorEl.textContent = `Could not load the library: ${message}`;
      errorEl.hidden = false;
    }

    tiles.forEach((tile) => {
      tile.addEventListener("click", () => {
        const cat = tile.dataset.category || "__all__";
        showCategory(cat);
      });
    });
    backBtn.addEventListener("click", showGateway);

    function renderVisitorFlat() {
      if (books.length === 0) {
        visitorEmpty.hidden = false;
      } else {
        visitorGrid.innerHTML = books.map(bookCard).join("");
        visitorGrid.hidden = false;
      }
    }

    (async () => {
      try {
        const res = await fetch("/api/library/books", { credentials: "same-origin", cache: "no-store" });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          showError(body.error ?? `HTTP ${res.status}`);
          return;
        }
        const data = await res.json();
        books = (data.books ?? []) as Book[];
        const isAuthed = !!data.viewer_authenticated;

        loadingEl.hidden = true;

        if (isAuthed) {
          introParishioner.hidden = false;
          gateway.hidden = false;
          updateCounts();
        } else {
          introVisitor.hidden = false;
          renderVisitorFlat();
        }
      } catch (err) {
        showError(err instanceof Error ? err.message : String(err));
      }
    })();
  </script>
</Layout>
