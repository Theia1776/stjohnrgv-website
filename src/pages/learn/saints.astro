---
import Layout from "../../layouts/Layout.astro";

interface Saint {
  name: string;
  slug: string;
  feasts: string[];
  life: string;
  attribution: string;
  troparion: string;
  kontakion: string;
  iconSlug: string;
}

interface Entry {
  /** Index into the master `saints` array — used by the modal opener. */
  idx: number;
  name: string;
  /** Display feast text for the panel: a single fixed date for month
   *  panels, or all of the saint's movable feasts joined for the
   *  movable panel. */
  feast: string;
  /** For sorting fixed entries within a month. -1 if not applicable. */
  day: number;
}

const MONTHS = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const MOVABLE_TOKEN_RE = /\b(?:sunday|monday|tuesday|wednesday|thursday|friday|saturday|pascha)\b/i;

function classifyFeast(feast: string): { kind: "fixed"; month: number; day: number } | { kind: "movable" } {
  // Movable wins when any weekday/pascha word appears, even if a
  // month name happens to be in the string too.
  if (MOVABLE_TOKEN_RE.test(feast)) return { kind: "movable" };
  // Plain "Month Day" pattern — case-insensitive, allows "April 1" /
  // "April 1." / "April 1, 2020" but not "April 1st" with ordinal
  // suffix (rare in this dataset; flag if it shows up).
  const m = /^([A-Za-z]+)\s+(\d{1,2})\b/.exec(feast.trim());
  if (m) {
    const monthIdx = MONTHS.findIndex((n) => n.toLowerCase() === m[1].toLowerCase());
    if (monthIdx >= 0) return { kind: "fixed", month: monthIdx, day: parseInt(m[2], 10) };
  }
  // Catch-all: anything that isn't recognizable as fixed (e.g. "Day
  // of the Holy Spirit") falls into Movable Feasts so it doesn't
  // disappear from the catalog.
  return { kind: "movable" };
}

// Load + sort all saints alphabetically.
const saintModules = import.meta.glob<{ default: Saint }>(
  "../../data/saints/*.json",
  { eager: true },
);
const saints: Saint[] = Object.values(saintModules)
  .map((m) => m.default)
  .sort((a, b) => a.name.localeCompare(b.name));

// Build month buckets and movable bucket. A saint with both a fixed
// and a movable feast appears in both buckets.
const monthBuckets: Entry[][] = MONTHS.map(() => []);
const movableBucket: Entry[] = [];

saints.forEach((saint, idx) => {
  const movableFeasts: string[] = [];
  saint.feasts.forEach((feast) => {
    const c = classifyFeast(feast);
    if (c.kind === "fixed") {
      monthBuckets[c.month].push({ idx, name: saint.name, feast, day: c.day });
    } else {
      movableFeasts.push(feast);
    }
  });
  if (movableFeasts.length > 0) {
    movableBucket.push({
      idx,
      name: saint.name,
      feast: movableFeasts.join(" · "),
      day: -1,
    });
  }
});

// Sort: fixed entries by day-of-month then name; movable by name.
monthBuckets.forEach((b) =>
  b.sort((a, b) => (a.day - b.day) || a.name.localeCompare(b.name)),
);
movableBucket.sort((a, b) => a.name.localeCompare(b.name));

const totalCount = saints.length;
const movableCount = movableBucket.length;

// Inline saint data for client-side search + modal. Escape `<` so any
// "</script>" fragment inside a saint life can't break out of the tag.
const saintsJson = JSON.stringify(saints).replace(/</g, "\\u003c");
---

<Layout
  title="Saints | St. John of Kronstadt Orthodox Mission"
  description="A searchable encyclopedia of saints commemorated at St. John of Kronstadt Orthodox Mission, Bayview TX. Browse by month or movable feast."
>
  <section class="mx-auto max-w-5xl px-4 py-16 md:py-20">

    <!-- Page heading — full-width centered above the two columns. -->
    <div class="text-center">
      <h1 class="font-display text-3xl text-text-primary md:text-4xl">
        Comprehensive Catalog of Saints / Martyrs
      </h1>
      <div class="mx-auto mt-4 h-px w-24 bg-liturgical-current"></div>
    </div>

    <!-- Two columns below the heading: encyclopedia paragraph on the
         left, app-store call-to-action centered on the right. With the
         heading lifted out of the left column, both columns now start
         at the same y-position so the prompt sits inline with the
         opening line of the paragraph. -->
    <div class="mt-10 grid gap-8 md:grid-cols-2 md:gap-12">
      <!-- Left column: acknowledgement paragraph. -->
      <div>
        <p class="text-base leading-relaxed text-text-primary/85">
          An encyclopedia of saints commemorated in our parish. With deep
          gratitude to David Leselidze and
          <a
            href="https://www.holytrinityorthodox.com/htc/orthodox-calendar/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-blue-dark hover:underline"
          >Holy Trinity Orthodox Mission</a>
          for graciously permitting our parish to embed and source from
          their calendar to draw a comprehensive database of saints&apos;
          lives for the private use of our parish. Our catalog of
          <span id="saints-count">{totalCount.toLocaleString()}</span>
          saints would not exist without their generosity.
        </p>
      </div>

      <!-- Right column: centered app-store call-to-action.
           Badges hotlinked from Google's and Apple's brand-asset URLs
           (intended for that use per each platform's marketing
           guidelines).

           Google PNG stays at h-[68px] — the size that finally reads
           correctly given the badge's ~8% internal whitespace padding.
           Apple SVG drops to h-12 (48px) so the two badges read at a
           similar visible weight side by side; the SVG has no padding
           so its bounding box equals its visible art. The CSS heights
           are intentionally different — equal CSS height = unequal
           visible badges, which is the trap we kept falling into. -->
      <div class="text-center">
        <p class="text-sm font-bold leading-relaxed text-brand-blue-dark">
          Take the Orthodox Calendar with you wherever you go &mdash; download the official app:
        </p>
        <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
          <a
            href="https://play.google.com/store/apps/details?id=com.holytrinityorthodox.orthodoxcalendar&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Get the Orthodox Calendar on Google Play"
          >
            <img
              src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
              alt="Get it on Google Play"
              class="h-[68px] w-auto"
            />
          </a>
          <a
            href="https://apps.apple.com/us/app/orthodox-calendar/id381641703"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download the Orthodox Calendar on the App Store"
          >
            <img
              src="https://developer.apple.com/app-store/marketing/guidelines/images/badge-download-on-the-app-store.svg"
              alt="Download on the App Store"
              class="h-12 w-auto"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Search bar (full container width below the header) -->
    <div class="mt-10 mx-auto max-w-3xl">
      <label class="block">
        <span class="sr-only">Search saints</span>
        <input
          id="saints-search"
          type="search"
          placeholder="Search saints..."
          autocomplete="off"
          class="block w-full border border-text-secondary bg-cream-card px-4 py-3 text-base text-text-primary placeholder:text-text-secondary focus:outline-none"
        />
      </label>
    </div>

    <!-- ============== SEARCH RESULTS (only shown when search has text) ============== -->
    <div id="search-results" hidden class="mt-10"></div>

    <!-- ============== MONTH VIEW (default) ============== -->
    <div id="month-view" class="mt-10">

      <!-- Month tile grid (now sits directly under the search bar):
           3×4 on lg, scaling down responsively. -->
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {MONTHS.map((monthName, i) => {
          const count = monthBuckets[i].length;
          const empty = count === 0;
          return (
            <button
              type="button"
              data-tile={String(i)}
              aria-expanded="false"
              aria-controls={`panel-${i}`}
              class={[
                "flex flex-col items-center justify-center border bg-cream-card px-4 py-5 shadow-sm transition-colors focus:outline-none",
                empty
                  ? "cursor-not-allowed border-border-soft opacity-50"
                  : "border-brand-tan hover:border-brand-tan-dark focus:border-brand-tan-dark aria-expanded:border-brand-blue-dark aria-expanded:bg-brand-blue-pale",
              ].join(" ")}
              disabled={empty}
            >
              <span class="font-display text-lg text-text-primary">{monthName}</span>
              <span class="mt-1 text-xs text-text-secondary">
                {count} {count === 1 ? "saint" : "saints"}
              </span>
            </button>
          );
        })}
      </div>

      <!-- Movable Feasts tile — centered, sits below the months grid. -->
      <div class="mt-6 mx-auto max-w-md">
        <button
          type="button"
          data-tile="movable"
          aria-expanded="false"
          aria-controls="panel-movable"
          class="group flex w-full flex-col items-center justify-center border-2 border-brand-tan bg-cream-card px-6 py-5 shadow-sm transition-colors hover:border-brand-tan-dark focus:border-brand-tan-dark focus:outline-none aria-expanded:border-brand-blue-dark aria-expanded:bg-brand-blue-pale"
          disabled={movableCount === 0}
        >
          <span class="font-display text-xl text-text-primary">Movable Feasts</span>
          <span class="mt-1 text-xs text-text-secondary">
            {movableCount} {movableCount === 1 ? "saint" : "saints"}
          </span>
        </button>
      </div>

      <!-- Panel area: a single panel slot whose content swaps on tile
           click. We render all panels with hidden=true at build time
           and toggle the visible one in JS. -->
      <div id="panel-area" class="mt-8">

        {movableCount > 0 && (
          <div id="panel-movable" data-panel hidden class="border border-brand-tan bg-cream-card p-6 shadow-sm">
            <h2 class="font-display text-2xl text-text-primary">Movable Feasts</h2>
            <div class="mt-3 h-px w-16 bg-liturgical-current"></div>
            <ul class="mt-5 divide-y divide-border-soft border-y border-border-soft">
              {movableBucket.map((e) => (
                <li class="py-3">
                  <button
                    type="button"
                    data-saint-index={e.idx}
                    class="block w-full text-left focus:outline-none"
                  >
                    <span class="font-display text-text-primary hover:underline">{e.name}</span>
                    <span class="block text-sm text-text-secondary">{e.feast}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}

        {monthBuckets.map((entries, i) => entries.length > 0 && (
          <div id={`panel-${i}`} data-panel hidden class="border border-brand-tan bg-cream-card p-6 shadow-sm">
            <h2 class="font-display text-2xl text-text-primary">{MONTHS[i]}</h2>
            <div class="mt-3 h-px w-16 bg-liturgical-current"></div>
            <ul class="mt-5 divide-y divide-border-soft border-y border-border-soft">
              {entries.map((e) => (
                <li class="py-3">
                  <button
                    type="button"
                    data-saint-index={e.idx}
                    class="block w-full text-left focus:outline-none"
                  >
                    <span class="font-display text-text-primary hover:underline">{e.name}</span>
                    <span class="block text-sm text-text-secondary">{e.feast}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== SAINT MODAL ============== -->
  <div
    id="saint-modal"
    class="hidden fixed inset-0 z-[60] overflow-y-auto bg-text-primary/60 p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="saint-modal-title"
  >
    <div id="saint-modal-panel" class="mx-auto max-w-2xl border border-brand-tan bg-cream-card p-6 shadow-lg md:p-8">
      <button
        id="saint-modal-close"
        type="button"
        aria-label="Close"
        class="float-right -mr-1 -mt-1 font-display text-2xl leading-none text-text-secondary hover:text-text-primary"
      >×</button>
      <h3 id="saint-modal-title" class="mb-1 pr-8 font-display text-xl font-bold text-brand-blue"></h3>
      <p id="saint-modal-feasts" class="mb-4 text-sm italic text-text-secondary"></p>
      <div id="saint-modal-body" class="space-y-4 leading-relaxed"></div>
    </div>
  </div>

  <!-- Saints data baked in for client-side search + modal -->
  <script type="application/json" id="saints-data" is:inline set:html={saintsJson}></script>

  <script is:inline>
    const saints = JSON.parse(document.getElementById("saints-data").textContent);

    // ============================================================
    // Helpers
    // ============================================================
    function escapeHtml(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    // ============================================================
    // Tile / panel toggle (only one panel open at a time)
    // ============================================================
    const monthView = document.getElementById("month-view");
    const panels = Array.from(monthView.querySelectorAll("[data-panel]"));
    const tiles = Array.from(monthView.querySelectorAll("[data-tile]"));
    let activeTile = null;

    function closeAllPanels() {
      panels.forEach((p) => { p.hidden = true; });
      tiles.forEach((t) => t.setAttribute("aria-expanded", "false"));
      activeTile = null;
    }

    function openPanel(which) {
      const panelId = which === "movable" ? "panel-movable" : `panel-${which}`;
      const panel = document.getElementById(panelId);
      if (!panel) return;
      panels.forEach((p) => { p.hidden = (p !== panel); });
      tiles.forEach((t) => {
        t.setAttribute("aria-expanded", t.dataset.tile === which ? "true" : "false");
      });
      activeTile = which;
      // Smooth scroll the panel into view.
      panel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    monthView.addEventListener("click", (e) => {
      const tile = e.target.closest("[data-tile]");
      if (!tile || tile.disabled) return;
      const which = tile.dataset.tile;
      if (activeTile === which) {
        closeAllPanels();
      } else {
        openPanel(which);
      }
    });

    // ============================================================
    // Search — hides month view, renders flat results list
    // ============================================================
    const searchEl = document.getElementById("saints-search");
    const searchResults = document.getElementById("search-results");

    function renderSearchResults(q) {
      const matches = saints
        .map((s, idx) => ({ s, idx }))
        .filter(({ s }) =>
          (s.name + " " + s.feasts.join(" ")).toLowerCase().includes(q),
        );

      if (matches.length === 0) {
        searchResults.innerHTML = `
          <p class="text-center italic text-text-secondary">
            No saints found matching your search.
          </p>
        `;
        return;
      }

      const items = matches.map(({ s, idx }) => `
        <li class="py-3">
          <button
            type="button"
            data-saint-index="${idx}"
            class="block w-full text-left focus:outline-none"
          >
            <span class="font-display text-text-primary hover:underline">${escapeHtml(s.name)}</span>
            <span class="block text-sm text-text-secondary">${escapeHtml(s.feasts.join(" · "))}</span>
          </button>
        </li>
      `).join("");

      const noun = matches.length === 1 ? "result" : "results";
      searchResults.innerHTML = `
        <p class="mb-4 text-sm text-text-secondary">${matches.length} ${noun} matching &ldquo;${escapeHtml(q)}&rdquo;</p>
        <ul class="divide-y divide-border-soft border-y border-border-soft">${items}</ul>
      `;
    }

    searchEl.addEventListener("input", () => {
      const q = searchEl.value.trim().toLowerCase();
      if (!q) {
        // Clear search → restore month grid, hide results
        searchResults.hidden = true;
        searchResults.innerHTML = "";
        monthView.hidden = false;
        return;
      }
      // Search active → hide month grid, show results (and close any
      // open panel state so re-clearing search reverts cleanly)
      closeAllPanels();
      monthView.hidden = true;
      searchResults.hidden = false;
      renderSearchResults(q);
    });

    // ============================================================
    // Modal
    // ============================================================
    const modal = document.getElementById("saint-modal");
    const modalPanel = document.getElementById("saint-modal-panel");
    const modalTitle = document.getElementById("saint-modal-title");
    const modalFeasts = document.getElementById("saint-modal-feasts");
    const modalBody = document.getElementById("saint-modal-body");
    const modalClose = document.getElementById("saint-modal-close");

    function openModal(idx) {
      const saint = saints[idx];
      if (!saint) return;

      modalTitle.textContent = saint.name || "";

      const feastText = (saint.feasts && saint.feasts.length)
        ? "Commemorated on " + saint.feasts.join(" · ")
        : "";
      modalFeasts.textContent = feastText;
      modalFeasts.hidden = !feastText;

      const parts = [];
      if (saint.life && saint.life.trim()) {
        parts.push(`<div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(saint.life)}</div>`);
      } else {
        // Bio-pending placeholder card — styled to match the saint
        // catalog's other cards (cream surface, sacred-gold accent
        // border + cross icon, text-primary copy). Surfaces honestly
        // that the entry exists but the biographical text is still
        // being sourced.
        parts.push(`
          <div class="border-2 border-sacred-gold bg-cream-card p-6 text-center">
            <div aria-hidden="true" class="mb-3 text-4xl text-sacred-gold">☩</div>
            <p class="font-display text-text-primary leading-relaxed">
              We don&apos;t currently have biographical information for
            </p>
            <p class="mt-2 font-display text-lg font-semibold text-text-primary leading-tight">
              ${escapeHtml(saint.name || "this saint")}.
            </p>
            <p class="mt-3 text-sm italic text-text-secondary">
              We&apos;re working to source and add it &mdash; thank you for your patience.
            </p>
          </div>
        `);
      }
      if (saint.troparion && saint.troparion.trim()) {
        parts.push(`
          <div class="border-t border-border-soft pt-4">
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Troparion</p>
            <div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(saint.troparion)}</div>
          </div>
        `);
      }
      if (saint.kontakion && saint.kontakion.trim()) {
        parts.push(`
          <div class="border-t border-border-soft pt-4">
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Kontakion</p>
            <div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(saint.kontakion)}</div>
          </div>
        `);
      }
      // Only show per-card attribution when it's an actual copyright /
      // translator credit (starts with © / Copyright). The generic
      // "Holy Trinity Orthodox Mission, holytrinityorthodox.com"
      // fallback we set during import — and any "unknown" placeholder —
      // are covered by the page-level acknowledgement above and would
      // be redundant noise on every card.
      const a = (saint.attribution || "").trim();
      if (a && /^(©|\(c\)|copyright)/i.test(a)) {
        parts.push(`<p class="mt-4 text-xs italic text-text-secondary">${escapeHtml(a)}</p>`);
      }
      modalBody.innerHTML = parts.join("");

      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      modalClose.focus();
    }

    function closeModal() {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    modal.addEventListener("click", (e) => {
      if (!modalPanel.contains(e.target)) closeModal();
    });
    modalClose.addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
    });

    // Saint-name click → open modal. Single delegated listener catches
    // clicks inside month/movable panels AND inside search results.
    document.addEventListener("click", (e) => {
      const target = e.target.closest("[data-saint-index]");
      if (!target) return;
      const idx = parseInt(target.dataset.saintIndex, 10);
      if (Number.isFinite(idx)) openModal(idx);
    });
  </script>
</Layout>
