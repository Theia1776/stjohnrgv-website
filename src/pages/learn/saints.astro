---
import Layout from "../../layouts/Layout.astro";

interface Saint {
  name: string;
  slug: string;
  feasts: string[];
  life: string;
  attribution: string;
  troparion: string;
  kontakion: string;
  iconSlug: string;
}

// Load every saint JSON at build time and sort alphabetically by name.
// Astro 6 removed Astro.glob; use Vite's import.meta.glob with
// `eager: true` so the JSON contents land here synchronously rather
// than as lazy-loaders.
const saintModules = import.meta.glob<{ default: Saint }>(
  "../../data/saints/*.json",
  { eager: true },
);
const saints: Saint[] = Object.values(saintModules)
  .map((m) => m.default)
  .sort((a, b) => a.name.localeCompare(b.name));

const count = saints.length;

// Inline the saints array as JSON in a <script type="application/json">
// tag so the client-side modal can read full life/troparion/kontakion
// without round-trips. Escaping `<` blocks any "</script>" sequence
// inside saint life text from breaking out of the tag.
const saintsJson = JSON.stringify(saints).replace(/</g, "\\u003c");
---

<Layout
  title="Saints | St. John of Kronstadt Orthodox Mission"
  description="A growing encyclopedia of the saints commemorated in our parish. Browse and search the Orthodox calendar."
>
  <section class="mx-auto max-w-5xl px-4 py-16 md:py-20">

    <!-- Header -->
    <div class="mx-auto max-w-3xl">
      <p class="mb-2 font-display text-xs uppercase tracking-widest text-brand-tan-dark">Our Canonical Calendar</p>
      <h1 class="font-display text-3xl text-text-primary md:text-4xl">Saints</h1>
      <div class="mt-6 h-px w-24 bg-liturgical-current"></div>
      <p class="mt-6 text-lg leading-relaxed text-text-primary/85">
        A growing encyclopedia of the saints commemorated in our parish.
        New entries are added daily.
      </p>
      <p class="mt-2 text-sm text-text-secondary">
        <span id="saints-count">{count}</span> saints in the database
      </p>

      <!-- Search -->
      <div class="mt-8">
        <label class="block">
          <span class="sr-only">Search saints</span>
          <input
            id="saints-search"
            type="search"
            placeholder="Search saints..."
            autocomplete="off"
            class="block w-full border border-text-secondary bg-cream-card px-4 py-3 text-base text-text-primary placeholder:text-text-secondary focus:outline-none"
          />
        </label>
      </div>
    </div>

    <!-- Empty state -->
    <p id="saints-empty" hidden class="mt-12 text-center italic text-text-secondary">
      No saints found matching your search.
    </p>

    <!-- Saints grid -->
    <div id="saints-grid" class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {saints.map((s, i) => (
        <article
          class="flex cursor-pointer flex-col border border-brand-tan bg-cream-card p-6 shadow-sm transition-colors hover:border-brand-tan-dark focus:border-brand-tan-dark focus:outline-none"
          tabindex="0"
          role="button"
          aria-label={`Read about ${s.name}`}
          data-saint-card
          data-saint-index={i}
          data-search={(s.name + " " + s.feasts.join(" ")).toLowerCase()}
        >
          <h3 class="font-display text-base font-bold leading-snug text-text-primary">{s.name}</h3>
          {s.feasts.length > 0 && (
            <p class="mt-3 text-sm text-text-secondary">{s.feasts.join(" · ")}</p>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ============== SAINT MODAL ============== -->
  <!-- Same shape as the calendar's reading modal: backdrop click,
       × button, and Esc all close. -->
  <div
    id="saint-modal"
    class="hidden fixed inset-0 z-[60] overflow-y-auto bg-text-primary/60 p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="saint-modal-title"
  >
    <div id="saint-modal-panel" class="mx-auto max-w-2xl border border-brand-tan bg-cream-card p-6 shadow-lg md:p-8">
      <button
        id="saint-modal-close"
        type="button"
        aria-label="Close"
        class="float-right -mr-1 -mt-1 font-display text-2xl leading-none text-text-secondary hover:text-text-primary"
      >×</button>
      <h3 id="saint-modal-title" class="mb-1 pr-8 font-display text-xl font-bold text-brand-blue"></h3>
      <p id="saint-modal-feasts" class="mb-4 text-sm italic text-text-secondary"></p>
      <div id="saint-modal-body" class="space-y-4 leading-relaxed"></div>
    </div>
  </div>

  <!-- Saints data baked into the page as JSON. The modal pulls
       full life / troparion / kontakion from here without a round-trip. -->
  <script type="application/json" id="saints-data" is:inline set:html={saintsJson}></script>

  <script is:inline>
    const saints = JSON.parse(document.getElementById("saints-data").textContent);

    // ============================================================
    // SEARCH — client-only filter on data-search attribute.
    // ============================================================
    const searchEl = document.getElementById("saints-search");
    const grid = document.getElementById("saints-grid");
    const emptyEl = document.getElementById("saints-empty");
    const cards = Array.from(grid.querySelectorAll("[data-saint-card]"));

    function filterCards() {
      const q = searchEl.value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const haystack = card.dataset.search || "";
        const match = !q || haystack.includes(q);
        card.hidden = !match;
        if (match) visible++;
      }
      emptyEl.hidden = visible > 0;
    }
    searchEl.addEventListener("input", filterCards);

    // ============================================================
    // MODAL
    // ============================================================
    const modal = document.getElementById("saint-modal");
    const modalPanel = document.getElementById("saint-modal-panel");
    const modalTitle = document.getElementById("saint-modal-title");
    const modalFeasts = document.getElementById("saint-modal-feasts");
    const modalBody = document.getElementById("saint-modal-body");
    const modalClose = document.getElementById("saint-modal-close");

    function escapeHtml(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function openModal(idx) {
      const saint = saints[idx];
      if (!saint) return;

      modalTitle.textContent = saint.name || "";

      const feastText = (saint.feasts && saint.feasts.length)
        ? "Commemorated on " + saint.feasts.join(" · ")
        : "";
      modalFeasts.textContent = feastText;
      modalFeasts.hidden = !feastText;

      const parts = [];
      if (saint.life && saint.life.trim()) {
        parts.push(`<div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(saint.life)}</div>`);
      } else {
        parts.push('<p class="italic text-text-secondary">No biography available.</p>');
      }
      if (saint.troparion && saint.troparion.trim()) {
        parts.push(`
          <div class="border-t border-border-soft pt-4">
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Troparion</p>
            <div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(saint.troparion)}</div>
          </div>
        `);
      }
      if (saint.kontakion && saint.kontakion.trim()) {
        parts.push(`
          <div class="border-t border-border-soft pt-4">
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Kontakion</p>
            <div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(saint.kontakion)}</div>
          </div>
        `);
      }
      if (saint.attribution && saint.attribution.trim()) {
        parts.push(`<p class="mt-4 text-xs italic text-text-secondary">${escapeHtml(saint.attribution)}</p>`);
      }
      modalBody.innerHTML = parts.join("");

      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      // Focus close button so Esc works immediately and screen-reader
      // users land in the dialog.
      modalClose.focus();
    }

    function closeModal() {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    modal.addEventListener("click", (e) => {
      if (!modalPanel.contains(e.target)) closeModal();
    });
    modalClose.addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
    });

    // Card click + keyboard activation
    grid.addEventListener("click", (e) => {
      const card = e.target.closest("[data-saint-card]");
      if (!card) return;
      const idx = parseInt(card.dataset.saintIndex, 10);
      openModal(idx);
    });
    grid.addEventListener("keydown", (e) => {
      const card = e.target.closest("[data-saint-card]");
      if (!card) return;
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const idx = parseInt(card.dataset.saintIndex, 10);
        openModal(idx);
      }
    });
  </script>
</Layout>
