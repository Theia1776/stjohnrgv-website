---
import Layout from "../../../layouts/Layout.astro";

// Single static reader page for the parish library. Takes the book's
// slug from a `?slug=` query param and populates the header + PDF
// viewer at runtime, so any book in the library_books table works
// without a per-slug rebuild. The /learn/library middleware gates
// access; the PDF itself is served via a 60-second signed URL from
// /api/library/pdf.
---

<Layout
  title="Parish Library Reader | St. John of Kronstadt"
  description="Read texts from the parish digital library."
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <!-- Reader-only theming. The site has light/dark mode but the reader
       always uses a dark frame so the white PDF pages pop. The toolbar
       and breadcrumb stay in the site's regular theme above. -->
  <style is:global>
    .pdf-stage { background: #1d1f23; }
    /* Every hit is marked; the one you're on is marked more strongly. */
    #text-body mark {
      background: var(--color-brand-blue-pale);
      color: var(--color-text-primary);
      padding: 0 0.1em;
    }
    #text-body mark.find-current {
      background: var(--color-sacred-gold);
      color: #2C2828;
    }
    .pdf-page-canvas {
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
      display: block;
      margin: 0 auto;
    }
  </style>

  <!-- ============== HEADER + TOOLBAR ============== -->
  <section class="bg-cream-bg">
    <div class="mx-auto max-w-6xl px-4 pt-10 pb-6 md:px-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">
        <a href="/learn/library/" class="text-brand-tan-dark no-underline hover:underline">
          ← Parish Library
        </a>
      </p>
      <h1 id="book-title" class="mt-2 font-display text-2xl text-text-primary md:text-3xl">Loading…</h1>
      <p id="book-author" class="mt-2 text-sm italic text-text-secondary"></p>
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-4 md:px-6">
      <div
        class="flex flex-wrap items-center gap-3 border border-border-soft bg-cream-card p-3 shadow-sm md:gap-4 md:p-4"
        role="toolbar"
        aria-label="Reader controls"
      >
        <!-- Mode toggle -->
        <div role="group" aria-label="View mode" class="flex">
          <button
            id="mode-scroll"
            type="button"
            aria-pressed="true"
            class="border border-brand-blue-dark bg-brand-blue-dark px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-cream-card"
          >
            Scroll
          </button>
          <button
            id="mode-book"
            type="button"
            aria-pressed="false"
            class="border border-brand-blue-dark border-l-0 bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark"
          >
            Book
          </button>
          <button
            id="mode-text"
            type="button"
            aria-pressed="false"
            class="border border-brand-blue-dark border-l-0 bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark"
          >
            Text
          </button>
        </div>

        <!-- Back to the top of the book. The floating arrow does this
             too, but it only appears once you've scrolled and it sits in
             the corner; deep in a 400-page book you want it where your
             eyes already are. -->
        <button
          type="button"
          id="to-top"
          class="border border-border-soft bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-text-primary hover:text-brand-blue-dark"
        >
          ↑ Top
        </button>

        <!-- Why the Text button is greyed out, said plainly rather than
             left to a hover tooltip nobody finds. -->
        <span id="no-text-note" hidden class="text-xs italic text-text-secondary">
          Scanned pages — no text version to search.
        </span>

        <!-- Type size, for the text view only. -->
        <div id="text-size-controls" hidden role="group" aria-label="Text size" class="flex items-center gap-2">
          <button
            type="button"
            id="text-smaller"
            class="border border-border-soft bg-cream-card px-2.5 py-1.5 font-display text-xs font-semibold text-text-primary"
            aria-label="Smaller text"
          >A&minus;</button>
          <button
            type="button"
            id="text-larger"
            class="border border-border-soft bg-cream-card px-2.5 py-1.5 font-display text-xs font-semibold text-text-primary"
            aria-label="Larger text"
          >A+</button>
        </div>

        <!-- Pager -->
        <div class="ml-auto flex items-center gap-2">
          <button
            id="pager-prev"
            type="button"
            class="border border-border-soft bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-text-primary disabled:cursor-not-allowed disabled:opacity-40"
          >
            ← Prev
          </button>
          <span
            id="pager-status"
            class="font-display text-xs uppercase tracking-widest text-text-secondary"
            aria-live="polite"
          >
            Loading…
          </span>
          <button
            id="pager-next"
            type="button"
            class="border border-border-soft bg-cream-card px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-text-primary disabled:cursor-not-allowed disabled:opacity-40"
          >
            Next →
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== TEXT STAGE ==============
       The cleaned-up text version: the same book, reflowing, sized to
       taste, on the site's normal cream background rather than the dark
       PDF frame. Fed by /api/library/text. -->
  <section id="text-stage" hidden class="bg-cream-bg">
    <div class="mx-auto max-w-3xl px-4 py-10 md:px-6 md:py-14">
      <!-- Find within the book. The page views are canvases — there is
           no text in them for the browser's own Ctrl+F to catch — so the
           text view carries its own search. -->
      <!-- Sticks below the site header while you read. Jumping to a
           match 300 pages down is no use if Next is still at the top of
           the book. top-[73px] clears the header (69px tall, offset 4px
           from the top). -->
      <div id="find-bar" hidden class="sticky top-[73px] z-30 mb-6 flex flex-wrap items-center gap-2 border border-border-soft bg-cream-card p-3 shadow-sm">
        <label for="find-input" class="sr-only">Find in this book</label>
        <input
          id="find-input"
          type="search"
          autocomplete="off"
          placeholder="Find in this book…"
          class="min-w-0 flex-1 border border-border-soft bg-cream-bg px-3 py-2 text-sm text-text-primary placeholder:text-text-secondary focus:outline-none focus:ring-2"
        />
        <span id="find-count" class="px-1 text-sm text-text-secondary" aria-live="polite"></span>
        <button type="button" id="find-prev" class="border border-border-soft bg-cream-bg px-3 py-2 font-display text-xs font-semibold uppercase tracking-widest text-text-primary disabled:opacity-40" disabled>Prev</button>
        <button type="button" id="find-next" class="border border-border-soft bg-cream-bg px-3 py-2 font-display text-xs font-semibold uppercase tracking-widest text-text-primary disabled:opacity-40" disabled>Next</button>
      </div>

      <p id="text-loading" class="text-center font-display text-sm uppercase tracking-widest text-text-secondary">
        Loading text…
      </p>
      <p
        id="text-unavailable"
        hidden
        class="mx-auto max-w-xl border border-brand-tan bg-cream-card p-5 text-center text-sm text-text-primary/85"
      ></p>
      <div
        id="text-body"
        hidden
        class="mx-auto max-w-2xl whitespace-pre-wrap text-text-primary/90"
        style="font-size: 1.05rem; line-height: 1.8;"
      ></div>
    </div>
  </section>

  <!-- ============== READER STAGE ============== -->
  <section id="pdf-stage-section" class="pdf-stage">
    <div
      id="pdf-viewer"
      class="mx-auto min-h-[60vh] max-w-6xl px-4 py-8 md:px-6 md:py-12"
    >
      <p id="pdf-loading" class="text-center font-display text-sm uppercase tracking-widest text-cream-card/70">
        Loading text…
      </p>
      <p
        id="pdf-error"
        hidden
        role="alert"
        class="mx-auto max-w-md border border-liturgical-red bg-cream-card p-4 text-center text-sm text-liturgical-red"
      ></p>
    </div>
  </section>

  <!-- PDF.js — pinned to 3.11.174 -->
  <script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
  ></script>

  <script>
    // PDF.js attaches itself as window.pdfjsLib. Declare a typed shim so
    // TypeScript stops complaining; the actual API surface is documented
    // at https://mozilla.github.io/pdf.js/api/.
    interface PDFViewport { width: number; height: number; }
    interface PDFPage {
      getViewport(opts: { scale: number }): PDFViewport;
      render(opts: { canvasContext: CanvasRenderingContext2D; viewport: PDFViewport }): { promise: Promise<void> };
    }
    interface PDFDocument {
      numPages: number;
      getPage(n: number): Promise<PDFPage>;
    }
    interface PDFJSLib {
      GlobalWorkerOptions: { workerSrc: string };
      getDocument(opts: { url: string } | string): { promise: Promise<PDFDocument> };
    }
    const pdfjsLib = (window as unknown as { pdfjsLib: PDFJSLib }).pdfjsLib;

    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

    type Book = {
      slug: string;
      title: string;
      author: string | null;
      category: string;
      languages: string[];
      description: string | null;
      pdf_storage_key: string;
      /** Whether a cleaned-up text version exists for this book. */
      has_text?: boolean;
      /** Staging books are visible to admins only. */
      hidden?: boolean;
    };

    const viewer = document.getElementById("pdf-viewer") as HTMLDivElement;
    const loadingEl = document.getElementById("pdf-loading") as HTMLParagraphElement;
    const errorEl = document.getElementById("pdf-error") as HTMLParagraphElement;
    const titleEl = document.getElementById("book-title") as HTMLHeadingElement;
    const authorEl = document.getElementById("book-author") as HTMLParagraphElement;
    const modeScrollBtn = document.getElementById("mode-scroll") as HTMLButtonElement;
    const modeBookBtn = document.getElementById("mode-book") as HTMLButtonElement;
    const modeTextBtn = document.getElementById("mode-text") as HTMLButtonElement;
    const textStage = document.getElementById("text-stage") as HTMLElement;
    const pdfStage = document.getElementById("pdf-stage-section") as HTMLElement;
    const textBody = document.getElementById("text-body") as HTMLDivElement;
    const textLoading = document.getElementById("text-loading") as HTMLParagraphElement;
    const textUnavailable = document.getElementById("text-unavailable") as HTMLParagraphElement;
    const textSizeControls = document.getElementById("text-size-controls") as HTMLDivElement;
    const prevBtn = document.getElementById("pager-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("pager-next") as HTMLButtonElement;
    const statusEl = document.getElementById("pager-status") as HTMLSpanElement;

    type Mode = "scroll" | "book" | "text";
    let mode: Mode = "scroll";
    let pdf: PDFDocument | null = null;
    let currentPage = 1;
    let currentSlug = "";
    // Fetched once per book, then kept — flipping between views should
    // not re-download it.
    let textLoaded = false;
    // Remembered across books and visits, so a reader who needs larger
    // type sets it once.
    const TEXT_SIZE_KEY = "htoc-reader-text-size";
    let textSize = Number(localStorage.getItem(TEXT_SIZE_KEY) || "1.05");
    // Cache rendered scroll-mode canvases so toggling modes doesn't
    // re-render every page.
    const scrollCanvases = new Map<number, HTMLCanvasElement>();

    function showError(msg: string) {
      loadingEl.hidden = true;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }

    function setStatus() {
      if (!pdf) {
        statusEl.textContent = "Loading…";
        return;
      }
      if (mode === "scroll") {
        statusEl.textContent = `Page ${currentPage} of ${pdf.numPages}`;
      } else {
        const left = currentPage;
        const right = Math.min(currentPage + 1, pdf.numPages);
        statusEl.textContent =
          left === right
            ? `Page ${left} of ${pdf.numPages}`
            : `Pages ${left}-${right} of ${pdf.numPages}`;
      }
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled =
        mode === "scroll"
          ? currentPage >= pdf.numPages
          : currentPage + 1 > pdf.numPages;
    }

    async function renderToCanvas(pageNum: number, targetWidth: number): Promise<HTMLCanvasElement> {
      const page = await pdf!.getPage(pageNum);
      const baseViewport = page.getViewport({ scale: 1 });
      const scale = targetWidth / baseViewport.width;
      const viewport = page.getViewport({ scale });

      const canvas = document.createElement("canvas");
      canvas.className = "pdf-page-canvas";
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.maxWidth = "100%";
      canvas.style.height = "auto";
      canvas.dataset.pageNum = String(pageNum);

      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("Canvas 2D context unavailable.");
      await page.render({ canvasContext: ctx, viewport }).promise;
      return canvas;
    }

    function clearViewer() {
      viewer.querySelectorAll(".pdf-stack, .pdf-spread").forEach((n) => n.remove());
    }

    async function renderScroll() {
      clearViewer();
      const stack = document.createElement("div");
      stack.className = "pdf-stack space-y-6";
      viewer.appendChild(stack);

      const targetWidth = Math.min(viewer.clientWidth - 32, 900);

      for (let i = 1; i <= pdf!.numPages; i++) {
        let canvas = scrollCanvases.get(i);
        if (!canvas) {
          canvas = await renderToCanvas(i, targetWidth);
          scrollCanvases.set(i, canvas);
        }
        canvas.id = `pdf-page-${i}`;
        stack.appendChild(canvas);
      }

      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && e.intersectionRatio > 0.5) {
              const n = Number((e.target as HTMLElement).dataset.pageNum);
              if (n) {
                currentPage = n;
                setStatus();
              }
            }
          }
        },
        { threshold: [0.5] },
      );
      stack.querySelectorAll<HTMLCanvasElement>(".pdf-page-canvas").forEach((c) => obs.observe(c));
    }

    async function renderSpread() {
      clearViewer();
      const spread = document.createElement("div");
      spread.className =
        "pdf-spread relative grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6";
      viewer.appendChild(spread);

      const halfWidth = Math.min((viewer.clientWidth - 64) / 2, 700);

      const left = await renderToCanvas(currentPage, halfWidth);
      spread.appendChild(left);

      if (currentPage + 1 <= pdf!.numPages) {
        const right = await renderToCanvas(currentPage + 1, halfWidth);
        spread.appendChild(right);
      }

      const overlay = document.createElement("div");
      overlay.className = "pointer-events-none absolute inset-0 grid grid-cols-2";
      const leftHalf = document.createElement("div");
      leftHalf.className = "pointer-events-auto cursor-w-resize";
      leftHalf.title = "Previous spread";
      leftHalf.addEventListener("click", () => goPrev());
      const rightHalf = document.createElement("div");
      rightHalf.className = "pointer-events-auto cursor-e-resize";
      rightHalf.title = "Next spread";
      rightHalf.addEventListener("click", () => goNext());
      overlay.appendChild(leftHalf);
      overlay.appendChild(rightHalf);
      spread.appendChild(overlay);
    }

    async function render() {
      if (!pdf) return;
      if (mode === "scroll") await renderScroll();
      else await renderSpread();
      setStatus();
    }

    function goPrev() {
      if (!pdf) return;
      if (mode === "scroll") {
        currentPage = Math.max(1, currentPage - 1);
        document.getElementById(`pdf-page-${currentPage}`)?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
        setStatus();
      } else {
        currentPage = Math.max(1, currentPage - 2);
        render();
      }
    }

    function goNext() {
      if (!pdf) return;
      if (mode === "scroll") {
        currentPage = Math.min(pdf.numPages, currentPage + 1);
        document.getElementById(`pdf-page-${currentPage}`)?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
        setStatus();
      } else {
        if (currentPage + 2 <= pdf.numPages) currentPage += 2;
        render();
      }
    }
    prevBtn.addEventListener("click", goPrev);
    nextBtn.addEventListener("click", goNext);

    // ============================================================
    // TEXT VIEW — the cleaned-up text stored with the book
    // ============================================================
    function applyTextSize() {
      textBody.style.fontSize = `${textSize}rem`;
      localStorage.setItem(TEXT_SIZE_KEY, String(textSize));
    }

    // Jumps here land instantly — nobody deep in a book wants to watch
    // 300 pages scroll past. The floating back-to-top button in the
    // layout reads this flag too.
    document.documentElement.style.scrollBehavior = "auto";
    document.documentElement.dataset.instantScroll = "true";

    document.getElementById("to-top")?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "auto" });
    });

    // ============================================================
    // FIND IN BOOK
    // ============================================================
    let bookText = "";
    let findMatches: number[] = [];
    let findIndex = 0;
    let findLoose = false;
    // Whether this book has a text version to search at all.
    let bookHasText = false;

    function escapeForHtml(value: string): string {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    /**
     * A searchable copy of the book, plus a map back to where each
     * character came from.
     *
     * Text pulled out of a PDF carries the printed page's habits: a word
     * broken across a line arrives as "near- ness", kerned runs arrive
     * as "near ness", and stray double spaces are everywhere. Searching
     * the raw text for an exact phrase therefore fails on words the
     * reader can plainly see — which is exactly what the browser's own
     * Ctrl+F runs into.
     *
     * So we search a normalised copy (lowercased, whitespace collapsed,
     * soft hyphens dropped, line-break hyphens rejoined) and use the map
     * to highlight the right characters in the original.
     */
    let findNorm = "";
    let findMap: number[] = [];
    // A second, harsher index with every space removed. PDF extraction
    // sometimes splits a word on nothing but a space ("near ness"),
    // which no amount of hyphen-mending will fix. Searching without
    // spaces at all catches those — at the cost of letting "to me"
    // match "tome" — so it is only consulted when the ordinary search
    // comes up empty, and the reader is told when that happened.
    let findTight = "";
    let findTightMap: number[] = [];

    function buildFindIndex(raw: string) {
      const chars: string[] = [];
      const map: number[] = [];
      let lastWasSpace = true; // leading whitespace earns no entry

      for (let i = 0; i < raw.length; i++) {
        const ch = raw[i];

        // Soft hyphen: invisible, never part of a word.
        if (ch === "­") continue;

        // A hyphen followed by whitespace is the printed page breaking a
        // word in half. Drop both, so "near- ness" reads as "nearness".
        if (ch === "-" && /\s/.test(raw[i + 1] ?? "")) {
          let j = i + 1;
          while (j < raw.length && /\s/.test(raw[j])) j++;
          i = j - 1;
          continue;
        }

        if (/\s/.test(ch)) {
          if (lastWasSpace) continue;
          chars.push(" ");
          map.push(i);
          lastWasSpace = true;
          continue;
        }

        chars.push(ch.toLowerCase());
        map.push(i);
        lastWasSpace = false;
      }

      findNorm = chars.join("");
      findMap = map;

      const tight: string[] = [];
      const tightMap: number[] = [];
      for (let i = 0; i < chars.length; i++) {
        if (chars[i] === " ") continue;
        tight.push(chars[i]);
        tightMap.push(map[i]);
      }
      findTight = tight.join("");
      findTightMap = tightMap;
    }

    function normalizeQuery(value: string): string {
      return value.replace(/­/g, "").replace(/\s+/g, " ").trim().toLowerCase();
    }

    function setFindButtons(enabled: boolean) {
      (document.getElementById("find-prev") as HTMLButtonElement).disabled = !enabled;
      (document.getElementById("find-next") as HTMLButtonElement).disabled = !enabled;
    }

    function showCurrentMatch() {
      const marks = textBody.querySelectorAll("mark");
      marks.forEach((m) => m.classList.remove("find-current"));
      const current = marks[findIndex];
      if (!current) return;
      current.classList.add("find-current");
      // Instant: hunting through a book shouldn't mean watching it glide.
      // Centred, so a hit never lands underneath the sticky find bar.
      current.scrollIntoView({ behavior: "instant" as ScrollBehavior, block: "center" });
      const countEl = document.getElementById("find-count") as HTMLSpanElement;
      countEl.textContent =
        `${findIndex + 1} of ${marks.length}` + (findLoose ? " (ignoring spaces)" : "");
    }

    function runFind() {
      const input = document.getElementById("find-input") as HTMLInputElement;
      const countEl = document.getElementById("find-count") as HTMLSpanElement;
      const query = input.value.trim();

      // Rebuilding the whole book for one letter isn't worth it, and the
      // hit count would be meaningless anyway.
      if (query.length < 2) {
        textBody.textContent = bookText;
        countEl.textContent = "";
        findMatches = [];
        findIndex = 0;
        setFindButtons(false);
        return;
      }

      // Search the normalised copy, then translate each hit back to the
      // original characters so the highlight lands where the reader can
      // see it. Building the HTML from the raw text keeps & and < safe.
      const needle = normalizeQuery(query);
      const tightNeedle = needle.replace(/ /g, "");

      function countIn(hay: string, target: string): number {
        if (!target) return 0;
        let n = 0;
        let at = hay.indexOf(target);
        while (at !== -1) {
          n++;
          at = hay.indexOf(target, at + target.length);
        }
        return n;
      }

      const exactCount = countIn(findNorm, needle);
      const tightCount = countIn(findTight, tightNeedle);

      // Prefer the precise search. Ignore spaces when it finds nothing —
      // or, for a phrase of two or more words, when doing so finds more:
      // that difference is a word the PDF split in half, and a
      // multi-word phrase is specific enough that ignoring spaces won't
      // start matching "to me" inside "tome".
      const multiWord = needle.includes(" ");
      const loose = tightCount > 0 && (exactCount === 0 || (multiWord && tightCount > exactCount));

      const haystack = loose ? findTight : findNorm;
      const map = loose ? findTightMap : findMap;
      const target = loose ? tightNeedle : needle;

      const pieces: string[] = [];
      let last = 0;
      let count = 0;
      let at = target ? haystack.indexOf(target) : -1;
      while (at !== -1) {
        const start = map[at];
        const end = map[at + target.length - 1] + 1;
        if (start >= last) {
          pieces.push(escapeForHtml(bookText.slice(last, start)));
          pieces.push(`<mark>${escapeForHtml(bookText.slice(start, end))}</mark>`);
          last = end;
          count++;
        }
        at = haystack.indexOf(target, at + target.length);
      }
      pieces.push(escapeForHtml(bookText.slice(last)));

      if (count === 0) {
        textBody.textContent = bookText;
        countEl.textContent = "no matches";
        setFindButtons(false);
        return;
      }

      textBody.innerHTML = pieces.join("");
      findIndex = 0;
      findLoose = loose;
      setFindButtons(true);
      showCurrentMatch();
    }

    function stepFind(delta: number) {
      const marks = textBody.querySelectorAll("mark");
      if (marks.length === 0) return;
      findIndex = (findIndex + delta + marks.length) % marks.length;
      showCurrentMatch();
    }

    // Ctrl+F is what anyone reaches for, and on the page views it finds
    // nothing at all — those are images of pages, with no text in them
    // for the browser to catch. So on a book that has a text version we
    // take the shortcut over: switch to the text view and put the cursor
    // in our own find box, which also copes with words the PDF split in
    // half. On a book with no text version we leave the browser's own
    // find alone rather than intercepting it to no purpose.
    document.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== "f" && ev.key !== "F") return;
      if (!(ev.ctrlKey || ev.metaKey) || ev.altKey) return;
      if (!bookHasText) return;

      ev.preventDefault();
      if (mode !== "text") setMode("text");
      const input = document.getElementById("find-input") as HTMLInputElement | null;
      // The text may still be arriving; focusing once it's there avoids
      // the cursor landing in a box that's about to be revealed.
      const focusIt = () => {
        input?.focus();
        input?.select();
      };
      if (textLoaded) focusIt();
      else setTimeout(focusIt, 300);
    });

    document.getElementById("find-input")?.addEventListener("input", runFind);
    document.getElementById("find-next")?.addEventListener("click", () => stepFind(1));
    document.getElementById("find-prev")?.addEventListener("click", () => stepFind(-1));
    document.getElementById("find-input")?.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key === "Enter") {
        ev.preventDefault();
        stepFind(ev.shiftKey ? -1 : 1);
      } else if (ev.key === "Escape") {
        ev.preventDefault();
        (ev.target as HTMLInputElement).value = "";
        runFind();
      }
    });

    async function loadText() {
      if (textLoaded) return;
      textLoading.hidden = false;
      textUnavailable.hidden = true;
      textBody.hidden = true;

      try {
        const res = await fetch(`/api/library/text?slug=${encodeURIComponent(currentSlug)}`, {
          credentials: "same-origin",
          cache: "no-store",
        });
        const data = await res.json().catch(() => ({}));
        textLoading.hidden = true;

        if (!res.ok) {
          // 409 means the book has no text — a scan, or not yet
          // prepared. Say which, and point back to the pages.
          textUnavailable.textContent = data.error || `Could not load the text (${res.status}).`;
          textUnavailable.hidden = false;
          return;
        }

        bookText = data.text ?? "";
        buildFindIndex(bookText);
        textBody.textContent = bookText;
        applyTextSize();
        textBody.hidden = false;
        (document.getElementById("find-bar") as HTMLDivElement).hidden = false;
        textLoaded = true;
      } catch (err) {
        textLoading.hidden = true;
        textUnavailable.textContent = `Could not load the text: ${(err as Error).message || err}`;
        textUnavailable.hidden = false;
      }
    }

    function styleModeButton(btn: HTMLButtonElement, active: boolean) {
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("bg-brand-blue-dark", active);
      btn.classList.toggle("text-cream-card", active);
      btn.classList.toggle("bg-cream-card", !active);
      btn.classList.toggle("text-brand-blue-dark", !active);
    }

    function setMode(next: Mode) {
      if (mode === next) return;
      mode = next;

      styleModeButton(modeScrollBtn, mode === "scroll");
      styleModeButton(modeBookBtn, mode === "book");
      styleModeButton(modeTextBtn, mode === "text");

      const isText = mode === "text";
      textStage.hidden = !isText;
      // Only meaningful once there is text on screen to search.
      const findBar = document.getElementById("find-bar") as HTMLDivElement | null;
      if (findBar) findBar.hidden = !isText || !textLoaded;
      pdfStage.hidden = isText;
      textSizeControls.hidden = !isText;
      // The pager belongs to the page views; the text view is one
      // continuous scroll with no pages to step through.
      prevBtn.hidden = isText;
      nextBtn.hidden = isText;
      statusEl.hidden = isText;

      if (isText) {
        loadText();
        return;
      }
      if (mode === "book" && currentPage % 2 === 0) currentPage -= 1;
      render();
    }
    modeScrollBtn.addEventListener("click", () => setMode("scroll"));
    modeBookBtn.addEventListener("click", () => setMode("book"));
    modeTextBtn.addEventListener("click", () => setMode("text"));

    document.getElementById("text-larger")?.addEventListener("click", () => {
      textSize = Math.min(2, Math.round((textSize + 0.1) * 100) / 100);
      applyTextSize();
    });
    document.getElementById("text-smaller")?.addEventListener("click", () => {
      textSize = Math.max(0.8, Math.round((textSize - 0.1) * 100) / 100);
      applyTextSize();
    });

    document.addEventListener("keydown", (e) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      // Nothing to page through in the text view.
      if (mode === "text") return;
      if (e.key === "ArrowLeft") goPrev();
      else if (e.key === "ArrowRight") goNext();
    });

    // ============================================================
    // BOOTSTRAP — read slug from URL, fetch book metadata,
    // populate header, fetch signed PDF URL, render
    // ============================================================
    (async () => {
      const params = new URLSearchParams(window.location.search);
      const slug = (params.get("slug") || "").trim();
      currentSlug = slug;
      // ?view=text opens straight into the cleaned-up text — that's what
      // the "Read as text" link on each library card points at.
      const wantsText = params.get("view") === "text";
      if (!slug) {
        titleEl.textContent = "No book selected";
        showError("This reader needs a ?slug= parameter. Pick a book from the library.");
        return;
      }

      try {
        // Ask for this one book by slug. Scanning the whole catalog
        // (as this used to) never found hidden staging books, so an
        // admin opening one from /admin/library/ was told it didn't
        // exist — and it fetched every book's details to show one.
        const bookRes = await fetch(`/api/library/book?slug=${encodeURIComponent(slug)}`, {
          credentials: "same-origin",
          cache: "no-store",
        });
        if (bookRes.status === 401) {
          location.assign(`/login/?next=${encodeURIComponent(location.pathname + location.search)}`);
          return;
        }
        if (!bookRes.ok) {
          const detail = await bookRes.json().catch(() => ({}));
          titleEl.textContent = bookRes.status === 404 ? "Book not found" : "Not available";
          showError(detail.error || `Could not load this book (${bookRes.status}).`);
          return;
        }
        const { book } = (await bookRes.json()) as { book: Book };
        if (!book) {
          titleEl.textContent = "Book not found";
          showError(`No book with slug "${slug}".`);
          return;
        }

        document.title = `${book.title} | Parish Library`;
        titleEl.textContent = book.title;
        authorEl.textContent = book.author ?? "";

        bookHasText = book.has_text !== false;

        // A book with no text version says so on the button, and beside it.
        if (book.has_text === false) {
          modeTextBtn.title = "No text version for this book";
          modeTextBtn.classList.add("opacity-50");
          document.getElementById("no-text-note")?.removeAttribute("hidden");
        }

        // Someone who asked for the text view gets it straight away —
        // waiting for a 300-page PDF to render first would be a long
        // stare at nothing. The pages still load underneath, so
        // switching back to them is instant.
        if (wantsText) setMode("text");

        const pdfRes = await fetch(`/api/library/pdf?key=${encodeURIComponent(book.pdf_storage_key)}`, {
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        if (pdfRes.status === 401) {
          location.assign(`/login/?next=${encodeURIComponent(location.pathname + location.search)}`);
          return;
        }
        if (!pdfRes.ok) {
          const json = await pdfRes.json().catch(() => ({}));
          showError(json.error || `Could not load text (${pdfRes.status}).`);
          return;
        }
        const { url } = (await pdfRes.json()) as { url: string };
        pdf = await pdfjsLib.getDocument({ url }).promise;
        loadingEl.hidden = true;
        await render();
      } catch (e) {
        showError(`Could not load text: ${(e as Error).message || e}`);
      }
    })();
  </script>
</Layout>
