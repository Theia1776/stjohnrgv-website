---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Service Schedule | St. John of Kronstadt Orthodox Mission, Bayview TX"
  description="Sunday Divine Liturgy at 9:00 AM, Saturday Vespers at 6:00 PM, and Julian Calendar feast day services. St. John of Kronstadt Orthodox Mission, Bayview TX 78566."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs uppercase tracking-widest text-brand-tan-dark">Visit Us</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Service Schedule</h1>

    <div class="mt-8 divide-y divide-border-soft border-y border-border-soft">
      <div class="grid grid-cols-3 gap-4 py-4">
        <div class="font-display text-text-primary">Divine Liturgy</div>
        <div class="text-text-primary/80">Sunday</div>
        <div class="text-right text-text-primary">9:00 AM</div>
      </div>
      <div class="grid grid-cols-3 gap-4 py-4">
        <div class="font-display text-text-primary">Vespers</div>
        <div class="text-text-primary/80">Saturday</div>
        <div class="text-right text-text-primary">6:00 PM</div>
      </div>
      <div class="grid grid-cols-3 gap-4 py-4">
        <div class="font-display text-text-primary">Confession</div>
        <div class="text-text-primary/80">By appointment</div>
        <div class="text-right text-text-primary">—</div>
      </div>
    </div>

    <p class="mt-8 text-text-primary/75">
      Detailed feast day services, directions, parking, and a "what to expect at your first
      visit" guide are coming soon. To plan your visit, please call
      <a href="tel:+19564490225">(956) 449-0225</a>.
    </p>
  </section>
</Layout>
