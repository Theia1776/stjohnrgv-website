---
import Layout from "../layouts/Layout.astro";

// Sending a name in to be prayed for.
//
// Open to anyone, signed in or not — the newsletter links here, and a
// person reading it on their phone is not going to make an account
// first. Nothing on this page ever shows a request back: the list is
// read in the parish office and nowhere else.
---

<Layout
  title="Prayer Requests | St. John of Kronstadt Orthodox Mission"
  description="Send in names to be prayed for at St. John of Kronstadt Orthodox Mission, Bayview TX — for the living, and for those who have fallen asleep."
>
  <main class="mx-auto max-w-2xl px-4 py-12 md:px-6">
    <p class="font-display text-xs uppercase tracking-widest text-brand-tan-dark">
      St. John of Kronstadt Orthodox Mission
    </p>
    <h1 class="mt-2 font-display text-4xl text-text-primary md:text-5xl">Prayer Requests</h1>
    <div class="mt-5 h-px w-24 bg-liturgical-current"></div>

    <p class="mt-5 leading-relaxed text-text-primary/85">
      Send us the name of someone you would like us to keep in your prayers,
      and we will pass it on to our parishioners.
    </p>

    <form id="prayer-form" class="mt-8 space-y-5">
      <fieldset class="border border-border-soft p-4">
        <legend class="px-1 text-xs uppercase tracking-widest text-text-secondary">
          Who are we praying for?
        </legend>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="radio" name="kind" value="living" checked class="h-4 w-4" />
          <span class="text-sm text-text-primary">For the living</span>
        </label>
        <label class="mt-2 flex items-center gap-3 cursor-pointer">
          <input type="radio" name="kind" value="departed" class="h-4 w-4" />
          <span class="text-sm text-text-primary">In memory</span>
        </label>
      </fieldset>

      <label class="block text-xs uppercase tracking-widest text-text-secondary">
        Name <span aria-hidden="true" class="text-brand-tan-dark">*</span>
        <input
          id="p-name"
          type="text"
          required
          maxlength="120"
          placeholder="Ana G."
          class="mt-1 block w-full border border-border-soft bg-cream-bg px-3 py-2 text-base normal-case tracking-normal text-text-primary"
        />
      </label>

      <label class="block text-xs uppercase tracking-widest text-text-secondary">
        Your name
        <input
          id="p-by"
          type="text"
          maxlength="120"
          class="mt-1 block w-full border border-border-soft bg-cream-bg px-3 py-2 text-base normal-case tracking-normal text-text-primary"
        />
      </label>

      <div class="block text-xs uppercase tracking-widest text-text-secondary">
        How to reach you
        <div class="mt-1 flex flex-wrap gap-2">
          <select
            id="p-contact-type"
            aria-label="Email or phone"
            class="border border-border-soft bg-cream-bg px-3 py-2 text-base normal-case tracking-normal text-text-primary"
          >
            <option value="Email">Email</option>
            <option value="Phone">Phone number</option>
          </select>
          <input
            id="p-contact"
            type="text"
            maxlength="120"
            aria-label="Your email or phone number"
            class="min-w-0 flex-1 border border-border-soft bg-cream-bg px-3 py-2 text-base normal-case tracking-normal text-text-primary"
          />
        </div>
      </div>

      <label class="block text-xs uppercase tracking-widest text-text-secondary">
        Anything Father should know
        <span class="normal-case tracking-normal text-text-secondary">(optional)</span>
        <textarea
          id="p-note"
          rows="3"
          maxlength="1000"
          class="mt-1 block w-full border border-border-soft bg-cream-bg px-3 py-2 text-base normal-case tracking-normal text-text-primary"
        ></textarea>
      </label>

      <!-- Being prayed for and being printed are two different things
           to agree to, so they are asked separately. -->
      <label class="flex items-start gap-3 cursor-pointer border-t border-border-soft pt-5">
        <input type="checkbox" id="p-newsletter" checked class="mt-1 h-4 w-4" />
        <span class="text-sm text-text-primary">
          Include this name in the newsletter for our parishioners
        </span>
      </label>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <button type="submit" id="p-submit" class="btn btn-primary">Send this request</button>
        <span id="p-status" role="status" class="text-sm text-text-secondary"></span>
      </div>
    </form>

  </main>
</Layout>

<script>
  const form = document.getElementById("prayer-form") as HTMLFormElement;
  const status = document.getElementById("p-status") as HTMLElement;
  const submit = document.getElementById("p-submit") as HTMLButtonElement;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = val("p-name");
    if (!name) {
      status.textContent = "Please give a name.";
      status.className = "text-sm text-liturgical-red";
      return;
    }

    submit.disabled = true;
    status.className = "text-sm text-text-secondary";
    status.textContent = "Sending…";
    try {
      const res = await fetch("/api/prayer-requests", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          kind:
            (document.querySelector('input[name="kind"]:checked') as HTMLInputElement)?.value ===
            "departed"
              ? "departed"
              : "living",
          requested_by: val("p-by"),
          contact: val("p-contact")
            ? `${(document.getElementById("p-contact-type") as HTMLSelectElement).value}: ${val("p-contact")}`
            : "",
          in_newsletter: (document.getElementById("p-newsletter") as HTMLInputElement).checked,
          note: (document.getElementById("p-note") as HTMLTextAreaElement).value.trim(),
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        status.textContent = body.error ?? `Couldn't send it (${res.status}).`;
        status.className = "text-sm text-liturgical-red";
        return;
      }
      // Say what happened and to which list, then clear the form so a
      // second name can be sent without the first still sitting there.
      status.textContent = body.message ?? "Thank you — it has been sent.";
      status.className = "text-sm text-brand-blue-dark";
      form.reset();
    } catch (err) {
      status.textContent = `Couldn't send it: ${err instanceof Error ? err.message : String(err)}`;
      status.className = "text-sm text-liturgical-red";
    } finally {
      submit.disabled = false;
    }
  });
</script>
