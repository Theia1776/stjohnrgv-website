---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Reset Password | St. John of Kronstadt Orthodox Mission"
  description="Reset the password for your St. John of Kronstadt parish website account."
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <section class="bg-cream-bg">
    <div class="mx-auto max-w-md px-4 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Parish Access</p>
      <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Reset Password</h1>
      <div class="mt-6 h-px w-24 bg-liturgical-current"></div>

      <!-- ============== STEP 1: REQUEST CODE ============== -->
      <div id="step-request">
        <p class="mt-6 text-text-primary/85 leading-relaxed">
          Enter the email address on your account and we will send you a
          six-digit reset code. Use it on the next step to choose a new
          password.
        </p>

        <form id="request-form" class="mt-8 space-y-5" novalidate>
          <div>
            <label for="request-email" class="block text-sm font-semibold text-text-primary">
              Email <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="request-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
          </div>

          <div>
            <button id="request-submit" type="submit" class="btn btn-primary btn-lg">
              Send Reset Code
            </button>
            <p
              id="request-error"
              role="alert"
              hidden
              class="mt-3 text-sm font-semibold text-liturgical-red"
            ></p>
          </div>
        </form>
      </div>

      <!-- ============== STEP 2: ENTER CODE + NEW PASSWORD ============== -->
      <div id="step-reset" hidden>
        <div
          id="reset-sent-note"
          role="status"
          aria-live="polite"
          class="mt-6 border-l-2 border-sacred-gold bg-cream-card p-4 text-sm text-text-primary/85"
        >
          <p>
            If an account exists for <strong id="reset-email-echo"></strong>, a
            six-digit code is on its way. Check your inbox — and your spam
            folder, just in case. The code expires in 15 minutes.
          </p>
        </div>

        <form id="reset-form" class="mt-8 space-y-5" novalidate>
          <div>
            <label for="reset-code" class="block text-sm font-semibold text-text-primary">
              Reset Code <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="reset-code"
              name="code"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              required
              maxlength="6"
              pattern="[0-9]*"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary tracking-[0.4em] placeholder:text-text-secondary placeholder:tracking-normal"
              placeholder="000000"
            />
          </div>

          <div>
            <label for="reset-password" class="block text-sm font-semibold text-text-primary">
              New Password <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="reset-password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
            <p class="mt-1.5 text-xs text-text-secondary">At least 8 characters.</p>
          </div>

          <div>
            <label for="reset-password-confirm" class="block text-sm font-semibold text-text-primary">
              Confirm New Password <span aria-hidden="true" class="text-brand-tan-dark">*</span>
            </label>
            <input
              id="reset-password-confirm"
              name="password_confirm"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="mt-1.5 block w-full border border-text-secondary bg-cream-card px-3 py-2.5 text-text-primary placeholder:text-text-secondary"
            />
          </div>

          <div>
            <button id="reset-submit" type="submit" class="btn btn-primary btn-lg">
              Change Password
            </button>
            <p
              id="reset-error"
              role="alert"
              hidden
              class="mt-3 text-sm font-semibold text-liturgical-red"
            ></p>
          </div>
        </form>

        <p class="mt-6 text-sm text-text-secondary">
          Didn't get a code?
          <button id="resend-link" type="button" class="font-semibold text-brand-blue-dark underline">
            Start over
          </button>
        </p>
      </div>

      <!-- ============== SUCCESS ============== -->
      <div
        id="step-success"
        hidden
        role="status"
        aria-live="polite"
        class="mt-6 border-2 border-sacred-gold bg-cream-card p-6 shadow-sm"
      >
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">All Set</p>
        <h2 class="mt-2 font-display text-xl text-text-primary">Password changed.</h2>
        <div class="mt-4 h-px w-16 bg-liturgical-current"></div>
        <p class="mt-4 text-text-primary/85 leading-relaxed">
          Your password has been updated. You can now sign in with your new
          password.
        </p>
        <a href="/login/" class="btn btn-primary btn-lg mt-6">Go to Sign In</a>
      </div>

      <p class="mt-10 text-sm text-text-secondary">
        Remembered it? <a href="/login/" class="font-semibold text-brand-blue-dark underline">Back to sign in</a>
      </p>
    </div>
  </section>

  <script>
    const stepRequest = document.getElementById("step-request") as HTMLDivElement;
    const stepReset = document.getElementById("step-reset") as HTMLDivElement;
    const stepSuccess = document.getElementById("step-success") as HTMLDivElement;

    // ============================================================
    // STEP 1 — request a code
    // ============================================================
    const requestForm = document.getElementById("request-form") as HTMLFormElement;
    const requestEmail = document.getElementById("request-email") as HTMLInputElement;
    const requestErr = document.getElementById("request-error") as HTMLParagraphElement;
    const requestBtn = document.getElementById("request-submit") as HTMLButtonElement;
    const emailEcho = document.getElementById("reset-email-echo") as HTMLElement;

    // Remember which email the code was sent to so step 2 can submit it
    // without asking the member to retype it.
    let pendingEmail = "";

    requestForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      requestErr.hidden = true;
      requestErr.textContent = "";
      requestBtn.disabled = true;
      const original = requestBtn.textContent ?? "Send Reset Code";
      requestBtn.textContent = "Sending…";

      const email = requestEmail.value.trim();
      try {
        const res = await fetch("/api/auth/forgot", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok) {
          pendingEmail = email;
          emailEcho.textContent = email;
          stepRequest.hidden = true;
          stepReset.hidden = false;
          (document.getElementById("reset-code") as HTMLInputElement).focus();
          return;
        }
        requestErr.textContent = json.error || "Something went wrong. Try again.";
        requestErr.hidden = false;
      } catch {
        requestErr.textContent = "Couldn't reach the server. Check your connection.";
        requestErr.hidden = false;
      } finally {
        requestBtn.disabled = false;
        requestBtn.textContent = original;
      }
    });

    // ============================================================
    // STEP 2 — submit code + new password
    // ============================================================
    const resetForm = document.getElementById("reset-form") as HTMLFormElement;
    const resetCode = document.getElementById("reset-code") as HTMLInputElement;
    const resetPassword = document.getElementById("reset-password") as HTMLInputElement;
    const resetConfirm = document.getElementById("reset-password-confirm") as HTMLInputElement;
    const resetErr = document.getElementById("reset-error") as HTMLParagraphElement;
    const resetBtn = document.getElementById("reset-submit") as HTMLButtonElement;

    resetForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      resetErr.hidden = true;
      resetErr.textContent = "";

      const code = resetCode.value.trim();
      const password = resetPassword.value;
      const confirm = resetConfirm.value;

      if (password.length < 8) {
        resetErr.textContent = "Password must be at least 8 characters.";
        resetErr.hidden = false;
        return;
      }
      if (password !== confirm) {
        resetErr.textContent = "The two passwords don't match.";
        resetErr.hidden = false;
        return;
      }

      resetBtn.disabled = true;
      const original = resetBtn.textContent ?? "Change Password";
      resetBtn.textContent = "Changing…";

      try {
        const res = await fetch("/api/auth/reset", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: pendingEmail, code, password }),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok) {
          stepReset.hidden = true;
          stepSuccess.hidden = false;
          stepSuccess.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }
        resetErr.textContent = json.error || "Couldn't reset the password. Try again.";
        resetErr.hidden = false;
      } catch {
        resetErr.textContent = "Couldn't reach the server. Check your connection.";
        resetErr.hidden = false;
      } finally {
        resetBtn.disabled = false;
        resetBtn.textContent = original;
      }
    });

    // "Start over" — go back to step 1 to request a fresh code.
    const resendLink = document.getElementById("resend-link") as HTMLButtonElement;
    resendLink.addEventListener("click", () => {
      stepReset.hidden = true;
      stepRequest.hidden = false;
      resetForm.reset();
      requestEmail.focus();
    });
  </script>
</Layout>
