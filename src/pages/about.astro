---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About St. John of Kronstadt Orthodox Mission | True Orthodox Church, Bayview TX"
  description="Learn about St. John of Kronstadt Orthodox Mission — a True Orthodox parish in the Rio Grande Valley celebrating the ancient Julian Calendar faith of the Apostles and Church Fathers."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs uppercase tracking-widest text-gold-dim">Our Parish</p>
    <h1 class="mt-2 font-display text-3xl text-ink md:text-4xl">About St. John of Kronstadt Orthodox Mission</h1>
    <p class="mt-6 text-lg text-ink/80">
      A fuller introduction to the parish, the Julian Calendar tradition, and our
      patron St. John of Kronstadt — coming soon.
    </p>
    <p class="mt-4 text-ink/70">
      In the meantime, you can <a href="/schedule/" class="text-burgundy underline hover:text-ink">view the service schedule</a>
      or <a href="/contact/" class="text-burgundy underline hover:text-ink">speak with Fr. Antonios Altermatt</a>.
    </p>
  </section>
</Layout>
