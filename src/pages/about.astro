---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About St. John of Kronstadt Orthodox Mission | True Orthodox Church, Bayview TX"
  description="Learn about St. John of Kronstadt Orthodox Mission — a True Orthodox parish in the Rio Grande Valley celebrating the ancient Julian Calendar faith of the Apostles and Church Fathers."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Our Parish</p>
    <h1 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">About St. John of Kronstadt Orthodox Mission</h1>
    <p class="mt-6 text-lg text-text-primary/80">
      A fuller introduction to the parish, the Julian Calendar tradition, and our
      patron St. John of Kronstadt — coming soon.
    </p>
    <p class="mt-4 text-text-primary/75">
      In the meantime, you can <a href="#schedule">view the service schedule</a>
      or <a href="/contact/">speak with Fr. Antonios Altermatt</a>.
    </p>
  </section>

  <hr class="mx-auto h-px w-full max-w-3xl border-0 bg-liturgical-current opacity-40" />

  <!-- ==================== SERVICES & SCHEDULE ==================== -->
  <section id="schedule" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-16 md:py-20">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Visit</p>
    <h2 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Services &amp; Schedule</h2>
    <div class="mt-6 h-px w-24 bg-liturgical-current"></div>
    <dl class="mt-6 divide-y divide-border-soft border-y border-border-soft">
      <div class="grid gap-1 py-4 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
        <dt class="font-display text-lg text-text-primary">Vespers</dt>
        <dd class="text-text-primary/85">Saturday evenings · 5:00 PM</dd>
      </div>
      <div class="grid gap-1 py-4 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
        <dt class="font-display text-lg text-text-primary">Divine Liturgy</dt>
        <dd class="text-text-primary/85">
          Sunday mornings · 9:00 AM
          <span class="block text-sm italic text-text-secondary">
            Hours read and Confessions beginning at 8:00 AM
          </span>
        </dd>
      </div>
    </dl>
    <p class="mt-6 text-text-primary/75">
      Questions about visiting? Call
      <a href="tel:+19564490225">(956) 449-0225</a>.
    </p>
  </section>

  <hr class="mx-auto h-px w-full max-w-3xl border-0 bg-liturgical-current opacity-40" />

  <!-- ==================== CANONICAL STANDING ==================== -->
  <section id="communion" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-16 md:py-20">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-tan-dark">Our Canonical Family</p>
    <h2 class="mt-2 font-display text-3xl text-text-primary md:text-4xl">Canonical Standing</h2>
    <div class="mt-6 h-px w-24 bg-liturgical-current"></div>
    <p class="mt-6 text-lg leading-relaxed text-text-primary/85">
      St. John of Kronstadt Orthodox Mission is a parish of the Autonomous
      Orthodox Metropolia of North and South America and the British Isles
      (True Orthodox). We are in canonical communion with the Avlona Synod
      USA and the IPC Katakomb Church.
    </p>
  </section>
</Layout>
