---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Julian Calendar | St. John of Kronstadt Orthodox Mission"
  description="Daily Orthodox commemorations, scripture readings, fasting rules, and troparia according to the Julian calendar."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">

    <p class="mb-4 font-display text-xs uppercase tracking-widest text-text-secondary">Julian Calendar</p>

    <!-- Date header + navigation -->
    <div id="cal-header" class="mb-10 flex items-center gap-3">
      <button id="prev-day" class="shrink-0 font-display text-sm text-brand-blue transition-colors hover:text-brand-blue-dark">← Prev</button>
      <h1 id="cal-date" class="flex-1 text-center font-display text-xl text-text-primary md:text-2xl"></h1>
      <button id="next-day" class="shrink-0 font-display text-sm text-brand-blue transition-colors hover:text-brand-blue-dark">Next →</button>
    </div>
    <div class="mb-8 text-center">
      <button id="today-btn" class="font-display text-xs uppercase tracking-widest text-text-secondary transition-colors hover:text-brand-blue">↩ Today</button>
    </div>

    <!-- Loading -->
    <div id="cal-loading" class="py-20 text-center text-text-secondary">
      <p class="font-display text-base tracking-wide">Loading…</p>
    </div>

    <!-- Error -->
    <div id="cal-error" class="hidden py-20 text-center">
      <p class="text-lg text-text-secondary">Could not load calendar data. Please check your connection and try again.</p>
    </div>

    <!-- Content -->
    <div id="cal-content" class="hidden space-y-10"></div>

  </section>

  <!-- Reading modal — hidden by default, opened by Read More buttons. -->
  <div
    id="reading-modal"
    class="hidden fixed inset-0 z-[60] overflow-y-auto bg-text-primary/60 p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reading-modal-title"
  >
    <div id="reading-modal-panel" class="mx-auto max-w-2xl border border-brand-tan bg-cream-card p-6 shadow-lg md:p-8">
      <button
        id="reading-modal-close"
        type="button"
        aria-label="Close reading"
        class="float-right -mr-1 -mt-1 font-display text-2xl leading-none text-text-secondary hover:text-text-primary"
      >×</button>
      <h3 id="reading-modal-title" class="mb-4 pr-8 font-display text-xl font-bold text-brand-blue"></h3>
      <div id="reading-modal-body" class="space-y-2 leading-relaxed"></div>
    </div>
  </div>

  <script is:inline>
    const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

    let currentDate = new Date();
    currentDate.setHours(0,0,0,0);

    // Holds the day's readings array for modal lookup by index.
    let currentReadings = [];

    function formatDate(d) {
      return `${DAYS[d.getDay()]}, ${MONTHS[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
    }

    function apiUrl(date) {
      return `https://orthocal.info/api/julian/${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}/`;
    }

    function cacheKey(date) {
      return `orthocal-${date.toISOString().split('T')[0]}`;
    }

    async function fetchDay(date) {
      const key = cacheKey(date);
      const cached = localStorage.getItem(key);
      if (cached) return JSON.parse(cached);
      const res = await fetch(apiUrl(date));
      if (!res.ok) throw new Error('API error');
      const data = await res.json();
      localStorage.setItem(key, JSON.stringify(data));
      return data;
    }

    function toneOrdinal(n) {
      if (!n) return '';
      const words = ['','One','Two','Three','Four','Five','Six','Seven','Eight'];
      return words[n] || n;
    }

    function escapeHtml(s) {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderContent(day) {
      const sections = [];

      // Week description + Tone
      const weekDesc = day.titles?.[0] || '';
      const tone = day.tone ? `Tone ${toneOrdinal(day.tone)}` : '';
      if (weekDesc || tone) {
        const combined = [weekDesc, tone].filter(Boolean).join(' — ');
        sections.push(`
          <div class="rounded border border-brand-tan bg-cream-card px-5 py-4">
            <p class="font-display text-base font-bold text-text-primary">${escapeHtml(combined)}</p>
          </div>
        `);
      }

      // Fasting rule
      if (day.fast_level_desc) {
        let fastText = day.fast_level_desc;
        if (day.fast_exception) fastText += ` — ${day.fast_exception}`;
        sections.push(`
          <div class="border-l-4 border-brand-tan py-1 pl-4">
            <p class="mb-1 font-display text-xs uppercase tracking-widest text-text-secondary">Fasting Rule</p>
            <p class="text-lg text-text-primary">${escapeHtml(fastText)}</p>
          </div>
        `);
      }

      // Commemorations — saints come from day.saints; titles[0] is the
      // week/tone description and is rendered in the top banner above.
      const commemorations = day.saints || [];
      if (commemorations.length > 0) {
        const items = commemorations.map(t => `<li class="text-lg leading-snug text-text-primary">• ${escapeHtml(t)}</li>`).join('');
        sections.push(`
          <div>
            <h2 class="mb-4 border-b border-brand-tan pb-2 font-display text-lg text-text-primary">Commemorations</h2>
            <ul class="space-y-2">${items}</ul>
          </div>
        `);
      }

      // Scripture Readings — card grid; full passage opens in a modal.
      if (day.readings?.length > 0) {
        currentReadings = day.readings;
        const readingItems = day.readings.map((r, i) => {
          const passage = r.passage || [];
          const previewVerses = passage.slice(0, 2);
          const previewHtml = previewVerses.length > 0
            ? previewVerses.map(v =>
                `<p class="text-sm leading-relaxed text-text-primary/85"><span class="mr-1 font-display text-xs text-text-secondary">${escapeHtml(v.verse)}</span>${escapeHtml(v.content)}</p>`
              ).join('')
            : '<p class="text-sm italic text-text-secondary">No preview available.</p>';
          const hasFull = passage.length > 0;
          const hasMore = passage.length > 2;
          const moreLabel = hasMore ? 'Read more →' : (hasFull ? 'View →' : '');
          const moreBtn = moreLabel
            ? `<button type="button" data-reading-index="${i}" class="mt-4 self-start font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark hover:underline">${moreLabel}</button>`
            : '';
          return `
            <article class="flex flex-col border border-brand-tan bg-cream-card p-5 shadow-sm">
              <p class="mb-3 font-display text-sm font-bold text-brand-blue">${escapeHtml(r.display || '')}</p>
              <div class="flex-1 space-y-1">${previewHtml}</div>
              ${moreBtn}
            </article>
          `;
        }).join('');

        sections.push(`
          <div>
            <h2 class="mb-4 border-b border-brand-tan pb-2 font-display text-lg text-text-primary">Scripture Readings</h2>
            <div class="grid gap-4 sm:grid-cols-2">${readingItems}</div>
          </div>
        `);
      }

      // Troparia / stories
      if (day.stories?.length > 0) {
        const storyItems = day.stories.map(s => `
          <div class="border-b border-border-soft pb-4 last:border-0">
            <p class="mb-2 font-display text-sm font-bold text-text-primary">${escapeHtml(s.title || '')}</p>
            <p class="text-lg leading-relaxed text-text-primary">${escapeHtml(s.text || '')}</p>
          </div>
        `).join('');
        sections.push(`
          <div>
            <h2 class="mb-4 border-b border-brand-tan pb-2 font-display text-lg text-text-primary">Troparia</h2>
            <div class="space-y-2">${storyItems}</div>
          </div>
        `);
      }

      document.getElementById('cal-content').innerHTML = sections.join('');
    }

    async function loadDay(date) {
      const loading = document.getElementById('cal-loading');
      const error = document.getElementById('cal-error');
      const content = document.getElementById('cal-content');

      loading.classList.remove('hidden');
      error.classList.add('hidden');
      content.classList.add('hidden');
      content.innerHTML = '';

      document.getElementById('cal-date').textContent = formatDate(date);

      try {
        const day = await fetchDay(date);
        renderContent(day);
        loading.classList.add('hidden');
        content.classList.remove('hidden');
      } catch (e) {
        console.error('orthocal.info fetch failed:', e);
        loading.classList.add('hidden');
        error.classList.remove('hidden');
      }
    }

    // ---- Reading modal ----
    const modal = document.getElementById('reading-modal');
    const modalPanel = document.getElementById('reading-modal-panel');
    const modalTitle = document.getElementById('reading-modal-title');
    const modalBody = document.getElementById('reading-modal-body');
    const modalClose = document.getElementById('reading-modal-close');

    function openReadingModal(reading) {
      if (!reading) return;
      modalTitle.textContent = reading.display || '';
      const verses = (reading.passage || []).map(v =>
        `<p><span class="mr-1 font-display text-xs text-text-secondary">${escapeHtml(v.verse)}</span><span class="text-base text-text-primary">${escapeHtml(v.content)}</span></p>`
      ).join('');
      modalBody.innerHTML = verses || '<p class="italic text-text-secondary">No passage text available.</p>';
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeReadingModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Click outside the panel closes the modal; clicks inside the panel
    // bubble up but the contains() check filters them out.
    modal.addEventListener('click', (e) => {
      if (!modalPanel.contains(e.target)) closeReadingModal();
    });
    modalClose.addEventListener('click', closeReadingModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeReadingModal();
    });

    // Event delegation: any [data-reading-index] click in cal-content
    // opens the modal with the corresponding reading.
    document.getElementById('cal-content').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-reading-index]');
      if (btn) {
        const idx = parseInt(btn.dataset.readingIndex, 10);
        openReadingModal(currentReadings[idx]);
      }
    });

    // ---- Day navigation ----
    document.getElementById('prev-day').addEventListener('click', () => {
      currentDate.setDate(currentDate.getDate() - 1);
      loadDay(currentDate);
    });

    document.getElementById('next-day').addEventListener('click', () => {
      currentDate.setDate(currentDate.getDate() + 1);
      loadDay(currentDate);
    });

    document.getElementById('today-btn').addEventListener('click', () => {
      currentDate = new Date();
      currentDate.setHours(0,0,0,0);
      loadDay(currentDate);
    });

    loadDay(currentDate);
  </script>
</Layout>
