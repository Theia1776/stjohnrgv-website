---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Julian Calendar & Feast Days | St. John of Kronstadt Orthodox Mission"
  description="The traditional Julian Calendar feast days observed at St. John of Kronstadt Orthodox Mission, with both Old Style and New Style dates."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:py-28">
    <p class="text-xs uppercase tracking-widest text-gold-dim">Liturgical Year</p>
    <h1 class="mt-2 font-display text-3xl text-ink md:text-4xl">Julian Calendar &amp; Feast Days</h1>
    <p class="mt-6 text-lg text-ink/80">
      A full-year calendar of Great Feasts and major commemorations — with Julian (Old Style)
      and Gregorian (New Style) dates side-by-side — coming soon.
    </p>
    <p class="mt-4 text-ink/70">
      The Julian Calendar currently runs thirteen days behind the civil (Gregorian) calendar.
      A feast on December 25 OS, for example, falls on January 7 NS.
    </p>
  </section>
</Layout>
