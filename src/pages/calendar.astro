---
import Layout from "../layouts/Layout.astro";
import { saints, normalizeName } from "../lib/saints-lookup";

// Pre-attach a normalized name to each saint so the client doesn't
// have to re-normalize on every modal open. Inlined as JSON below
// next to the existing inline scripts; the modal opener checks this
// list first before falling through to /api/saint.
const localSaintsForClient = saints.map((s) => ({
  ...s,
  _norm: normalizeName(s.name),
  _normAliases: (s.aliases ?? []).map((a) => normalizeName(a)).filter(Boolean),
}));
const localSaintsJson = JSON.stringify(localSaintsForClient).replace(/</g, "\\u003c");
---

<Layout
  title="Calendar | St. John of Kronstadt Orthodox Mission"
  description="Daily Orthodox commemorations, saints, scripture readings, and troparia from St. John of Kronstadt Orthodox Mission, Bayview TX, Rio Grande Valley."
>
  <section class="mx-auto max-w-6xl px-4 py-20 md:py-28">

    <!-- Header / nav / loading / error stay narrow for readability;
         only the card grids inside #cal-content expand to the wider
         max-w-6xl section width. renderContent re-wraps its banner +
         commemorations blocks in max-w-3xl for the same reason. -->
    <div class="mx-auto max-w-3xl">
      <p class="mb-4 font-display text-xs uppercase tracking-widest text-text-secondary">Liturgical Calendar</p>

      <!-- Date header + navigation -->
      <div id="cal-header" class="mb-10 flex items-center gap-3">
        <button id="prev-day" class="shrink-0 font-display text-sm text-brand-blue transition-colors hover:text-brand-blue-dark">← Prev</button>
        <h1 id="cal-date" class="flex-1 text-center font-display text-xl text-text-primary md:text-2xl"></h1>
        <button id="next-day" class="shrink-0 font-display text-sm text-brand-blue transition-colors hover:text-brand-blue-dark">Next →</button>
      </div>
      <div class="mb-8 text-center">
        <button id="today-btn" class="font-display text-xs uppercase tracking-widest text-text-secondary transition-colors hover:text-brand-blue">↩ Today</button>
      </div>

      <!-- Loading -->
      <div id="cal-loading" class="py-20 text-center text-text-secondary">
        <p class="font-display text-base tracking-wide">Loading…</p>
      </div>

      <!-- Error -->
      <div id="cal-error" class="hidden py-20 text-center">
        <p class="text-lg text-text-secondary">Could not load calendar data. Please check your connection and try again.</p>
      </div>
    </div>

    <!-- Content (banner + commemorations re-clamp to max-w-3xl inside;
         readings + troparia card grids fill the full max-w-6xl). -->
    <div id="cal-content" class="hidden space-y-10"></div>

  </section>

  <!-- Reading modal — hidden by default, opened by Read More buttons. -->
  <div
    id="reading-modal"
    class="hidden fixed inset-0 z-[60] overflow-y-auto bg-text-primary/60 p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reading-modal-title"
  >
    <div id="reading-modal-panel" class="mx-auto max-w-2xl border border-brand-tan bg-cream-card p-6 shadow-lg md:p-8">
      <button
        id="reading-modal-close"
        type="button"
        aria-label="Close reading"
        class="float-right -mr-1 -mt-1 font-display text-2xl leading-none text-text-secondary hover:text-text-primary"
      >×</button>
      <h3 id="reading-modal-title" class="mb-4 pr-8 font-display text-xl font-bold text-brand-blue"></h3>
      <div id="reading-modal-body" class="space-y-2 leading-relaxed"></div>
    </div>
  </div>

  <!-- Local saints database (build-time snapshot of src/data/saints/).
       The modal opener checks this list before falling through to
       /api/saint, so a saint already in the parish catalog renders
       its full local life/troparion/kontakion with no round-trip. -->
  <script type="application/json" id="local-saints-data" is:inline set:html={localSaintsJson}></script>

  <script is:inline>
    const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

    let currentDate = new Date();
    currentDate.setHours(0,0,0,0);

    // Per-day state used by the modal openers and the saints toggle
    // (event handlers look these up by data-saint-index / data-card-key).
    let currentSaints = [];
    let currentReadings = [];
    let currentTroparia = [];

    // In-memory caches of fetched bodies, keyed by upstream url. Backed
    // by localStorage so reload + day-back-and-forth stays snappy.
    const readingCache = new Map();
    const saintCache = new Map();

    function formatDate(d) {
      return `${DAYS[d.getDay()]}, ${MONTHS[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
    }

    // YYYY-MM-DD from local components (not toISOString) so a user in the
    // western hemisphere gets *their* civil date instead of a UTC shift.
    function dateParam(d) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${day}`;
    }

    function apiUrl(date) { return `/api/calendar?date=${dateParam(date)}`; }
    // v2 prefix bust: bumped from htoc-cal- so visitors with cached
    // payloads from before saints became {name, url} objects get a
    // fresh fetch and clickable saint links instead of plain text.
    function dayCacheKey(date) { return `htoc-cal2-${dateParam(date)}`; }
    function readingCacheKey(url) { return `htoc-reading-${url}`; }
    function saintCacheKey(url) { return `htoc-saint-${url}`; }

    async function fetchDay(date) {
      const key = dayCacheKey(date);
      const cached = localStorage.getItem(key);
      if (cached) return JSON.parse(cached);
      const res = await fetch(apiUrl(date));
      if (!res.ok) throw new Error('Calendar API error');
      const data = await res.json();
      localStorage.setItem(key, JSON.stringify(data));
      return data;
    }

    async function fetchReading(url) {
      if (readingCache.has(url)) return readingCache.get(url);
      const lsKey = readingCacheKey(url);
      const stored = localStorage.getItem(lsKey);
      if (stored) {
        const parsed = JSON.parse(stored);
        readingCache.set(url, parsed);
        return parsed;
      }
      const res = await fetch(`/api/reading?url=${encodeURIComponent(url)}`);
      if (!res.ok) throw new Error('Reading API error');
      const data = await res.json();
      localStorage.setItem(lsKey, JSON.stringify(data));
      readingCache.set(url, data);
      return data;
    }

    async function fetchSaint(url) {
      if (saintCache.has(url)) return saintCache.get(url);
      const lsKey = saintCacheKey(url);
      const stored = localStorage.getItem(lsKey);
      if (stored) {
        const parsed = JSON.parse(stored);
        saintCache.set(url, parsed);
        return parsed;
      }
      const res = await fetch(`/api/saint?url=${encodeURIComponent(url)}`);
      if (!res.ok) throw new Error('Saint API error');
      const data = await res.json();
      localStorage.setItem(lsKey, JSON.stringify(data));
      saintCache.set(url, data);
      return data;
    }

    function toneOrdinal(n) {
      if (!n) return '';
      const words = ['','One','Two','Three','Four','Five','Six','Seven','Eight'];
      return words[n] || n;
    }

    function escapeHtml(s) {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Take the first N non-empty lines of a multiline string.
    function firstLines(text, n) {
      if (!text) return '';
      return text.split('\n').filter(l => l.trim()).slice(0, n).join('\n');
    }

    // Split the troparia plain-text block into individual entries.
    // Heuristic per the upstream format: a non-empty line ending in
    // " —" (em dash) is a title; everything from there until the next
    // such line is its body.
    function parseTroparia(text) {
      if (!text) return [];
      const entries = [];
      let current = null;
      for (const line of text.split('\n')) {
        const trimmed = line.trim();
        const titleMatch = /^(.+?)\s*—\s*$/.exec(trimmed);
        if (titleMatch && titleMatch[1].trim()) {
          if (current) entries.push(current);
          current = { title: titleMatch[1].trim(), body: '' };
        } else if (current) {
          current.body += (current.body ? '\n' : '') + line;
        }
      }
      if (current) entries.push(current);
      return entries.map(e => ({ title: e.title, body: e.body.trim() }));
    }

    // ---- Card rendering ----
    function renderReadingCard(r, i) {
      const ref = escapeHtml(r.reference || '');
      return `
        <article
          class="flex w-full max-w-sm flex-col border border-brand-tan bg-cream-card p-6 shadow-sm sm:basis-60 md:p-8"
          data-card="reading"
          data-card-key="${i}"
        >
          <p class="mb-3 font-display text-sm font-bold text-brand-blue">${ref}</p>
          <div class="flex-1 whitespace-pre-wrap text-sm leading-relaxed text-text-primary/85" data-preview>
            <span class="italic text-text-secondary">Loading…</span>
          </div>
          <button
            type="button"
            data-modal-open
            class="mt-4 self-start font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark hover:underline"
          >Read more →</button>
        </article>
      `;
    }

    function renderTroparionCard(entry, i) {
      const title = escapeHtml(entry.title || '');
      const preview = escapeHtml(firstLines(entry.body, 1));
      return `
        <article
          class="flex w-full max-w-sm flex-col border border-brand-tan bg-cream-card p-6 shadow-sm sm:basis-60 md:p-8"
          data-card="troparion"
          data-card-key="${i}"
        >
          <p class="mb-3 font-display text-sm font-bold text-brand-blue">${title}</p>
          <div class="flex-1 text-sm leading-relaxed text-text-primary/85">${preview || '<span class="italic text-text-secondary">(no text)</span>'}</div>
          <button
            type="button"
            data-modal-open
            class="mt-4 self-start font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark hover:underline"
          >Read more →</button>
        </article>
      `;
    }

    function renderContent(data) {
      const sections = [];

      // Top banner: week_title — Tone Ordinal. Clamped to max-w-3xl so
      // the headline keeps a comfortable reading width even though the
      // section now goes wider for the card grids.
      const title = data.week_title || '';
      const toneText = data.tone ? `Tone ${toneOrdinal(data.tone)}` : '';
      if (title || toneText) {
        const combined = [title, toneText].filter(Boolean).join(' — ');
        sections.push(`
          <div class="mx-auto w-full max-w-3xl rounded border border-brand-tan bg-cream-card px-5 py-4">
            <p class="font-display text-base font-bold text-text-primary">${escapeHtml(combined)}</p>
          </div>
        `);
      }

      // Commemorations: first 5 visible, the rest carry data-saint-overflow
      // and start hidden. The toggle button below flips them. Saints with
      // a Lives URL render as buttons that open the in-page saint modal;
      // saints with no upstream Life page stay as plain text.
      // Backward-compat: tolerate cached payloads from before the API
      // started returning {name, url} objects.
      currentSaints = (data.saints || []).map(s =>
        typeof s === 'string' ? { name: s, url: null } : s
      );
      if (currentSaints.length > 0) {
        const itemsHtml = currentSaints.map((s, i) => {
          const overflow = i >= 5;
          const cls = `text-lg leading-snug text-text-primary${overflow ? ' hidden' : ''}`;
          const attr = overflow ? ' data-saint-overflow' : '';
          const name = escapeHtml(s.name || '');
          const inner = s.url
            ? `<button type="button" data-saint-index="${i}" class="text-left text-brand-blue-dark hover:underline">${name}</button>`
            : name;
          return `<li class="${cls}"${attr}>• ${inner}</li>`;
        }).join('');
        const toggleHtml = currentSaints.length > 5
          ? `<button
              type="button"
              data-saints-toggle="show"
              class="mt-3 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue-dark hover:underline"
            >Show all (${currentSaints.length})</button>`
          : '';
        sections.push(`
          <div class="mx-auto w-full max-w-3xl" data-saints-block>
            <h2 class="mb-4 border-b border-brand-tan pb-2 font-display text-lg text-text-primary">Commemorations</h2>
            <ul class="space-y-2">${itemsHtml}</ul>
            ${toggleHtml}
          </div>
        `);
      }

      // Scripture Readings — card grid; "Read more" opens the in-page modal.
      currentReadings = data.readings || [];
      if (currentReadings.length > 0) {
        const readingItems = currentReadings.map((r, i) => renderReadingCard(r, i)).join('');
        sections.push(`
          <div>
            <h2 class="mb-4 border-b border-brand-tan pb-2 font-display text-lg text-text-primary">Scripture Readings</h2>
            <div class="flex flex-wrap justify-center gap-6">${readingItems}</div>
          </div>
        `);
      }

      // Troparia & Kontakia — parsed into cards matching the readings style.
      currentTroparia = parseTroparia(data.troparia || '');
      if (currentTroparia.length > 0) {
        const tropItems = currentTroparia.map((e, i) => renderTroparionCard(e, i)).join('');
        sections.push(`
          <div>
            <h2 class="mb-4 border-b border-brand-tan pb-2 font-display text-lg text-text-primary">Troparia &amp; Kontakia</h2>
            <div class="flex flex-wrap justify-center gap-6">${tropItems}</div>
          </div>
        `);
      }

      document.getElementById('cal-content').innerHTML = sections.join('');
    }

    // After renderContent: lazily fetch each reading's verses to fill in
    // the card preview. Runs in parallel; failures are swallowed
    // gracefully and the card shows a fallback.
    async function populateReadingPreviews() {
      await Promise.all(currentReadings.map(async (r, i) => {
        if (!r.url) return;
        const card = document.querySelector(`[data-card="reading"][data-card-key="${i}"]`);
        if (!card) return;
        const previewEl = card.querySelector('[data-preview]');
        try {
          const data = await fetchReading(r.url);
          const preview = firstLines(data.verses || '', 3);
          if (previewEl) {
            previewEl.textContent = preview || '(no preview available)';
          }
        } catch (_err) {
          if (previewEl) {
            previewEl.innerHTML = '<span class="italic text-text-secondary">(preview unavailable)</span>';
          }
        }
      }));
    }

    async function loadDay(date) {
      const loading = document.getElementById('cal-loading');
      const error = document.getElementById('cal-error');
      const content = document.getElementById('cal-content');

      loading.classList.remove('hidden');
      error.classList.add('hidden');
      content.classList.add('hidden');
      content.innerHTML = '';

      document.getElementById('cal-date').textContent = formatDate(date);

      try {
        const data = await fetchDay(date);
        renderContent(data);
        loading.classList.add('hidden');
        content.classList.remove('hidden');
        // Kick off reading-preview fetches; do not block the visible
        // render on them.
        populateReadingPreviews();
      } catch (e) {
        console.error('/api/calendar fetch failed:', e);
        loading.classList.add('hidden');
        error.classList.remove('hidden');
      }
    }

    // ---- Modal ----
    const modal = document.getElementById('reading-modal');
    const modalPanel = document.getElementById('reading-modal-panel');
    const modalTitle = document.getElementById('reading-modal-title');
    const modalBody = document.getElementById('reading-modal-body');
    const modalClose = document.getElementById('reading-modal-close');

    function showModal() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function renderVersesHtml(verses) {
      return verses.split('\n').filter(l => l.trim()).map(line => {
        const m = /^(\S+)\s+([\s\S]+)$/.exec(line);
        if (m) {
          return `<p><span class="mr-1 font-display text-xs text-text-secondary">${escapeHtml(m[1])}</span><span class="text-text-primary">${escapeHtml(m[2])}</span></p>`;
        }
        return `<p class="text-text-primary">${escapeHtml(line)}</p>`;
      }).join('');
    }

    async function openReadingModal(reading) {
      if (!reading) return;
      modalTitle.textContent = reading.reference || '';
      modalBody.innerHTML = '<p class="italic text-text-secondary">Loading…</p>';
      showModal();
      if (!reading.url) {
        modalBody.innerHTML = '<p class="italic text-text-secondary">No passage available.</p>';
        return;
      }
      try {
        const data = await fetchReading(reading.url);
        const verses = (data.verses || '').trim();
        modalBody.innerHTML = verses
          ? renderVersesHtml(verses)
          : '<p class="italic text-text-secondary">No passage text available.</p>';
      } catch (_err) {
        modalBody.innerHTML = '<p class="italic text-text-secondary">Could not load passage.</p>';
      }
    }

    function openTroparionModal(entry) {
      if (!entry) return;
      modalTitle.textContent = entry.title || '';
      modalBody.innerHTML =
        `<div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(entry.body || '')}</div>`;
      showModal();
    }

    // ---- Local saints DB (inlined at build time) ----
    // Mirrors src/lib/saints-lookup.ts so the modal can do a
    // synchronous in-page lookup before falling back to /api/saint.
    const LOCAL_SAINTS = JSON.parse(
      document.getElementById('local-saints-data').textContent,
    );
    const PREFIX_RE_CLIENT =
      /^(?:(?:the\s+)?(?:saint(?:ed)?|holy|venerable|monk|martyr|hieromartyr|righteous|apostle|prophet|blessed)\s+)+/i;
    function normalizeNameClient(s) {
      let n = String(s ?? '').toLowerCase();
      n = n.replace(/\([^)]*\)/g, ' ').replace(/\[[^\]]*\]/g, ' ');
      n = n.replace(PREFIX_RE_CLIENT, '');
      n = n.replace(/[^a-z0-9\s]+/g, ' ');
      n = n.replace(/\s+/g, ' ').trim();
      return n;
    }
    function findLocalSaint(calendarName) {
      const target = normalizeNameClient(calendarName);
      if (!target) return null;
      for (const s of LOCAL_SAINTS) {
        if (s._norm && (target.includes(s._norm) || s._norm.includes(target))) {
          return s;
        }
        if (s._normAliases) {
          for (const a of s._normAliases) {
            if (a && (target.includes(a) || a.includes(target))) {
              return s;
            }
          }
        }
      }
      return null;
    }

    function renderLocalSaintInModal(local) {
      modalTitle.textContent = local.name || '';
      const parts = [];
      // Subtle source badge so visitors know the bio is from the
      // parish catalog rather than the upstream HTC fetch.
      parts.push(
        '<p class="mb-3 font-display text-xs uppercase tracking-widest text-brand-tan-dark">From our parish saints catalog</p>',
      );
      if (local.feasts && local.feasts.length) {
        parts.push(`<p class="mb-3 text-sm italic text-text-secondary">Commemorated on ${escapeHtml(local.feasts.join(' · '))}</p>`);
      }
      if (local.life && local.life.trim()) {
        parts.push(`<div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(local.life)}</div>`);
      } else {
        parts.push('<p class="italic text-text-secondary">No biography available.</p>');
      }
      if (local.troparion && local.troparion.trim()) {
        parts.push(`
          <div class="border-t border-border-soft pt-4">
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Troparion</p>
            <div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(local.troparion)}</div>
          </div>
        `);
      }
      if (local.kontakion && local.kontakion.trim()) {
        parts.push(`
          <div class="border-t border-border-soft pt-4">
            <p class="mb-2 font-display text-xs uppercase tracking-widest text-text-secondary">Kontakion</p>
            <div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(local.kontakion)}</div>
          </div>
        `);
      }
      if (local.attribution) {
        parts.push(`<p class="mt-6 text-xs italic text-text-secondary">${escapeHtml(local.attribution)}</p>`);
      }
      modalBody.innerHTML = parts.join('');
    }

    async function openSaintModal(saint) {
      if (!saint) return;
      // Show the calendar's saint text immediately, then swap in the
      // canonical name from the Life page (local or HTC) once it loads.
      modalTitle.textContent = saint.name || '';
      showModal();

      // Try the parish saints catalog first — synchronous, no fetch.
      const local = findLocalSaint(saint.name);
      if (local) {
        renderLocalSaintInModal(local);
        return;
      }

      // Fall back to the existing HTC fetch flow.
      modalBody.innerHTML = '<p class="italic text-text-secondary">Loading…</p>';
      if (!saint.url) {
        modalBody.innerHTML = '<p class="italic text-text-secondary">No biography available.</p>';
        return;
      }
      try {
        const data = await fetchSaint(saint.url);
        if (data.name) modalTitle.textContent = data.name;
        const parts = [];
        if (data.commemorated) {
          parts.push(`<p class="mb-3 text-sm italic text-text-secondary">${escapeHtml(data.commemorated)}</p>`);
        }
        if (data.life) {
          parts.push(`<div class="whitespace-pre-wrap text-text-primary leading-relaxed">${escapeHtml(data.life)}</div>`);
        } else {
          parts.push('<p class="italic text-text-secondary">No biography text available.</p>');
        }
        if (data.attribution) {
          parts.push(`<p class="mt-6 text-xs italic text-text-secondary">${escapeHtml(data.attribution)}</p>`);
        }
        modalBody.innerHTML = parts.join('');
      } catch (_err) {
        modalBody.innerHTML = '<p class="italic text-text-secondary">Could not load life.</p>';
      }
    }

    // Close handlers
    modal.addEventListener('click', (e) => {
      if (!modalPanel.contains(e.target)) closeModal();
    });
    modalClose.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    // ---- Click delegation (saint links + card modal triggers + saints toggle) ----
    document.getElementById('cal-content').addEventListener('click', (e) => {
      // Saint name click → open Life modal
      const saintLink = e.target.closest('[data-saint-index]');
      if (saintLink) {
        const idx = parseInt(saintLink.dataset.saintIndex, 10);
        openSaintModal(currentSaints[idx]);
        return;
      }

      // Card modal triggers (readings + troparia)
      const opener = e.target.closest('[data-modal-open]');
      if (opener) {
        const card = opener.closest('[data-card]');
        if (card) {
          const idx = parseInt(card.dataset.cardKey, 10);
          if (card.dataset.card === 'reading') {
            openReadingModal(currentReadings[idx]);
          } else if (card.dataset.card === 'troparion') {
            openTroparionModal(currentTroparia[idx]);
          }
        }
        return;
      }

      // Commemorations show-all / show-less toggle
      const toggle = e.target.closest('[data-saints-toggle]');
      if (toggle) {
        const block = toggle.closest('[data-saints-block]');
        if (!block) return;
        const overflow = block.querySelectorAll('[data-saint-overflow]');
        const expanded = toggle.dataset.saintsToggle === 'hide';
        if (expanded) {
          overflow.forEach(li => li.classList.add('hidden'));
          toggle.textContent = `Show all (${overflow.length + 5})`;
          toggle.dataset.saintsToggle = 'show';
        } else {
          overflow.forEach(li => li.classList.remove('hidden'));
          toggle.textContent = 'Show less';
          toggle.dataset.saintsToggle = 'hide';
        }
      }
    });

    // ---- Day navigation ----
    document.getElementById('prev-day').addEventListener('click', () => {
      currentDate.setDate(currentDate.getDate() - 1);
      loadDay(currentDate);
    });
    document.getElementById('next-day').addEventListener('click', () => {
      currentDate.setDate(currentDate.getDate() + 1);
      loadDay(currentDate);
    });
    document.getElementById('today-btn').addEventListener('click', () => {
      currentDate = new Date();
      currentDate.setHours(0,0,0,0);
      loadDay(currentDate);
    });

    loadDay(currentDate);
  </script>
</Layout>
