---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLiturgicalSeason } from "../lib/liturgical.ts";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const SITE_URL = "https://stjohnrgv.org";
const DEFAULT_OG = "/og-image.jpg";

const {
  title,
  description,
  canonical = SITE_URL + Astro.url.pathname,
  ogImage = DEFAULT_OG,
} = Astro.props;

const ogImageUrl = ogImage.startsWith("http") ? ogImage : SITE_URL + ogImage;

// Compute today's liturgical season at build time. The page renders with
// the right colors and (homepage) banner content baked in for non-JS users
// and for the build day. The client script below re-evaluates with the
// user's actual local date and updates if it differs.
const buildDaySeason = getLiturgicalSeason(new Date());
const liturgicalRootStyle =
  `--liturgical-current: ${buildDaySeason.colorHex};`
  + `--liturgical-current-text: ${buildDaySeason.textColorHex};`;
---

<!doctype html>
<html lang="en" data-build-season={buildDaySeason.seasonKey} style={liturgicalRootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Dark-theme bootstrap. Runs synchronously before the body
         renders so visitors with a saved or system-preferred dark
         theme don't see a flash of light theme. The Header.astro
         toggle persists the user's choice in localStorage. -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="St. John of Kronstadt Orthodox Mission" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Cinzel (display) + Crimson Pro (body, variable weight 400–700, upright + italic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Crimson+Pro:ital,wght@0,400..700;1,400..700&display=swap"
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Liturgical accent stripe — sticks at the very top, visible at all
         times. The signature seasonal-color element on every page. -->
    <div class="sticky top-0 z-50 h-1 w-full bg-liturgical-current" aria-hidden="true"></div>

    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Back-to-top floating button — appears after the user scrolls past 600px. -->
    <button id="back-to-top" type="button" class="btn-floating" aria-label="Back to top">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
    </button>

    <script>
      // Back-to-top: show after 600px scroll, smooth-scroll to top on click.
      // Smooth-scroll honors :root scroll-behavior, so prefers-reduced-motion
      // users get an instant jump (handled in global.css).
      const btn = document.getElementById("back-to-top");
      if (btn) {
        const threshold = 600;
        const update = () => {
          if (window.scrollY > threshold) btn.classList.add("is-visible");
          else btn.classList.remove("is-visible");
        };
        window.addEventListener("scroll", update, { passive: true });
        btn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        update();
      }
    </script>

    <script>
      /**
       * Liturgical season hydration.
       *
       * The build-day season is baked into <html style="..."> by SSR, so a
       * non-JS user always sees a sensible color. This script re-runs
       * getLiturgicalSeason() with the user's local date — if their date
       * has rolled past the build date into a new season (e.g. they
       * loaded a build from yesterday into the morning of Pascha), the
       * colors and homepage banner update without a flash.
       */
      import { getLiturgicalSeason } from "../lib/liturgical.ts";

      const PASCHAL_KEYS = new Set(["pascha-day", "bright-week", "paschal-season"]);

      const root = document.documentElement;
      const builtSeason = root.dataset.buildSeason;
      const today = getLiturgicalSeason(new Date());

      if (today.seasonKey !== builtSeason) {
        root.style.setProperty("--liturgical-current", today.colorHex);
        root.style.setProperty("--liturgical-current-text", today.textColorHex);
        root.dataset.buildSeason = today.seasonKey;

        const banner = document.getElementById("liturgical-banner");
        if (banner) {
          const headlineEl = banner.querySelector<HTMLElement>("[data-banner-headline]");
          const sublineEl = banner.querySelector<HTMLElement>("[data-banner-subline]");
          const labelEl = banner.querySelector<HTMLElement>("[data-banner-label]");
          if (headlineEl) headlineEl.textContent = today.bannerHeadline;
          if (sublineEl) sublineEl.textContent = today.bannerSubline;
          if (labelEl) labelEl.textContent = `${today.label} — ${today.vestmentName} vestments`;
          banner.dataset.seasonKey = today.seasonKey;

          // Toggle paschal-specific styling: background image (Anastasis icon),
          // sacred-gold + paschal-headline on the headline, paschal-label on the
          // label. Keeps the banner correct when the user's local date has
          // rolled into / out of a paschal season post-build.
          const isPaschalNow = PASCHAL_KEYS.has(today.seasonKey);

          banner.classList.toggle("paschal-banner-bg", isPaschalNow);
          banner.classList.toggle("text-cream-card", isPaschalNow);
          banner.classList.toggle("bg-liturgical-current", !isPaschalNow);

          if (headlineEl) {
            // Sacred-gold for the "Christ is Risen!" headline (visual focus);
            // bold weight + dark text-shadow via .paschal-headline.
            headlineEl.classList.toggle("text-sacred-gold", isPaschalNow);
            headlineEl.classList.toggle("paschal-headline", isPaschalNow);
          }

          // Eyebrow ("Current Season"): paschal swaps to Cinzel + stronger
          // text-shadow + slightly more letter-spacing via .paschal-eyebrow;
          // other seasons use the default tracked-out 70% opacity treatment.
          const eyebrowEl = banner.querySelector<HTMLElement>("[data-banner-eyebrow]");
          if (eyebrowEl) {
            eyebrowEl.classList.toggle("paschal-eyebrow", isPaschalNow);
            eyebrowEl.classList.toggle("tracking-[0.3em]", !isPaschalNow);
            eyebrowEl.classList.toggle("opacity-70", !isPaschalNow);
          }
          if (labelEl) {
            labelEl.classList.toggle("text-base", isPaschalNow);
            labelEl.classList.toggle("paschal-label", isPaschalNow);
            labelEl.classList.toggle("text-xs", !isPaschalNow);
            labelEl.classList.toggle("opacity-70", !isPaschalNow);
          }
        }
      }
    </script>
  </body>
</html>
