---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLiturgicalSeason } from "../lib/liturgical.ts";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const SITE_URL = "https://stjohnrgv.org";
const DEFAULT_OG = "/og-image.jpg";

const {
  title,
  description,
  canonical = SITE_URL + Astro.url.pathname,
  ogImage = DEFAULT_OG,
} = Astro.props;

const ogImageUrl = ogImage.startsWith("http") ? ogImage : SITE_URL + ogImage;

// Compute today's liturgical season at build time. The page renders with
// the right colors and (homepage) banner content baked in for non-JS users
// and for the build day. The client script below re-evaluates with the
// user's actual local date and updates if it differs.
const buildDaySeason = getLiturgicalSeason(new Date());
const liturgicalRootStyle =
  `--liturgical-current: ${buildDaySeason.colorHex};`
  + `--liturgical-current-text: ${buildDaySeason.textColorHex};`;
---

<!doctype html>
<html lang="en" data-build-season={buildDaySeason.seasonKey} style={liturgicalRootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="St. John of Kronstadt Orthodox Mission" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Cinzel + IM Fell English -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=IM+Fell+English:ital@0;1&display=swap"
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Liturgical accent stripe — full-width 4px line at the top of the page. -->
    <div class="h-1 w-full bg-liturgical-current" aria-hidden="true"></div>

    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      /**
       * Liturgical season hydration.
       *
       * The build-day season is baked into <html style="..."> by SSR, so a
       * non-JS user always sees a sensible color. This script re-runs
       * getLiturgicalSeason() with the user's local date — if their date
       * has rolled past the build date into a new season (e.g. they
       * loaded a build from yesterday into the morning of Pascha), the
       * colors and homepage banner update without a flash.
       */
      import { getLiturgicalSeason } from "../lib/liturgical.ts";

      const root = document.documentElement;
      const builtSeason = root.dataset.buildSeason;
      const today = getLiturgicalSeason(new Date());

      if (today.seasonKey !== builtSeason) {
        root.style.setProperty("--liturgical-current", today.colorHex);
        root.style.setProperty("--liturgical-current-text", today.textColorHex);
        root.dataset.buildSeason = today.seasonKey;

        const banner = document.getElementById("liturgical-banner");
        if (banner) {
          const headlineEl = banner.querySelector<HTMLElement>("[data-banner-headline]");
          const sublineEl = banner.querySelector<HTMLElement>("[data-banner-subline]");
          const labelEl = banner.querySelector<HTMLElement>("[data-banner-label]");
          if (headlineEl) headlineEl.textContent = today.bannerHeadline;
          if (sublineEl) sublineEl.textContent = today.bannerSubline;
          if (labelEl) labelEl.textContent = `${today.label} — ${today.vestmentName} vestments`;
          banner.dataset.seasonKey = today.seasonKey;
        }
      }
    </script>
  </body>
</html>
